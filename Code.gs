function AQBBuildAIPexelsImageQueries(service,category,description){
  // Retained function name for compatibility; this photo query planner does not call AI.
  const s=String(service||'').trim(), categoryName=String(category||'').trim();
  const name=(/child|kid|teen/i.test(s)?'Black child':'Black woman');
  const phrases=[];
  if(/boho.*knotless|knotless.*boho/i.test(s))phrases.push('finished bohemian knotless braids curly strands scalp parting installed hairstyle');
  else if(/artistic.*cornrow|designer.*cornrow/i.test(s))phrases.push('artistic designer cornrows geometric curved braiding scalp pattern finished hairstyle');
  else if(/lemonade/i.test(s))phrases.push('lemonade braids side swept cornrows installed finished hairstyle');
  else if(/passion twist/i.test(s))phrases.push('passion twists finished protective hairstyle two strand curly twists');
  else if(/fulani/i.test(s))phrases.push('Fulani braids front cornrows back individual braids finished hairstyle');
  else if(/knotless|braids|cornrows|twists|locs|weave/i.test(s))phrases.push(s+' completed installed hairstyle scalp detail');
  else phrases.push(s+' professional salon finished service');
  phrases.push(s+' '+categoryName+' finished hairstyle salon result');
  phrases.push(s+' Black hair salon hairstyle close up of technique');
  return phrases.map(x=>name+' '+x).filter((x,i,a)=>a.indexOf(x)===i).slice(0,4);
}

function AQBEvaluatePexelsCandidateWithAI(service,category,description,candidate){
  // V16.21.15.6.5.3.10 — Deterministic, offline metadata screening ONLY.
  // No Pexels description or search-query token can prove visually correct pixels.
  // Explicitly fail closed for approval; manual visual evidence is required.
  const url=String(candidate&&candidate.imageUrl||'').trim();
  if(!/^https:\/\//i.test(url))return {configured:false,valid:false,score:0,reason:'INVALID_IMAGE_URL',inspectionPerformed:false};
  const alt=String(candidate&&(candidate.alt||candidate.description||candidate.photographerAlt)||'').toLowerCase();
  const name=String(service||'').toLowerCase();
  const negative=[];
  if(/\b(hair bundle|bundles|loose extensions|hair extensions for sale|holding extensions|held in hand|hand holding|product shot|product only|unattached|wig on stand|mannequin head)\b/i.test(alt))negative.push('PRODUCT_OR_UNINSTALLED_HAIR');
  if(/cornrow|lemonade|feed.in/i.test(name)&&/\b(twists|loose curls|afro wig)\b/i.test(alt)&&!/cornrow|braids/i.test(alt))negative.push('WRONG_STYLE_FAMILY');
  if(/\btwist/i.test(name)&&/\b(cornrows|straight back cornrows)\b/i.test(alt)&&!/twist/i.test(alt))negative.push('WRONG_STYLE_FAMILY');
  if(/boho.*knotless|knotless.*boho/i.test(name)&&/\b(hair bundles|braid extensions|hair product)\b/i.test(alt))negative.push('PRODUCT_INSTEAD_OF_INSTALLED_STYLE');
  const reason=negative.length?'DISCOVERY_REJECTED_'+negative.join('_'):'MANUAL_VISUAL_VERIFICATION_REQUIRED';
  return {configured:false,valid:false,score:0,reason:reason,
    inspectionPerformed:false,screeningMode:'DETERMINISTIC_METADATA_ONLY',
    evidence:{sourceTextAvailable:!!alt,negativeSignals:negative,visualProof:false},
    missingFeatures:['IMAGE_PIXEL_INSPECTION_NOT_PERFORMED','SERVICE_SPECIFIC_TECHNIQUE_UNVERIFIED']};
}

function AQBBuildPexelsImageQueries(service,category,description){
