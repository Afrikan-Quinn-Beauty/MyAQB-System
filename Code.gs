    // The canonical generator already returns a ContentService TextOutput.
    return AQBCreateTikTokGenericCatalogueFeed({format:format});
  }catch(err){
    console.error('AQB TikTok feed generation failed: '+String(err&&err.message||err).slice(0,250));
    return ContentService.createTextOutput('Feed temporarily unavailable').setMimeType(ContentService.MimeType.TEXT);
  }
}
/** Admin-only, does not expose the token or change the existing credential. */
function AQBInitializeTikTokFeedToken(){
  AQBRequireAdmin();
  const p=PropertiesService.getScriptProperties();
  if(p.getProperty('TIKTOK_FEED_STATIC_TOKEN'))return {configured:true,rotated:false,notice:'Token exists; no changes made.'};
  const token=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');
  p.setProperty('TIKTOK_FEED_STATIC_TOKEN',token);
  return {configured:true,rotated:false,notice:'Token generated and stored; retrieve securely through administrator configuration. Do not log or share publicly.'};
}
/** Read-only feed row diagnostic; no product database or channel cache is created. */
function AQBInspectTikTokFeedReadiness(){
  AQBRequireAdmin();
  const data=AQBBuildTikTokCatalogueRows();
  const issues=[],ids={};
  data.rows.forEach(function(r,i){
    const id=String(r[0]||'');
    if(!/^AQBCAT\d{3,}$/.test(id))issues.push({id:id,row:i+1,issue:'Invalid canonical ID'});
    if(ids[id])issues.push({id:id,row:i+1,issue:'Duplicate canonical ID'});
    ids[id]=true;
    if(!String(r[1]||'').trim())issues.push({id:id,issue:'Missing title'});
    if(!String(r[2]||'').trim())issues.push({id:id,issue:'Missing description'});
    if(!/^https:\/\//i.test(String(r[3]||'')))issues.push({id:id,issue:'Missing or non-HTTPS image URL'});
    if(!/^https:\/\//i.test(String(r[4]||'')))issues.push({id:id,issue:'Missing or non-HTTPS booking URL'});
    if(!/^\d+(?:\.\d{2})? KES$/.test(String(r[5]||'')))issues.push({id:id,issue:'Invalid price'});
  });
  return {readOnly:true,canonicalSource:true,counts:data.counts,eligible:data.rows.length,issueCount:issues.length,issues:issues.slice(0,200),issuesTruncated:issues.length>200,feedTokenConfigured:String(PropertiesService.getScriptProperties().getProperty('TIKTOK_FEED_STATIC_TOKEN')||'').length>=32,publicEndpointNotVerified:true,tiktokIngestionNotVerified:true};
}
/** Read-only status: never assumes a callback is publicly reachable. */
function AQBDarajaActivationReadiness(){
  AQBRequireAdmin();
  const base=AQBDarajaCallbackReadiness();
  return Object.assign({},base,{canActivate:false,reason:'Callback delivery and public route authorization require independently verified end-to-end testing. No production STK initiated.'});
}

/** AQB30: single-service own-photo qualification and publication; no bulk mode. */
function AQB30PublishOwnPhoto(input){
  input=input||{};
  if(input.dryRun!==true&&input.confirm!==true)throw Error('Explicit single-service publication confirmation required');
  AQBRequireCataloguePhotoManager();
  const id=String(input.catalogueId||'').trim().toUpperCase();
  if(!/^AQBCAT\d{3,}$/.test(id))throw Error('Invalid canonical ID');
  const lock=LockService.getScriptLock();if(!lock.tryLock(30000))throw Error('Publication busy');
  try{
    const ss=AQBGetSpreadsheet(),stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),cat=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),ledger=ss.getSheetByName('AQB Photo Approval Decisions');
    if(!stage||!cat||!ledger)throw Error('Catalogue, Photo Staging and approval ledger required');
    const sm=AQBBuildHeaderMap(stage),cm=AQBBuildHeaderMap(cat),lm=AQBBuildHeaderMap(ledger);
    function need(map,names,label){names.forEach(function(k){if(!map[k])throw Error(label+' missing '+k);});}
    need(sm,['Catalogue ID','Candidate Image URL','Candidate Source','Qualification Status'],'Photo Staging');
    need(cm,['Catalogue ID','Image URL','Image Source','Photo Qualification Status'],'Catalogue');
    need(lm,['Catalogue ID','Candidate Image URL','Decision','Reviewer','Visual Match Confirmed'],'Approval ledger');
    function rows(sheet,map){const out=[];const data=sheet.getDataRange().getValues();for(let i=1;i<data.length;i++)if(String(data[i][map['Catalogue ID']-1]||'').trim().toUpperCase()===id)out.push({number:i+1,values:data[i]});return out;}
    const sr=rows(stage,sm),cr=rows(cat,cm);
    if(sr.length!==1||cr.length!==1)throw Error('Service requires exactly one staging and one Catalogue row');
    const get=(row,map,key)=>String(map[key]?row.values[map[key]-1]||'':'').trim();
    const url=get(sr[0],sm,'Candidate Image URL'),source=get(sr[0],sm,'Candidate Source');
    if(!url||source!=='Own photo')throw Error('Only explicitly approved own-photo candidates can use this journey');
    const match=url.match(/[?&]id=([A-Za-z0-9_-]{15,})/);if(!match)throw Error('Candidate must be an AQB Drive image');
    const folderId=AQBNormalizeDriveFolderId(AQBGetSetupSetting('Catalogue Own Photo Folder ID'));
    if(!folderId)throw Error('AQB Photo folder not configured');
    const file=DriveApp.getFileById(match[1]);
    if(file.isTrashed()||!/^image\//.test(file.getMimeType()))throw Error('Candidate Drive image missing or invalid');
    const parents=file.getParents();let inFolder=false;while(parents.hasNext())if(parents.next().getId()===folderId)inFolder=true;
    if(!inFolder)throw Error('Candidate is not in the configured AQB Photo folder');
    const actor=AQBRequireCataloguePhotoManager(),email=String(actor.email||Session.getActiveUser().getEmail()||'').toLowerCase();
    const approvals=rows(ledger,lm);let last=null;
    approvals.forEach(function(r){if(get(r,lm,'Candidate Image URL')===url)last=r;});
    if(!last||get(last,lm,'Decision')!=='APPROVED'||get(last,lm,'Visual Match Confirmed').toUpperCase()!=='TRUE'||get(last,lm,'Reviewer').toLowerCase()!==email)throw Error('Matching reviewer approval for this exact Drive candidate is required');
    const old=get(cr[0],cm,'Image URL');
    if(old&&old!==url)throw Error('Existing Catalogue image protected: use an explicit replacement workflow');
    if(old===url)return {success:true,catalogueId:id,alreadyPublished:true,published:false,eligible:true};
    if(input.dryRun===true)return {success:true,catalogueId:id,eligible:true,alreadyPublished:false,published:false,qualification:'Ready for explicit qualification and publication'};
    stage.getRange(sr[0].number,sm['Qualification Status']).setValue('QUALIFIED');
    const fields={'Image URL':url,'Image Source':'AQB OWN PHOTO','Photo Qualification Status':'QUALIFIED','Image Status':'Qualified Representative Image','Photo Provenance':'AQB OWN PHOTO — MANUALLY APPROVED','Representative Image':'YES'};
    Object.keys(fields).forEach(function(k){if(cm[k])cat.getRange(cr[0].number,cm[k]).setValue(fields[k]);});
    SpreadsheetApp.flush();
    AQBLogAudit('PUBLISH_APPROVED_OWN_PHOTO','Photography',id,'Approved Drive photo '+file.getId());
    return {success:true,catalogueId:id,qualified:true,published:true,imageUrl:url};
  }finally{lock.releaseLock();}
}
