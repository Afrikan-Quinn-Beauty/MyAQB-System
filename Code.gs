  }catch(e){AQBLogAudit('GOOGLE_CONTACTS_MOBILE_LOAD_ERROR','User',user.email,String(e&&e.message||e));throw new Error('Google Contacts page failed: '+String(e&&e.message||e));}
}

function AQBSaveCustomerToGoogleContact(payload){
  const user=AQBRequireGoogleContactsUser(); payload=payload||{};
  const fallback=AQBSplitCustomerName(String(payload.customerName||'').trim()), first=String(payload.firstName||'').trim()||fallback.firstName, last=String(payload.lastName||'').trim()||fallback.lastName;
  const phone=AQBNormalizePhone(payload.phone||payload.whatsappNumber||''), email=String(payload.email||'').trim();
  if(!first&&!last)throw new Error('Customer name is required to save a Google Contact.'); if(!AQBIsValidPhone(phone))throw new Error('Please enter a valid Kenyan WhatsApp/phone number.');
  if(typeof People==='undefined'||!People.People)throw new Error('Google Contacts authorization or People API access is required.');
  let existing;
  try{ existing=AQBGetGoogleContacts().contacts||[]; }catch(e){ AQBLogAudit('GOOGLE_CONTACTS_ERROR','Customer',String(payload.customerId||''),String(e&&e.message||e)); throw new Error('Google Contacts authorization is required before AQB can save this contact.'); }
  let match=existing.find(c=>phone&&AQBNormalizePhone(c.phone)===phone); if(!match&&email)match=existing.find(c=>email.toLowerCase()===String(c.email||'').trim().toLowerCase());
  const person={names:[{givenName:first,familyName:last}]}; if(phone)person.phoneNumbers=[{value:phone,type:'mobile'}]; if(email)person.emailAddresses=[{value:email,type:'home'}];
  let saved;
  try{
    if(match&&match.resourceName){
      let current=match; try{current=People.People.get(match.resourceName,{personFields:'names,phoneNumbers,emailAddresses,metadata'});}catch(e){current=match;}
      if(current.etag)person.etag=current.etag;
      saved=People.People.updateContact(match.resourceName,person,{updatePersonFields:'names,phoneNumbers,emailAddresses',personFields:'names,phoneNumbers,emailAddresses,metadata'});
      AQBLogAudit('GOOGLE_CONTACT_UPDATED','Customer',String(payload.customerId||''),'Google Contact updated by '+user.email+'.');
    }else{
      saved=People.People.createContact(person,{personFields:'names,phoneNumbers,emailAddresses,metadata'});
      AQBLogAudit('GOOGLE_CONTACT_CREATED','Customer',String(payload.customerId||''),'Google Contact created by '+user.email+'.');
    }
  }catch(e){AQBLogAudit('GOOGLE_CONTACTS_ERROR','Customer',String(payload.customerId||''),String(e&&e.message||e));throw new Error('Google Contact could not be saved. Your AQB customer record is safe.');}
  return {success:true,created:!match,updated:!!match,contact:AQBNormalizeGoogleContactPerson(saved)};
}

function AQBFindGoogleContactForCustomer(customerId){
  AQBRequireGoogleContactsUser();
  const details=AQBGetCustomerDetails(String(customerId||'').trim());
  const c=details&&details.customer?details.customer:null;
  if(!c)throw new Error('Customer not found.');
  const contacts=AQBGetGoogleContacts().contacts||[];
  const phone=AQBNormalizePhone(c.whatsappNumber||c.phone||'');
  return contacts.find(function(x){return phone && AQBNormalizePhone(x.phone)===phone;})||null;
}

function AQBImportGoogleContactsAsCustomers(contacts){
  const user=AQBRequireGoogleContactsUser();
  contacts=Array.isArray(contacts)?contacts:[];
  if(!contacts.length) return {success:true,imported:0,skipped:0,duplicates:0,invalid:0,results:[]};
  const sheet=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS), lastCol=sheet.getLastColumn(), m=AQBBuildHeaderMap(sheet), lastRow=sheet.getLastRow();
  const rows=lastRow>=2?sheet.getRange(2,1,lastRow-1,lastCol).getValues():[];
  const byPhone={},byEmail={};
  rows.forEach(function(r){
    const ph=AQBNormalizePhone(r[m['WhatsApp Number']-1]); if(ph)byPhone[ph]=String(r[m['Customer ID']-1]||'');
    const em=m['Email']?String(r[m['Email']-1]||'').trim().toLowerCase():''; if(em)byEmail[em]=String(r[m['Customer ID']-1]||'');
  });
  const results=[]; let imported=0,skipped=0,duplicates=0,invalid=0;
  const lock=LockService.getScriptLock(); lock.waitLock(30000);
  try{
    // Rebuild identity indexes AFTER acquiring lock; another writer may have added a customer.
    Object.keys(byPhone).forEach(k=>delete byPhone[k]);
    Object.keys(byEmail).forEach(k=>delete byEmail[k]);
    const lockedLast=sheet.getLastRow();
    if(lockedLast>=2)sheet.getRange(2,1,lockedLast-1,lastCol).getValues().forEach(function(r){
      const ph=AQBNormalizePhone(r[m['WhatsApp Number']-1]);
      if(ph)byPhone[ph]=String(r[m['Customer ID']-1]||'');
      if(m['Email']){const em=String(r[m['Email']-1]||'').trim().toLowerCase();if(em)byEmail[em]=String(r[m['Customer ID']-1]||'');}
    });
    contacts.forEach(function(c){
      c=c||{};
      const name=String(c.name||[c.firstName,c.lastName].filter(Boolean).join(' ')||'').trim();
      const first=String(c.firstName||'').trim() || AQBSplitCustomerName(name).firstName;
      const last=String(c.lastName||'').trim() || AQBSplitCustomerName(name).lastName;
      const phone=AQBNormalizePhone(c.phone||'');
      const email=String(c.email||'').trim();
      if(!name && !phone && !email){skipped++;results.push({name:name||'Unnamed',status:'SKIPPED',reason:'No usable contact details.'});return;}
      if(!AQBIsValidPhone(phone)){invalid++;skipped++;results.push({name:name||'Unnamed',status:'SKIPPED',reason:'Missing or invalid Kenyan phone number.'});return;}
      if(byPhone[phone] || (email && byEmail[email.toLowerCase()])){duplicates++;skipped++;results.push({name:name||phone,status:'SKIPPED',reason:'Already exists in AQB Customers.',customerId:byPhone[phone]||byEmail[email.toLowerCase()]});return;}
      const customerId=AQBGenerateCustomerID(), row=Array(lastCol).fill('');
      row[m['Customer ID']-1]=customerId; row[m['Customer Name']-1]=AQBBuildCustomerFullName(first,last,name);
      row[m['WhatsApp Number']-1]=phone; row[m['Customer Location']-1]=''; row[m['Service']-1]='Other Service Customer';
      if(m['First Name'])row[m['First Name']-1]=first; if(m['Last Name'])row[m['Last Name']-1]=last;
      if(m['Email'])row[m['Email']-1]=email;
      if(m['Payment Status'])row[m['Payment Status']-1]='Pending'; if(m['Total Visits'])row[m['Total Visits']-1]=0;
      if(m['Customer Status'])row[m['Customer Status']-1]='New'; if(m['Next Appointment Created'])row[m['Next Appointment Created']-1]='No';
      AQBAppendUniqueCustomerRow(sheet,row); byPhone[phone]=customerId; if(email)byEmail[email.toLowerCase()]=customerId; imported++;
      AQBLogAudit('IMPORT_GOOGLE_CONTACT','Customer',customerId,'Imported customer from Google Contacts by '+user.email+'.');
      results.push({name:name||phone,status:'IMPORTED',customerId});
    });
  }finally{lock.releaseLock();}
  return {success:true,imported,skipped,duplicates,invalid,results};
}

function AQBFindCustomer(phone){
  AQBRequireUser(); const normalized=AQBNormalizePhone(phone);
  if(!AQBIsValidPhone(normalized))return {found:false,phone:normalized};
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow();if(n<2)return {found:false,phone:normalized};
  const m=AQBBuildHeaderMap(s), rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  for(const row of rows){if(AQBNormalizePhone(row[m['WhatsApp Number']-1])===normalized)return {found:true,customer:AQBBuildCustomerObject(row,m)};}
  return {found:false,phone:normalized};
}

function AQBBuildCustomerObject(r,m,nextMap){
  if(!m || typeof m!=='object') m=AQBBuildHeaderMap(AQBGetSheet(CONFIG.SHEETS.CUSTOMERS));
  const get=h=>m? r[m[h]-1] : ''; const customerId=String(get('Customer ID')||r[0]||''), appt=AQBGetCustomerAppointmentSummary(customerId), next=(nextMap&&nextMap[customerId])||null;
  const service=String(get('Service')||r[6]||'');
  const lastRetieRaw=get('Last Retie Date')||r[7],daysSinceLastRetie=AQBIsSisterlocksService(service)&&lastRetieRaw?AQBGetDaysSinceDate(lastRetieRaw):null;
  const overdue=daysSinceLastRetie!==null?daysSinceLastRetie>CONFIG.RETIE_DAYS:false;
  const retieState=daysSinceLastRetie===null?'':(overdue?'OVERDUE':(daysSinceLastRetie===CONFIG.RETIE_DAYS?'DUE':'UPCOMING'));
  // A real future appointment takes precedence over the customer's overdue state.
  // OVERDUE RETIE is only the surfaced appointment status when there is no active
  // future appointment to display. This prevents a manually booked overdue client
  // from continuing to appear as OVERDUE RETIE after they have a SCHEDULED/CONFIRMED booking.
  const activeStatuses=['BOOKED','SCHEDULED','CONFIRMED','RESCHEDULED','NO REPLY'];
  const appointmentStatus=activeStatuses.includes(String(appt.appointmentStatus||'').trim().toUpperCase())
    ? appt.appointmentStatus
    : (overdue ? 'OVERDUE RETIE' : appt.appointmentStatus);
