    {key:'treatment',terms:['treatment','conditioning','deep conditioning','conditioner','hair mask']},
    {key:'installation',terms:['installation','install','installing','application','applying','fitting']},
    {key:'retightening',terms:['retightening','retighten','retie','re-tie','tightening']},
    {key:'repair',terms:['repair','repairing','fix','fixing','restoration','restore']},
    {key:'cutting',terms:['cut','cutting','trim','trimming','haircut']},
    {key:'colour',terms:['colour','color','colouring','coloring','dye','dyeing','tint']},
    {key:'consultation',terms:['consultation','consult','assessment','assessing']},
    {key:'braiding',terms:['braiding','braid installation','installing braids','plaiting']},
