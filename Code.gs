      const id=String(row[imageHeaders['Catalogue ID']-1]||'').trim().toUpperCase();
      if(!id)return;
      if(canonicalImages[id])throw Error('Duplicate Catalogue ID in photo reconciliation: '+id);
      canonicalImages[id]={url:String(row[imageHeaders['Image URL']-1]||'').trim(),source:imageHeaders['Image Source']?String(row[imageHeaders['Image Source']-1]||'').trim():''};
    });
    items.forEach(function(item){
      const id=String(item.catalogueId||'').trim().toUpperCase(), current=canonicalImages[id];
      if(!current||!current.url)throw Error('Missing canonical approved image for '+id);
      item.image=current.url;
      item.imageSource=current.source==='AQB Brand Asset'?'AQB Studio':(current.source||'AQB Studio');
    });
    const rows=items.map(function(x){return [x.catalogueId||'',x.category||'',x.customerCategory||'',x.name||'',x.price||'',x.description||'',x.image||'',x.imageStatus||'Publishable',x.imageSource||'',x.booking||'',x.whatsapp||'',new Date(),x.catalogueType||'Service',x.trendStatus||'',x.featured||'NO',x.trendStart||'',x.trendEnd||'',x.trendSource||'',x.collectionIds||'',x.serviceTier||''];});
    const last=publicSheet.getLastRow();if(last>1)publicSheet.getRange(2,1,last-1,PUBLIC_CATALOGUE_HEADERS.length).clearContent();if(rows.length)publicSheet.getRange(2,1,rows.length,PUBLIC_CATALOGUE_HEADERS.length).setValues(rows);
    const mostLoved=AQBGetCatalogueMostLoved(items,365),popularityMap={};mostLoved.forEach(function(x){popularityMap[String(x.catalogueId||x.name||'').toLowerCase()]=x;});items.forEach(function(x){const p=popularityMap[String(x.catalogueId||x.name||'').toLowerCase()];if(p){x.completedBookings=p.completedBookings;x.repeatCustomers=p.repeatCustomers;x.uniqueCustomers=p.uniqueCustomers;x.lastActivity=p.lastActivity;}});
    const canonicalTrending=Array.isArray(live.canonicalTrending)?live.canonicalTrending:AQBGetCurrentApprovedTrendingItems(items),tierCounts={};items.forEach(function(x){const k=String(x.serviceTier||'').trim();if(k)tierCounts[k]=(tierCounts[k]||0)+1;});
    const prepared={ready:true,items:items,appearance:live.appearance||AQBGetPublicAppearance(),catalogueUrl:live.catalogueUrl||((String(ScriptApp.getService().getUrl()||'').replace(/\/$/,'')+'?page=catalogue')),preparedAt:new Date().toISOString(),canonicalTrending:canonicalTrending,serviceTiers:tierCounts,mostLoved:mostLoved,mostLovedWindowDays:365,publicationReadiness:readiness,warning:live.warning||''};
    AQBCachePublicCatalogueSnapshot(prepared);
    AQBLogAudit('PREPARE_PUBLIC_CATALOGUE','Catalogue','PUBLIC',actor+' prepared '+items.length+' publication-ready services from '+readiness.checked+' active services; '+readiness.blocked+' remain safely withheld.');
    return {version:'V16.21.16.8.30',function:'AQBPrepareCataloguePublic',success:true,internal:internal,source:String(options.source||''),refreshSkipped:options.skipRefresh===true,total:Number(result.total||0),added:Number(result.added||0),updated:Number(result.updated||0),promotionRun:false,validation:{success:true,checked:readiness.checked,publishable:readiness.ready,blocked:readiness.blocked,duplicates:0,missing:Number(readiness.reasonCounts.MISSING_PHOTO||0),invalid:Number(readiness.reasonCounts.INVALID_PHOTO_URL||0),missingCatalogueRows:readiness.missingCatalogueRows,legacyDuplicateUrlGate:false},publicationReadiness:readiness,prepared:items.length,trending:canonicalTrending.length,serviceTiers:tierCounts,warning:prepared.warning||''};
  }catch(e){try{AQBLogAudit('PREPARE_PUBLIC_CATALOGUE_FAILED','Catalogue','PUBLIC',actor+' failed: '+(e.message||e));}catch(ignoreAudit){}throw e;}
}

function AQBCachePublicCatalogueSnapshot(data){
  const cache=CacheService.getScriptCache(), key='AQB_PUBLIC_CATALOGUE_V1621165', metaKey=key+'__META';
  try{
    const packed=JSON.stringify(data||{}), chunkSize=80000;
    cache.remove(key);cache.remove(metaKey);
    for(let i=0;i<12;i++)cache.remove(key+'__'+i);
    if(packed.length<90000){cache.put(key,packed,21600);return;}
    const count=Math.ceil(packed.length/chunkSize);
    for(let i=0;i<count;i++)cache.put(key+'__'+i,packed.slice(i*chunkSize,(i+1)*chunkSize),21600);
    cache.put(metaKey,String(count),21600);
  }catch(ignore){}
}

