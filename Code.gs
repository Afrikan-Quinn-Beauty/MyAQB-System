function AQBIsCompletionWhatsAppSent(appointmentId,customerId,appointmentDate){
  const props=PropertiesService.getScriptProperties(),key='AQB_COMPLETION_WA_SENT_'+String(appointmentId||'').trim();
  if(props.getProperty(key))return true;
  // Recover pre-worker sends from the Audit Log so deployment does not duplicate a
  // completion message that succeeded before appointment-level markers existed.
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.AUDIT_LOG),n=s.getLastRow(); if(n<2)return false;
    const rows=s.getRange(2,1,n-1,Math.min(9,s.getLastColumn())).getValues();
    const base=appointmentDate instanceof Date?new Date(appointmentDate):new Date(String(appointmentDate||''));
    const from=isNaN(base.getTime())?null:new Date(base.getFullYear(),base.getMonth(),base.getDate());
    const to=from?new Date(from.getTime()+3*86400000):null;
    for(let i=rows.length-1;i>=0;i--){
      const r=rows[i],action=String(r[3]||'').trim(),recordId=String(r[5]||'').trim();
      if(action!=='WHATSAPP_COMPLETION_SENT'||recordId!==String(customerId||'').trim())continue;
      const ts=r[0] instanceof Date?r[0]:new Date(r[0]);
      if(!from||(!isNaN(ts.getTime())&&ts>=from&&ts<to)){
        props.setProperty(key,new Date().toISOString());
        return true;
      }
    }
  }catch(ignore){}
  return false;
}

