  try{
    AQBEnsureSheet(CONFIG.SHEETS.CATALOGUE,CATALOGUE_HEADERS);
    const publicSheet=AQBEnsureSheet(CONFIG.SHEETS.PUBLIC_CATALOGUE,PUBLIC_CATALOGUE_HEADERS);
    publicSheet.getRange(1,1,1,PUBLIC_CATALOGUE_HEADERS.length).setValues([PUBLIC_CATALOGUE_HEADERS]);
    const result=options.skipRefresh===true?{success:true,skipped:true}:AQBRefreshCatalogue();
    const tierAuthority=AQBAuditCatalogueTierAuthority();
    if(!tierAuthority.success)throw new Error('PUBLIC CATALOGUE TIER AUTHORITY GATE: stored Catalogue Service Tier/category authority is invalid.');
    const sourceAuthority=AQBAuditCatalogueSourceOfTruth();
    if(!sourceAuthority.success)throw new Error('PUBLIC CATALOGUE SOURCE-OF-TRUTH GATE: stored Catalogue authority fields are incomplete or inconsistent.');
    const readiness=AQBEvaluateCataloguePublicationReadiness({writeStatus:true});
    if(!readiness.success)throw new Error('PUBLIC CATALOGUE SAFETY GATE: publication readiness could not be evaluated.');
    if(readiness.ready<1)throw new Error('PUBLIC CATALOGUE SAFETY GATE: no approved service currently passes the photo/publication gate.');
    // Report why public coverage differs from active Catalogue services;
    // never bypass the approval/readiness gate to force a numeric count.
    if(readiness.blocked){
      Logger.log('AQB_PUBLIC_READINESS_DIAGNOSTIC '+JSON.stringify({version:'V16.21.16.7',checked:readiness.checked,ready:readiness.ready,blocked:readiness.blocked,reasonCounts:readiness.reasonCounts||{},missingCatalogueRows:readiness.missingCatalogueRows||0}));
    }

    const live=AQBGetCatalogueLegacyPublicData({fast:true})||{},items=Array.isArray(live.items)?live.items:[];
    if(items.length!==readiness.ready)throw new Error('PUBLIC CATALOGUE SAFETY GATE: readiness authority reports '+readiness.ready+' safe services but prepared public data contains '+items.length+'. Run AQBCatalogueAuditRegression() before publishing.');
    const readySet={};readiness.readyIds.forEach(function(id){readySet[String(id||'').toUpperCase()]=true;});
    const unsafe=items.filter(function(x){return !readySet[String(x.catalogueId||'').toUpperCase()];});
    if(unsafe.length)throw new Error('PUBLIC CATALOGUE SAFETY GATE: prepared data contains '+unsafe.length+' services outside the current publication-ready authority.');

    // V16.21.16.8.29: current canonical Catalogue photos are the ONLY service-photo authority.
    // Do not use historic local brand asset mappings, Pexels results or cached public URLs.
    const imageSheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE), imageValues=imageSheet.getDataRange().getValues(), imageHeaders=AQBBuildHeaderMap(imageSheet), canonicalImages={};
    ['Catalogue ID','Image URL'].forEach(function(k){if(!imageHeaders[k])throw Error('Missing canonical image field '+k);});
