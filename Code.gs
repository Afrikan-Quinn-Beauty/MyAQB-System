function AQBGetMasterListValues(item) {
  return AQBGetMasterListOptions(item).map(r=>r.service);
}

function AQBGetMasterListOptions(item) {
  const s=AQBGetSheet(CONFIG.SHEETS.LISTS), n=s.getLastRow(); if(n<2)return [];
  const schema=AQBGetMasterListsSchema(),map=schema.map,valueCol=schema.serviceNameCol,catCol=map['Category'],activeCol=map['Active'],orderCol=map['Sort Order'],itemCol=schema.itemCol;
  const requested=String(item||'').trim();
  const seen={};
  return s.getRange(2,1,n-1,s.getLastColumn()).getValues()
    .filter(function(r){
      if(!r[valueCol-1])return false;
      if(schema.legacyNoItem){
        // Older AQB Master Lists exports did not carry Item/Service Name labels.
        // Treat populated service rows as services; management-only lists still use the newer schema.
        return requested==='Service';
      }
      return String(r[itemCol-1]||'').trim()===requested;
    })
    .filter(function(r){const active=r[activeCol-1];return !(active===false||String(active).toLowerCase()==='false'||String(active)==='0');})
    .map(function(r){return {service:String(r[valueCol-1]).trim(),category:String(catCol?r[catCol-1]:'').trim(),sortOrder:Number(orderCol?r[orderCol-1]:0)||0,item:schema.legacyNoItem?'Service':String(r[itemCol-1]).trim()};})
    .filter(function(x){const k=x.service.toLowerCase();if(seen[k])return false;seen[k]=true;return true;})
    .sort(function(a,b){return a.category.localeCompare(b.category,undefined,{sensitivity:'base'})||a.sortOrder-b.sortOrder||a.service.localeCompare(b.service,undefined,{sensitivity:'base'});});
}

function AQBGetServiceOptions(){
  AQBRequireUser();
  const services=AQBGetMasterListOptions('Service'),counts={};
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow(),cutoff=new Date();
    cutoff.setFullYear(cutoff.getFullYear()-1);cutoff.setHours(0,0,0,0);
    if(n>=2)s.getRange(2,1,n-1,17).getValues().forEach(function(r){
      if(String(r[8]||'').trim().toUpperCase()!=='COMPLETED')return;
      const d=r[5] instanceof Date?r[5]:new Date(r[5]);if(isNaN(d)||d<cutoff)return;
      const name=String(r[4]||'').trim();if(name)counts[name]=(counts[name]||0)+1;
    });
  }catch(ignore){}
  services.sort(function(a,b){return String(a.category||'').localeCompare(String(b.category||''),undefined,{sensitivity:'base'})||String(a.service||'').localeCompare(String(b.service||''),undefined,{sensitivity:'base'});});
  const ranked=services.filter(function(x){return counts[x.service]>0;}).sort(function(a,b){return (counts[b.service]||0)-(counts[a.service]||0)||a.service.localeCompare(b.service,undefined,{sensitivity:'base'});}).slice(0,10),rank={};
  ranked.forEach(function(x,i){rank[x.service]=i+1;});
  return services.map(function(x){return Object.assign({},x,{usageCount:counts[x.service]||0,mostlyUsedRank:rank[x.service]||0});});
}

