    const isTargetWarning=action==='CALENDAR_CLEANUP_WARNING'&&description.indexOf('Completed appointment cleanup attempted 3 event(s): 0 deleted, 3 still pending.')>=0;
    if(isTargetError||isTargetWarning)removed++;else keep.push(r);
  });
  if(removed){
