function AQBAuditPublicOriginalPhotoTest3(){
  AQBRequireCataloguePhotoManager();
  const ids=['AQBCAT009','AQBCAT100','AQBCAT142'];
  const ss=AQBGetSpreadsheet(),stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),hm=AQBBuildHeaderMap(stage);
  const at=function(r,k){return hm[k]?String(r[hm[k]-1]||'').trim():'';},lookup={};
  stage.getDataRange().getValues().slice(1).forEach(function(r){const id=at(r,'Catalogue ID').toUpperCase();if(ids.indexOf(id)>=0)lookup[id]=r;});
  const result=ids.map(function(id){const r=lookup[id];if(!r)return{id:id,status:'STAGING_MISSING'};
    const m=at(r,'Candidate Image URL').match(/(?:[?&]id=|\/file\/d\/)([A-Za-z0-9_-]{15,})/);
    if(!m)return{id:id,status:'ORIGINAL_ID_UNRESOLVED'};
    try{const t=Date.now(),f=DriveApp.getFileById(m[1]),mime=f.getMimeType(),size=f.getSize();return{id:id,status:'READABLE',mime:mime,originalBytes:size,estimatedBase64Bytes:Math.ceil(size/3)*4,elapsedMs:Date.now()-t,under8MB:size<=8388608};}
    catch(ex){return{id:id,status:'ORIGINAL_UNAVAILABLE',error:String(ex.message||ex).slice(0,120)};}
  });
  const safe=AQBGetPublicCataloguePhotoTest3(ids);
