function AQBMatchEventRuleDate(event,date){
  const d=new Date(date||new Date()),tz=Session.getScriptTimeZone();
  const y=Number(Utilities.formatDate(d,tz,'yyyy')),
        m=Number(Utilities.formatDate(d,tz,'MM')),
        day=Number(Utilities.formatDate(d,tz,'dd'));
  const rule=String(event['Trigger Rule']||'').trim().toUpperCase();

  if(rule==='FIRST_FULL_WEEK_OCT_FRIDAY'){
    if(m!==10)return false;
    let firstMonday=1;
    for(let n=1;n<=7;n++){
      const x=new Date(y,9,n);
      if(x.getDay()===1){firstMonday=n;break;}
    }
    return day===firstMonday+4;
  }
  let mm=rule.match(/^MONTH_DAY:(\d{2})-(\d{2})$/);
  if(mm)return m===Number(mm[1])&&day===Number(mm[2]);
  let iso=rule.match(/^DATE:(\d{4})-(\d{2})-(\d{2})$/);
  if(iso)return y===Number(iso[1])&&m===Number(iso[2])&&day===Number(iso[3]);
  return false;
}

function AQBGetEventAudience(audience,eventId){
  const target=String(audience||'').trim().toUpperCase();
  if(['ACTIVE_CUSTOMERS','ALL_CUSTOMERS','ONBOARDED_CUSTOMERS','OPTED_IN_MARKETING_CUSTOMERS'].indexOf(target)===-1)throw new Error('Unsupported AQB event audience: '+target);
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow();
  if(n<2)return [];
  const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues(),out=[];
  const consentCol=m['WhatsApp Marketing Consent']||m['Marketing Consent']||m['WhatsApp Opt In']||m['WhatsApp Opt-In']||m['WhatsApp Consent'];
  if(!consentCol)return []; // Fail closed: no proven marketing opt-in field.
  const seen={};
  rows.forEach(function(r){
    const id=String(r[m['Customer ID']-1]||'').trim(),
          status=String(r[m['Customer Status']-1]||'').trim().toUpperCase(),
          phone=String(r[m['WhatsApp Number']-1]||'').trim();
    if(!id||!phone)return;
    // ONBOARDED_CUSTOMERS means an established active/onboarded customer, not every saved contact.
    if(['ACTIVE_CUSTOMERS','ONBOARDED_CUSTOMERS'].indexOf(target)!==-1 && ['ACTIVE','ONBOARDED'].indexOf(status)===-1)return;
    // Marketing: explicit opt-in required, including for ALL_CUSTOMERS.
    if(['YES','TRUE','OPTED_IN','OPTED IN','1','CONSENTED'].indexOf(String(r[consentCol-1]||'').trim().toUpperCase())===-1)return;
    const contact=AQBResolveWhatsAppNumber(phone);if(!contact.valid||!AQBIsWhatsAppEligiblePhone(contact.normalized)||seen[contact.normalized])return;
    seen[contact.normalized]=true;
    out.push({
      customerId:id,
      customerName:String(r[m['Customer Name']-1]||'').trim(),
      firstName:AQBGetCustomerFirstName(r,m)||String(r[m['Customer Name']-1]||'').trim().split(/\s+/)[0],
      phone:contact.normalized
    });
  });
  return out;
}

function AQBRunEventCampaign(event,maxSends){
  const eventId=String(event['Event ID']||'').trim().toUpperCase(),
        template=String(event['Template']||'').trim(),
        sender=AQBResolveEventSender(event['Sender']),
        limit=Math.max(1,Math.min(100,Number(maxSends)||40));
  if(!eventId||!template)throw new Error('Event configuration is incomplete.');
   const registered=AQBGetRegisteredWhatsAppTemplate(template,'en_US');
   if(registered.category.toUpperCase()!=='MARKETING')throw new Error('Event must use a Marketing template.');
   if(String(event['Template Variables']||'').split(',').filter(Boolean).length!==registered.bodyVariables)throw new Error('Event variable count does not match registered template.');
  if(!sender.authorized)throw new Error('Event sender is not an active authorised AQB user: '+String(event['Sender']||''));

  const audience=AQBGetEventAudience(event['Audience'],eventId),pending=audience.filter(function(c){
    return !AQBIsEventMessageSent(eventId,c.customerId);
  });

  let attempted=0,sent=0,failed=0,duplicatesBlocked=audience.length-pending.length;
  const issues=[];
  pending.slice(0,limit).forEach(function(customer){
    attempted++;
    try{
      const values=AQBBuildEventTemplateValues(event,customer),
            result=AQBSendWhatsAppTemplate(customer.phone,template,'en_US',AQBBuildWhatsAppBodyVariables(values));
      if(result&&result.sent){
        sent++;AQBLogEventWhatsApp(event,customer,result,'SENT','');
      }else{
        failed++;AQBLogEventWhatsApp(event,customer,result,'FAILED',String(result&&result.reason||'WhatsApp send was skipped.'));
        issues.push({customerId:customer.customerId,reason:String(result&&result.reason||'SEND_SKIPPED')});
      }
    }catch(e){
      failed++;AQBLogEventWhatsApp(event,customer,null,'FAILED',String(e&&e.message||e));
      issues.push({customerId:customer.customerId,reason:String(e&&e.message||e)});
    }
  });

  const remaining=Math.max(0,pending.length-attempted);
  const result={
    eventId:eventId,eventName:String(event['Event Name']||''),template:template,
    audience:audience.length,attempted:attempted,sent:sent,failed:failed,
    duplicatesBlocked:duplicatesBlocked,remaining:remaining,issues:issues
  };
  try{AQBLogAudit('AQB_EVENT_MESSAGE_CAMPAIGN','WhatsApp Event',eventId,JSON.stringify(result));}catch(ignore){}
  return result;
}

function AQBEnsureEventMessagingContinuation(){
