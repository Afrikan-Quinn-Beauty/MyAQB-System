  const requestedHH=Utilities.formatString('%02d:%02d',Math.floor(requestedTime/60),requestedTime%60);
  const available=AQBGetWhatsAppAvailableSlots(requestedDate,service);
  if(!available.some(function(x){return x.start===requestedHH;}))throw new Error('That booking time is unavailable or outside the 60-day appointment policy.');
  let customer=AQBFindCustomerByWhatsAppNumberPublic(phone),created=false;
  if(!customer){customer=AQBCreateWhatsAppCustomer(phone,name,service);created=true;}
  const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),cm=AQBBuildHeaderMap(cs),n=cs.getLastRow(),rows=cs.getRange(2,1,n-1,cs.getLastColumn()).getValues();let row=null,rowNum=0;
  for(let i=0;i<rows.length;i++)if(String(rows[i][cm['Customer ID']-1])===String(customer.customerId)){row=rows[i].slice();rowNum=i+2;break;}
  if(!row)throw new Error('Customer record could not be prepared.');
  const date=new Date(dateValue);date.setHours(0,0,0,0);const hh=Math.floor(startMinutes/60),mm=startMinutes%60;const start=new Date(date);start.setHours(hh,mm,0,0);const pricing=AQBFindServicePricing(service);const payload={service:service,appointmentDate:AQBFormatDateForClient(date),startTime:Utilities.formatDate(start,Session.getScriptTimeZone(),'HH:mm'),chargedPrice:AQBNormalizePriceText(pricing.price).amount||undefined,paymentStatus:'Pending',bookingSource:'WhatsApp Conversation',notes:'Booked through AQB conversational WhatsApp.',internalAppointment:true};
  try{const appointment=AQBCreateAppointmentForCustomer(customer.customerId,row,payload,{email:'WhatsApp Conversation',role:'System'},cm);return {customer:customer,appointment:appointment};}
