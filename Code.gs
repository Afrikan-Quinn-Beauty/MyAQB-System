/** AQB V17.0.7 Customer Profile — management-only edit and deletion safety gates. */
function AQBRequireCustomerManager(){
  const u=AQBGetCurrentUser();
  if(['Admin','Salon Manager'].indexOf(u.role)<0)throw new Error('Admin or Salon Manager access required.');
  return u;
}
function AQBFindCustomerRowForManagement_(id){
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),m=AQBBuildHeaderMap(s),key=String(id||'').trim().toUpperCase();
  if(!/^AQB\d{3,}$/.test(key)||AQBIsTestCustomer(key))throw new Error('Invalid or protected AQBID.');
  const n=s.getLastRow(),values=n>1?s.getRange(2,1,n-1,s.getLastColumn()).getValues():[];
  const matches=[];values.forEach((r,i)=>{if(String(r[m['Customer ID']-1]||'').trim().toUpperCase()===key)matches.push({row:i+2,values:r});});
  if(matches.length!==1)throw new Error('Customer identity missing or duplicated; operation blocked.');
  return {sheet:s,map:m,rowNumber:matches[0].row,values:matches[0].values,id:key};
}
function AQBUpdateCustomerProfile(payload){
  const actor=AQBRequireCustomerManager();if(!payload)throw new Error('Missing update payload.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const found=AQBFindCustomerRowForManagement_(payload.customerId),m=found.map,r=found.values;
    const first=String(payload.firstName||'').trim(),last=String(payload.lastName||'').trim();
    const name=AQBBuildCustomerFullName(first,last,'');if(!name)throw new Error('Customer name required.');
    const previousFields={};['First Name','Last Name','Customer Name','Customer Location','Notes'].forEach(function(h){if(m[h])previousFields[h]=String(r[m[h]-1]||'');});
    const oldPhone=AQBNormalizePhone(r[m['WhatsApp Number']-1]);
    const phone=AQBNormalizePhone(payload.whatsappNumber);
    if(!AQBIsValidPhone(phone))throw new Error('Valid Kenyan mobile number required.');
    if(phone!==oldPhone)throw new Error('Phone changes require a separate WhatsApp/M-Pesa identity migration and are blocked in this release.');
    r[m['First Name']-1]=first;r[m['Last Name']-1]=last;r[m['Customer Name']-1]=name;
    if(m['Customer Location'])r[m['Customer Location']-1]=String(payload.customerLocation||'').trim();
    if(m['Notes'])r[m['Notes']-1]=String(payload.notes||'').trim();
    // Update only approved fields: never rewrite computed cells or unrelated customer columns.
    const changes={'First Name':first,'Last Name':last,'Customer Name':name};
    if(m['Customer Location'])changes['Customer Location']=String(payload.customerLocation||'').trim();
    if(m['Notes'])changes['Notes']=String(payload.notes||'').trim();
    Object.keys(changes).forEach(function(header){if(!m[header])throw new Error('Required column missing: '+header);});
    Object.keys(changes).forEach(function(header){found.sheet.getRange(found.rowNumber,m[header]).setValue(changes[header]);});
    // Repair an existing formula-interpreted phone without changing identity.
    found.sheet.getRange(found.rowNumber,m['WhatsApp Number']).setNumberFormat('@').setValue(phone);
    const editedFields=Object.keys(changes).filter(function(h){return String(previousFields[h]||'')!==String(changes[h]||'');});
    AQBLogAudit('EDIT_CUSTOMER','Customer',found.id,'Profile edit by '+actor.email+'; fields: '+(editedFields.join(', ')||'no textual change')+'; phone identity unchanged.');
    return {success:true,customerId:found.id};
  }finally{lock.releaseLock();}
}
function AQBGetCustomerDeletionOptions(customerId){
  AQBRequireCustomerManager();
  const preview=AQBGetCustomerDeletionPreview(customerId);
  return {customerId:preview.customerId,dependencies:preview.dependencies,blockers:preview.blockers,
    options:[{key:'ARCHIVE',label:'Delete Customer Only',enabled:false},{key:'ERASE_AND_RELEASE',label:'Delete Customer and Data; Reuse AQBID',enabled:false}],
    message:'Both deletion modes are disabled until full WhatsApp, retie, audit, external identity and financial retention verification is implemented.'};
}
/** Archive registry stores lifecycle separately from customer business status. */
function AQBGetArchivedCustomerIds_(){
  const raw=PropertiesService.getScriptProperties().getProperty('AQB_CUSTOMER_ARCHIVED_V1707')||'{}';
  const data=JSON.parse(raw);if(!data||Array.isArray(data)||typeof data!=='object')throw new Error('Invalid archive registry.');return data;
}
function AQBIsCustomerArchived_(id){return Object.prototype.hasOwnProperty.call(AQBGetArchivedCustomerIds_(),String(id||'').trim().toUpperCase());}
function AQBArchiveCustomer(payload){
  const actor=AQBRequireCustomerManager(),id=String(payload&&payload.customerId||'').trim().toUpperCase();
  if(String(payload&&payload.confirmation||'')!=='ARCHIVE '+id)throw new Error('Type ARCHIVE '+id+' to confirm.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    AQBFindCustomerRowForManagement_(id);
    const preview=AQBGetCustomerDeletionPreview(id);
    if(preview.dependencies.some(x=>x.status==='NO_EXPLICIT_ID_COLUMN'))throw new Error('Unmapped workbook sheets: archive blocked pending dependency review.');
    const registry=AQBGetArchivedCustomerIds_();if(registry[id])throw new Error('Customer already archived.');
    registry[id]={at:new Date().toISOString(),by:actor.email};
    PropertiesService.getScriptProperties().setProperty('AQB_CUSTOMER_ARCHIVED_V1707',JSON.stringify(registry));
    // Fail closed: scheduled messaging/booking writers must check this lifecycle state before archive is production enabled.
    AQBLogAudit('ARCHIVE_CUSTOMER','Customer',id,'Archived by '+actor.email+'; history retained.');
    return {success:true,customerId:id,status:'ARCHIVED',warning:'Review existing scheduled automations for archived-customer exclusion.'};
  }finally{lock.releaseLock();}
}
function AQBRestoreCustomer(payload){
  const actor=AQBRequireCustomerManager(),id=String(payload&&payload.customerId||'').trim().toUpperCase();
  if(String(payload&&payload.confirmation||'')!=='RESTORE '+id)throw new Error('Type RESTORE '+id+' to confirm.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    AQBFindCustomerRowForManagement_(id);
    const registry=AQBGetArchivedCustomerIds_();if(!registry[id])throw new Error('Customer is not archived.');
    delete registry[id];PropertiesService.getScriptProperties().setProperty('AQB_CUSTOMER_ARCHIVED_V1707',JSON.stringify(registry));
    AQBLogAudit('RESTORE_CUSTOMER','Customer',id,'Restored by '+actor.email);
    return {success:true,customerId:id,status:'RESTORED'};
  }finally{lock.releaseLock();}
}
function AQBDeleteCustomer(payload){
  AQBRequireCustomerManager();
  const mode=String(payload&&payload.mode||'');
  if(mode==='ARCHIVE')return AQBArchiveCustomer(payload);
  if(mode!=='ERASE_AND_RELEASE')throw new Error('Invalid deletion mode.');
  AQBGetCustomerDeletionPreview(payload.customerId);
  throw new Error('Permanent erasure and AQBID reuse blocked: external references, financial retention and identity isolation are not certified. No data changed.');
}


// V17 Unified Build — read-only completion/financial reconciliation preflight.
// Does not modify appointments, payments, Cash Flow or customer data.
function AQBAuditCompletionPaymentLinks(limit){
  AQBRequireAdmin();
  const max=Math.min(500,Math.max(1,Number(limit)||100));
  const appointments=AQBGetRowsAsObjects(CONFIG.SHEETS.APPOINTMENTS);
  const payments=AQBGetRowsAsObjects(CONFIG.SHEETS.PAYMENTS);
  const cash=AQBGetRowsAsObjects(CONFIG.SHEETS.CASH_FLOW);
  const byPayment={};
  cash.forEach(function(c){
    const pid=String(c['Source Payment ID']||'').trim();
    if(pid)(byPayment[pid]||(byPayment[pid]=[])).push(c);
  });
  const byAppointment={};
  payments.forEach(function(p){
    const aid=String(p['Appointment ID']||'').trim();
    if(aid)(byAppointment[aid]||(byAppointment[aid]=[])).push(p);
  });
  const exceptions=[];
  appointments.forEach(function(a){
    if(String(a.Status||'').trim().toUpperCase()!=='COMPLETED')return;
    const aid=String(a['Appointment ID']||'').trim();
    const related=byAppointment[aid]||[];
    const paid=related.filter(function(p){return String(p['Payment Status']||'').trim().toLowerCase()==='paid';});
    const income=paid.reduce(function(sum,p){return sum+(Number(p.Amount)||0);},0);
    const charge=Number(a['Charged Price']||a['Amount Due']||0);
    const issues=[];
    if(charge>income)issues.push('OUTSTANDING_OR_UNRECORDED_PAYMENT');
    if(income>charge&&charge>0)issues.push('PAYMENTS_EXCEED_CHARGE');
    paid.forEach(function(p){
      const tx=byPayment[String(p['Payment ID']||'').trim()]||[];
      if(tx.length!==1)issues.push('CASH_FLOW_LINK_COUNT_'+tx.length);
      else if(Number(tx[0].Amount)!==Number(p.Amount))issues.push('CASH_FLOW_AMOUNT_MISMATCH');
    });
    if(issues.length)exceptions.push({appointmentId:aid,customerId:String(a['Customer ID']||''),service:String(a.Service||''),charge:charge,paid:income,issues:issues});
  });
  return {success:true,readOnly:true,completedCount:appointments.filter(function(a){return String(a.Status||'').trim().toUpperCase()==='COMPLETED';}).length,exceptionCount:exceptions.length,exceptions:exceptions.slice(0,max),truncated:exceptions.length>max};
}


/** AQB V17.0.7.4 — read-only unified journey preflight.
 * Does not create test records, contact customers, initiate STK, or modify configuration.
 * Reports schema readiness only; does not constitute a passed functional checkpoint.
 */
