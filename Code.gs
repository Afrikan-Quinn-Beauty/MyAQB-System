function AQBGetPhotoPipelineLease(action,owner,token){
  const KEY='AQB_PHOTO_PIPELINE_ACTIVE_LEASE',
        TTL_MS=10*60*1000,
        now=Date.now(),
        lock=LockService.getScriptLock();
  if(!lock.tryLock(5000)){
    return {ok:false,busy:true,owner:'SCRIPT_LOCK_BUSY'};
  }
  try{
    const props=PropertiesService.getScriptProperties();
    let active=null;
    try{active=JSON.parse(props.getProperty(KEY)||'null');}catch(e){active=null;}

    if(String(action||'').toUpperCase()==='RELEASE'){
      if(active && token && String(active.token||'')===String(token)){
        props.deleteProperty(KEY);
        return {ok:true,released:true};
      }
      return {ok:true,released:false};
    }

    if(active && Number(active.expiresAt||0)>now){
      return {
        ok:false,busy:true,
        owner:String(active.owner||'UNKNOWN'),
        acquiredAt:Number(active.acquiredAt||0),
        expiresAt:Number(active.expiresAt||0)
      };
    }

    const lease={
      owner:String(owner||'PHOTO_PIPELINE'),
      token:Utilities.getUuid(),
      acquiredAt:now,
      expiresAt:now+TTL_MS
    };
    props.setProperty(KEY,JSON.stringify(lease));
    return {ok:true,busy:false,owner:lease.owner,token:lease.token,acquiredAt:lease.acquiredAt,expiresAt:lease.expiresAt};
  }finally{
    lock.releaseLock();
  }
}

