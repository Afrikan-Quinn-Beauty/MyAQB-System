function AQBUpdateCustomerAfterCompletion(customerId,appointment,actualRetieDate){
  AQBAssertSingleCustomerMatch(customerId);
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow();
    if(n<2)throw new Error('Customer record not found.');
    // V16.21.16.8.52: inspect uniqueness while holding the customer-update lock.
    AQBAssertSingleCustomerMatch(customerId);
    const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
    for(let i=0;i<rows.length;i++){
      const r=rows[i];if(String(r[m['Customer ID']-1])!==String(customerId))continue;
      const service=String(appointment[4]||'').trim();
      const isRetie=AQBIsSisterlocksRetieService(service);
      r[m['Total Visits']-1]=Number(r[m['Total Visits']-1]||0)+1;
      // 'Complete' with a positive paid price is also a customer-level paid state.
      // This does not duplicate payment transactions or mark future appointments paid.
      if(m['Payment Status'])r[m['Payment Status']-1]=AQBGetCustomerPaymentSummary(customerId).paid>0?'Part Paid':'Pending';
      let nextAppointment=null;
      if(isRetie){
        // Manual Retie Override / special arrangements can leave the customer
        // with a non-retie service. The actual completed retie is authoritative.
        r[m['Service']-1]=service;
        const completed=actualRetieDate?AQBParseDateFromClient(actualRetieDate):new Date(); // Non-today appointments require the date at completion preflight.
        const c=AQBCalculateRetieDates(completed);
        r[m['Last Retie Date']-1]=completed;
        r[m['Next Retie Date']-1]=AQBParseDateFromClient(c.nextRetieDate);
        r[m['Reminder Date']-1]=AQBParseDateFromClient(c.reminderDate);
        r[m['Reminder Sent']-1]='No';
        r[m['Next Appointment Created']-1]='No';
        if(!r[m['Customer Status']-1]||r[m['Customer Status']-1]==='New')r[m['Customer Status']-1]='Active';
      }
      // Commit visits, paid status and retie dates before external Calendar/slot
      // operations. A failed booking must not roll back completed customer work.
      s.getRange(i+2,1,1,s.getLastColumn()).setValues([r]);
      if(isRetie){
        try{
          nextAppointment=AQBCreateAutomaticRetieAppointmentForCustomer(r,m);
          if(nextAppointment&&nextAppointment.appointmentId){
            // Appointment creation sorts Customers; re-resolve ID before updating the flag.
            const refreshed=s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues();
            const matches=refreshed.map((v,j)=>({v,j})).filter(x=>String(x.v[m['Customer ID']-1]||'').trim()===String(customerId));
            if(matches.length!==1)throw new Error('Customer identity changed after booking: '+customerId);
            s.getRange(matches[0].j+2,m['Next Appointment Created']).setValue('Yes');
          }
        }catch(e){
          AQBLogAudit('RETIE_AUTO_CREATE_FAILED','Customer',customerId,
            'Completed retie dates saved, automatic booking failed: '+String(e&&e.message||e));
        }
      }
      return nextAppointment;
    }
    throw new Error('Customer '+customerId+' was not found.');
  }finally{lock.releaseLock();}
}

