function AQBRunLiveTrendIntelligence(scope){
  // This reader intentionally does NOT read generated AQB opportunity/analysis
  // records as a second source of trend truth.
  AQBRequireAdmin();
  AQBEnsureAQBDNBFeedSheets();
  const s=AQBGetSheet(CONFIG.SHEETS.DNB_FEED), m=AQBBuildHeaderMap(s), n=s.getLastRow();
  if(n<2){
    return {success:true,provider:'AQB DNB',source:'DNB',recommendationsOnly:true,result:{trends:[]},dnbSignals:0,liveMatches:0,message:'No structured DNB feed record is available.'};
  }
  const rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  let latestDate='';
  rows.forEach(function(r){const d=String(r[m['Brief Date']-1]||'').trim();if(d>latestDate)latestDate=d;});
  const latest=rows.filter(function(r){return String(r[m['Brief Date']-1]||'').trim()===latestDate;});
  const trends=[],seen={};
  latest.sort(function(a,b){return Number(a[m['Rank']-1]||999)-Number(b[m['Rank']-1]||999);}).forEach(function(r){
    const trendName=String((m['Trend Name']?r[m['Trend Name']-1]:'')||r[m['Headline']-1]||'').trim();
    const category=String(r[m['Category']-1]||'Hair & Beauty').trim()||'Hair & Beauty';
    if(!trendName)return;
    const key=category.toLowerCase()+'|'+trendName.toLowerCase(); if(seen[key])return; seen[key]=true;
    const confidence=String(r[m['Confidence']-1]||'').trim();
    const evidence=[String(r[m['Headline']-1]||''),String(r[m['Summary']-1]||''),String(r[m['Why AQB']-1]||'')].filter(Boolean).join(' | ');
    trends.push({
      name:trendName, category:category, subcategory:'', dnbItemId:String(r[m['Item ID']-1]||'').trim(),
      description:String(r[m['Summary']-1]||r[m['Headline']-1]||'').trim(),
      status:'LIVE_TREND', confidence:confidence||'DNB', evidence:evidence,
      sourceUrls:[String(r[m['Source URL']-1]||'').trim()].filter(Boolean), matchingServices:[],
      recommendedAdminAction:String(r[m['AQB Opportunity']-1]||'REVIEW').trim()||'REVIEW',
      imageUrl:String(r[m['Image URL']-1]||'').trim(), imageSource:String(r[m['Source Name']-1]||'').trim(),
      imageSourceUrl:String(r[m['Source URL']-1]||'').trim(), photoBrief:'',
      dailyBriefId:String(r[m['DNB External ID']-1]||r[m['Feed ID']-1]||'').trim()
    });
  });
  return {
    success:true,provider:'AQB DNB',source:'DNB',recommendationsOnly:true,
    dnbBriefId:latestDate,dnbSignals:trends.length,
    liveMatches:trends.length,result:{trends:trends},
    message:'AQB Trending candidates were read directly from the latest structured DNB feed; no independent trend research was performed.'
  };
}

function AQBRefreshLiveTrending(){
  const user=AQBRequireCataloguePhotoManager(); AQBEnsureTrendSheets();
  const research=AQBRunLiveTrendIntelligence('DNB_SOURCE_ONLY');
  if(!research.success){
    return {success:false,research:research,result:null,recommendationsOnly:true,inboxAdded:0,liveMatches:0,declined:0,masterMatches:0,
      message:research.error||'DNB source data is unavailable. No independent trend research was performed and existing AQB Trend data was kept unchanged.'};
  }
  const trends=(research.result&&Array.isArray(research.result.trends))?research.result.trends:[];
  const inbox=AQBGetSheet(CONFIG.SHEETS.TREND_INBOX), im=AQBBuildHeaderMap(inbox);
  const master=AQBGetSheet(CONFIG.SHEETS.LISTS), schema=AQBGetMasterListsSchema(), masterRows=master.getLastRow()>=2?master.getRange(2,1,master.getLastRow()-1,master.getLastColumn()).getValues():[];
  const mm=AQBEnsureMasterListsTrendingColumn(), existingByKey={};
  masterRows.forEach(function(r,i){const k=String(r[mm['Category']-1]||'').trim().toLowerCase()+'|'+String(r[schema.serviceNameCol-1]||'').trim().toLowerCase();if(k)existingByKey[k]={rowNumber:i+2};});
  const existingInbox=inbox.getLastRow()>=2?inbox.getRange(2,1,inbox.getLastRow()-1,inbox.getLastColumn()).getValues():[];
  const today=new Date(); let live=0,declined=0,inboxAdded=0,masterMatches=0;
  trends.forEach(function(t){
    const name=String(t.name||'').trim(),cat=String(t.category||'').trim(),status=String(t.status||'').toUpperCase(); if(!name||!cat)return;
    const evidence=Array.isArray(t.evidence)?t.evidence.join(' | '):String(t.evidence||''), urls=Array.isArray(t.sourceUrls)?t.sourceUrls.join(' | '):String(t.sourceUrls||''), match=Array.isArray(t.matchingServices)?t.matchingServices.map(String).filter(Boolean):[];
    const sourceId=String(t.dnbItemId||'').trim();
    let found=-1, approvedSource=false;
    for(let i=0;i<existingInbox.length;i++){
      const r=existingInbox[i],type=String(r[im['Record Type']-1]||'').toUpperCase();
      if(type!=='TREND_INBOX')continue;
      const existingEvidence=String(r[im['Source Evidence']-1]||'');
      const sourceMatch=sourceId&&existingEvidence.split(' | ').indexOf('DNB_ITEM_ID:'+sourceId)>=0;
      const fallbackMatch=!sourceId&&String(r[im['Style Name']-1]||'').trim().toLowerCase()===name.toLowerCase()&&String(r[im['Category']-1]||'').trim().toLowerCase()===cat.toLowerCase();
      if(!sourceMatch&&!fallbackMatch)continue;
      if(['ARCHIVED','DELETED','REJECTED','DECLINED','APPROVED'].includes(String(r[im['Status']-1]||'').trim().toUpperCase())){approvedSource=true;break;}
      found=i;break;
    }
    if(approvedSource)return;
    // Do not recreate an approved canonical proposal for the same DNB source item.
    if(sourceId){
      const approvedSheet=AQBGetSheet(CONFIG.SHEETS.TREND_CATALOGUE),am=AQBBuildHeaderMap(approvedSheet);
      if(am['Source Evidence']&&approvedSheet.getLastRow()>1){
        const approvedRows=approvedSheet.getRange(2,1,approvedSheet.getLastRow()-1,approvedSheet.getLastColumn()).getValues();
        if(approvedRows.some(function(r){return String(r[am['Record Type']-1]||'').toUpperCase()==='TREND_CATALOGUE' && String(r[am['Source Evidence']-1]||'').split(' | ').indexOf('DNB_ITEM_ID:'+sourceId)>=0;}))return;
      }
