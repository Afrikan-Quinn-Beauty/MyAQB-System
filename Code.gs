function doGet(e) {
  // Public Meta webhook verification bypasses staff authentication.
  if(e&&e.parameter&&String(e.parameter['hub.mode']||'')==='subscribe'){
    return AQBVerifyWhatsAppWebhook(e.parameter);
  }
  const page=e&&e.parameter&&String(e.parameter.page||'').trim().toLowerCase();
  if(page==='dnb-latest') return AQBServeAQBDNBLatestFeed(e);
  if(page==='dnb-status') return AQBServeAQBDNBStatus(e);
  if(page==='meta-feed') return AQBCreateMetaCatalogueFeed();
  if(page==='tiktok-feed') return AQBServeSecureTikTokFeed(e);
  if(page==='catalogue'){
    // Public Catalogue renders without synchronization work.
    return HtmlService.createHtmlOutputFromFile('Catalogue')
      .addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover')
      .setTitle('Catalogue — Afrikan Quinn Beauty Centre')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }
  if(page==='booking'){
    return HtmlService.createHtmlOutputFromFile('Booking')
      .addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover')
      .setTitle('Book an Appointment — Afrikan Quinn Beauty Centre')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }
  return HtmlService.createHtmlOutputFromFile('Index')
    .addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover')
    .setTitle(CONFIG.APP_NAME)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

