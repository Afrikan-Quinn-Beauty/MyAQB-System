  }
  const items=values.slice(1).filter(function(r){
    const active=r[h['Active']];
    const display=h['Display in Catalogue']===undefined?'yes':String(r[h['Display in Catalogue']]||'yes').trim().toLowerCase();
    return !(active===false||String(active).toLowerCase()==='false'||String(active)==='0') && display!=='no' && display!=='false' && AQBIsPublicCatalogueRowQualified(r,Object.keys(h).reduce(function(o,k){o[k]=h[k]+1;return o;},{}));
  }).map(function(r){
    const service=String(r[h['Service Name']]||'').trim();
    const category=String(r[h['Category']]||'').trim();
    const catalogueId=h['Catalogue ID']!==undefined?String(r[h['Catalogue ID']]||'').trim().toUpperCase():'';
    const studioCurrent=h['Image Source']!==undefined && String(r[h['Image Source']]||'').trim().toUpperCase()==='AQB STUDIO' && h['Photo Qualification Status']!==undefined && String(r[h['Photo Qualification Status']]||'').trim().toUpperCase()==='QUALIFIED';
    const localAsset=!studioCurrent&&!!AQB_CATALOGUE_LOCAL_ASSETS[catalogueId];
    const desc=h['Description']!==undefined?String(r[h['Description']]||'').trim():'';
    const imageUrl=h['Image URL']!==undefined?String(r[h['Image URL']]||'').trim():'';
    const ownPhoto=h['Own Photo']!==undefined?String(r[h['Own Photo']]||'').trim():'';
    const imageStatus=h['Image Status']!==undefined?String(r[h['Image Status']]||'').trim():'';
    const imageAllowed=studioCurrent || (imageStatus!=='Duplicate Image - Needs Unique Photo' && imageStatus!=='Duplicate Image - Replacement Required' && imageStatus!=='Needs Relevant Unique Photo' && imageStatus!=='No Relevant Photo Found');
    // Customer-facing actual price: Master Lists is authoritative. Market benchmarks and recommendations are informational until Admin applies them.
    const benchmark=h['Nairobi Benchmark']!==undefined?String(r[h['Nairobi Benchmark']]||'').trim():'';
    const recommended=h['Recommended Catalogue Price']!==undefined?String(r[h['Recommended Catalogue Price']]||'').trim():'';
    const masterPrice=livePrices[category.toLowerCase()+'|'+service.toLowerCase()]||AQBNormalizePriceText(String(r[h['Price']]||'')).display||String(r[h['Price']]||'').trim();
    const price=masterPrice||recommended||benchmark||'Price on consultation';
    const booking=(webAppUrl?webAppUrl:'')+'?page=booking&service='+encodeURIComponent(service)+'&catalogue_id='+encodeURIComponent(catalogueId);
    const sourceUrl=h['Image Source URL']!==undefined?String(r[h['Image Source URL']]||'').trim():'';
    const source=h['Image Source']!==undefined?String(r[h['Image Source']]||'').trim():'';
    const review=h['Review Notes']!==undefined?String(r[h['Review Notes']]||'').trim():'';
    return {
      catalogueId:h['Catalogue ID']!==undefined?String(r[h['Catalogue ID']]||'').trim():'',
      serviceTier:h['Service Tier']!==undefined?String(r[h['Service Tier']]||'').trim():'',
      category:category,
      customerCategory:h['Customer Category']!==undefined?String(r[h['Customer Category']]||'').trim():'',
      name:service,description:desc,
      image:(localAsset||imageAllowed)?(localAsset?('AQB_LOCAL_ASSET:'+catalogueId):(studioCurrent?imageUrl:(ownPhoto||imageUrl))):'',
      imageStatus:imageStatus,
      imageSource:source,imageSourceUrl:sourceUrl,imageCredit:review,
      price:price,
      booking:booking,
      whatsapp:'https://wa.me/'+AQBGetPublicWhatsAppNumber()+'?text='+encodeURIComponent('Hello Afrikan Quinn Beauty Centre 💛\nI would like to enquire about the price for '+service+'. Please share the current starting price and any information I should know.'),
      group:(h['Customer Category']!==undefined?String(r[h['Customer Category']]||'').trim():category),
      isTrend:String(h['Catalogue Type']!==undefined?r[h['Catalogue Type']]||'':'').trim().toLowerCase()==='trend' || String(h['Catalogue Section']!==undefined?r[h['Catalogue Section']]||'':'').trim().toLowerCase()==='trending styles',
      catalogueType:h['Catalogue Type']!==undefined?String(r[h['Catalogue Type']]||'').trim():'',
      trendStatus:h['Trend Status']!==undefined?String(r[h['Trend Status']]||'').trim():'',
      featured:h['Featured']!==undefined?String(r[h['Featured']]||'').trim():'NO',
      trendStart:h['Trend Start']!==undefined?r[h['Trend Start']]:'',
      trendEnd:h['Trend End']!==undefined?r[h['Trend End']]:'',
      trendSource:h['Trend Source']!==undefined?String(r[h['Trend Source']]||'').trim():'',
      collectionIds:h['Collection IDs']!==undefined?String(r[h['Collection IDs']]||'').trim():''
    };
  // Every active public service must have a valid photo before publication.
  }).filter(function(x){return !!x.name && !!x.image;});

  const canonicalTrending=AQBGetCurrentApprovedTrendingItems(items);
  return {items:items,logo:options.fast?'':AQBGetPublicLogoDataInternal(),appearance:AQBGetPublicAppearance(),catalogueUrl:webAppUrl+'?page=catalogue',canonicalTrending:canonicalTrending,warning:warning};
}

function AQBGetPublicServiceCatalog(includeCatalogueIds){
  AQBValidateMasterListsSchema();
  const s=AQBGetSheet(CONFIG.SHEETS.LISTS),n=s.getLastRow(); if(n<2)return [];
  const m=AQBGetMasterListsSchema(),map=m.map,valueCol=m.serviceNameCol,catCol=map['Category'],activeCol=map['Active'],orderCol=map['Sort Order'],itemCol=m.itemCol;
  const rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  // The public Catalogue only needs service/pricing data. Loading the identity map
  // here adds a second full Catalogue-sheet read and can make the public page slow.
  // Booking/Meta callers explicitly request IDs with includeCatalogueIds=true.
  const catalogueMap=includeCatalogueIds?AQBGetCatalogueIdentityMap():{};
  return rows.filter(function(r){
    const item=m.legacyNoItem?'Service':String(r[itemCol-1]||'').trim();
    const active=r[activeCol-1];
    return item==='Service' && r[valueCol-1] && !(active===false || String(active).toLowerCase()==='false' || String(active)==='0');
  }).map(function(r){
    const service=String(r[valueCol-1]||'').trim();
    const category=String(catCol?r[catCol-1]:'').trim();
    const key=AQBNormalizeMetaText(category)+'|'+AQBNormalizeMetaText(service);
    const identity=catalogueMap[key]||catalogueMap[AQBNormalizeMetaText(service)]||null;
    return {
      service:service,
      price:String(r[map['Price']-1]||'').trim(),
      group:category,
      category:category,
      item:'Service',
      sortOrder:Number(r[orderCol-1]||0)||0,
      catalogueId:includeCatalogueIds&&identity?String(identity.catalogueId||'').trim():''
    };
  })
  .filter(function(x,i,a){return a.findIndex(function(y){return y.service.toLowerCase()===x.service.toLowerCase();})===i;})
  .sort(function(a,b){return a.category.localeCompare(b.category,undefined,{sensitivity:'base'})||a.sortOrder-b.sortOrder||a.service.localeCompare(b.service,undefined,{sensitivity:'base'});});
}

