function AQBBuildAvailableSlotWindows(dateValue,serviceValue,excludeId){
  const date=AQBParseDateFromClient(dateValue);
  if(!(date instanceof Date)||isNaN(date.getTime()))throw new Error('Choose a valid appointment date.');
  date.setHours(0,0,0,0);
  const today=new Date(),startOfToday=new Date(today);startOfToday.setHours(0,0,0,0);
  const maxDate=new Date(startOfToday);maxDate.setDate(maxDate.getDate()+60);
  if(date<startOfToday||date>maxDate)throw new Error('Choose a date within the next 60 days.');
  if(date.getDay()===0)return {date:date,durationMinutes:0,sundaySpecial:true,slots:[]};
  const service=String(serviceValue||'').trim();
  if(!service)throw new Error('Choose a service first.');
  const durationMinutes=Number(AQBGetAppointmentDurationMinutes(service));
  if(!Number.isFinite(durationMinutes)||durationMinutes<=0)throw new Error('Service duration is unavailable.');
  const slots=[];
  for(let minutes=7*60;minutes+durationMinutes<=19*60;minutes+=15){
    const start=new Date(date);start.setHours(Math.floor(minutes/60),minutes%60,0,0);
    const end=new Date(start.getTime()+durationMinutes*60000);
    const future=start>today;
    const taken=future?AQBIsAppointmentSlotTaken(date,start,end,excludeId||null):false;
    slots.push({start:start,end:end,available:future&&!taken,reason:!future?'Past time':taken?'Booked':''});
  }
  return {date:date,durationMinutes:durationMinutes,sundaySpecial:false,slots:slots};
}

function AQBGetPublicAvailableSlots(dateValue,serviceValue){
  const result=AQBBuildAvailableSlotWindows(dateValue,serviceValue,null);
  return result.slots.map(function(x){return {
    value:Utilities.formatDate(x.start,Session.getScriptTimeZone(),'HH:mm'),
    label:Utilities.formatDate(x.start,Session.getScriptTimeZone(),'h:mm a')+' – '+Utilities.formatDate(x.end,Session.getScriptTimeZone(),'h:mm a'),
    endTime:Utilities.formatDate(x.end,Session.getScriptTimeZone(),'HH:mm'),
    available:x.available,status:x.available?'AVAILABLE':'BOOKED'
  };});
}

function AQBGetPublicBookingDurationMinutes(service){
  return AQBGetAppointmentDurationMinutes(service);
}

function AQBGetNextPublicBookingSlot(serviceValue){
  const service=String(serviceValue||'').trim();
  if(!service)throw new Error('Please choose a service.');
  const today=new Date();today.setHours(0,0,0,0);
  for(let offset=0;offset<=60;offset++){
    const d=new Date(today);d.setDate(d.getDate()+offset);
    const rows=AQBGetPublicAvailableSlots(AQBFormatDateForClient(d),service).filter(function(x){return x&&x.available;});
    if(rows.length)return {date:AQBFormatDateForClient(d),slot:rows[0],offsetDays:offset};
  }
  return {date:'',slot:null,offsetDays:null};
}

function AQBSubmitPublicBooking(payload){
  if(!payload)throw new Error('No booking information was received.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const suppliedFirst=String(payload.firstName||'').trim();
    const suppliedLast=String(payload.lastName||'').trim();
    const legacyName=String(payload.customerName||'').trim();
    const nameParts=AQBSplitCustomerName(legacyName);
    const firstName=suppliedFirst||nameParts.firstName;
    const lastName=suppliedLast||nameParts.lastName;
    const name=AQBBuildCustomerFullName(firstName,lastName,legacyName);
    const phone=AQBNormalizePhone(payload.phone||payload.whatsappNumber||'');
    const service=String(payload.service||'').trim();
    const location=String(payload.location||payload.customerLocation||'').trim();
    const notes=String(payload.notes||'').trim();
    const sendWhatsAppBooking=payload.sendWhatsAppBooking===true;
    const date=AQBParseDateFromClient(payload.appointmentDate);
    const startTime=String(payload.startTime||'').trim();
    if(!firstName)throw new Error('Please enter your first name.');
    if(!AQBIsValidPhone(phone))throw new Error('Please enter a valid Kenyan mobile number.');
    if(!service)throw new Error('Please select a service.');
    if(!date||!startTime)throw new Error('Please choose an appointment date and time.');

    const catalog=AQBGetPublicServiceCatalog();
    const serviceInfo=catalog.find(function(x){return x.service===service;});
    if(!serviceInfo)throw new Error('The selected service is not currently available for online booking.');
    const duration=AQBGetPublicBookingDurationMinutes(service);
    const st=AQBParseTimeFromClient(startTime);
    AQBValidateInternalAppointmentStartTime(startTime);
    const start=AQBCombineDateAndTime(date,st);
    const end=new Date(start.getTime()+duration*60000);
    AQBValidateCustomerBookingHours(date,start,end,false);
    const today=new Date();today.setHours(0,0,0,0);
    const maximum=new Date(today);maximum.setDate(maximum.getDate()+60);
    if(date<today||date>maximum)throw new Error('Please choose a date within the next 60 days.');
    if(start<=new Date())throw new Error('Please choose a future appointment time.');
    const maxEnd=new Date(date);maxEnd.setHours(19,0,0,0);
    if(end>maxEnd)throw new Error('That service would run beyond our online booking hours. Please choose an earlier time.');
    if(AQBIsAppointmentSlotTaken(date,start,end,null))throw new Error('That time has just been booked. Please choose another available time.');

    const startingPrice=AQBGetPublicStartingPriceNumber(serviceInfo.price);
    if(!(startingPrice>0))throw new Error('This service does not have an online starting price configured yet. Please contact Afrikan Quinn Beauty Centre to book it.');

    const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=cs.getLastRow(),m=AQBBuildHeaderMap(cs),lastCol=cs.getLastColumn();
    let rowNum=null,row=null;
    if(n>=2){
      const rows=cs.getRange(2,1,n-1,lastCol).getValues();
      for(let i=0;i<rows.length;i++){
        if(AQBNormalizePhone(rows[i][m['WhatsApp Number']-1])===phone){rowNum=i+2;row=rows[i];break;}
      }
    }

    let customerId,appointment,whatsapp=null;
    const appointmentPayload={
      appointmentDate:AQBFormatDateForClient(date),startTime:startTime,
      endTime:Utilities.formatDate(end,Session.getScriptTimeZone(),'HH:mm'),
      service:service,serviceGroup:serviceInfo.group,notes:notes,
      chargedPrice:startingPrice,paymentStatus:'Pending',bookingSource:'Customer Booking'
    };

    if(rowNum){
      customerId=String(row[m['Customer ID']-1]||'');
      row[m['Customer Name']-1]=name;
      if(m['First Name'])row[m['First Name']-1]=firstName;
      if(m['Last Name'])row[m['Last Name']-1]=lastName;
      row[m['Customer Location']-1]=location;
      row[m['Service']-1]=service;
      row[m['Notes']-1]=notes;
      if(!String(row[m['Customer Status']-1]||'').trim())row[m['Customer Status']-1]='Active';
      appointment=AQBCreateAppointmentForCustomer(customerId,row,appointmentPayload,null,m);
      row[m['Payment Status']-1]='Pending';
      cs.getRange(rowNum,1,1,lastCol).setValues([row]);
      s.getRange(rowNum,m['WhatsApp Number']).setNumberFormat('@').setValue(phone);
      try{whatsapp=AQBSendBookingWhatsAppForAppointment(appointment,firstName);}
      catch(e){AQBLogAudit('WHATSAPP_ERROR','Appointment',appointment.appointmentId,e.message);whatsapp={sent:false,error:e.message};}
      return Object.assign({success:true,existing:true,price:serviceInfo.price,catalogueId:serviceInfo.catalogueId||'',whatsappSent:!!(whatsapp&&whatsapp.sent),whatsapp},appointment);
    }

    customerId=AQBGenerateCustomerID();
    const newRow=Array(lastCol).fill('');
    newRow[m['Customer ID']-1]=customerId;
    newRow[m['Customer Name']-1]=name;
    newRow[m['WhatsApp Number']-1]=phone;
    newRow[m['Customer Location']-1]=location;
    newRow[m['Service']-1]=service;
    if(m['First Name'])newRow[m['First Name']-1]=firstName;
    if(m['Last Name'])newRow[m['Last Name']-1]=lastName;
    newRow[m['Reminder Sent']-1]='';
    newRow[m['Payment Status']-1]='Pending';
    newRow[m['Total Visits']-1]=0;
    newRow[m['Notes']-1]=notes;
    newRow[m['Customer Status']-1]='New';
    newRow[m['Next Appointment Created']-1]='No';

    // Transaction order: appointment must succeed before the new customer is
    // permanently written. If the customer write fails, roll the appointment back.
    appointment=AQBCreateAppointmentForCustomer(customerId,newRow,appointmentPayload,null,m);
    try{
      AQBAppendUniqueCustomerRow(cs,newRow);
    }catch(e){
      if(appointment)AQBRollbackCreatedAppointment(appointment.appointmentId,appointment.calendarEventId);
      throw new Error('Customer could not be saved after appointment creation. The appointment was rolled back. '+String(e&&e.message||e));
    }
    newRow[m['Payment Status']-1]='Pending';
    cs.getRange(cs.getLastRow(),1,1,lastCol).setValues([newRow]);

    // Public bookings use the existing booking-confirmation message for all services.
    try{whatsapp=AQBSendBookingWhatsAppForAppointment(appointment,firstName);}
    catch(e){AQBLogAudit('WHATSAPP_ERROR','Appointment',appointment.appointmentId,e.message);whatsapp={sent:false,error:e.message};}
    return Object.assign({success:true,existing:false,price:serviceInfo.price,catalogueId:serviceInfo.catalogueId||'',whatsappSent:!!(whatsapp&&whatsapp.sent),whatsapp},appointment);
  }finally{lock.releaseLock();}
}

