    const rank={P1_SIGNATURE:0,P2_SUPPORTING:1,P3_EXTENDED:2,REVIEW:3};return rank[a.signaturePriority]-rank[b.signaturePriority]||a.displayName.localeCompare(b.displayName);
  });
  const staging=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
  const photo={catalogueImages:rows.filter(r=>r.ownPhoto||r.imageUrl).length,catalogueWithoutImages:rows.filter(r=>!r.ownPhoto&&!r.imageUrl).length,storedQualifiedValues:rows.filter(r=>/^(qualified|approved|passed|pass)$/i.test(r.qualification)).length,stagingExists:!!staging,stagingRowCount:staging?Math.max(0,staging.getLastRow()-1):null,stagingHeaders:[],stagingQualificationColumns:[],stagingQualificationCounts:{},familyCoverApprovedCount:null,variantVisuallyApprovedCount:null};
