function AQBReconcileCanonicalPhotoFamily(r){
  const canonical=["Colour","Weaving & Wigs","Mizani Professional Care","Natural Hair","Twists","Braids","Sisterlocks & Microlocs","Treatments & Hair Spa","Home, Office & Mobile","Kids","Locs","Bridal & Special Occasions","Quick Services"];
  const exact={}; canonical.forEach(function(x){exact[x.toLowerCase()]=x;});
  const raw=String(r.category||"").trim(), k=raw.toLowerCase();
  if(exact[k]) return {family:exact[k],status:"EXACT",reason:"Catalogue Category already uses canonical 13-family contract"};

  // Phase 2.2f: service identity outranks broad legacy category aliases.
  // Use Service Name + explicit variants first. Description/Photo Brief only confirm/fallback.
  const primary=(String(r.serviceName||"")+" "+String(r.variants||"")).toLowerCase();
  const support=(String(r.description||"")+" "+String(r.photoBrief||"")).toLowerCase();
  let family="";

  // Strong audience/delivery identities.
  if(/\b(child|children|kid|kids|school lines|student school|teen)\b/.test(primary)) family="Kids";
  else if(/\b(bridal|bride|wedding|special occasion|photoshoot)\b/.test(primary)) family="Bridal & Special Occasions";
  else if(/\b(mobile|office|corporate group|group hair day|home service|on-site|onsite|service area|nairobi)\b/.test(primary)) family="Home, Office & Mobile";
  // Specialist/proprietary identities before generic loc/treatment words.
  else if(/\b(sisterlocks|sister locks|microlocs|micro locs|micro-locs)\b/.test(primary)) family="Sisterlocks & Microlocs";
  else if(/\b(mizani)\b/.test(primary)) family="Mizani Professional Care";
  // Technique/service identities.
  else if(/\b(human hair boho braids|human hair braiding)\b/.test(primary)) family="Braids";
  else if(/\bhuman hair twists\b/.test(primary)) family="Twists";
  else if(/\b(wig|weave|sew-in|sew in|clip-in|clip in|microlink|micro weaving|hair extensions)\b/.test(primary)) family="Weaving & Wigs";
  else if(/\b(loc|locs|dreadlock|dreadlocks|starter loc|instant dread|faux loc)\b/.test(primary)) family="Locs";
  else if(/\b(twist|twists|passion twist|senegalese|marley|spring twist|havana)\b/.test(primary)) family="Twists";
  else if(/\b(braid|braids|braiding|cornrow|cornrows|knotless|feed-in|feed in|fulani|stitch lines|swahili lines|lemonade)\b/.test(primary)) family="Braids";
  else if(/\b(colour|color|colouring|coloring|highlight|highlights|dye)\b/.test(primary)) family="Colour";
  else if(/\b(spa|treatment|therapy|steam|scalp|conditioning|detox|massage|protein|moisture|hot oil)\b/.test(primary)) family="Treatments & Hair Spa";
  else if(/\b(quick|express|wash only|shampoo only|trim only)\b/.test(primary)) family="Quick Services";
  else if(/\b(natural hair|afro|silk press|wash & go|wash and go|rod set|roller set|straw set|finger coil|bantu knot|pixie|twist-out|twist out|braid-out|braid out|flat-iron|flat iron|detangling)\b/.test(primary)) family="Natural Hair";

  if(family) return {family:family,status:"SEMANTIC_REASSIGNMENT",reason:"Service identity overrides broad/noncanonical legacy Category"};

  // Narrow aliases are safe only after identity has had first refusal.
  const aliases={
    "braiding services":"Braids","braids & protective styles":"Braids","braiding & protective styles":"Braids",
    "children & teens":"Kids","children and teens":"Kids","kids & teens":"Kids",
    "mizani professional services":"Mizani Professional Care","mizani services":"Mizani Professional Care","mizani signature packages":"Mizani Professional Care",
    "natural hair styling":"Natural Hair","natural hair services":"Natural Hair","signature packages":"Natural Hair",
    "natural hair treatments":"Treatments & Hair Spa","wellness & hair spa":"Treatments & Hair Spa",
    "loc services":"Locs","starter locs & loc care":"Locs","locks & maintenance":"Locs","locks & maintenance (dreadlocks)":"Locs",
    "sisterlocks services":"Sisterlocks & Microlocs",
    "weaving & extensions":"Weaving & Wigs","weaves & wig services":"Weaving & Wigs","weaves and wig services":"Weaving & Wigs","weaving and wigs":"Weaving & Wigs",
    "hair treatments & scalp care":"Treatments & Hair Spa","hair treatments and scalp care":"Treatments & Hair Spa",
    "hair coloring & chemical treatments":"Colour","hair colouring & chemical treatments":"Colour",
    "bridal & special occasion":"Bridal & Special Occasions","bridal and special occasions":"Bridal & Special Occasions",
    "mobile beauty services":"Home, Office & Mobile","mobile services":"Home, Office & Mobile","home & mobile":"Home, Office & Mobile","corporate & group services":"Home, Office & Mobile",
    "quick service":"Quick Services"
  };
  if(aliases[k]) return {family:aliases[k],status:"LEGACY_ALIAS",reason:"Narrow legacy Category alias used after service-identity evaluation"};

  // Supporting text is a final read-only fallback, never allowed to override a resolved identity.
  if(/\b(mizani)\b/.test(support)) family="Mizani Professional Care";
  else if(/\b(sisterlocks|microlocs)\b/.test(support)) family="Sisterlocks & Microlocs";
  else if(/\b(bridal|wedding)\b/.test(support)) family="Bridal & Special Occasions";
  else if(/\b(mobile|office|on-site|onsite)\b/.test(support)) family="Home, Office & Mobile";
  else if(/\b(colour|color|highlight|dye)\b/.test(support)) family="Colour";
  else if(/\b(loc|locs|dreadlock)\b/.test(support)) family="Locs";
  else if(/\b(twist|twists)\b/.test(support)) family="Twists";
  else if(/\b(braid|braids|cornrow|cornrows|knotless)\b/.test(support)) family="Braids";
  else if(/\b(wig|weave|extension)\b/.test(support)) family="Weaving & Wigs";
  else if(/\b(spa|treatment|therapy|steam|scalp|conditioning|protein|moisture)\b/.test(support)) family="Treatments & Hair Spa";
  else if(/\b(natural hair|afro|silk press)\b/.test(support)) family="Natural Hair";
  if(!family) return {family:"UNASSIGNED",status:"UNMAPPED",reason:"No safe canonical family could be inferred from completed Catalogue identity"};
  return {family:family,status:"SEMANTIC_REASSIGNMENT",reason:"Canonical family inferred from supporting Catalogue identity; read-only proposal"};
