    const key=AQBGetCanonicalServiceKey(category,name);
    if(!keys[key])result.missingMasterMatches.push({catalogueId:id,serviceName:name,category:category});
    const mobile=AQBNormalizePriceText(r[cm.Price-1]);
    if(AQBNormalizeBool(r[cm.Active-1])&&!(mobile.amount>0))result.invalidMobilePrice.push(id);
    if(cm['Salon Price']&&AQBNormalizeBool(r[cm.Active-1])){
