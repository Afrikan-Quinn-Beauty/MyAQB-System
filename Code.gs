function AQBGetMobileAppointmentDetails(appointmentId){
  AQBRequireUser();
  const id=String(appointmentId||'').trim();
  if(!id)throw new Error('Appointment ID is required.');
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
  if(n<2)throw new Error('Appointment not found.');
  const rows=s.getRange(2,1,n-1,17).getValues();
  for(const r of rows){
    if(String(r[0]||'').trim()===id){
      const a=AQBBuildAppointmentObject(r);
      return {appointment:a,customer:AQBGetCustomerDetails(a.customerId).customer};
    }
  }
  throw new Error('Appointment not found.');
}

function AQBGetMobileAppointments(scope){
  const value=String(scope||'today').toLowerCase();
  if(value==='upcoming')return AQBGetUpcomingAppointments().slice(0,30);
  if(value==='overdue'){
    AQBRequireUser();
    const sheet=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),count=sheet.getLastRow();
    if(count<2)return [];
    const todayKey=AQBFormatDateKey(new Date());
    if(scheduledDate!==todayKey&&!actualRetieDate)throw new Error('Enter the actual service date when completing an early or overdue appointment.');
    const rows=sheet.getRange(2,1,count-1,17).getValues()
      .filter(function(r){
        const status=String(r[8]||'').trim().toUpperCase();
        return r[5] instanceof Date && AQBFormatDateKey(r[5])<todayKey &&
          ['SCHEDULED','CONFIRMED','PENDING','OVERDUE','MISSED'].indexOf(status)>=0;
      }).map(AQBBuildAppointmentObject);
    rows.sort(function(a,b){return (a.appointmentDate+a.startTime).localeCompare(b.appointmentDate+b.startTime);});
    return rows.slice(0,50);
  }
  return AQBGetTodaysAppointments();
}

function AQBGenerateAppointmentID(){return CONFIG.APPOINTMENT_PREFIX+String(AQBGetNextNumber(CONFIG.SHEETS.APPOINTMENTS,1,/^AQBA(\d+)$/)).padStart(3,'0');}

function AQBGetCustomerAppointmentSummary(customerId){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
  if(n<2)return {appointmentStatus:'',confirmation:'',calendarEventId:''};
  const rows=s.getRange(2,1,n-1,17).getValues(),today=new Date();
  today.setHours(0,0,0,0);
  let best=null;
  for(const r of rows){
    if(String(r[1]||'')!==String(customerId||''))continue;
    const d=r[5] instanceof Date?new Date(r[5]):new Date(r[5]);
    if(isNaN(d.getTime()))continue;
    const status=String(r[8]||'').trim().toUpperCase();
    const future=d>=today && !['CANCELLED','NO SHOW','COMPLETED'].includes(status);
    const score=(future?1000000000000:0)+d.getTime();
    if(!best || score>best.score)best={score,r};
  }
  if(!best)return {appointmentStatus:'',confirmation:'',calendarEventId:''};
  const r=best.r;
  return {appointmentStatus:String(r[8]||''),confirmation:String(r[9]||''),calendarEventId:String(r[11]||'')};
}

function AQBInitializeNextAppointmentCreated(){
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS), n=s.getLastRow();
  if(n<2)return;
  const lastCol=s.getLastColumn();
  const map=AQBBuildHeaderMap(s);
  const col=map['Next Appointment Created'];
  if(!col)return;
  const values=s.getRange(2,col,n-1,1).getValues();
  let changed=false;
  values.forEach(function(r){
    if(String(r[0]||'').trim()===''){r[0]='No';changed=true;}
  });
  if(changed)s.getRange(2,col,n-1,1).setValues(values);
}

function AQBGetNextAppointmentsMap(){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow(),out={}; if(n<2)return out;
  const rows=s.getRange(2,1,n-1,17).getValues(),now=new Date();
  rows.forEach(function(r){
    const customerId=String(r[1]||'').trim(),status=String(r[8]||'').trim().toUpperCase(); if(!customerId||['CANCELLED','NO SHOW','COMPLETED'].includes(status))return;
    const d=r[5] instanceof Date?new Date(r[5]):new Date(r[5]); if(isNaN(d.getTime()))return;
    const t=r[6] instanceof Date?new Date(r[6]):new Date(r[6]); if(!isNaN(t.getTime()))d.setHours(t.getHours(),t.getMinutes(),0,0);
    if(d<now)return;
    if(!out[customerId]||d<out[customerId].when)out[customerId]={when:d,label:AQBFormatDateForClient(d)+' • '+AQBFormatTimeForClient(d),appointmentId:String(r[0]||''),service:String(r[4]||''),status:status};
  }); return out;
}

