  });
  const ap=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),am=AQBBuildHeaderMap(ap);
  const appointments=ap.getLastRow()>1?ap.getRange(2,1,ap.getLastRow()-1,ap.getLastColumn()).getValues():[];
