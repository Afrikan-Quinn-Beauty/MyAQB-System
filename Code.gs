function AQBGetChannelDescription(value){
  let s=String(value===null||value===undefined?'':value).replace(/\s+/g,' ').trim();
  if(!s)return '';
  if(s.length<=180)return s;
  s=s.slice(0,181);
  const cut=s.lastIndexOf(' ');
  if(cut>90)s=s.slice(0,cut);
  return s.replace(/[.,;:!?\-–—\s]+$/,'').trim()+'.';
}

function AQBBuildChannelEligibleRows(channel){
  const s=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),v=s.getDataRange().getValues();
  const headers=['Catalogue ID','Service Name','Description','Image','Link','Price','Category','Video URL','Trend Status','Featured'];
  if(v.length<2)return {headers:headers,rows:[],counts:{active:0,eligible:0,blocked:0,duplicates:0}};
  const h={};v[0].forEach(function(x,i){h[String(x||'').trim()]=i;});
  ['Catalogue ID','Service Name','Active','Price'].forEach(function(k){if(h[k]===undefined)throw new Error('Catalogue sheet is missing column: '+k);});
  const master=AQBBuildCanonicalMasterServiceRows();
  const expectedKeys={}; master.rows.forEach(function(x){if(x.active)expectedKeys[AQBGetCanonicalServiceKey(x.category,x.service)]=true;});
  const rows=[],seen={};let active=0,blocked=0,duplicates=0;
  v.slice(1).forEach(function(r){
    if(!AQBNormalizeBool(r[h['Active']]))return;
    active++;
    const id=String(r[h['Catalogue ID']]||'').trim(),title=String(r[h['Service Name']]||'').trim(),categoryForKey=h['Category']===undefined?'':String(r[h['Category']]||'').trim();
    if(!expectedKeys[AQBGetCanonicalServiceKey(categoryForKey,title)])return;
    if(!id||!title){blocked++;return;}
    if(seen[id]){duplicates++;return;}
    seen[id]=true;
    const oneBased={};Object.keys(h).forEach(function(k){oneBased[k]=h[k]+1;});
    if(channel && !AQBHasCatalogueChannel(r,oneBased,String(channel).toUpperCase()))return;
    const imageOwn=h['Own Photo']===undefined?'':String(r[h['Own Photo']]||'').trim();
    const imageOnline=h['Image URL']===undefined?'':String(r[h['Image URL']]||'').trim();
    const image=imageOwn||imageOnline;
    const priceRaw=String(r[h['Price']]||'').replace(/,/g,'');
    const priceMatch=priceRaw.match(/(\d+(?:\.\d+)?)/),price=priceMatch?Number(priceMatch[1]):0;
    if(!image||!AQBIsCataloguePublicImageQualified(r,oneBased)||!(price>0)){blocked++;return;}
    const category=h['Category']===undefined?'Beauty Services':String(r[h['Category']]||'Beauty Services').trim();
    const desc=h['Description']===undefined?'':String(r[h['Description']]||'').trim();
    const trend=h['Trend Status']===undefined?'':String(r[h['Trend Status']]||'').trim().toUpperCase();
    const featured=h['Featured']===undefined?'':String(r[h['Featured']]||'').trim().toUpperCase();
    const link=String(ScriptApp.getService().getUrl()||'').replace(/\/$/,'')+'?page=booking&service='+encodeURIComponent(title);
    const video=h['Video URL']===undefined?'':String(r[h['Video URL']]||'').trim();
    rows.push({id:id,title:title,description:AQBGetChannelDescription(desc),image:image,link:link,price:price,category:category,video:video,trend:trend,featured:featured});
  });
  return {headers:headers,rows:rows,counts:{active:active,eligible:rows.length,blocked:blocked,duplicates:duplicates}};
}

