}

function AQBSyncPhotoStaging(){
  // V16.21.16.1: source-owned columns only; no legacy full-sheet rewrite.
  return AQBUpsertPhotoStagingSourceRows();
  const VERSION=AQB_PHOTO_PIPELINE_VERSION_;
  const ss=AQBGetSpreadsheet(),catalogue=AQBGetSheet('Catalogue');
  let stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);

  if(!stage){
    const rebuilt=AQBRebuildPhotoStaging();
    stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
    if(!stage)return {version:VERSION,function:'AQBSyncPhotoStaging',createdStaging:true,rebuilt:rebuilt,success:false};
  }

  const locked=AQBGetPhotoStagingCatalogueFields();
  const derived=['Photo Track','Photo Subtype','Search Strategy','Pexels Required','Search Query'];
  let sh=AQBBuildHeaderMap(stage);

  const required=locked.concat(
    derived,
    [
      'Candidate Image URL','Candidate Source URL','Candidate Source',
      'Qualification Status','Review Reason','Search Status','Gate Outcome',
      'Created At','Updated At'
    ],
    AQB_PHOTO_PIPELINE_META_FIELDS_
  );

  const missing=required.filter(function(h){return !sh[h];});
  let schemaMigration=null;
  if(missing.length){
    schemaMigration=AQBMigratePhotoStagingSchema(stage,required);
    sh=AQBBuildHeaderMap(stage);
  }

  AQBEnsurePhotoPipelineColumns();
  sh=AQBBuildHeaderMap(stage);

  const ch=AQBBuildHeaderMap(catalogue),cv=catalogue.getDataRange().getValues();
  if(!ch['Catalogue ID'])throw new Error('Catalogue missing Catalogue ID.');

  const byId={},catalogueOrder=[];
  function catVal(row,name){return ch[name]?row[ch[name]-1]:'';}
  function textValue(v){return String(v==null?'':v).trim();}

  for(let i=1;i<cv.length;i++){
    const id=String(catVal(cv[i],'Catalogue ID')||'').trim().toUpperCase();
    if(!/^AQBCAT\d{3}$/.test(id))continue;
    const rec={};
    locked.forEach(function(h){rec[h]=catVal(cv[i],h);});
    byId[id]=rec;
    catalogueOrder.push(id);
  }

  const sv=stage.getDataRange().getValues(),
    stageById={},
    duplicateStageIds=[];

  for(let i=1;i<sv.length;i++){
    const id=String(sv[i][sh['Catalogue ID']-1]||'').trim().toUpperCase();
    if(!id)continue;
    if(stageById[id]){
      duplicateStageIds.push({id:id,row:i+1,firstRow:stageById[id].rowNumber});
    }else{
      stageById[id]={rowNumber:i+1,row:sv[i].slice()};
    }
  }

  const orphanIds=Object.keys(stageById).filter(function(id){return !byId[id];});
  const now=new Date(),lastCol=stage.getLastColumn(),outRows=[],changedIds=[];
  let addedRows=0,sourceRowsUpdated=0,sourceFieldsChanged=0,
      derivedRowsUpdated=0,derivedFieldsChanged=0,
      revalidationRequired=0,localAssetRows=0,preservedEvidenceRows=0;

  function setCell(row,name,value){
    if(sh[name])row[sh[name]-1]=value;
  }

  function routeRecord(id,rec){
    return {
      catalogueId:id,
      serviceName:textValue(rec['Service Name']),
      serviceTier:textValue(rec['Service Tier']),
      category:textValue(rec['Category']),
      catalogueType:textValue(rec['Catalogue Type']),
      description:textValue(rec['Description']),
      photoBrief:textValue(rec['Photo Brief']),
      customerVariantNames:textValue(rec['Customer Variant Names']),
      customerSearchNames:textValue(rec['Customer Search Names']),
      serviceSynonyms:textValue(rec['Service Synonyms']),
      variants:[
        textValue(rec['Customer Variant Names']),
        textValue(rec['Customer Search Names']),
        textValue(rec['Service Synonyms'])
      ].filter(Boolean).join(' | ')
    };
  }

  catalogueOrder.forEach(function(id){
    const rec=byId[id],existing=stageById[id];
    const row=existing?existing.row.slice():new Array(lastCol).fill('');
    while(row.length<lastCol)row.push('');

    const route=AQBRoutePhotoStaging(routeRecord(id,rec));
    const rv={
      'Photo Track':route.track||'REVIEW_UNCLASSIFIED',
      'Photo Subtype':route.subtype||'',
      'Search Strategy':route.searchStrategy||'UNASSIGNED',
      'Pexels Required':!!route.pexelsRequired,
      'Search Query':route.pexelsRequired
        ?String(route.searchQuery||(route.queries||[])[0]||'').trim()
        :''
    };

    let sourceChanged=!existing,routeChanged=!existing;

    locked.forEach(function(h){
      const old=existing&&sh[h]?textValue(row[sh[h]-1]):'';
      const neu=textValue(rec[h]);
      if(old!==neu){
        sourceChanged=true;
        sourceFieldsChanged++;
      }
      setCell(row,h,rec[h]);
    });

    derived.forEach(function(h){
      const old=existing&&sh[h]
        ?(h==='Pexels Required'?String(row[sh[h]-1]).toLowerCase():textValue(row[sh[h]-1]))
        :'';
      const neu=(h==='Pexels Required'?String(!!rv[h]).toLowerCase():textValue(rv[h]));
      if(old!==neu){
        routeChanged=true;
        derivedFieldsChanged++;
      }
      setCell(row,h,rv[h]);
    });

    if(!existing){
      addedRows++;
      setCell(row,'Created At',now);
    }else{
      const candidate=sh['Candidate Image URL']?textValue(row[sh['Candidate Image URL']-1]):'';
      const q=sh['Qualification Status']?textValue(row[sh['Qualification Status']-1]):'';
      if(candidate||q)preservedEvidenceRows++;
    }

    if(sourceChanged)sourceRowsUpdated++;
    if(routeChanged)derivedRowsUpdated++;

    const fp=AQBBuildPhotoFingerprint(rec);
    setCell(row,'Source Fingerprint',fp);
    setCell(row,'Pipeline Revision',VERSION);
    setCell(row,'Pipeline Updated At',now);

    if(!route.pexelsRequired){
      setCell(row,'Search Query','');
      setCell(row,'Candidate Image URL','');
      setCell(row,'Candidate Source URL','');
      setCell(row,'Candidate Source','AQB LOCAL ASSET');
      setCell(row,'Qualification Status','UI_COMPONENT_READY');
      setCell(row,'Review Reason','AQB local/UI asset required; stock-photo qualification is intentionally not applicable.');
      setCell(row,'Search Status','LOCAL_ASSET_REQUIRED');
      setCell(row,'Gate Outcome','LOCAL_ASSET_REQUIRED');
      setCell(row,'Pipeline Status','LOCAL_ASSET_REQUIRED');
      localAssetRows++;
    }else if(!existing){
      setCell(row,'Qualification Status','PENDING');
      setCell(row,'Search Status',
        (rv['Photo Track']==='REVIEW_UNCLASSIFIED'||rv['Search Strategy']==='UNASSIGNED')
          ?'ROUTER_REVIEW_REQUIRED'
          :'READY_FOR_DISCOVERY'
      );
      setCell(row,'Gate Outcome','');
      setCell(row,'Pipeline Status','PENDING_DISCOVERY');
      changedIds.push(id);
    }else if(sourceChanged||routeChanged){
      setCell(row,'Qualification Status','REVALIDATION_REQUIRED');
      setCell(row,'Search Status',
        (rv['Photo Track']==='REVIEW_UNCLASSIFIED'||rv['Search Strategy']==='UNASSIGNED')
          ?'ROUTER_REVIEW_REQUIRED'
          :'SOURCE_CHANGED_REVALIDATION_REQUIRED'
      );
      setCell(row,'Review Reason','Catalogue identity/content changed; source and route were refreshed from the current Catalogue and existing candidate evidence must be revalidated.');
      setCell(row,'Gate Outcome','REVALIDATION_REQUIRED');
      setCell(row,'Pipeline Status','REVALIDATION_REQUIRED');
      revalidationRequired++;
      changedIds.push(id);
    }else{
      setCell(row,'Pipeline Status','SOURCE_CURRENT');
    }

    if(sourceChanged||routeChanged)setCell(row,'Updated At',now);
    outRows.push(row);
  });

  /*
   * AUTHORITATIVE BULK REWRITE
   * Preserve the header/schema, replace all staging data rows with the exact
   * current Catalogue identity set. This removes stale/duplicate rows without
   * deleteRow loops and keeps valid downstream evidence attached by Catalogue ID.
   */
  const oldDataRows=Math.max(0,stage.getLastRow()-1);
  const clearRows=Math.max(oldDataRows,outRows.length);
  if(clearRows)stage.getRange(2,1,clearRows,lastCol).clearContent();
  if(outRows.length)stage.getRange(2,1,outRows.length,lastCol).setValues(outRows);

  AQBQueuePhotoPipelineIds(changedIds);

  const out={
    version:VERSION,
    function:'AQBSyncPhotoStaging',
    readOnly:false,
    networkUsed:false,
    catalogueWrites:0,
    ownership:'MASTER_LISTS_TO_CATALOGUE_TO_PHOTO_STAGING',
    mode:'AUTHORITATIVE_BULK_REFRESH_BY_CATALOGUE_ID',
    catalogueRows:catalogueOrder.length,
    stagingRowsBefore:oldDataRows,
    stagingRowsAfter:outRows.length,
    sourceRowsUpdated:sourceRowsUpdated,
    sourceFieldsChanged:sourceFieldsChanged,
    derivedRowsUpdated:derivedRowsUpdated,
    derivedFieldsChanged:derivedFieldsChanged,
    addedRows:addedRows,
    orphanRowsRemoved:orphanIds.length,
    orphanIds:orphanIds.slice(0,40),
    duplicateRowsRemoved:duplicateStageIds.length,
    revalidationRequired:revalidationRequired,
    localAssetRows:localAssetRows,
    preservedEvidenceRows:preservedEvidenceRows,
    queuedForPipeline:changedIds.length,
    lockedFields:locked,
    derivedFields:derived,
    schemaMigration:schemaMigration,
    success:outRows.length===catalogueOrder.length
  };

  Logger.log('=== AQB CATALOGUE -> PHOTO STAGING REFRESH ===');
  Logger.log(JSON.stringify(out));
  return out;
}

function AQBRebuildPhotoStaging() {
  const VERSION = "V16.6.20-Beta-C.4.8.25.39-WhatsAppContactConsistency";
  const SHEET_NAME = "AQB Photo Staging";
  const HEADERS = [
    "Catalogue ID", "Service Name", "Service Tier", "Category", "Catalogue Type",
    "Description", "Photo Brief", "Customer Variant Names",
    "Customer Search Names", "Service Synonyms",
    "Photo Track", "Photo Subtype", "Search Strategy", "Pexels Required", "Search Query",
    "Candidate Image URL", "Candidate Source URL", "Candidate Source",
    "Discovery Score", "Visual Score", "Qualification Status", "Review Reason", "Search Status",
    "Created At", "Updated At", "Recovery Query", "Recovery Page", "Recovery Candidate URL",
    "Recovery Candidate Source URL", "Recovery Score", "Recovery Status", "Recovery Decision",
    "Previous Candidate URL", "Previous Score", "Vocabulary Before", "Vocabulary Variant",
    "Vocabulary Decision", "Vocabulary Evidence", "Candidate Evidence JSON", "Bottleneck Signal",
    "Bottleneck Dimension", "Signal Attainment", "Strongest Structural Signal",
    "Strongest Structural Evidence", "Gate Outcome",
    "S1 / CATID Status", "S1 / CATID Score", "S2 / FAMILY Status", "S2 / FAMILY Score",
    "S3 / DESC Status", "S3 / DESC Score", "S4 / BRIEF Status", "S4 / BRIEF Score",
    "S5 / ROUTER Status", "S5 / ROUTER Score", "S6 / ACTION Status", "S6 / ACTION Score",
    "S7 / TYPE Status", "S7 / TYPE Score", "S8 / FAMILYCTX Status", "S8 / FAMILYCTX Score"
  ];

  const ss = AQBGetSpreadsheet();
  const catalogue = AQBGetSheet("Catalogue");
  const hm = AQBBuildHeaderMap(catalogue);
  const requiredCatalogue = ["Catalogue ID","Service Name","Category","Description","Photo Brief"];
  requiredCatalogue.forEach(function(h){ if(!hm[h]) throw new Error("Catalogue missing required Photo Staging source column: "+h); });
  const values = catalogue.getDataRange().getValues();
  function cv(row,name){ return hm[name] ? String(row[hm[name]-1] == null ? "" : row[hm[name]-1]).trim() : ""; }

  let stage = ss.getSheetByName(SHEET_NAME);
  if (!stage) stage = ss.insertSheet(SHEET_NAME);

  const now = new Date();
  const rows = [];
  const routeIssues = [];
  let localAssetRows = 0, pexelsRows = 0;

  for (let i=1;i<values.length;i++) {
    const r=values[i];
    const id=cv(r,"Catalogue ID");
    if(!id) continue;
    const rec={
      catalogueId:id,
      serviceName:cv(r,"Service Name"),
      serviceTier:cv(r,"Service Tier"),
      category:cv(r,"Category"),
      catalogueType:cv(r,"Catalogue Type"),
      description:cv(r,"Description"),
      photoBrief:cv(r,"Photo Brief"),
      customerVariantNames:cv(r,"Customer Variant Names"),
      customerSearchNames:cv(r,"Customer Search Names"),
      serviceSynonyms:cv(r,"Service Synonyms")
    };
    rec.variants=[rec.customerVariantNames,rec.customerSearchNames,rec.serviceSynonyms].filter(Boolean).join(" | ");
    const route=AQBRoutePhotoStaging(rec);
    const isLocal=!route.pexelsRequired;
    const query=isLocal ? "" : String((route.queries||[])[0]||"").trim();
    const row=new Array(HEADERS.length).fill("");
    function set(name,value){ row[HEADERS.indexOf(name)] = value; }
    set("Catalogue ID",id); set("Service Name",rec.serviceName); set("Service Tier",rec.serviceTier); set("Category",rec.category);
    set("Catalogue Type",rec.catalogueType); set("Description",rec.description); set("Photo Brief",rec.photoBrief);
    set("Customer Variant Names",rec.customerVariantNames); set("Customer Search Names",rec.customerSearchNames); set("Service Synonyms",rec.serviceSynonyms);
    set("Photo Track",route.track||"REVIEW_UNCLASSIFIED"); set("Photo Subtype",route.subtype||"");
    set("Search Strategy",route.searchStrategy||"UNASSIGNED"); set("Pexels Required",!!route.pexelsRequired); set("Search Query",query);
    if(isLocal){
      set("Candidate Source","AQB LOCAL ASSET");
      set("Qualification Status","UI_COMPONENT_READY");
      set("Review Reason","AQB local/UI asset required; stock-photo qualification is intentionally not applicable.");
      set("Search Status","LOCAL_ASSET_REQUIRED");
      set("Gate Outcome","LOCAL_ASSET_REQUIRED");
      localAssetRows++;
    } else {
      set("Qualification Status","PENDING");
      set("Search Status", (route.track==="REVIEW_UNCLASSIFIED" || route.searchStrategy==="UNASSIGNED") ? "ROUTER_REVIEW_REQUIRED" : "READY_FOR_DISCOVERY");
      if(route.track==="REVIEW_UNCLASSIFIED" || route.searchStrategy==="UNASSIGNED") routeIssues.push({id:id,service:rec.serviceName,track:route.track,strategy:route.searchStrategy});
      pexelsRows++;
    }
    set("Created At",now); set("Updated At",now);
    rows.push(row);
  }

  stage.clear();
  stage.getRange(1,1,1,HEADERS.length).setValues([HEADERS]);
  if(rows.length) stage.getRange(2,1,rows.length,HEADERS.length).setValues(rows);
  stage.setFrozenRows(1);

  // Fresh qualification/discovery state. Candidate history was row-corrupted and is not carried forward.
  const props=PropertiesService.getScriptProperties();
  props.deleteProperty("AQB_PHOTO_QUALIFICATION_NEXT_INDEX");
  props.deleteProperty("AQB_PHOTO_QUALIFICATION_CURSOR");
  props.deleteProperty("AQB_PHOTO_QUALIFICATION_CURSOR_V2526");
  props.deleteProperty("AQB_PHOTO_QUALIFICATION_CURSOR_V2528");
  props.deleteProperty("AQB_C4822_AUTO_PAUSED");
  const allProps=props.getProperties();
  let clearedQueryCache=0;
  Object.keys(allProps).forEach(function(k){ if(k.indexOf("AQB_C4822_Q_")===0){ props.deleteProperty(k); clearedQueryCache++; } });

  const out={version:VERSION,function:"AQBRebuildPhotoStaging",readOnly:false,networkUsed:false,catalogueWrites:0,
    stagingRows:rows.length,schemaColumns:HEADERS.length,pexelsRows:pexelsRows,localAssetRows:localAssetRows,
    routeReviewRequired:routeIssues.length,routeIssues:routeIssues.slice(0,25),candidateFieldsReset:true,qualificationFieldsReset:true,
    catalogueOwnedFieldsLocked:AQBGetPhotoStagingCatalogueFields(),stagingWritePolicy:'CATALOGUE_FIELDS_READ_ONLY_EXCEPT_EXPLICIT_REFRESH_OR_REBUILD',
    qualificationCursorReset:true,discoveryQueryCacheCleared:clearedQueryCache,success:rows.length>0};
  Logger.log("=== AQB PHOTO STAGING REBUILD ==="); Logger.log(JSON.stringify(out)); return out;
}

function AQBProvisionPhotoStaging(){ return AQBRebuildPhotoStaging(); }

function AQBDiscoverPhotoCandidates(allowAutoResume, allowedIds) {
  const VERSION = "V16.6.20-Beta-C.4.8.25.41-UnifiedAQBPhotoPipeline";
  const STAGE_NAME = "AQB Photo Staging";
  const MAX_NETWORK_REQUESTS = 18;
  const MIN_PROVIDER_REMAINING = 5;
  const REQUEST_DELAY_MS = 1100;
  const props = PropertiesService.getScriptProperties();
  const apiKey = String(props.getProperty("PEXELS_API_KEY") || "").trim();
  if (!apiKey) throw new Error("PEXELS_API_KEY is not configured.");
  const scopedIds = Array.isArray(allowedIds) && allowedIds.length ? allowedIds.map(function(x){return String(x||"").trim().toUpperCase();}) : [];
  const scopedMap = {}; scopedIds.forEach(function(x){scopedMap[x]=true;});
  const scoped = scopedIds.length > 0;

  const ss = AQBGetSpreadsheet();
  const stage = ss.getSheetByName(STAGE_NAME);
  if (!stage) throw new Error("AQB Photo Staging does not exist. Run AQBPhotoProvisionStaging() first.");
  const sv = stage.getDataRange().getValues();
  const sh = {};
  sv[0].forEach(function(h,i){ sh[String(h).trim()] = i; });
  ["Catalogue ID","Service Name","Photo Track","Photo Subtype","Search Strategy","Pexels Required","Search Query","Candidate Image URL","Candidate Source URL","Candidate Source","Discovery Score","Visual Score","Qualification Status","Review Reason","Search Status","Updated At"].forEach(function(h){
    if (sh[h] == null) throw new Error("AQB Photo Staging missing required column: " + h);
  });

  const cat = AQBGetSheet("Catalogue");
  const ch = AQBBuildHeaderMap(cat);
  const cv = cat.getDataRange().getValues();
  function cval(row,name){ return ch[name] ? String(row[ch[name]-1] == null ? "" : row[ch[name]-1]).trim() : ""; }
  const catalogueById = {};
  for (let i=1;i<cv.length;i++) {
    const id=cval(cv[i],"Catalogue ID"); if(!id) continue;
    catalogueById[id]={
      catalogueId:id, serviceName:cval(cv[i],"Service Name"), category:cval(cv[i],"Category"),
      description:cval(cv[i],"Description"), photoBrief:cval(cv[i],"Photo Brief"),
      variants:[cval(cv[i],"Customer Variant Names"),cval(cv[i],"Customer Search Names"),cval(cv[i],"Service Synonyms")].filter(Boolean).join(" | ")
    };
  }

  let networkRequests=0, cacheHits=0, routed=0, candidatesFound=0, noResultQueries=0, completedWithoutCandidate=0, localAssetRows=0, skippedReview=0;
  let stopReason="QUEUE_COMPLETE", providerRemaining=null, providerReset=null, stoppedAt=null;
  const touchedRows=[];
  const now=new Date();

  for (let r=1;r<sv.length;r++) {
    const row=sv[r];
    const id=String(row[sh["Catalogue ID"]]||"").trim();
    if(!id) continue;
    if(scoped && !scopedMap[id.toUpperCase()]) continue;
    const rec=catalogueById[id];
    if(!rec) continue;
    const route=AQBRoutePhotoStaging(rec);
    if(route.track==="REVIEW_UNCLASSIFIED" || route.searchStrategy==="UNASSIGNED") {
      AQBWritePhotoDiscoveryFields(stage,r+1,sh,{"Photo Track":route.track,"Photo Subtype":route.subtype||"","Search Strategy":route.searchStrategy,"Search Status":"ROUTER_REVIEW_REQUIRED","Review Reason":"Certified router could not produce a safe discovery route.","Updated At":now});
      touchedRows.push(id); routed++; continue;
    }

    // Keep certified route snapshots current in permanent staging.
    const routePatch={"Photo Track":route.track,"Photo Subtype":route.subtype||"","Search Strategy":route.searchStrategy,"Pexels Required":route.pexelsRequired,"Updated At":now};
    AQBWritePhotoDiscoveryFields(stage,r+1,sh,routePatch); routed++;

    if(!route.pexelsRequired) {
      AQBWritePhotoDiscoveryFields(stage,r+1,sh,{"Candidate Source":"AQB LOCAL ASSET","Search Status":"LOCAL_ASSET_REQUIRED","Qualification Status":"PENDING","Review Reason":"Operational/logistics/membership record: use an AQB-owned local/brand asset rather than Pexels.","Updated At":now});
      localAssetRows++; continue;
    }

    const qualification=String(row[sh["Qualification Status"]]||"").trim().toUpperCase();
    const candidate=String(row[sh["Candidate Image URL"]]||"").trim();
    if(candidate && (qualification==="PENDING_VISUAL_REVIEW" || qualification==="APPROVED" || qualification==="REJECTED" || qualification==="REVIEW")) {
      skippedReview++; continue;
    }
    if(candidate) { skippedReview++; continue; }

    const queries=(route.queries||[]).filter(Boolean);
    if(!queries.length) {
      AQBWritePhotoDiscoveryFields(stage,r+1,sh,{"Search Status":"ROUTER_REVIEW_REQUIRED","Review Reason":"No certified Pexels query available.","Updated At":now});
      continue;
    }

    const lastQuery=String(row[sh["Search Query"]]||"").trim();
    const lastStatus=String(row[sh["Search Status"]]||"").trim();
    let queryIndex=0;
    if(lastStatus==="QUERY_NO_CANDIDATE" && lastQuery) {
      const ix=queries.map(AQBNormalizePhotoQuery).indexOf(AQBNormalizePhotoQuery(lastQuery));
      queryIndex=ix>=0?ix+1:0;
    } else if(lastStatus==="PEXELS_EXHAUSTED") {
      completedWithoutCandidate++; continue;
    }
    if(queryIndex>=queries.length) {
      AQBWritePhotoDiscoveryFields(stage,r+1,sh,{"Search Status":"PEXELS_EXHAUSTED","Review Reason":"All certified identity-preserving queries completed without a retained candidate.","Updated At":now});
      completedWithoutCandidate++; continue;
    }

    const query=queries[queryIndex];
    const cacheKey="AQB_C4822_Q_"+AQBHashPhotoQuery(AQBNormalizePhotoQuery(query));
    let searchResult=null;
    const cached=props.getProperty(cacheKey);
    if(cached) {
      try { searchResult=JSON.parse(cached); cacheHits++; } catch(e) { props.deleteProperty(cacheKey); }
    }

    if(!searchResult) {
      if(networkRequests>=MAX_NETWORK_REQUESTS) { stopReason="REQUEST_BUDGET_REACHED"; stoppedAt=id; break; }
      if(networkRequests>0) Utilities.sleep(REQUEST_DELAY_MS);
      const url="https://api.pexels.com/v1/search?per_page=15&orientation=portrait&query="+encodeURIComponent(query);
      const resp=UrlFetchApp.fetch(url,{method:"get",headers:{Authorization:apiKey},muteHttpExceptions:true});
      networkRequests++;
      const code=resp.getResponseCode();
      const headers=resp.getAllHeaders ? resp.getAllHeaders() : {};
      providerRemaining=AQBParseHeaderInt(headers,"x-ratelimit-remaining");
      providerReset=AQBParseHeaderInt(headers,"x-ratelimit-reset");
      if(code===429) { stopReason="PROVIDER_RATE_LIMITED"; stoppedAt=id; break; }
      if(code<200 || code>=300) {
        AQBWritePhotoDiscoveryFields(stage,r+1,sh,{"Search Query":query,"Search Status":"SEARCH_FAILED_HTTP_"+code,"Review Reason":"Pexels request failed; row retained for retry.","Updated At":now});
        stopReason="HTTP_FAILURE"; stoppedAt=id; break;
      }
      let body={}; try{body=JSON.parse(resp.getContentText()||"{}");}catch(e){body={};}
      searchResult=AQBSelectPhotoCandidate(rec,query,body.photos||[]);
      // Cache both candidate and no-result outcomes so identical queries do not consume another request.
      props.setProperty(cacheKey,JSON.stringify(searchResult));
      if(providerRemaining!==null && providerRemaining<=MIN_PROVIDER_REMAINING) {
        // Finish this response safely, then stop before provider exhaustion.
        stopReason="PROVIDER_BUDGET_FLOOR_REACHED";
      }
    }

    if(searchResult && searchResult.found) {
      AQBWritePhotoDiscoveryFields(stage,r+1,sh,{
        "Search Query":query,"Candidate Image URL":searchResult.imageUrl,"Candidate Source URL":searchResult.sourceUrl,
        "Candidate Source":"Pexels","Discovery Score":searchResult.discoveryScore,
        "Review Reason":"Discovery candidate only. Visual qualification is required before Catalogue promotion.",
        "Search Status":"CANDIDATE_FOUND_VISUAL_REVIEW","Updated At":now
      });
      const qhm=AQBBuildHeaderMap(stage);
      const qreset={"Visual Score":"","Qualification Status":"PENDING_VISUAL_REVIEW","Bottleneck Signal":"","Bottleneck Dimension":"","Signal Attainment":"","Strongest Structural Signal":"","Strongest Structural Evidence":"","Gate Outcome":"","Pipeline Status":"PENDING_QUALIFICATION","Pipeline Updated At":now};
      ["S1 / CATID Status","S1 / CATID Score","S2 / FAMILY Status","S2 / FAMILY Score","S3 / DESC Status","S3 / DESC Score","S4 / BRIEF Status","S4 / BRIEF Score","S5 / ROUTER Status","S5 / ROUTER Score","S6 / ACTION Status","S6 / ACTION Score","S7 / TYPE Status","S7 / TYPE Score","S8 / FAMILYCTX Status","S8 / FAMILYCTX Score"].forEach(function(h){qreset[h]="";});
      AQBWriteProtectedPhotoFields(stage,r+1,qhm,"QUALIFICATION",qreset);
      candidatesFound++; touchedRows.push(id);
    } else {
      noResultQueries++;
      const finalQuery=queryIndex===queries.length-1;
      AQBWritePhotoDiscoveryFields(stage,r+1,sh,{"Search Query":query,"Search Status":finalQuery?"PEXELS_EXHAUSTED":"QUERY_NO_CANDIDATE","Review Reason":finalQuery?"All certified identity-preserving queries completed without a retained candidate.":"No retained candidate from this query; next certified query remains eligible.","Updated At":now});
      if(finalQuery) completedWithoutCandidate++;
      touchedRows.push(id);
    }

    if(stopReason==="PROVIDER_BUDGET_FLOOR_REACHED") { stoppedAt=id; break; }
  }

  const remaining=AQBCountRemainingDiscovery(stage,sh);
  const complete=remaining===0;
  if(complete) stopReason="QUEUE_COMPLETE";
  let autoResumeScheduled=false, nextRunAt=null;
  if(!complete && allowAutoResume && String(props.getProperty("AQB_C4822_AUTO_PAUSED")||"")!=="TRUE") {
    nextRunAt=AQBSchedulePhotoPipelineContinuation(stopReason,providerReset);
    autoResumeScheduled=!!nextRunAt;
  }

  const out={
    version:VERSION,success:stopReason!=="HTTP_FAILURE" && stopReason!=="PROVIDER_RATE_LIMITED",phase:"BUDGETED_PRODUCTION_PHOTO_DISCOVERY",
    catalogueWrites:0,imageUrlWrites:0,descriptionWrites:0,photoBriefWrites:0,newCatalogueColumns:0,
    stagingWritesOnly:true,networkUsed:networkRequests>0,networkRequests:networkRequests,cacheHits:cacheHits,maxNetworkRequestsPerRun:MAX_NETWORK_REQUESTS,
    providerRemaining:providerRemaining,providerReset:providerReset,stopReason:stopReason,stoppedAt:stoppedAt,
    routedRows:routed,candidatesFound:candidatesFound,noResultQueries:noResultQueries,pexelsExhausted:completedWithoutCandidate,
    localAssetRows:localAssetRows,rowsAwaitingVisualReview:skippedReview,remainingDiscoveryRows:remaining,complete:complete,
    autoResumeScheduled:autoResumeScheduled,nextRunAt:nextRunAt?nextRunAt.toISOString():null,touchedCatalogueIds:touchedRows
  };
  Logger.log("=== AQB PHOTO CANDIDATE DISCOVERY ===");
  Logger.log(JSON.stringify(out));
  return out;
}

function AQBWritePhotoDiscoveryFields(sheet,rowNumber,hm,patch){
  Object.keys(patch).forEach(function(k){ if(hm[k]!=null) sheet.getRange(rowNumber,hm[k]+1).setValue(patch[k]); });
}

function AQBNormalizePhotoQuery(q){ return String(q||"").toLowerCase().replace(/[–—]/g,"-").replace(/\s+/g," ").trim(); }

function AQBHashPhotoQuery(s){
  const b=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s),Utilities.Charset.UTF_8);
  return b.map(function(x){const v=(x<0?x+256:x).toString(16);return v.length===1?"0"+v:v;}).join("").slice(0,24);
