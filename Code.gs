function AQBGetPhotoManualQueueGuardState(){
  const stage=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),held={};
  if(!stage||stage.getLastRow()<2)return held;
  const hm=AQBBuildHeaderMap(stage),v=stage.getDataRange().getValues();
  if(!hm['Catalogue ID'])return held;
  for(let i=1;i<v.length;i++){
    const id=String(v[i][hm['Catalogue ID']-1]||'').trim().toUpperCase();
    if(!id)continue;
    const q=hm['Qualification Status']?String(v[i][hm['Qualification Status']-1]||'').trim().toUpperCase():'';
    const r=hm['Recovery Status']?String(v[i][hm['Recovery Status']-1]||'').trim().toUpperCase():'';
    if(q==='LOCAL_ASSET_REQUIRED'||r==='MANUAL_ASSET_REQUIRED')held[id]={qualificationStatus:q,recoveryStatus:r};
  }
  return held;
}

function AQBQueueChangedPhotoRows(){
  const stage=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);if(!stage)return {queued:0,ids:[],manualGuardSkipped:0,manualGuardIds:[]};
  const hm=AQBEnsurePhotoPipelineColumns(),sv=stage.getDataRange().getValues(),stageFp={},manualHeld={};
  for(let i=1;i<sv.length;i++){
    const id=String(sv[i][hm['Catalogue ID']-1]||'').trim().toUpperCase();if(!id)continue;
    stageFp[id]=String(sv[i][hm['Source Fingerprint']-1]||'').trim();
    const q=hm['Qualification Status']?String(sv[i][hm['Qualification Status']-1]||'').trim().toUpperCase():'';
    const r=hm['Recovery Status']?String(sv[i][hm['Recovery Status']-1]||'').trim().toUpperCase():'';
    if(q==='LOCAL_ASSET_REQUIRED'||r==='MANUAL_ASSET_REQUIRED')manualHeld[id]=1;
  }
  const cat=AQBGetSheet('Catalogue'),ch=AQBBuildHeaderMap(cat),cv=cat.getDataRange().getValues(),ids=[],manualGuardIds=[];
  for(let i=1;i<cv.length;i++){
    const id=String(cv[i][ch['Catalogue ID']-1]||'').trim().toUpperCase();if(!id)continue;
    const rec={};AQB_PHOTO_SOURCE_FIELDS_.forEach(function(k){rec[k]=ch[k]?cv[i][ch[k]-1]:'';});
    if(stageFp[id]!==AQBBuildPhotoFingerprint(rec)){
      if(manualHeld[id])manualGuardIds.push(id);else ids.push(id);
    }
  }
  AQBQueuePhotoPipelineIds(ids);
  return {queued:ids.length,ids:ids,manualGuardSkipped:manualGuardIds.length,manualGuardIds:manualGuardIds};
}

function AQBRunPhotoVisualPilot(options){
  // Existing Catalogue Photo Manager web review, 18 per batch (introduced V16.21.15.6.5.12).
  // Exception-first, human visual comparison, no invented scores or photo mutations.
  const reviewer=AQBRequireCataloguePhotoManager();
  const settings=options&&typeof options==='object'?options:{};
  const props=PropertiesService.getScriptProperties(),KEY='AQB_VISUAL_PILOT_REVIEW_511_CURSOR';
  // Saved-decision progress is computed from 232 unique canonical IDs, NEVER from cursor position.
  const reviewExceptions=['AQBCAT009','AQBCAT013','AQBCAT052','AQBCAT053','AQBCAT059','AQBCAT100','AQBCAT102','AQBCAT103','AQBCAT104','AQBCAT142','AQBCAT143','AQBCAT227'];
  function reviewProgress(){
    const sheet=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.CATALOGUE);
    if(!sheet)throw Error('Catalogue unavailable for review progress.');
    const rows=sheet.getDataRange().getValues(),headers=rows[0].map(String),col=headers.indexOf('Catalogue ID');
    if(col<0)throw Error('Catalogue ID missing.');
    const ids=rows.slice(1).map(r=>String(r[col]||'').trim().toUpperCase()).filter(id=>/^AQBCAT\d{3}$/.test(id)).sort();
    if(ids.length!==232||new Set(ids).size!==232)throw Error('Catalogue cardinality mismatch; review progress frozen.');
    const order=reviewExceptions.concat(ids.filter(id=>!reviewExceptions.includes(id)));
    const all=props.getProperties();let reviewed=0,accepted=0,rejected=0,blocked=0,needsAttention=0;
    const savedIds=[],unreviewed=[];
    order.forEach((id,i)=>{
      let d=null;try{d=JSON.parse(all['AQB_PHOTO_HUMAN_REVIEW_'+id]||'null');}catch(e){}
      if(!d||d.id!==id||!['VISUAL_SELECTION_ACCEPTED_PENDING_FINAL_GATE','VISUAL_REJECTED_FOR_REPLACEMENT','BLOCKED_REQUIRES_FRESH_VISUAL_GATE'].includes(d.state)){
        unreviewed.push(i);return;
      }
      reviewed++;savedIds.push(id);
      if(d.state==='VISUAL_REJECTED_FOR_REPLACEMENT'){rejected++;needsAttention++;}
      else if(d.state==='BLOCKED_REQUIRES_FRESH_VISUAL_GATE'){blocked++;needsAttention++;}
      else accepted++;
    });
    return {total:232,reviewed:reviewed,remaining:232-reviewed,acceptedPendingGate:accepted,
      // No bulk selection performs formal S1–S8 approval; never misrepresent these as approved.
      approvedByBulkReview:0,rejected:rejected,blocked:blocked,needsAttention:needsAttention,
      complete:reviewed===232,firstUnreviewedOffset:unreviewed.length?unreviewed[0]:232,
      nextUnreviewedOffset:unreviewed.length?unreviewed[0]:232};
  }
  if(settings.action==='GET_REVIEW_PROGRESS')return reviewProgress();
  // Lazy image payload: not included in login HTML. Available only after role authorization.
  if(settings.action==='LOAD_STAGED_PREVIEWS')return {}; // Retired ten-card preview payload; use unified Own Photo Manager.
  // 232 service-specific text concept covers; NOT verified or publishable service photography.
  if(settings.action==='LOAD_CONCEPT_CARDS')return {}; // Retired 232 text concept covers; no photo data mutation.
  // This is a human review record only. The canonical qualification engine, score and
  // publication gates remain authoritative and are never modified by bulk selection.
  if(settings.action==='SAVE_REVIEW'){
    const decisions=Array.isArray(settings.decisions)?settings.decisions:[];
    const offset=Number(settings.offset);
    if(!Number.isInteger(offset)||offset<0||offset>=232||decisions.length>18||!decisions.length)
      throw Error('Invalid review batch. Nothing saved.');
    const ss0=AQBGetSpreadsheet(), sheet0=ss0.getSheetByName(CONFIG.SHEETS.CATALOGUE);
    if(!sheet0)throw Error('Catalogue unavailable.');
    const matrix0=sheet0.getDataRange().getValues(),head0=matrix0[0].map(String),ix0=head0.indexOf('Catalogue ID');
    if(ix0<0)throw Error('Catalogue ID authority missing.');
    const allIds0=matrix0.slice(1).map(r=>String(r[ix0]||'').trim().toUpperCase()).filter(x=>/^AQBCAT\d{3}$/.test(x)).sort();
    if(allIds0.length!==232||new Set(allIds0).size!==232)throw Error('Catalogue identity mismatch.');
    const exceptions0=['AQBCAT009','AQBCAT013','AQBCAT052','AQBCAT053','AQBCAT059','AQBCAT100','AQBCAT102','AQBCAT103','AQBCAT104','AQBCAT142','AQBCAT143','AQBCAT227'];
    const ordered0=exceptions0.concat(allIds0.filter(id=>!exceptions0.includes(id)));
    const permitted=new Set(ordered0.slice(offset,Math.min(offset+18,232)));
    const seen=new Set(),updates={};let reviewed=0,blocked=0;
    decisions.forEach(d=>{
      const id=String(d&&d.id||'').toUpperCase(),choice=String(d&&d.choice||'').toUpperCase(),reason=String(d&&d.reason||'').trim().slice(0,250);
      if(!permitted.has(id)||seen.has(id)||!['ACCEPT','REJECT'].includes(choice))throw Error('Invalid or duplicate photo decision.');
      if(choice==='REJECT'&&!reason)throw Error('A rejection reason is required for '+id);
      seen.add(id);
      const restricted=exceptions0.includes(id);
      const state=choice==='ACCEPT'?(restricted?'BLOCKED_REQUIRES_FRESH_VISUAL_GATE':'VISUAL_SELECTION_ACCEPTED_PENDING_FINAL_GATE'):'VISUAL_REJECTED_FOR_REPLACEMENT';
      if(restricted&&choice==='ACCEPT')blocked++;
      updates['AQB_PHOTO_HUMAN_REVIEW_'+id]=JSON.stringify({id:id,state:state,reason:reason,
        reviewer:reviewer.email,at:new Date().toISOString(),sourceVersion:'V16.21.15.6.5.21'});
      reviewed++;
    });
    // Each property is small. No Catalogue/Staging/qualification writes and no publication.
    props.setProperties(updates,false);
    Logger.log('AQB_PHOTO_BULK_REVIEW '+JSON.stringify({version:'V16.21.15.6.5.21',reviewed:reviewed,blocked:blocked,
      sheetWrites:0,qualificationWrites:0,publications:0,reviewer:reviewer.email}));
    const progress=reviewProgress();
    return {saved:true,reviewed:reviewed,blocked:blocked,nextOffset:progress.firstUnreviewedOffset,progress:progress,
      sheetWrites:0,qualificationWrites:0,publications:0};
  }
  const ss=AQBGetSpreadsheet(),cat=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),
    stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),cards=ss.getSheetByName('AQB Family Photo Cards');
  if(!cat||!stage||!cards)throw Error('Visual review requires Catalogue, AQB Photo Staging and AQB Family Photo Cards.');
  function collect(sh,idHeader){
    const data=sh.getDataRange().getValues(), headers=data[0].map(x=>String(x||'').trim()), pos=headers.indexOf(idHeader);
    if(pos<0)throw Error('Missing '+idHeader+' in '+sh.getName());
    const records={};
    data.slice(1).forEach((r,i)=>{const id=String(r[pos]||'').trim().toUpperCase();
      if(!/^AQBCAT\d{3}$/.test(id)||records[id])throw Error('Invalid/duplicate ID in '+sh.getName()+' row '+(i+2));records[id]=r;});
    return {headers:headers,records:records,ids:Object.keys(records).sort()};
  }
  const C=collect(cat,'Catalogue ID'),S=collect(stage,'Catalogue ID'),F=collect(cards,'Canonical Service ID'),ids=C.ids;
  if(ids.length!==232||S.ids.length!==232||F.ids.length!==232||ids.some(id=>!S.records[id]||!F.records[id]))
    throw Error('Visual review cardinality check failed. No cursor moved.');
  function val(o,id,k){const n=o.headers.indexOf(k);return n<0?'':String(o.records[id][n]??'').trim();}
  const exceptionIds=['AQBCAT009','AQBCAT013','AQBCAT052','AQBCAT053','AQBCAT059','AQBCAT100',
    'AQBCAT102','AQBCAT103','AQBCAT104','AQBCAT142','AQBCAT143','AQBCAT227'];
  const order=exceptionIds.concat(ids.filter(id=>exceptionIds.indexOf(id)<0));
  const fingerprint=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,
    ids.map(id=>[id,val(C,id,'Service Name'),val(C,id,'Photo Brief'),val(C,id,'Image URL'),
      val(S,id,'Candidate Image URL'),val(S,id,'Qualification Status'),val(F,id,'Card Asset Review Locator')].join('|')).join('\n'))).slice(0,30);
  const saved=props.getProperty(KEY+'_FP');if(saved&&saved!==fingerprint)throw Error('Photo/brief references changed. Review cursor frozen.');
  const cursor=settings.webReview===true?Number(settings.offset||0):Number(props.getProperty(KEY)||0);
  if(!Number.isInteger(cursor)||cursor<0||cursor>232)throw Error('Invalid review cursor.');
  const end=Math.min(cursor+18,232), rows=[],counts={};
  for(const id of order.slice(cursor,end)){
    const status=val(S,id,'Qualification Status'),candidate=val(S,id,'Candidate Image URL'),
      canonical=val(C,id,'Image URL')||val(C,id,'Own Photo'),local=val(F,id,'Card Asset Review Locator');
    counts[status]=(counts[status]||0)+1;
    const item={id:id,service:val(C,id,'Service Name'),category:val(C,id,'Category'),
      photoBrief:val(C,id,'Photo Brief'),description:val(C,id,'Description'),
      historicalStatus:status,historicalVisualScore:val(S,id,'Visual Score'),
      candidateImageUrl:candidate,canonicalImageUrl:canonical,
      sourceUrl:val(S,id,'Candidate Source URL'),localReviewLocator:local,
      localReviewState:val(F,id,'Card Asset Review State'),
      exception:exceptionIds.indexOf(id)>=0,decision:'PENDING_HUMAN_VISUAL_ASSESSMENT',
      savedReviewState:(()=>{try{const d=JSON.parse(props.getProperty('AQB_PHOTO_HUMAN_REVIEW_'+id)||'null');return d&&d.id===id?String(d.state||''):'';}catch(e){return '';}})()};
    rows.push(item);
    Logger.log('AQB_VISUAL_PILOT_ROW '+JSON.stringify({id:id,service:item.service,status:status,
      candidate:!!candidate,canonical:!!canonical,localReviewAsset:!!local,
      exception:item.exception,decision:item.decision}));
  }
  // Display the actual images side by side using the Sheets UI. Local file locators are explicitly
  // labelled because they cannot be displayed as HTTP images until hosted.
  function escapeHtml(v){return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
  function safeHttp(v){const x=String(v||'').trim();return /^https:\/\/[^\s<>"']+$/i.test(x)?escapeHtml(x):'';}
  function photoBox(url,label){const u=safeHttp(url);return '<div class="photo"><b>'+label+'</b>'+
    (u?'<img loading="lazy" referrerpolicy="no-referrer" src="'+u+'" alt="'+label+'" onerror="this.alt=\'Image could not load\';this.style.display=\'none\'">':
    '<p class="missing">No hosted image reference</p>')+'</div>';}
  const cardsHtml=rows.map(r=>'<section><header><strong>'+escapeHtml(r.id)+' — '+escapeHtml(r.service)+
    '</strong><span>'+escapeHtml(r.historicalStatus)+' · Historical '+escapeHtml(r.historicalVisualScore||'N/A')+
    (r.exception?' · PRIORITY EXCEPTION':'')+'</span></header><div class="photos">'+
    photoBox(r.candidateImageUrl,'Candidate')+photoBox(r.canonicalImageUrl,'Canonical')+'</div>'+
    '<p><b>Photo Brief:</b> '+escapeHtml(r.photoBrief)+'</p><p><b>Description:</b> '+escapeHtml(r.description)+'</p>'+
    '<p><b>Review asset:</b> '+escapeHtml(r.localReviewLocator||'None staged')+'</p>'+
    '<p><b>Review checklist:</b> Exact service identity · hair/style/process details · exclusions · S1–S8 · provenance/rights</p>'+
    '<p><b>Decision:</b> Pending human visual assessment. No automatic qualification.</p></section>').join('');
  const html='<!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1"><style>'+ 
    'body{font:14px Arial,sans-serif;background:#f6f7f7;color:#1c2522;margin:16px}section{background:white;padding:15px;margin:0 0 16px;border:1px solid #ddd;border-radius:9px}header{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px}header span{color:#805626}.photos{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.photo{min-width:0;background:#f4f4f4;padding:8px}.photo img{width:100%;max-height:285px;object-fit:contain;display:block}.missing{color:#a24545}p{line-height:1.4}small{display:block;margin-bottom:15px}@media(max-width:550px){.photos{grid-template-columns:1fr}}'+
    '</style></head><body><h2>AQB Actual Image Review — '+(cursor+1)+'–'+end+' / 232</h2>'+
    '<small>Exception-first. Images shown are real remote references; local staging assets require hosting or manual viewing. Review is human-led. No photo, qualification or public record is changed.</small>'+
    cardsHtml+'</body></html>';
  let dialogShown=false,dialogError='';
  if(settings.webReview!==true&&settings.showDialog!==false&&rows.length){try{
    SpreadsheetApp.getUi().showModelessDialog(HtmlService.createHtmlOutput(html).setWidth(960).setHeight(700),
      'AQB Photo Visual Review '+(cursor+1)+'–'+end);dialogShown=true;
  }catch(err){dialogError=String(err.message||err);}}
  // Do not advance if the viewing UI could not be opened, unless the caller explicitly
  // requests return-only mode for a separate reviewer.
  const returnOnly=settings.showDialog===false&&settings.webReview!==true;
  if(dialogShown||returnOnly){props.setProperties({[KEY]:String(end),[KEY+'_FP']:fingerprint});}
  const summary={version:'V16.21.15.6.5.13',from:cursor+1,to:end,total:232,
    nextCursor:dialogShown||returnOnly?end:cursor,complete:(dialogShown||returnOnly)&&end===232,
    reviewCount:rows.length,counts:counts,exceptionFirst:true,dialogShown:dialogShown,
    dialogError:dialogError,advanced:dialogShown||returnOnly,sheetWrites:0,
    qualificationWrites:0,publications:0,visualQualificationCompleted:false,
    rightsVerified:false,rows:rows};
  Logger.log('AQB_VISUAL_PILOT_PAGE '+JSON.stringify({version:summary.version,from:summary.from,to:summary.to,
    nextCursor:summary.nextCursor,complete:summary.complete,dialogShown:dialogShown,
    dialogError:dialogError,advanced:summary.advanced,counts:counts,
    sheetWrites:0,qualificationWrites:0,publications:0,visualQualificationCompleted:false}));
  if(settings.webReview===true){summary.nextCursor=cursor;summary.advanced=false;summary.dialogShown=false;}
  return summary;
}

function AQBRunPhotoChallengerBatch(options){
  const request=options&&typeof options==='object'?options:{};
  const targetId=String(request.catalogueId||'').trim().toUpperCase();
  const targeted=/^AQBCAT\d{3}$/.test(targetId);
  const operation=String(request.action||'RESEARCH').toUpperCase();
  // V16.21.15.6.5.21: authorized in-app Pexels search; each AQBCAT identity stays independent.
  if(operation==='PEXELS_SEARCH'){
    AQBRequireCataloguePhotoManager();
    const ids=Array.isArray(request.catalogueIds)?request.catalogueIds:[request.catalogueId];
    if(!ids.length||ids.length>18)throw Error('Select 1–18 Catalogue services.');
    const clean=ids.map(x=>String(x||'').trim().toUpperCase());
    if(new Set(clean).size!==clean.length||clean.some(x=>!/^AQBCAT\d{3}$/.test(x)))throw Error('Invalid or repeated Catalogue ID.');
    const key=String(PropertiesService.getScriptProperties().getProperty('PEXELS_API_KEY')||'').trim();
    if(!key)throw Error('PEXELS_API_KEY has not been configured.');
    const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),hm=AQBBuildHeaderMap(cat),values=cat.getDataRange().getValues();
    const field=(r,k)=>hm[k]?String(r[hm[k]-1]||'').trim():'';
    const byId={};values.slice(1).forEach(r=>{const id=field(r,'Catalogue ID').toUpperCase();if(id)byId[id]=r;});
    const overrides=request.queries&&typeof request.queries==='object'?request.queries:{};
    const page=Math.max(1,Math.min(20,Math.floor(Number(request.page)||1)));
    const results=[];
    clean.forEach(id=>{
      const r=byId[id];if(!r)throw Error('Unknown Catalogue service: '+id);
      const service=field(r,'Service Name'),category=field(r,'Category'),brief=field(r,'Photo Brief');
      const manual=String(overrides[id]||'').trim().slice(0,180);
      const query=manual||[service,category,brief.slice(0,130)].filter(Boolean).join(' ').slice(0,240);
      const uri='https://api.pexels.com/v1/search?'+['query='+encodeURIComponent(query),'per_page=9','page='+page].join('&');
      try{
        const response=UrlFetchApp.fetch(uri,{headers:{Authorization:key},muteHttpExceptions:true});
        const status=response.getResponseCode();
        if(status!==200){results.push({id,service,category,query,page,photos:[],error:'Pexels HTTP '+status});return;}
        const raw=JSON.parse(response.getContentText()||'{}');
        const photos=(raw.photos||[]).map(p=>({photoId:String(p.id||''),thumb:String(p.src&&p.src.medium||''),preview:String(p.src&&p.src.large||''),sourceUrl:String(p.url||''),photographer:String(p.photographer||''),photographerUrl:String(p.photographer_url||''),alt:String(p.alt||'').slice(0,240)}));
        const cacheKey='AQB_PEXELS_SEARCH_'+Utilities.base64EncodeWebSafe(id+'_'+AQBGetCurrentUser().email).slice(0,90);
        CacheService.getScriptCache().put(cacheKey,JSON.stringify({ids:photos.map(p=>p.photoId),page,query}),1200);
        results.push({id,service,category,query,page,hasMore:!!raw.next_page,photos});
      }catch(e){results.push({id,service,category,query,page,photos:[],error:String(e&&e.message||e)});}
    });
    return {success:true,results,requested:clean.length,publicationWrites:0};
  }
  if(operation==='PEXELS_STAGE'){
    const actor=AQBRequireCataloguePhotoManager();
    const choices=Array.isArray(request.choices)?request.choices:[];
    if(!choices.length||choices.length>18)throw Error('Choose 1–18 candidates to stage.');
    const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(cat),catRows=cat.getDataRange().getValues();
    const ids=new Set(catRows.slice(1).map(r=>String(r[cm['Catalogue ID']-1]||'').trim().toUpperCase()));
    const st=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);if(!st)throw Error('Photo staging sheet missing.');
    const hm=AQBBuildHeaderMap(st),data=st.getDataRange().getValues();
    const rowById={};data.slice(1).forEach((r,i)=>{const id=String(r[hm['Catalogue ID']-1]||'').trim().toUpperCase();if(id)rowById[id]=i+2;});
    const seen=new Set(),validated=[];
    choices.forEach(c=>{
      const id=String(c.id||'').trim().toUpperCase(),photoId=String(c.photoId||'').trim();
      if(!ids.has(id)||!rowById[id]||!/^\d+$/.test(photoId)||seen.has(id))throw Error('Invalid or duplicate selected service/photo.');seen.add(id);
      const cacheKey='AQB_PEXELS_SEARCH_'+Utilities.base64EncodeWebSafe(id+'_'+actor.email).slice(0,90);
      let cached;try{cached=JSON.parse(CacheService.getScriptCache().get(cacheKey)||'null');}catch(e){}
      if(!cached||!cached.ids.includes(photoId))throw Error('Search result expired for '+id+'. Search again before staging.');
      validated.push({id,photoId,row:rowById[id]});
    });
    // Review-only staging; preserve canonical and publishing authority. A candidate must pass visual and rights checks later.
    const fields=['Pexels Review Photo ID','Pexels Review Image URL','Pexels Review Source URL','Pexels Review Photographer','Pexels Review Rights','Pexels Review Status','Pexels Review At','Pexels Review By'];
    fields.forEach(h=>{if(!hm[h]){const col=st.getLastColumn()+1;st.getRange(1,col).setValue(h);hm[h]=col;}});
    const lock=LockService.getScriptLock();lock.waitLock(20000);
    try{
      validated.forEach(item=>{
        const key=String(PropertiesService.getScriptProperties().getProperty('PEXELS_API_KEY')||'').trim();
        const res=UrlFetchApp.fetch('https://api.pexels.com/v1/photos/'+encodeURIComponent(item.photoId),{headers:{Authorization:key},muteHttpExceptions:true});
        if(res.getResponseCode()!==200)throw Error('Pexels source could not be verified for '+item.id);
        const photo=JSON.parse(res.getContentText());
        const vals=[item.photoId,String(photo.src&&photo.src.large||''),String(photo.url||''),String(photo.photographer||''),'Pexels license — commercial-use and third-party-rights review required','PENDING_VISUAL_AND_RIGHTS_REVIEW',new Date(),actor.email];
        fields.forEach((h,i)=>st.getRange(item.row,hm[h]).setValue(vals[i]));
        AQBLogAudit('PEXELS_PHOTO_STAGED','Catalogue',item.id,'Pexels photo '+item.photoId+' staged by '+actor.email+'; no qualification or publication.');
      });
    }finally{lock.releaseLock();}
    return {success:true,staged:validated.length,qualificationWrites:0,publishedPhotoWrites:0};
  }
  if(operation==='GOOGLE_REGISTER'){
    const actor=AQBRequireCataloguePhotoManager();
    const id=String(request.catalogueId||'').trim().toUpperCase();
    if(!/^AQBCAT\d{3}$/.test(id))throw new Error('Select one canonical AQBCAT service.');
    const url=String(request.imageUrl||'').trim(),source=String(request.sourceUrl||'').trim();
    const permission=String(request.licenceEvidence||'').trim();
    const valid=u=>/^https:\/\/[^\s]+$/i.test(u)&&!/[<>\"']/.test(u);
    if(!valid(url)||!valid(source))throw new Error('Supply valid HTTPS image and original source-page URLs.');
    if(!permission||permission.length<12)throw new Error('Record the image licence, copyright holder permission or evidence before staging.');
    const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(cat),data=cat.getDataRange().getValues();
    if(!data.slice(1).some(r=>String(r[cm['Catalogue ID']-1]||'').trim().toUpperCase()===id))throw new Error('Catalogue service not found.');
    const sheet=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
    if(!sheet)throw new Error('Photo staging sheet is missing.');
    const hm=AQBBuildHeaderMap(sheet),rows=sheet.getDataRange().getValues();
    let target=0;for(let i=1;i<rows.length;i++)if(String(rows[i][hm['Catalogue ID']-1]||'').trim().toUpperCase()===id){target=i+1;break;}
    if(!target)throw new Error('Canonical staging record missing; run existing staging provisioning.');
    const fields=['Google Reference Image URL','Google Reference Source URL','Google Reference Rights Evidence','Google Reference Status','Google Reference Registered At'];
    fields.forEach(h=>{if(!hm[h]){const c=sheet.getLastColumn()+1;sheet.getRange(1,c).setValue(h);hm[h]=c;}});
    const updates=[url,source,permission,'MANUAL_SOURCE_REGISTERED_RIGHTS_UNVERIFIED',new Date()];
    fields.forEach((h,i)=>sheet.getRange(target,hm[h]).setValue(updates[i]));
    AQBLogAudit('GOOGLE_IMAGE_REFERENCE_STAGED','Catalogue',id,'Admin or Manager '+actor.email+' registered an image reference; no published image changed.');
