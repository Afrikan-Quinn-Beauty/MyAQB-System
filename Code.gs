    ['jumbo',['jumbo','extra large']],['straight back',['straight back','straight-back']],['goddess',['goddess']],['boho',['boho','bohemian']]
  ], out=[];
  defs.forEach(function(d){if(d[1].some(function(t){return AQBHasVariantTerm(all,t);})){out.push({key:d[0],terms:d[1]});}});
  return out;
}

function AQBGetVariantContradictions(profile,text){
  const h=AQBNormalizeVariantText(text), out=[], service=AQBNormalizeVariantText(profile.service);
  const hard=(profile.hardModifiers||[]).map(function(x){return x.key;});
  if(hard.indexOf('long')>=0&&/\bshort\b|\bbob\b|chin length|jaw length/.test(h))out.push('long target vs short/bob candidate');
  if((hard.indexOf('short')>=0||hard.indexOf('bob')>=0)&&/\blong\b|waist length|hip length|very long/.test(h))out.push('short/bob target vs long candidate');
  if(profile.primaryFamily==='twist'&&!AQBHasVariantTerm(h,'twist')&&/\bafro\b|natural afro/.test(h))out.push('twist target vs generic afro candidate');
  if((profile.primaryFamily==='braid'||profile.primaryFamily==='cornrow')&&!AQBHasVariantTerm(h,'braid')&&!AQBHasVariantTerm(h,'cornrow')&&/\bafro\b|natural afro/.test(h))out.push('braid/cornrow target vs generic afro candidate');
  if(profile.primaryFamily==='cornrow'&&/line|straight back|swahili|lemonade/.test(service)&&/\bbun\b|updo|ponytail/.test(h))out.push('row-pattern target vs bun/updo candidate');
  if(profile.primaryFamily==='loc'&&/\bbraid\b|cornrow/.test(h)&&!/loc|dread/.test(h))out.push('loc target vs braid candidate');
  if(profile.primaryFamily==='twist'&&/cornrow/.test(h)&&!/twist/.test(h))out.push('twist target vs cornrow candidate');
  return AQBGetUniqueVariantValues(out);
}

function AQBEscapeRegex(value){
  return String(value||'').replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
}

