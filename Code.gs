function AQBAssertPhotoStagingPatch(patch){
  var locked=AQBGetPhotoStagingCatalogueFields(), blocked=[];
  Object.keys(patch||{}).forEach(function(name){if(locked.indexOf(name)!==-1)blocked.push(name);});
  if(blocked.length)throw new Error('PHOTO_STAGING_CATALOGUE_LOCK: staging worker attempted to write Catalogue-owned field(s): '+blocked.join(', '));
  return true;
}

function AQBAssertPhotoStagingCatalogueLock(stage,rowNumber,hm,row,catalogueById){
  var fields=AQBGetPhotoStagingCatalogueFields(), id=String(row[hm['Catalogue ID']-1]||'').trim().toUpperCase();
  var rec=(catalogueById||AQBGetCatalogueSnapshotById())[id];
  if(!rec)throw new Error('PHOTO_STAGING_CATALOGUE_LOCK: no Catalogue record for '+id+' at staging row '+rowNumber+'.');
  var mismatches=[];
  fields.forEach(function(h){
    if(!hm[h]){mismatches.push(h+' [missing column]');return;}
    var a=String(row[hm[h]-1]==null?'':row[hm[h]-1]).trim();
    var b=String(rec[h]==null?'':rec[h]).trim();
    if(a!==b)mismatches.push(h);
  });
  if(mismatches.length)throw new Error('PHOTO_STAGING_CATALOGUE_LOCK: Catalogue snapshot mismatch for '+id+' at staging row '+rowNumber+': '+mismatches.join(', ')+'. Run AQBPhotoSyncStaging().');
  return true;
}

