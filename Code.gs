  var send=options.send===true,ids=options.appointmentIds||AQB_COMPLETION_REPLAY_IDS_;
  var out=AQBCompletionDeliveryAudit_(ids.filter(function(id){return AQB_COMPLETION_EXCLUDE_IDS_.indexOf(id)===-1;}));
  if(!send)return out.map(function(x){var y=Object.assign({},x);delete y.customer;return y;});
  var hour=Number(Utilities.formatDate(new Date(),'Africa/Nairobi','H'));
  if(hour<7||hour>=20)throw new Error('AQB WhatsApp quiet hours 20:00–07:00; no sends performed.');
  var lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    out.forEach(function(x){
      if(x.status!=='MISSING_LEDGER')return;
      // Recheck under lock to avoid duplicate submissions.
