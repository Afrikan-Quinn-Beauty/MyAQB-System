function AQBAuditCustomerCatalogueImageSync(){
  // V16.21.16.8.30: verify exact APPROVED original through every customer image boundary.
  // Read-only. No photo selection, qualification, publishing or cache mutation.
  const version='V16.21.16.8.30', ss=AQBGetSpreadsheet();
  const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),pub=AQBGetSheet(CONFIG.SHEETS.PUBLIC_CATALOGUE);
  const stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),ledger=ss.getSheetByName('AQB Photo Approval Decisions');
  if(!stage||!ledger)throw Error('Studio staging and approval ledger required for exact original verification');
  function extract(sheet,urlColumn){
    const values=sheet.getDataRange().getValues(),h={};
    (values[0]||[]).forEach(function(v,i){h[String(v||'').trim()]=i;});
    ['Catalogue ID',urlColumn].forEach(function(k){if(h[k]===undefined)throw Error(sheet.getName()+' missing '+k);});
    const map={},duplicates=[];
    values.slice(1).forEach(function(r){
      const id=String(r[h['Catalogue ID']]||'').trim().toUpperCase();if(!id)return;
      if(Object.prototype.hasOwnProperty.call(map,id))duplicates.push(id);
      map[id]={url:String(r[h[urlColumn]]||'').trim(),source:h['Image Source']===undefined?'':String(r[h['Image Source']]||'').trim(),candidateSource:h['Candidate Source']===undefined?'':String(r[h['Candidate Source']]||'').trim(),decision:h['Decision']===undefined?'':String(r[h['Decision']]||'').trim().toUpperCase()};
    });return {map:map,duplicates:duplicates};
  }
  const a=extract(cat,'Image URL'),b=extract(pub,'Image URL'),c=extract(stage,'Candidate Image URL'),d=extract(ledger,'Candidate Image URL');
  const counts={MATCHED:0,STALE_IMAGE:0,MISSING_PUBLIC_RECORD:0,EXTRA_PUBLIC_RECORD:0,UNAPPROVED_CURRENT_ORIGINAL:0,CANONICAL_NOT_APPROVED_ORIGINAL:0,INVALID_PUBLIC_IMAGE_URL:0},sample=[];
  const ids=Object.keys(a.map);
  ids.forEach(function(id){
    let status='MATCHED';const ca=a.map[id],pu=b.map[id],st=c.map[id],ap=d.map[id];
    if(!pu)status='MISSING_PUBLIC_RECORD';
    else if(ca.url!==pu.url)status='STALE_IMAGE';
    else if(!st||!ap||st.candidateSource!=='AQB Studio'||ap.decision!=='APPROVED'||ap.url!==st.url)status='UNAPPROVED_CURRENT_ORIGINAL';
    else if(ca.url!==st.url)status='CANONICAL_NOT_APPROVED_ORIGINAL';
    else if(!/^https:\/\//i.test(pu.url))status='INVALID_PUBLIC_IMAGE_URL';
    counts[status]++;
    if(status!=='MATCHED'&&sample.length<30)sample.push({id:id,status:status,canonicalImageSource:ca.source,publicImageSource:pu?pu.source:'',approvedOriginalMatchesCanonical:!!(st&&ap&&ap.decision==='APPROVED'&&ap.url===st.url&&st.url===ca.url)});
  });
  Object.keys(b.map).forEach(function(id){if(!a.map[id]){counts.EXTRA_PUBLIC_RECORD++;if(sample.length<30)sample.push({id:id,status:'EXTRA_PUBLIC_RECORD'});}});
  const duplicates={canonical:a.duplicates,public:b.duplicates,staging:c.duplicates,approvalLedger:d.duplicates};
  const duplicateCritical=a.duplicates.length||b.duplicates.length||c.duplicates.length;
  const success=counts.MATCHED===ids.length&&counts.EXTRA_PUBLIC_RECORD===0&&!duplicateCritical;
  const out={version:version,function:'AQBAuditCustomerCatalogueImageSync',readOnly:true,writes:0,canonical:ids.length,public:Object.keys(b.map).length,staging:Object.keys(c.map).length,counts:counts,duplicateCanonicalIds:a.duplicates,duplicatePublicIds:b.duplicates,duplicateStagingIds:c.duplicates,sample:sample,success:success,renderingVerified:false,note:'Exact reference consistency only; customer browser rendering requires manual check.'};
  Logger.log('=== AQB CUSTOMER CATALOGUE APPROVED IMAGE SYNC READ ONLY ===');Logger.log(JSON.stringify(out));return out;
}

function AQBGetPublicCataloguePhotoBatch(ids){
  if(!Array.isArray(ids)||ids.length<1||ids.length>12||ids.some(function(id){return !/^AQBCAT\d{3}$/i.test(String(id||''));})||new Set(ids).size!==ids.length)
    throw Error('Public photo batch accepts 1–12 unique canonical CATIDs');
  ids=ids.map(function(id){return String(id).toUpperCase();});
  const ss=AQBGetSpreadsheet(),cs=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),ps=ss.getSheetByName(CONFIG.SHEETS.PUBLIC_CATALOGUE),ssg=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),ls=ss.getSheetByName('AQB Photo Approval Decisions');
  if(!cs||!ps||!ssg||!ls)throw Error('Required source / publication / approval sheets unavailable');
  const sheets=[cs,ps,ssg,ls],headers=sheets.map(AQBBuildHeaderMap);
  function read(row,hm,key){return hm[key]?String(row[hm[key]-1]==null?'':row[hm[key]-1]).trim():'';}
  function rowsById(sheet,hm){const map={};sheet.getDataRange().getValues().slice(1).forEach(function(row){const id=read(row,hm,'Catalogue ID').toUpperCase();if(id){if(map[id])throw Error('Duplicate image authority CATID '+id);map[id]=row;}});return map;}
  const canonical=rowsById(cs,headers[0]),pub=rowsById(ps,headers[1]),stage=rowsById(ssg,headers[2]);
  const latest={};ls.getDataRange().getValues().slice(1).forEach(function(row){const id=read(row,headers[3],'Catalogue ID').toUpperCase();if(id)latest[id]=row;});
  const holds=AQBGetCataloguePhotoHolds()||{},out={};
  ids.forEach(function(id){
    const c=canonical[id],p=pub[id],st=stage[id],a=latest[id];
    const original=st?read(st,headers[2],'Candidate Image URL'):'';
    const permitted=!!(c&&p&&st&&a&&original&&
      read(c,headers[0],'Image URL')===original&&read(p,headers[1],'Image URL')===original&&
      read(st,headers[2],'Candidate Source')==='AQB Studio'&&
      read(a,headers[3],'Decision').toUpperCase()==='APPROVED'&&read(a,headers[3],'Candidate Image URL')===original&&
      (!holds[id]||(read(a,headers[3],'Visual Match Confirmed').toUpperCase()==='TRUE'&&read(a,headers[3],'Legacy Hold').toUpperCase()==='TRUE')));
    if(!permitted){out[id]={status:'NOT_CURRENTLY_PUBLIC_APPROVED'};return;}
    const match=original.match(/(?:[?&]id=|\/file\/d\/)([A-Za-z0-9_-]{15,})/),sourceId=match&&match[1];
    const previewId=read(st,headers[2],'Preview File ID'),previewSource=read(st,headers[2],'Preview Source File ID');
    if(!sourceId||!previewId||previewSource!==sourceId||read(st,headers[2],'Preview Status')!=='PREVIEW_READY'){out[id]={status:'PREVIEW_NOT_CURRENT'};return;}
    try{
      const started=Date.now(),blob=DriveApp.getFileById(previewId).getBlob(),mime=String(blob.getContentType()||'').split(';')[0].toLowerCase(),bytes=blob.getBytes();
      if(bytes.length>600000||!/^image\/(png|jpeg)$/.test(mime)||!AQBPreviewImageDimensions_(bytes,mime)){out[id]={status:'PREVIEW_INVALID'};return;}
      out[id]={status:'READY',dataUrl:'data:'+mime+';base64,'+Utilities.base64Encode(bytes),bytes:bytes.length,ms:Date.now()-started};
    }catch(ex){out[id]={status:'PREVIEW_UNAVAILABLE'};}
  });
  return {version:'V16.21.16.8.33',readOnly:true,results:out};
}

