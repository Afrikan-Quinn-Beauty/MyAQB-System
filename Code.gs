function AQBEnsureMasterListsCatalogueIdColumn() {
  const s = AQBGetSheet(CONFIG.SHEETS.LISTS);
  const headers = s.getRange(1,1,1,Math.max(1,s.getLastColumn())).getValues()[0]
    .map(function(v){ return String(v || '').trim(); });
