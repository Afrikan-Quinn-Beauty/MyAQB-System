  let sharingWarning=''; try{file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);}catch(e){sharingWarning='Google Drive sharing policy prevented automatic public link access. Make the file viewable to anyone with the link for the public Catalogue.';}
  const imageUrl='https://drive.google.com/uc?export=view&id='+file.getId();
  if(cm['Own Photo'])row[cm['Own Photo']-1]=imageUrl;
  if(cm['Image URL'])row[cm['Image URL']-1]=imageUrl;
  if(cm['Image Status'])row[cm['Image Status']-1]='AQB Own Photo';
  if(cm['Image Source'])row[cm['Image Source']-1]='Google Photos → AQB Drive';
  if(cm['Image Source URL'])row[cm['Image Source URL']-1]=file.getUrl();
  if(cm['Image Use Note'])row[cm['Image Use Note']-1]='Selected by '+user.role+' from Google Photos and copied permanently into AQB Drive.';
  if(cm['Image Search Match'])row[cm['Image Search Match']-1]='Google Photos selected image';
  if(cm['Image Content Hash'])row[cm['Image Content Hash']-1]=hash;
  if(cm['Publication Status'])row[cm['Publication Status']-1]='PUBLISHABLE';
  target.sheet.getRange(target.rowNum,1,1,target.sheet.getLastColumn()).setValues([row]); SpreadsheetApp.flush();
  AQBDeleteGooglePhotosPickerSession(sessionId);
