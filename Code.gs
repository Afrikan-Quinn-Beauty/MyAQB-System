function AQBBuildCanonicalMasterServiceRows(){
  const master=AQBGetSheet(CONFIG.SHEETS.LISTS);
  const m=AQBBuildHeaderMap(master);

  ['Item','Category','Service Name','Price','Active','Sort Order'].forEach(function(h){
    if(!m[h])throw new Error('MASTER_LIST_SCHEMA_ERROR: missing required column '+h);
  });

  const n=master.getLastRow();
  if(n<2)return {
    rows:[],
    totalRows:0,
    uniqueRows:0,
    activeRows:0,
    activeUnique:0,
    duplicateGroups:[],
    duplicateRows:0
  };

  const values=master.getRange(2,1,n-1,master.getLastColumn()).getValues();
  const groups={};
  let activeRows=0;

  values.forEach(function(r,i){
    const item=String(r[m['Item']-1]||'').trim();
    if(item!=='Service')return;

    const category=String(r[m['Category']-1]||'').trim();
    const service=String(r[m['Service Name']-1]||'').trim();
    if(!category||!service)return;

    if(AQBCheckPriceValue(category)||AQBCheckPriceValue(service)){
      throw new Error(
        'MASTER_LIST_SCHEMA_GUARD_BLOCKED_SYNC: row '+(i+2)+
        ' resolved Category/Service Name to a price-like value. '+
        'Category="'+category+'", Service Name="'+service+'".'
      );
    }

    const active=AQBNormalizeBool(r[m['Active']-1]);
    if(active)activeRows++;

    const key=AQBGetCanonicalServiceKey(category,service);
    const rec={
      sourceRow:i+2,
      category:category,
      service:service,
      price:r[m['Price']-1],
      salonPrice:m['Salon Price']?r[m['Salon Price']-1]:'',
      active:active,
      sort:Number(r[m['Sort Order']-1])||0,
      trending:m['Trending']?AQBIsMasterListTrending(r[m['Trending']-1]):false,
      categoryId:AQBGetCategoryId(category),
      key:key
    };

    if(!groups[key])groups[key]=[];
    groups[key].push(rec);
  });

  const rows=[],duplicateGroups=[];
  let duplicateRows=0,activeUnique=0;

  Object.keys(groups).forEach(function(key){
    const list=groups[key];
    list.sort(function(a,b){
      return (a.active===b.active?0:(a.active?-1:1)) ||
        a.sort-b.sort ||
        a.sourceRow-b.sourceRow;
    });

    const winner=list[0];
    rows.push(winner);
    if(winner.active)activeUnique++;

    if(list.length>1){
      duplicateRows+=list.length-1;
      duplicateGroups.push({
        key:key,
        winner:winner,
        duplicates:list.slice(1)
      });
    }
  });

  // Preserve Master source order for deterministic new-ID allocation.
  rows.sort(function(a,b){return a.sourceRow-b.sourceRow;});

  return {
    rows:rows,
    totalRows:values.length,
    uniqueRows:rows.length,
    activeRows:activeRows,
    activeUnique:activeUnique,
    duplicateGroups:duplicateGroups,
    duplicateRows:duplicateRows
  };
}

function AQBCanonicalizeCatalogueSheet(){
  const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBEnsureCanonicalChannelFields(cat,AQBEnsureCatalogueMetaColumns()),n=cat.getLastRow();
  if(n<2)return {before:0,after:0,removed:0,duplicateGroups:0};
  const rows=cat.getRange(2,1,n-1,cat.getLastColumn()).getValues();
  const groups={};
  rows.forEach(function(r,i){
    const category=String(r[cm['Category']-1]||'').trim(),service=String(r[cm['Service Name']-1]||'').trim();
    if(!category||!service)return;
    const key=AQBGetCanonicalServiceKey(category,service); if(!groups[key])groups[key]=[];
    groups[key].push({row:r,index:i+2,active:AQBNormalizeBool(r[cm['Active']-1])});
  });
  const deleteRows=[]; let duplicateGroups=0;
  Object.keys(groups).forEach(function(key){
    const list=groups[key]; if(list.length<2)return;
    duplicateGroups++;
    list.sort(function(a,b){return (a.active===b.active?0:(a.active?-1:1))||a.index-b.index;});
    const keeper=list[0];
    // Preserve useful fields from duplicate rows when the canonical row is blank.
    list.slice(1).forEach(function(d){
      ['Catalogue ID','Canonical Service Key','Customer-Facing Name','Customer Search Names','Service Synonyms','Customer Variant Names','Customer Variant Status','Customer Variant Basis','Description','Own Photo','Image URL','Image Source','Image Source URL','Image Search Match','Image Status','Image Use Note','Nairobi Benchmark','Recommended Catalogue Price','Pricing Basis','Video URL','Trend Status','Featured','Publish Channels','Publication Status'].forEach(function(h){
        if(!cm[h])return;
        const a=String(keeper.row[cm[h]-1]||'').trim(), b=String(d.row[cm[h]-1]||'').trim();
        if(!a&&b)keeper.row[cm[h]-1]=d.row[cm[h]-1];
      });
      deleteRows.push(d.index);
    });
    /*
     * AQBCanonicalizeCatalogueSheet_() is NOT an identity generator.
     * It may merge duplicate presentation rows, but it must never
     * invent or re-index a Catalogue ID.
     */
    const keeperId=String(keeper.row[cm['Catalogue ID']-1]||'').trim().toUpperCase();
    if(keeperId && !AQBIsCanonicalCatalogueId(keeperId)){
      throw new Error(
        'CANONICALIZE_IDENTITY_FAULT: Existing Catalogue row ' +
        keeper.index + ' contains non-canonical ID ' + keeperId
      );
    }
    if(!keeperId){
      /*
       * A blank identity is structural corruption, not permission
       * to generate an ID from Category + Service.
       */
      throw new Error(
        'CANONICALIZE_IDENTITY_MISSING: Catalogue row ' +
        keeper.index + ' has no Catalogue ID. Identity repair must be performed ' +
        'by the dedicated Catalogue identity allocator.'
      );
    }
    keeper.row[cm['Catalogue ID']-1]=keeperId;
    cat.getRange(keeper.index,1,1,cat.getLastColumn()).setValues([keeper.row]);
  });
  deleteRows.sort(function(a,b){return b-a;}).forEach(function(r){cat.deleteRow(r);});
  return {before:n-1,after:cat.getLastRow()-1,removed:deleteRows.length,duplicateGroups:duplicateGroups};
}

function AQBGetCanonicalServiceKey(category,service){
  const c=String(category||'').normalize('NFKC').toLowerCase().replace(/[&+]/g,' and ').replace(/[’']/g,'').replace(/[^a-z0-9]+/g,' ').trim().replace(/\s+/g,' ');
  const s=String(service||'').normalize('NFKC').toLowerCase().replace(/[&+]/g,' and ').replace(/[’']/g,'').replace(/[–—−]/g,'-').replace(/[^a-z0-9-]+/g,' ').replace(/\s+/g,' ').trim();
  return c+'|'+s;
}

function AQBEnrichCanonicalCatalogueRecords(options){
  const user=AQBRequireAdmin(),opt=options||{},cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBEnsureCanonicalChannelFields(cat,AQBBuildHeaderMap(cat)),n=cat.getLastRow();
  if(n<2)return {success:true,processed:0,recommendations:0};
  const rows=cat.getRange(2,1,n-1,cat.getLastColumn()).getValues();let processed=0,recommendations=0;
  rows.forEach(function(r){
    const category=String(r[cm['Category']-1]||'').trim(),name=String(r[cm['Service Name']-1]||'').trim();if(!category||!name)return;
    const key=AQBGetCanonicalServiceKey(category,name);
    r[cm['Canonical Service Key']-1]=key;
    if(cm['Subcategory']&&!String(r[cm['Subcategory']-1]||'').trim()){
      const low=name.toLowerCase();let sub=category;
      if(/sisterlocks/.test(low))sub='Sisterlocks';
      else if(/microloc/.test(low))sub='Microlocs';
      else if(/weav/.test(low)||/sew.?in/.test(low))sub='Weaving';
      else if(/braid|cornrow|twist/.test(low))sub='Braiding & Twists';
      else if(/mizani|relax|treatment|colour|color/.test(low))sub='Hair Care & Treatment';
      r[cm['Subcategory']-1]=sub;
    }
    if(cm['Customer-Facing Name']&&!String(r[cm['Customer-Facing Name']-1]||'').trim())r[cm['Customer-Facing Name']-1]=name;
    if(cm['Customer Search Names']&&!String(r[cm['Customer Search Names']-1]||'').trim())r[cm['Customer Search Names']-1]=name;
    if(cm['Service Synonyms']&&!String(r[cm['Service Synonyms']-1]||'').trim())r[cm['Service Synonyms']-1]=AQBGetCustomerLanguageFallbacks(category,name).join(', ');
    if(cm['Publish Channels'])r[cm['Publish Channels']-1]=AQBNormalizePublishChannels(r[cm['Publish Channels']-1])||AQBGetDefaultPublishChannels();
    processed++;
  });
  cat.getRange(2,1,rows.length,cat.getLastColumn()).setValues(rows);
  try{AQBLogAudit('ENRICH_CANONICAL_CHANNEL_CATALOGUE','Catalogue','CHANNELS',user.email+' enriched '+processed+' canonical service records with shared customer-language fields and unified Publish Channels.');}catch(ignore){}
  return {success:true,processed:processed,recommendations:recommendations,publishChannels:AQBGetDefaultPublishChannels(),message:'Canonical Catalogue prepared for shared WEB / META / TIKTOK / PINTEREST channel architecture.'};
}

function AQBGetCatalogueIntegrityReport(){
  const user=AQBRequireAdmin();
  const master=AQBBuildCanonicalMasterServiceRows();
  const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBEnsureCatalogueMetaColumns(),n=cat.getLastRow();
  const rows=n>=2?cat.getRange(2,1,n-1,cat.getLastColumn()).getValues():[];
  const groups={}, activeRows=[], eligible=[]; let activeCatalogue=0, duplicateRows=0, missingImage=0, invalidImage=0, missingPrice=0;
  rows.forEach(function(r,i){
    const category=String(r[cm['Category']-1]||'').trim(),service=String(r[cm['Service Name']-1]||'').trim(); if(!category||!service)return;
    const key=AQBNormalizeServiceKey(category,service); if(!groups[key])groups[key]=[]; groups[key].push(i+2);
    if(!AQBNormalizeBool(r[cm['Active']-1]))return;
    activeCatalogue++;
    const image=String((cm['Own Photo']?r[cm['Own Photo']-1]:'')||(cm['Image URL']?r[cm['Image URL']-1]:'' )||'').trim();
    const oneBased={}; Object.keys(cm).forEach(function(k){oneBased[k]=cm[k];});
    const price=AQBNormalizePriceText(r[cm['Price']-1]).amount;
    if(!image)missingImage++;
    else if(!AQBIsCataloguePublicImageQualified(r,oneBased))invalidImage++;
    if(!(price>0))missingPrice++;
    if(image&&AQBIsCataloguePublicImageQualified(r,oneBased)&&price>0)eligible.push(key);
    activeRows.push(key);
  });
  Object.keys(groups).forEach(function(k){if(groups[k].length>1)duplicateRows+=groups[k].length-1;});
  const activeSet={};activeRows.forEach(k=>activeSet[k]=true);
  const masterSet={};master.rows.forEach(x=>{if(x.active)masterSet[AQBNormalizeServiceKey(x.category,x.service)]=true;});
  const missingInCatalogue=Object.keys(masterSet).filter(k=>!activeSet[k]);
  const extraInCatalogue=Object.keys(activeSet).filter(k=>!masterSet[k]);
  const report={generatedAt:new Date().toISOString(),master:{totalRows:master.totalRows,uniqueServiceRows:master.uniqueRows,activeRows:master.activeRows,activeUnique:master.activeUnique,duplicateRows:master.duplicateRows,duplicateGroups:master.duplicateGroups.map(function(g){return {key:g.key,winnerRow:g.winner.sourceRow,duplicateRows:g.duplicates.map(function(x){return x.sourceRow;})};})},catalogue:{totalRows:rows.length,activeRows:activeCatalogue,activeUnique:Object.keys(activeSet).length,duplicateRows:duplicateRows,missingInMaster:extraInCatalogue.length,missingActiveServices:missingInCatalogue.length,missingImage:missingImage,invalidImage:invalidImage,missingPrice:missingPrice,eligibleForChannels:eligible.length},parity:{masterActiveUnique:master.activeUnique,catalogueActiveUnique:Object.keys(activeSet).length,missingInCatalogue:missingInCatalogue,extraInCatalogue:extraInCatalogue},tiktok:{eligible:eligible.length,blocked:activeCatalogue-eligible.length}};
  try{AQBLogAudit('CATALOGUE_INTEGRITY_REPORT','Catalogue','INTEGRITY',user.email+' generated canonical catalogue integrity report. Master active unique: '+master.activeUnique+'; Catalogue active unique: '+Object.keys(activeSet).length+'; channel-eligible: '+eligible.length+'.');}catch(ignore){}
  return report;
}

function AQBCanonicalizeCatalogue(){
  const user=AQBRequireAdmin();
