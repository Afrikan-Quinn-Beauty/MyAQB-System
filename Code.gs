    mutations:['ServiceVariants reference sheet','Customer Variant Names','Customer Variant Status','Customer Variant Basis'],
    protected:'Service Name, Category, Description, Price, Photo Brief, Catalogue ID, photos, approval/publication, channel and trend fields unchanged',
    reviewItems:reviewItems,mediumItems:mediumItems,samples:samples
  };
  try{AQBLogAudit('BETA_C4722_BUILD_ID_VARIANTS','Catalogue','CUSTOMER-VARIANTS',user.email+' built ID-isolated variants for '+processed+' services: HIGH '+high+', MEDIUM '+medium+', REVIEW '+review+', manual preserved '+preservedManual+'. ServiceVariants rows '+db.rows+'.');}catch(ignore){}
  const summary=Object.assign({},result);delete summary.reviewItems;delete summary.mediumItems;delete summary.samples;console.log(JSON.stringify(summary));return result;
