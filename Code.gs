function AQBGetGeminiStatus(){
  const props=PropertiesService.getScriptProperties(),cache=CacheService.getScriptCache();
  const key=String(props.getProperty(CONFIG.GEMINI.API_KEY_PROPERTY)||'').trim();
  const model=String(props.getProperty(CONFIG.GEMINI.MODEL_PROPERTY)||CONFIG.GEMINI.DEFAULT_MODEL).trim();
  const state=String(cache.get('AQB_GEMINI_STATE')||'').trim()||(!key?'NOT_CONFIGURED':'READY');
  return {configured:!!key,model:model,provider:'Google Gemini',state:state,lastError:String(cache.get('AQB_GEMINI_ERROR')||'').trim()};
}

function AQBGetGeminiApiKey(){
  const key=String(PropertiesService.getScriptProperties().getProperty(CONFIG.GEMINI.API_KEY_PROPERTY)||'').trim();
  if(!key)throw new Error('Gemini API key is not configured. Add '+CONFIG.GEMINI.API_KEY_PROPERTY+' to Script Properties.');
  return key;
}

function AQBCallGemini(prompt,systemInstruction){
  const key=AQBGetGeminiApiKey();
  const props=PropertiesService.getScriptProperties();
  const model=String(props.getProperty(CONFIG.GEMINI.MODEL_PROPERTY)||CONFIG.GEMINI.DEFAULT_MODEL).trim();
  const url='https://generativelanguage.googleapis.com/v1beta/models/'+encodeURIComponent(model)+':generateContent';
  const payload={contents:[{role:'user',parts:[{text:String(prompt||'')}]}]};
  if(systemInstruction)payload.systemInstruction={parts:[{text:String(systemInstruction)}]};
  payload.generationConfig={temperature:0.2,maxOutputTokens:1200,responseMimeType:'application/json'};
  let lastStatus=0,lastBody='';
  for(let attempt=0;attempt<3;attempt++){
    const res=UrlFetchApp.fetch(url,{method:'post',muteHttpExceptions:true,contentType:'application/json',headers:{'x-goog-api-key':key},payload:JSON.stringify(payload)});
    const status=res.getResponseCode(),body=res.getContentText()||'';lastStatus=status;lastBody=body;
    if(status>=200&&status<300){
      const data=JSON.parse(body),parts=[];
      ((data.candidates||[])[0]||{}).content&&Array.isArray(data.candidates[0].content.parts)&&data.candidates[0].content.parts.forEach(function(p){if(p&&typeof p.text==='string')parts.push(p.text);});
      const text=parts.join('').trim();
      if(!text)throw new Error('Gemini returned no text.');
      const gc=CacheService.getScriptCache();gc.put('AQB_GEMINI_LAST_STATUS','OK',300);gc.put('AQB_GEMINI_STATE','READY',21600);gc.remove('AQB_GEMINI_ERROR');
      return text;
    }
    if(status!==429&&status!==503)break;
    if(attempt<2)Utilities.sleep(500*Math.pow(2,attempt));
  }
  const gc=CacheService.getScriptCache();gc.put('AQB_GEMINI_LAST_STATUS',String(lastStatus),300);
  const state=(lastStatus===429||lastStatus===503)?'TEMPORARILY_UNAVAILABLE':'ERROR';
  const msg=(lastStatus===429||lastStatus===503)?'Gemini temporarily unavailable. AQB fallback is active.':'Gemini request failed. AQB fallback is active.';
  gc.put('AQB_GEMINI_STATE',state,21600);gc.put('AQB_GEMINI_ERROR',msg,21600);
  throw new Error(msg);
}

function AQBParseGeminiJson(text){
  let s=String(text||'').trim();const fence=s.match(/```(?:json)?\s*([\s\S]*?)\s*```/i);if(fence)s=fence[1].trim();const first=s.indexOf('{'),last=s.lastIndexOf('}');if(first>=0&&last>first)s=s.slice(first,last+1);
