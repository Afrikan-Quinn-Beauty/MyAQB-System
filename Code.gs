function AQBBuildChannelCatalogueRows(channel){
  channel=String(channel||'').trim().toUpperCase();
  const s=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),n=s.getLastRow();
  if(n<2)return {rows:[],counts:{total:0,active:0,eligible:0,blocked:0,channelExcluded:0,duplicates:0}};
  let cm=AQBBuildHeaderMap(s);cm=AQBEnsureCatalogueUnifiedChannelFields(s,cm);
  const values=s.getRange(2,1,n-1,s.getLastColumn()).getValues(),seen={},rows=[];
  let active=0,blocked=0,channelExcluded=0,duplicates=0;
  values.forEach(function(r){
    if(!AQBNormalizeBool(r[cm['Active']-1]))return;
    active++;
    const id=String(r[cm['Catalogue ID']-1]||'').trim(),title=String(r[cm['Service Name']-1]||'').trim();
    if(!id||!title){blocked++;return;}
    if(seen[id]){duplicates++;return;}
    seen[id]=true;
    if(!AQBHasCatalogueChannel(r,cm,channel)){channelExcluded++;return;}
    const display=cm['Display in Catalogue']?String(r[cm['Display in Catalogue']-1]||'yes').trim().toLowerCase():'yes';
    const price=AQBNormalizePriceText(r[cm['Price']-1]).amount;
    const isStudio=!!cm['Image Source']&&!!cm['Photo Qualification Status']&&String(r[cm['Image Source']-1]||'').trim().toUpperCase()==='AQB STUDIO'&&String(r[cm['Photo Qualification Status']-1]||'').trim().toUpperCase()==='QUALIFIED';
    const image=isStudio?String(r[cm['Image URL']-1]||'').trim():(String(r[cm['Own Photo']-1]||'').trim()||String(r[cm['Image URL']-1]||'').trim());
    if(display==='no'||display==='false'||!image||!AQBIsCataloguePublicImageQualified(r,cm)||!(price>0)){blocked++;return;}
    const category=String(r[cm['Category']-1]||'Beauty Services').trim();
    const desc=String(r[cm['Description']-1]||'').trim();
    const booking=String(r[cm['Booking Link']-1]||'').trim()||String(ScriptApp.getService().getUrl()||'').replace(/\/$/,'')+'?page=booking&service='+encodeURIComponent(title);
    const video=cm['Video URL']?String(r[cm['Video URL']-1]||'').trim():'';
    const trend=cm['Trend Status']?String(r[cm['Trend Status']-1]||'').trim().toUpperCase():'';
    const featured=cm['Featured']?String(r[cm['Featured']-1]||'').trim().toUpperCase():'';
    rows.push({id:id,title:title,description:AQBGetChannelDescription(desc),image:image,link:booking,price:price,category:category,video:video,trend:trend,featured:featured,row:r});
  });
  return {rows:rows,counts:{total:values.length,active:active,eligible:rows.length,blocked:blocked,channelExcluded:channelExcluded,duplicates:duplicates}};
}

function AQBEnsureCanonicalChannelFields(cat,cm){
