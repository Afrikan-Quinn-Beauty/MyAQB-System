function AQBSendWhatsAppText(phone,text){
  const w=AQBGetWhatsAppSettings();if(!w.enabled||!w.phoneNumberId||!w.accessToken||!w.graphApiVersion)throw new Error('WhatsApp credentials are not fully configured.');const url='https://graph.facebook.com/'+encodeURIComponent(w.graphApiVersion)+'/'+encodeURIComponent(w.phoneNumberId)+'/messages';const payload={messaging_product:'whatsapp',to:AQBNormalizeWhatsAppIncomingNumber(phone),type:'text',text:{preview_url:true,body:String(text||'').slice(0,4000)}};const res=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+w.accessToken},payload:JSON.stringify(payload),muteHttpExceptions:true});const code=res.getResponseCode(),body=res.getContentText();if(code<200||code>=300)throw new Error('WhatsApp text reply failed ('+code+'): '+body);return JSON.parse(body||'{}');
}

function AQBHandleWhatsAppIncoming(message){
  const messageId=String(message&&message.id||'').trim(),phone=String(message&&message.from||'').trim(),type=String(message&&message.type||'').trim();
  const text=type==='text'?String(message.text&&message.text.body||'').trim():'';
  if(!messageId||!phone||AQBIsWhatsAppMessageProcessed(messageId))return;
  let reply='',customer=AQBFindCustomerByWhatsAppNumberPublic(phone),conv=AQBGetWhatsAppConversation(phone),state=conv.state||{},intent=AQBParseWhatsAppIntent(text),matched=AQBMatchWhatsAppService(text),service=matched?matched.name:(state.service||'');
  try{
    const handoff=AQBParseAcquisitionHandoff(text);
    if(handoff){
      const canonical=AQBGetPublicServiceCatalog(true).find(function(x){return String(x.catalogueId||'').toUpperCase()===handoff.catalogueId;});
      if(!canonical){
        reply='I could not find that service in the current AQB Catalogue. Please choose it again from our Catalogue.';
      }else{
        state.service=canonical.service;
        state.catalogueId=handoff.catalogueId;
        state.acquisitionSource=handoff.source;
        state.acquisitionCampaign=handoff.campaign;
        state.pending='date';
        service=canonical.service;
        intent='BOOKING';
        AQBRecordAcquisitionEnquiry({messageId:messageId,phone:phone,customerId:customer?customer.customerId:'',catalogueId:handoff.catalogueId,source:handoff.source,campaign:handoff.campaign});
        reply='👑 Welcome to My AQB! 💛\n\nYou selected '+canonical.service+'. '+(canonical.price?'Current listed price: '+canonical.price+'. ':'')+'\n\nAQB Comes to You is our current booking arrangement. What date would you prefer?';
      }
    }else if(type!=='text'){
      reply='Hi 💛 We can help with services, prices, availability and bookings. Please send a message such as “How much are starter locs?” or “Can I book tomorrow?”';
    } else if(intent==='GREETING'){
      reply='Hello 💛 Welcome to Afrikan Quinn Beauty Centre. How can we help with your hair today? You can ask about a service, price, availability, location, or booking.';
    } else if(intent==='SERVICES'){
      const services=AQBGetPublicServiceCatalog(false).slice(0,12).map(x=>x.service),trends=AQBGetTrendCatalogue(true).slice(0,8).map(x=>x.styleName);
      reply='Absolutely 💛 Here are some of our services:\n\n'+services.map(x=>'• '+x).join('\n')+(trends.length?'\n\n🔥 Trending Now\n'+trends.map(x=>'• '+x).join('\n'):'')+'\n\nTell me the style you are interested in and I can help with the price or booking.';
    } else if(intent==='LOCATION'){
      const b=AQBGetPublicWhatsAppBusinessInfo(); reply=b.location?'We are located at '+b.location+'. 💛':'I can help with our location 💛, but the AQB location is not currently configured in the public business information.';
    } else if(intent==='HOME_SERVICE'){
      const b=AQBGetPublicWhatsAppBusinessInfo();reply=b.homeService?'Yes 💛 AQB has home service configured. Tell me your area and the service you need, and I will help with the next step.':'I do not have confirmed AQB home-service information configured right now, so I do not want to promise it incorrectly. Tell me your area and the service you need, and I can pass the enquiry to the AQB team.';
    } else if(intent==='RETIE'&&!service){
      service='Sisterlocks Retightening';state.service=service;
      if(customer){const next=customer.nextRetieDate instanceof Date?AQBFormatDateForClient(customer.nextRetieDate):String(customer.nextRetieDate||'');reply=next?'Welcome back, '+(customer.firstName||customer.customerName)+' 💛 Your next Sisterlocks retie date on record is '+next+'. Would you like me to check the next available appointment?':'Welcome back 💛 I found your AQB customer record. Tell me the day you would like your Sisterlocks retied and I will check availability.';}
      else {reply='I can help with a Sisterlocks retightening 💛. What name should I put on the booking?';state.pending='name';}
    } else if(intent==='PRICE'||matched){
      if(!matched){reply='Of course 💛 Which service or style would you like the price for?';state.pending='service';}
      else {const price=matched.price||AQBFindServicePricing(matched.name).price;service=matched.name;state.service=service;reply=price?'💛 '+service+' starts from '+price+'. If you would like to book, tell me the day you prefer.':'I can help with '+service+' 💛. I do not have a confirmed AQB price for it yet, so I would rather not guess. Would you like me to help with availability instead?';}
    } else {
      // Booking flow is stateful: service -> date -> name (new customer) -> time -> booking.
      if(matched)state.service=service;
      if(state.pending==='service'&&!matched){state.service=text;service=text;state.pending='';}
      if(state.pending==='name'&&!AQBParseWhatsAppDate(text)&&AQBParseWhatsAppTime(text)===null){state.name=AQBNormalizeWhatsAppText(text);state.pending='';}
      service=matched?matched.name:(state.service||'');
      if(intent==='BOOKING'||service){
        if(!service){reply='Absolutely 💛 What service or style would you like to book?';state.pending='service';}
        else {
          state.service=service;let date=AQBParseWhatsAppDate(text);if(!date&&state.date)date=new Date(state.date);let tm=AQBParseWhatsAppTime(text);if(tm===null&&state.time!==undefined)tm=Number(state.time);
          if(!date){reply='Sure 💛 What day would you like? You can say “tomorrow” or give a date such as 20 September.';state.pending='date';}
          else if(date.getDay()===0){reply='Sunday is by special appointment. Please tell me if you would like a Sunday appointment and I will pass it to the AQB team.';state.pending='date';}
          else if(!customer&&!state.name){state.date=AQBFormatDateForClient(date);if(tm!==null)state.time=tm;reply='Great 💛 What name should I put on the booking?';state.pending='name';}
          else if(tm===null){const slots=AQBGetWhatsAppAvailableSlots(date,service).slice(0,5);state.date=AQBFormatDateForClient(date);if(!slots.length)reply='I’m sorry 💛 I could not find an available slot for '+state.date+'. Would you like the next available day instead?';else{reply='For '+service+' on '+state.date+', I have:\n\n'+slots.map((x,i)=>(i+1)+'. '+x.start+' hrs – '+x.end+' hrs').join('\n')+'\n\nReply with the time you prefer.';state.pending='time';}}
          else {
            const slots=AQBGetWhatsAppAvailableSlots(date,service),startText=Utilities.formatString('%02d:%02d',Math.floor(tm/60),tm%60),chosen=slots.find(x=>x.start===startText);
            if(!chosen){reply='That time is not available 💛. I can offer: '+slots.slice(0,5).map(x=>x.start+' hrs – '+x.end+' hrs').join(', ');state.pending='time';}
            else {const result=AQBBookWhatsAppAppointment(phone,customer?customer.customerName:state.name,service,date,tm);reply='Booked 💛 Your '+service+' appointment is set for '+result.appointment.appointmentDate+' at '+result.appointment.startTime+' hrs – '+result.appointment.endTime+' hrs. We have also added it to the AQB appointment calendar. Your appointment is currently BOOKED and pending confirmation.';state={};}
          }
        }
      } else {
        reply='I’m here to help 💛 You can ask me about AQB services, prices, availability, bookings, our location, or home service.';
      }
    }
    AQBSaveWhatsAppConversation(phone,customer,state,intent,state.pending||'');
    AQBSendWhatsAppText(phone,reply);
    AQBLogWhatsAppMessage(messageId,phone,'IN',type==='text'?'TEXT':'NON_TEXT',text,customer?customer.customerId:'',intent,service,'SENT',reply,'');
  }catch(err){
    AQBLogWhatsAppMessage(messageId,phone,'IN',type==='text'?'TEXT':'NON_TEXT',text,customer?customer.customerId:'',intent,service,'FAILED','',err.message);
    try{AQBSendWhatsAppText(phone,'I’m sorry 💛 I could not complete that request just now. Please send the message again or ask for a team member to help.');}catch(ignore){}
  }
}

