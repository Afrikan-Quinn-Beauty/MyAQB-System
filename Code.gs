  const actor=AQBRequireAdmin();
  const names=['CUSTOMERS','LISTS','CATALOGUE','APPOINTMENTS','PAYMENTS','CASH_FLOW'];
  const results=[];
  names.forEach(function(key){
    const configured=CONFIG.SHEETS[key];
    if(!configured){results.push({key:key,ok:false,reason:'SHEET_KEY_NOT_CONFIGURED'});return;}
    try{
      const sheet=AQBGetSheet(configured);
      if(!sheet){results.push({key:key,ok:false,reason:'SHEET_NOT_FOUND'});return;}
      results.push({key:key,ok:true,columns:sheet.getLastColumn(),records:Math.max(0,sheet.getLastRow()-1)});
    }catch(err){results.push({key:key,ok:false,reason:'SHEET_READ_ERROR'});}
  });
  return {version:'V17.0.7.4',mode:'READ_ONLY',
    implementedCheckpointsVerified:0,passedCheckpointsVerified:0,
    integrationsModified:false,results:results,
    note:'Structural preflight only. Never interpret as a successful journey test.'};
}


