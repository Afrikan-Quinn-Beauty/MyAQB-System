function AQBProcessWhatsAppWebhook(body){
  const entries=Array.isArray(body.entry)?body.entry:[];
  entries.forEach(function(entry){
    const changes=Array.isArray(entry.changes)?entry.changes:[];
    changes.forEach(function(change){
      const value=change&&change.value?change.value:{};
      const messages=Array.isArray(value.messages)?value.messages:[];
      messages.forEach(function(message){AQBHandleWhatsAppIncoming(message);});
      const statuses=Array.isArray(value.statuses)?value.statuses:[];
      statuses.forEach(function(status){
        try{AQBUpdateWhatsAppDeliveryStatus(status);}catch(ignoreStatus){}
      });
    });
  });
}

