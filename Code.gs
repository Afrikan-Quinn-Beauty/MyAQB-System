function AQBGetAdminFinancialDashboard(){
  AQBRequireAdmin();
  const payments=AQBGetRowsAsObjects(CONFIG.SHEETS.PAYMENTS), cash=AQBGetRowsAsObjects(CONFIG.SHEETS.CASH_FLOW);
  const now=new Date(),todayStart=new Date(now),todayEnd=AQBEndOfDay(now),weekStart=AQBStartOfWeek(now),monthStart=AQBStartOfMonth(now);
  todayStart.setHours(0,0,0,0);
  let today=0,week=0,month=0,total=0,deposits=0,parts=0;
  payments.forEach(function(r){
    if(String(r['Payment Status']||'')==='Cancelled')return;
    const d=r['Date'] instanceof Date?r['Date']:new Date(r['Date']);
    const a=Number(r['Amount']||0); if(!isFinite(a))return;
    total+=a; if(AQBIsDateInRange(d,todayStart,todayEnd))today+=a; if(AQBIsDateInRange(d,weekStart,todayEnd))week+=a; if(AQBIsDateInRange(d,monthStart,todayEnd))month+=a;
    if(String(r['Payment Type']||'')==='Deposit')deposits+=a; if(String(r['Payment Type']||'')==='Part Payment')parts+=a;
  });
  // Completed services that have no separate Payment record use the stored
  // appointment price as their revenue. This backfills today's completed work
  // without double-counting appointments that already have a payment record.
  today+=AQBGetCompletedAppointmentRevenue(todayStart,todayEnd);
  week+=AQBGetCompletedAppointmentRevenue(weekStart,todayEnd);
  month+=AQBGetCompletedAppointmentRevenue(monthStart,todayEnd);
  total+=AQBGetCompletedAppointmentRevenue(new Date(2000,0,1),todayEnd);
  let expenses=0;
  cash.forEach(function(r){if(String(r['Transaction Type']||'')==='Expense'){const d=r['Date'] instanceof Date?r['Date']:new Date(r['Date']);if(AQBIsDateInRange(d,new Date(2000,0,1),todayEnd))expenses+=Number(r['Amount']||0);}});
  const outstanding=AQBGetOutstandingPayments(),recent=AQBGetPaymentHistory().slice(0,10);
  return {todayIncome:today,thisWeekIncome:week,thisMonthIncome:month,totalPaid:total,deposits,partPayments:parts,outstanding,expenses,balance:total-expenses,recentTransactions:recent};
}

