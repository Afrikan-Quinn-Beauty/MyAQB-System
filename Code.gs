function AQBSendTikTokCatalogueRequest(method,path,payload){
  const c=AQBGetTikTokCatalogueConfig();
  if(!c.configured)throw new Error('Configure the TikTok Business Center ID, Catalogue ID, and API access token first.');
  const url='https://business-api.tiktok.com/open_api/'+c.apiVersion+path;
  const options={method:method||'get',muteHttpExceptions:true,headers:{'Access-Token':c.accessToken,'Content-Type':'application/json'}};
  if(payload!==undefined)options.payload=JSON.stringify(payload);
  const res=UrlFetchApp.fetch(url,options),code=res.getResponseCode(),body=res.getContentText()||'';
  let data={};try{data=body?JSON.parse(body):{};}catch(e){data={raw:body};}
  if(code<200||code>=300){const msg=data&&data.message?data.message:(data&&data.error&&data.error.message?data.error.message:body);throw new Error('TikTok API HTTP '+code+': '+msg);}
  if(data&&data.code!==undefined&&String(data.code)!=='0'){throw new Error('TikTok API error '+String(data.code)+': '+String(data.message||data.msg||body));}
  return data;
}

