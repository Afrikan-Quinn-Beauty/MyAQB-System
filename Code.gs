function AQBArchiveTrend(payload){
  // Single existing management action for Inbox dismiss/archive and approved-trend archival.
  const u=AQBRequireCataloguePhotoManager();
  payload=payload||{};
  const trendId=String(payload.trendId||'').trim();
  const action=String(payload.action||'ARCHIVE').trim().toUpperCase();
  if(!trendId)throw new Error('Trend ID is required.');
  if(!['ARCHIVE','DELETE','RESTORE','REJECT'].includes(action))throw new Error('Unsupported trend action.');
  const inbox=AQBGetSheet('AQB AI Signals'),im=AQBBuildHeaderMap(inbox);
  const inRows=inbox.getLastRow()>=2?inbox.getRange(2,1,inbox.getLastRow()-1,inbox.getLastColumn()).getValues():[];
  for(let i=0;i<inRows.length;i++){
    const r=inRows[i];
    if(String(r[im['Record Type']-1]||'').trim().toUpperCase()!=='TREND_INBOX'||String(r[im['Trend ID']-1]||'').trim()!==trendId)continue;
    const status=String(r[im['Status']-1]||'').trim().toUpperCase();
    if(status==='APPROVED')throw new Error('Approved trends cannot be removed from the Inbox. Archive the approved Catalogue record separately.');
    if(action==='RESTORE'){
      if(status!=='DELETED'&&status!=='ARCHIVED'&&status!=='REJECTED')throw new Error('Only dismissed Inbox suggestions can be restored.');
      const now=new Date();r[im['Status']-1]='PENDING';
      if(im['Trend Status'])r[im['Trend Status']-1]='PENDING';
      if(im['Active'])r[im['Active']-1]='NO';
      if(im['Featured'])r[im['Featured']-1]='NO';
      if(im['Updated At'])r[im['Updated At']-1]=now;
      if(im['Review Notes'])r[im['Review Notes']-1]=(String(r[im['Review Notes']-1]||'').trim()+'\nRESTORED for re-review by '+String(u.email||u.role||'management')+' at '+now.toISOString()).trim();
      inbox.getRange(i+2,1,1,inbox.getLastColumn()).setValues([r]);
      AQBLogAudit('TREND_INBOX_RESTORED','Trend',trendId,'Pending re-review; approval validation still required.');
      return {success:true,trendId:trendId,status:'PENDING',restored:true};
    }
    if(status==='DELETED'||status==='ARCHIVED'||status==='REJECTED')return {success:true,trendId:trendId,status:status,unchanged:true};
    // DELETE is a recoverable soft-delete, not physical removal of source evidence.
    const next=action==='DELETE'?'DELETED':action==='REJECT'?'REJECTED':'ARCHIVED',now=new Date();
    r[im['Status']-1]=next;
    if(im['Trend Status'])r[im['Trend Status']-1]=next;
    if(im['Active'])r[im['Active']-1]='NO';
    if(im['Featured'])r[im['Featured']-1]='NO';
    if(im['Reviewed At'])r[im['Reviewed At']-1]=now;
    if(im['Updated At'])r[im['Updated At']-1]=now;
    if(im['Review Notes'])r[im['Review Notes']-1]=(String(r[im['Review Notes']-1]||'').trim()+'\n'+next+' by '+String(u.email||u.role||'management')+' at '+now.toISOString()).trim();
    inbox.getRange(i+2,1,1,inbox.getLastColumn()).setValues([r]);
    AQBLogAudit('TREND_INBOX_'+next,'Trend',trendId,'Inbox record '+next+' by '+String(u.email||'authorized manager'));
    return {success:true,trendId:trendId,status:next,preserved:true};
  }
  if(action==='RESTORE')throw new Error('Only dismissed Inbox suggestions can be restored.');
  if(action==='DELETE')throw new Error('Only unapproved Inbox suggestions can be deleted.');
  const s=AQBGetSheet('AQB AI Trends'),m=AQBBuildHeaderMap(s),n=s.getLastRow(),rows=n>=2?s.getRange(2,1,n-1,s.getLastColumn()).getValues():[];
  for(let i=0;i<rows.length;i++){
    if(String(rows[i][m['Record Type']-1]||'').trim().toUpperCase()!=='TREND_CATALOGUE'||String(rows[i][m['Trend ID']-1]||'').trim()!==trendId)continue;
    const r=rows[i];r[m['Status']-1]='ARCHIVED';r[m['Trend Status']-1]='ARCHIVED';r[m['Active']-1]='No';r[m['Featured']-1]='NO';r[m['Updated At']-1]=new Date();
    s.getRange(i+2,1,1,s.getLastColumn()).setValues([r]);
    return {success:true,trendId:trendId,status:'ARCHIVED'};
  }
  throw new Error('Trend not found.');
}

function AQBFinalizeExpiredAITrends(options){
  // V16.21.15.4.3.21: approval-anchored, non-destructive 7-day expiry.
  // Run AQBFinalizeExpiredAITrends({dryRun:true}) to preview; the existing
  // AQBRunDailyMaintenance() uses commit mode to enforce normal retirement.
  // V16.21.15.5: historical-promotions reconciliation is explicitly invoked,
  // never performed implicitly by daily maintenance. Records are retired from
  // active Trending, without destroying their evidence or audit trail.
  if (options && options.mode === 'reconcilePromoted') {
    AQBRequireAdmin();
    const preview = options.dryRun !== false;
    if (!preview && options.confirm !== 'RECONCILE_PROMOTED_TRENDS')
      throw new Error('PROMOTION_RECONCILIATION_CONFIRMATION_REQUIRED');
    const trendSheet=AQBGetSheet('AQB AI Trends'),tm=AQBBuildHeaderMap(trendSheet);
    const masterServices=AQBGetMasterServiceRows().filter(function(x){return x.active;});
    const masterKeys={};masterServices.forEach(function(x){masterKeys[AQBNormalizeServiceKey(x.category,x.service)]=true;});
    const catalogue=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(catalogue),cn=catalogue.getLastRow();
    const catalogueByKey={};
    if (!cm['Service Name'] || !cm['Category'] || !cm['Catalogue ID'])
      throw new Error('PROMOTION_RECONCILIATION_CATALOGUE_SCHEMA_MISSING');
    if (cn>1)catalogue.getRange(2,1,cn-1,catalogue.getLastColumn()).getValues().forEach(function(r){
      const id=String(r[cm['Catalogue ID']-1]||'').trim();
      if (/^AQBCAT\d{3,}$/.test(id))catalogueByKey[AQBNormalizeServiceKey(r[cm['Category']-1],r[cm['Service Name']-1])]=id;
    });
    const required=['Record Type','Style Name','Category','Status','Trend Status','Active','Featured','Catalogue ID'];
    const missing=required.filter(function(k){return !tm[k];});
    if(missing.length)throw new Error('PROMOTION_RECONCILIATION_SCHEMA_MISSING: '+missing.join(', '));
    const total=trendSheet.getLastRow(),out={mode:'reconcilePromoted',dryRun:preview,checked:0,matched:0,unmatched:0,alreadyExited:0,retired:0,writes:0,records:[]};
    if(total<2)return out;
    const rows=trendSheet.getRange(2,1,total-1,trendSheet.getLastColumn()).getValues();
    const pending=[];
    rows.forEach(function(r,i){
      if(String(r[tm['Record Type']-1]||'').trim().toUpperCase()!=='TREND_CATALOGUE')return;
      out.checked++;
      const status=String(r[tm['Trend Status']-1]||'').trim().toUpperCase();
      const id=tm['Trend ID']?String(r[tm['Trend ID']-1]||''):'ROW-'+(i+2);
      if(['PROMOTED','EXITED','RETIRED'].includes(status)){out.alreadyExited++;return;}
      const category=String(r[tm['Category']-1]||'').trim();
      const candidates=[tm['Service Name']?r[tm['Service Name']-1]:'',r[tm['Style Name']-1]].filter(Boolean);
      let canonical='';
      for(const name of candidates){const key=AQBNormalizeServiceKey(category,name);if(masterKeys[key]&&catalogueByKey[key]){canonical=catalogueByKey[key];break;}}
      // V16.21.15.5.1: narrow historical alias for the single legacy bridal trend.
      // Accept only when BOTH authoritative inventories agree on AQBCAT055.
      if(!canonical && id==='AQB-TREND-CAT-028' &&
         AQBNormalizeServiceKey(category, String(r[tm['Style Name']-1]||''))===AQBNormalizeServiceKey('Bridal & Special Occasions','Bridal Natural Hair Trial') &&
         (!tm['Service Name'] || !String(r[tm['Service Name']-1]||'').trim() ||
          AQBNormalizeServiceKey(category,r[tm['Service Name']-1])===AQBNormalizeServiceKey('Bridal & Special Occasions','Bridal Natural Hair Trial')) &&
         (!String(r[tm['Catalogue ID']-1]||'').trim() ||
          String(r[tm['Catalogue ID']-1]).trim().toUpperCase()==='AQBCAT055')){
        const canonicalKey=AQBNormalizeServiceKey('Bridal & Special Occasions','Bride Natural Hair Trial');
        if(masterKeys[canonicalKey] && catalogueByKey[canonicalKey]==='AQBCAT055')canonical='AQBCAT055';
      }
      if(!canonical){out.unmatched++;out.records.push({trendId:id,issue:'NO_EXACT_CANONICAL_MASTER_AND_CATALOGUE_MATCH',category:category,style:String(r[tm['Style Name']-1]||'')});return;}
      out.matched++;out.records.push({trendId:id,canonicalId:canonical,action:preview?'WOULD_RETIRE':'RETIRED_FROM_ACTIVE_TRENDING'});
      pending.push({row:i+2,trendId:id,canonicalId:canonical});
    });
    if(preview)return out;
    // Reject partial migrations; reconcile ambiguous rows before any write.
    if(out.unmatched)throw new Error('PROMOTION_RECONCILIATION_BLOCKED: '+out.unmatched+' historical records lack exact canonical matches. Dry-run and review first.');
    const lock=LockService.getScriptLock();
    if(!lock.tryLock(30000))throw new Error('PROMOTION_RECONCILIATION_LOCK_UNAVAILABLE');
    try {
      pending.forEach(function(x){
        trendSheet.getRange(x.row,tm['Trend Status']).setValue('PROMOTED');
        trendSheet.getRange(x.row,tm['Active']).setValue('NO');
        trendSheet.getRange(x.row,tm['Featured']).setValue('NO');
        if(tm['Updated At'])trendSheet.getRange(x.row,tm['Updated At']).setValue(new Date());
        out.writes++;out.retired++;
        AQBLogAudit('TREND_HISTORICAL_PROMOTION_RECONCILED','Trend',x.trendId,'Completed promotion reconciled with canonical '+x.canonicalId+'; historical trend removed from active Trending (not physically deleted).');
      });
    }finally{lock.releaseLock();}
    return out;
  }
  const dryRun=!!(options && options.dryRun === true);
  const sheet=AQBGetSheet('AQB AI Trends'),m=AQBBuildHeaderMap(sheet);
  const required=['Record Type','Approved At','Trend Start','Trend End','Status','Trend Status','Active','Featured','Expired At'];
  const missing=required.filter(function(h){return !m[h];});
  if(missing.length)throw new Error('TREND_RETIRE_SCHEMA_MISSING: '+missing.join(', '));
  const result={dryRun:dryRun,processed:0,eligible:0,retired:0,alreadyRetired:0,datesRepaired:0,skippedMissingApproval:0,skippedInvalidApproval:0,skippedOtherStatus:0,skippedFutureApproval:0,deleted:0,permanentWrites:0,records:[]};
  const n=sheet.getLastRow();if(n<2)return result;
  const rows=sheet.getRange(2,1,n-1,sheet.getLastColumn()).getValues();
  const now=new Date(),dayMs=24*60*60*1000;
  // One bounded batch on each invocation; per-cell writes touch ONLY expiry metadata.
  for(let i=0;i<rows.length;i++){
    const r=rows[i],get=function(h){return r[m[h]-1];};
    if(String(get('Record Type')||'').trim().toUpperCase()!=='TREND_CATALOGUE')continue;
    result.processed++;
    const id=String(m['Trend ID']?get('Trend ID'):'').trim();
    const status=String(get('Status')||'').trim().toUpperCase();
    const ts=String(get('Trend Status')||'').trim().toUpperCase();
    if(ts==='EXPIRED'){result.alreadyRetired++;continue;}
    if(status!=='APPROVED'||ts!=='ACTIVE'){result.skippedOtherStatus++;continue;}
    const approvedRaw=get('Approved At');
    if(approvedRaw===''||approvedRaw===null||approvedRaw===undefined){result.skippedMissingApproval++;result.records.push({trendId:id,issue:'MISSING_APPROVED_AT'});continue;}
    // Never parse locale-dependent text or guess dates: require a Sheets Date cell.
    if(!(approvedRaw instanceof Date)||isNaN(approvedRaw.getTime())){result.skippedInvalidApproval++;result.records.push({trendId:id,issue:'INVALID_APPROVED_AT'});continue;}
    const approved=new Date(approvedRaw.getTime());
    if(approved.getTime()>now.getTime()){result.skippedFutureApproval++;result.records.push({trendId:id,issue:'FUTURE_APPROVAL_DATE'});continue;}
    result.eligible++;
    const originalDeadline=new Date(approved.getTime()+7*dayMs);
    const endRaw=get('Trend End');
    const validEnd=endRaw instanceof Date&&!isNaN(endRaw.getTime());
    // Preserve an earlier genuine end; never extend an approved promotion.
    const effectiveEnd=validEnd&&endRaw.getTime()<originalDeadline.getTime()?endRaw:originalDeadline;
    const startRaw=get('Trend Start');
    const validStart=startRaw instanceof Date&&!isNaN(startRaw.getTime());
    const fixStart=!validStart; // preserve any existing historical start evidence
    const fixEnd=!validEnd || endRaw.getTime()!==effectiveEnd.getTime();
    if(fixStart||fixEnd)result.datesRepaired++;
    const expired=effectiveEnd.getTime()<=now.getTime();
    if(expired)result.retired++;
    result.records.push({trendId:id,approvedAt:approved.toISOString(),effectiveEnd:effectiveEnd.toISOString(),wouldExpire:expired,dateRepair:fixStart||fixEnd});
    if(dryRun)continue;
    if(fixStart)sheet.getRange(i+2,m['Trend Start']).setValue(approved);
    if(fixEnd)sheet.getRange(i+2,m['Trend End']).setValue(effectiveEnd);
    if(expired){
      sheet.getRange(i+2,m['Trend Status']).setValue('EXPIRED');
      sheet.getRange(i+2,m['Active']).setValue('NO');
      sheet.getRange(i+2,m['Featured']).setValue('NO');
      if(!get('Expired At'))sheet.getRange(i+2,m['Expired At']).setValue(now);
    }
  }
  return result;
}

function AQBApproveTrend(payload) {
  var u = AQBRequireCataloguePhotoManager();
  AQBEnsureAISheets();
  payload = payload || {};

  var trendId = AQBNormalizeCatalogueIdentityText(payload.trendId);
  if (!trendId) throw new Error('Trend ID is required.');

  var inbox = AQBGetSheet(CONFIG.SHEETS.TREND_INBOX);
  var im = AQBBuildHeaderMap(inbox);
  var n = inbox.getLastRow();
  var src = null, rowNum = 0;
  if (n >= 2) {
    var rows = inbox.getRange(2,1,n-1,inbox.getLastColumn()).getValues();
    for (var i=0;i<rows.length;i++) {
      if (String(rows[i][im['Record Type']-1]||'').toUpperCase()==='TREND_INBOX' && AQBNormalizeCatalogueIdentityText(rows[i][im['Trend ID']-1]) === trendId) {
        src = rows[i].slice(); rowNum = i + 2; break;
      }
    }
  }
  if (!src) throw new Error('Trend suggestion not found.');
  // AQB Trending approval quality gate. Existing incomplete records stay preserved.
  var currentStatus = String(src[im['Status']-1]||'').trim().toUpperCase();
  if (['APPROVED','REJECTED','DECLINED','EXPIRED','ARCHIVED','DELETED'].indexOf(currentStatus)!==-1)
    throw new Error('TREND_APPROVAL_BLOCKED: proposal is not pending review ('+currentStatus+').');
  var originalName=String(src[im['Style Name']-1]||'').trim();
  var originalCategory=String(src[im['Category']-1]||'').trim();
  var originalUrl=String(src[im['Source URL']-1]||'').trim();
  var originalEvidence=String(src[im['Source Evidence']-1]||'').trim();
  if (!originalName || !originalCategory || /no new high.signal trend has been identified/i.test([originalName,src[im['Description']-1]].join(' ')))
    throw new Error('TREND_APPROVAL_BLOCKED: placeholder or incomplete proposal.');
  if (!/^https:\/\/[^\s/]+\.[^\s/]+/i.test(originalUrl) || !originalEvidence)
    throw new Error('TREND_APPROVAL_BLOCKED: verified source URL and evidence required.');
  // Duplicate identity and discovery-lead safeguards must also be enforced server-side.
  var normalizedStyle=String(originalName).normalize('NFKC').toLowerCase().trim().replace(/\s+/g,' ');
  if (rows.some(function(r,j){return j+2!==rowNum&&String(r[im['Record Type']-1]||'').trim().toUpperCase()==='TREND_INBOX'&&!['DELETED','ARCHIVED','EXPIRED','APPROVED'].includes(String(r[im['Status']-1]||'').trim().toUpperCase())&&String(r[im['Style Name']-1]||'').normalize('NFKC').toLowerCase().trim().replace(/\s+/g,' ')===normalizedStyle&&j+2<rowNum;}))
    throw new Error('TREND_APPROVAL_BLOCKED: DUPLICATE_SUGGESTION. Consolidate duplicate Inbox records before approving.');
  if (/SOURCE_REVIEW_REQUIRED|SOURCE REVIEW REQUIRED|original article.*verif|not verified/i.test(originalEvidence))
    throw new Error('TREND_APPROVAL_BLOCKED: SOURCE_REVIEW_REQUIRED. A search result is not verified publisher evidence.');

  // Server-side enforcement: the UI's approval button cannot bypass the
  // source, momentum, Kenya relevance and canonical-identity qualification.
  var qualifiedInbox=AQBGetTrendInboxAdmin();
  var qualifiedRecord=qualifiedInbox.find(function(x){return String(x['Trend ID']||'').trim()===trendId;});
  if(!qualifiedRecord||qualifiedRecord['Approval Eligible']!==true)
    throw new Error('TREND_APPROVAL_BLOCKED: '+(qualifiedRecord?String(qualifiedRecord['Approval Issue']||'QUALIFICATION_INCOMPLETE'):'INBOX_RECORD_NOT_ELIGIBLE')+'. Qualification score and source evidence require management review.');

  var styleName = AQBNormalizeCatalogueIdentityText(payload.styleName || src[im['Style Name']-1]);
  var category = AQBNormalizeCatalogueIdentityText(payload.category || src[im['Category']-1]);
  var serviceName = AQBNormalizeCatalogueIdentityText(payload.serviceName || payload.newServiceName || styleName) || styleName;
  var description = AQBNormalizeCatalogueIdentityText(payload.description || src[im['Description']-1]);
  var price = payload.price !== undefined ? payload.price : src[im['Suggested Price']-1];
  if (!category || !serviceName) throw new Error('Approved trend requires Category and Service Name.');

  var existingMaster = AQBFindCatalogueMasterServiceRows(category, serviceName);
  if (!existingMaster.length && styleName !== serviceName) {
    existingMaster = AQBFindCatalogueMasterServiceRows(category, styleName);
    if (existingMaster.length) serviceName = AQBNormalizeCatalogueIdentityText(existingMaster[0].row[AQBGetMasterListsSchema().serviceNameCol-1]);
  }

  var action = AQBNormalizeCatalogueIdentityText(payload.masterAction).toUpperCase();
  if(existingMaster.length && action==='ADD_AS_NEW')
    throw new Error('TREND_APPROVAL_BLOCKED: matching Master Lists service exists; reuse its canonical AQBCAT identity.');
  if(!existingMaster.length && action!=='ADD_AS_NEW')
    throw new Error('TREND_APPROVAL_BLOCKED: new service requires explicit ADD_AS_NEW authorization.');
  if (existingMaster.length && !['KEEP_EXISTING','UPDATE_EXISTING','ADD_AS_NEW'].includes(action)) {
    return {
      success:false, requiresMasterChoice:true, trendId:trendId, styleName:styleName,
      serviceName:serviceName, category:category, suggestedPrice:String(price || ''),
      existing:existingMaster.map(function(x){
        var r=x.row, schema=AQBGetMasterListsSchema(), mm=AQBBuildHeaderMap(AQBGetSheet(CONFIG.SHEETS.LISTS));
        return {rowNumber:x.rowNumber,category:AQBNormalizeCatalogueIdentityText(r[mm['Category']-1]),serviceName:AQBNormalizeCatalogueIdentityText(r[schema.serviceNameCol-1])};
      })
    };
  }

  // A trend approval does not authorize changing permanent pricing implicitly.
  if(existingMaster.length && action==='KEEP_EXISTING') {
    var masterSchema=AQBGetMasterListsSchema();
    var masterPriceColumn=masterSchema.map['Price'];
    if(masterPriceColumn) price=existingMaster[0].row[masterPriceColumn-1];
  }
  /* Never create a duplicate Master service. */
  var masterResult;
  if (existingMaster.length) {
    masterResult = AQBUpsertCatalogueMasterService(category, serviceName, price, true);
  } else {
    masterResult = AQBUpsertCatalogueMasterService(category, serviceName, price, true);
  }

  /* Master is now authoritative; Catalogue assigns/reuses the permanent ID. */
  var catalogueId = AQBSyncCatalogueAndResolveId(category, serviceName);
  var now = new Date();
  var trendEnd = new Date(now.getTime() + 7*24*60*60*1000);
  var trend = {
    price:price,
    description:description,
    imageUrl:AQBNormalizeCatalogueIdentityText(payload.imageUrl || src[im['Image URL']-1]),
    imageSource:AQBNormalizeCatalogueIdentityText(payload.imageSource || src[im['Image Source']-1]),
    imageSourceUrl:AQBNormalizeCatalogueIdentityText(payload.imageSourceUrl || src[im['Image Source URL']-1]),
    photoBrief:AQBNormalizeCatalogueIdentityText(payload.photoBrief || src[im['Photo Brief']-1]),
    featured:AQBNormalizeCatalogueIdentityText(payload.featured || 'YES').toUpperCase()==='YES'?'YES':'NO',
    trendStart:now, trendEnd:trendEnd,
    source:AQBNormalizeCatalogueIdentityText(payload.source || src[im['Source']-1]),
    collectionIds:AQBNormalizeCatalogueIdentityText(payload.collectionIds),
    duration:AQBNormalizeCatalogueIdentityText(payload.duration || src[im['Suggested Duration']-1])
  };

  var trendSheet=AQBGetSheet(CONFIG.SHEETS.TREND_CATALOGUE), tm=AQBBuildHeaderMap(trendSheet), tn=trendSheet.getLastRow();
  var trendRowNumber=0, existingTrendRow=null;
  if(tn>=2){
    var trRows=trendSheet.getRange(2,1,tn-1,trendSheet.getLastColumn()).getValues();
    for(var t=0;t<trRows.length;t++) if(AQBNormalizeCatalogueIdentityText(trRows[t][tm['Trend ID']-1])===trendId){trendRowNumber=t+2;existingTrendRow=trRows[t].slice();break;}
  }
  var trendOut=existingTrendRow || Array(trendSheet.getLastColumn()).fill('');
  var setTrend=function(h,v){if(tm[h] && v!==undefined) trendOut[tm[h]-1]=v;};
  setTrend('Trend ID',trendId); setTrend('Catalogue ID',catalogueId); setTrend('Style Name',styleName);
  setTrend('Category',category); setTrend('Subcategory',AQBNormalizeCatalogueIdentityText(payload.subcategory || src[im['Subcategory']-1]));
  setTrend('Description',description); setTrend('Price',price); setTrend('Duration',trend.duration);
  setTrend('Image URL',trend.imageUrl); setTrend('Image Source',trend.imageSource); setTrend('Trend Status','ACTIVE');
  setTrend('Featured',trend.featured); setTrend('Trend Start',trend.trendStart); setTrend('Trend End',trend.trendEnd);
  setTrend('Source',trend.source); setTrend('Source URL',AQBNormalizeCatalogueIdentityText(payload.sourceUrl || src[im['Source URL']-1]));
  setTrend('Source Evidence',AQBNormalizeCatalogueIdentityText(payload.sourceEvidence || src[im['Source Evidence']-1]));
  setTrend('Website','Yes'); setTrend('Meta','Yes'); setTrend('WhatsApp','Yes'); setTrend('Instagram','Yes');
  setTrend('Collection IDs',trend.collectionIds); setTrend('Active','Yes'); setTrend('Approved At',now);
  setTrend('Daily Brief ID',AQBNormalizeCatalogueIdentityText(payload.dailyBriefId || src[im['Daily Brief ID']-1]));
  setTrend('Photo Brief',trend.photoBrief); setTrend('Updated At',now);
  if(tm['Created At']) setTrend('Created At',existingTrendRow ? existingTrendRow[tm['Created At']-1] : now);
  setTrend('Record Type','TREND_CATALOGUE'); setTrend('Source Sheet','AQB AI Trends');
  if(tm['Record ID']) setTrend('Record ID',existingTrendRow ? AQBNormalizeCatalogueIdentityText(existingTrendRow[tm['Record ID']-1]) : 'AQB-TC-'+Utilities.getUuid().slice(0,8).toUpperCase());

  if(trendRowNumber) trendSheet.getRange(trendRowNumber,1,1,trendSheet.getLastColumn()).setValues([trendOut]);
  else {trendSheet.appendRow(trendOut); trendRowNumber=trendSheet.getLastRow();}

  src[im['Status']-1]='APPROVED'; src[im['Reviewed At']-1]=now;
  src[im['Review Notes']-1]=AQBNormalizeCatalogueIdentityText(payload.reviewNotes || 'Approved using V16.6.6 Catalogue-first identity architecture.');
  src[im['Approved Catalogue ID']-1]=catalogueId;
  inbox.getRange(rowNum,1,1,inbox.getLastColumn()).setValues([src]);

  AQBLogAudit('APPROVE_TREND_V1666','Trend',trendId,u.email+' matured Trend ID '+trendId+' into existing/new canonical Catalogue ID '+catalogueId+' for '+category+' / '+serviceName+'.');
  return {success:true,version:'V16.6.6',trendId:trendId,catalogueId:catalogueId,category:category,serviceName:serviceName,masterAction:masterResult.created?'ADD_AS_NEW':'UPDATE_EXISTING',masterRow:masterResult.rowNumber,message:'Trend matured successfully. Catalogue ID was resolved from the permanent Catalogue identity; no Catalogue ID was created in Master Lists.'};
}

function AQBTemporaryReadOnlyTrendingAudit() {
  const ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const wanted = [
    CONFIG.SHEETS.DNB_FEED, CONFIG.SHEETS.DNB_STATUS,
    'AQB AI Signals', 'AQB AI Trends', CONFIG.SHEETS.LISTS,
    CONFIG.SHEETS.CATALOGUE
  ];
  const tz = 'Africa/Nairobi';
  const report = {
    audit: 'AQB_V16.21.14_TRENDING_READ_ONLY',
    at: Utilities.formatDate(new Date(), tz, "yyyy-MM-dd'T'HH:mm:ss"),
    spreadsheetIdSuffix: String(ss.getId()).slice(-6),
    sheets: {}, triggersVisibleToRunner: [], propertiesPresence: {},
    configuredSheetRoles: {
      DNB_FEED: CONFIG.SHEETS.DNB_FEED,
      DNB_STATUS: CONFIG.SHEETS.DNB_STATUS,
      AQB_INTELLIGENCE: CONFIG.SHEETS.AQB_INTELLIGENCE,
      TREND_INBOX: CONFIG.SHEETS.TREND_INBOX,
      TREND_CATALOGUE: CONFIG.SHEETS.TREND_CATALOGUE,
      LISTS: CONFIG.SHEETS.LISTS,
      CATALOGUE: CONFIG.SHEETS.CATALOGUE
    },
    notes: [
      'This is a snapshot, not a backup or deployed-version attestation.',
      'Installable triggers owned by other accounts may be invisible.',
      'Apps Script historical executions must be inspected manually in Executions.',
      'This baseline shares AQB AI Trends for Trend Inbox and Trend Catalogue; use Record Type and status fields to distinguish logical records.'
    ]
  };
  const str = x => String(x == null ? '' : x).trim();
  const dateText = x => x instanceof Date && !isNaN(x.getTime())
    ? Utilities.formatDate(x, tz, 'yyyy-MM-dd HH:mm:ss') : str(x).slice(0, 50);
  wanted.forEach(name => {
    const sh = ss.getSheetByName(name);
    if (!sh) { report.sheets[name] = {exists:false}; return; }
    const nr = sh.getLastRow(), nc = sh.getLastColumn();
    const headers = nr && nc ? sh.getRange(1,1,1,nc).getDisplayValues()[0].map(str) : [];
    const pos = {}; headers.forEach((h,i) => {if (h && pos[h] === undefined) pos[h] = i;});
    const out = {exists:true, rows:Math.max(0,nr-1), columns:nc,
      headers:headers, duplicateHeaders:[], recordTypes:{}, statuses:{},
      duplicateIds:{}, blankIds:{}, latest:{}};
    const seenHeaders = {};
    headers.forEach(h => {if(h) {seenHeaders[h]=(seenHeaders[h]||0)+1;}});
    out.duplicateHeaders=Object.keys(seenHeaders).filter(h=>seenHeaders[h]>1);
    const idColumns = ['Item ID','Trend ID','Record ID','Catalogue ID'];
    const seen = {}, duplicates = {}, blanks = {};
    idColumns.forEach(h=>{if(pos[h]!==undefined){seen[h]=new Set();duplicates[h]=0;blanks[h]=0;}});
    const recentColumns = ['Received At','Updated At','Approved At','Created At','Published At','Discovered At','Trend End'];
    // Read in chunks, do not modify; keep only aggregates in the log.
    for(let first=2; first<=nr; first+=400) {
      const data=sh.getRange(first,1,Math.min(400,nr-first+1),nc).getValues();
      data.forEach(r=>{
        ['Record Type','Status','Trend Status','Active','Trending','Featured'].forEach(h=>{
          if(pos[h]===undefined)return;
          const k=str(r[pos[h]]).toUpperCase()||'(BLANK)';
          const dest=h==='Record Type'?out.recordTypes:(out.statuses[h]||(out.statuses[h]={}));
          dest[k]=(dest[k]||0)+1;
        });
        idColumns.forEach(h=>{
          if(pos[h]===undefined)return;
          const id=str(r[pos[h]]);
          if(!id){blanks[h]++;return;}
          if(seen[h].has(id))duplicates[h]++;else seen[h].add(id);
        });
        recentColumns.forEach(h=>{
          if(pos[h]===undefined)return;
          const value=r[pos[h]], ms=value instanceof Date?value.getTime():Date.parse(str(value));
          if(!Number.isFinite(ms))return;
          if(!out.latest[h] || ms>out.latest[h].ms)out.latest[h]={ms:ms,at:dateText(value)};
        });
      });
    }
    idColumns.forEach(h=>{if(seen[h]){out.duplicateIds[h]=duplicates[h];out.blankIds[h]=blanks[h];}});
    Object.keys(out.latest).forEach(h=>{out.latest[h]=out.latest[h].at;});
    if(name===CONFIG.SHEETS.DNB_STATUS && pos['Metric']!==undefined && pos['Value']!==undefined) {
      // Only show metric keys and timestamps; DO NOT log values (may be sensitive).
      out.metrics=[];
      for(let first=2; first<=nr; first+=400){
        const rows=sh.getRange(first,1,Math.min(400,nr-first+1),nc).getValues();
        rows.forEach(r=>{const key=str(r[pos['Metric']]);if(key)out.metrics.push(key);});
      }
    }
    report.sheets[name]=out;
  });
  try {
    const p=PropertiesService.getScriptProperties();
    ['AQB_DNB_FEED_TOKEN'].forEach(k=>{report.propertiesPresence[k]=!!p.getProperty(k);});
  } catch(e){report.propertiesPresence.error=String(e.message||e);}
  try {
    report.triggersVisibleToRunner=ScriptApp.getProjectTriggers().map(t=>({
      handler:t.getHandlerFunction(), eventType:String(t.getEventType()),
      source:String(t.getTriggerSource()), uniqueIdSuffix:String(t.getUniqueId()||'').slice(-5)
    }));
  } catch(e){report.triggersError=String(e.message||e);}
  console.log('=== AQB TRENDING READ-ONLY AUDIT BEGIN ===');
  console.log(JSON.stringify(report));
  console.log('=== AQB TRENDING READ-ONLY AUDIT END ===');
  return report;
}

