  if(/swahili line/.test(n))aliases=aliases.concat(['Swahili lines','African cornrows','scalp braids']);
  if(/feed in/.test(n))aliases=aliases.concat(['feed in cornrows','feed in braids','scalp cornrows']);
  if(/goddess|boho|bohemian/.test(n))aliases=aliases.concat(['boho braids','bohemian braids','goddess braids','braids with loose curls']);
  if(/french curl/.test(n))aliases=aliases.concat(['French curl braids','braids with curly ends','long braids with curls']);
  if(/deep curl/.test(n))aliases=aliases.concat(['curly twists','twists with curls','defined curl twists']);
  if(/jazzy/.test(n))aliases=aliases.concat(['curly twists','twists with curls']);
  if(/havana/.test(n))aliases=aliases.concat(['Havana twists','chunky rope twists']);
  if(/marley/.test(n))aliases=aliases.concat(['Marley twists','chunky rope twists']);
  if(/senegalese/.test(n))aliases=aliases.concat(['Senegalese twists','rope twists']);
  if(/island/.test(n))aliases=aliases.concat(['Island twists','two strand twists']);
  if(/olivia|italian curl/.test(n))aliases=aliases.concat(['curly twists','twists with curly ends']);
  if(/nnene|nnenne/.test(n))aliases=aliases.concat(['Nnene twists','rope twists','two strand twists']);
