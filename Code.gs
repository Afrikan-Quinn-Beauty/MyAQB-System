    const fields={'Category':category,'Description':payload.description,'Source':payload.source,'Source URL':payload.sourceUrl,'Source Evidence':payload.sourceEvidence,'Location Relevance':payload.locationRelevance,'Trend Activity':payload.trendActivity,'Photo Brief':payload.photoBrief};
