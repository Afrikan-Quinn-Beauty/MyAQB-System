function AQBBuildVariantActivityProfile(source,service){
  const low=AQBNormalizeVariantText(source), name=AQBNormalizeVariantText(service);
  const groups=[
    {key:'steam_oil_treatment',terms:['hair steam treatment','steam treatment','hair steaming','hair steamer','salon steamer','hooded steamer','steam therapy','applying hair oil','hair oil scalp','scalp oil','oil application','scalp oil massage']},
    {key:'removal',terms:['removal','remove','removing','take down','takedown','taking down','unbraid','unbraiding','detangle','detangling']},
