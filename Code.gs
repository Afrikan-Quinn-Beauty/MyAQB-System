function AQBResearchTrendingStyles(request){
  // On-demand only. No paid generative AI, automatic publication or second scheduled source.
  AQBRequireCataloguePhotoManager();
  const req=typeof request==='string'?{styleName:request}:(request||{});
  const styleName=String(req.styleName||'').trim().slice(0,110);
  if(!styleName||!/^[\p{L}\p{N}][\p{L}\p{N} \/'’&().+–-]{1,109}$/u.test(styleName))throw new Error('Enter a valid trend/style name.');
  const norm=x=>String(x||'').normalize('NFKC').toLowerCase().trim().replace(/\s+/g,' ');
  const clean=x=>String(x||'').replace(/<[^>]*>/g,' ').replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/&[^;\s]{2,12};/g,' ').replace(/\s+/g,' ').trim();
  const catalogue=AQBGetSheet(CONFIG.SHEETS.PUBLIC_CATALOGUE),cm=AQBBuildHeaderMap(catalogue);
  const rows=catalogue.getLastRow()>1?catalogue.getRange(2,1,catalogue.getLastRow()-1,catalogue.getLastColumn()).getValues():[];
  const exact=rows.filter(r=>norm(r[cm['Service Name']-1])===norm(styleName));
  const matches=exact.map(r=>({catalogueId:String(r[cm['Catalogue ID']-1]||''),serviceName:String(r[cm['Service Name']-1]||''),category:String(r[cm['Category']-1]||'')}));
  const matched=exact.length===1?exact[0]:null;
  let category=matched?String(matched[cm['Category']-1]||''):'';
  const catalogueDescription=matched&&cm['Description']?String(matched[cm['Description']-1]||'').slice(0,900):'';
  const rssQuery='"'+styleName.replace(/"/g,'')+'" hairstyle (Nairobi OR Kenya)';
  const url='https://news.google.com/rss/search?q='+encodeURIComponent(rssQuery)+'&hl=en-KE&gl=KE&ceid=KE:en';
  const globalUrl='https://news.google.com/rss/search?q='+encodeURIComponent('"'+styleName.replace(/"/g,'')+'" hairstyle OR hair styling')+'&hl=en-KE&gl=KE&ceid=KE:en';
  let leads=[],researchError='';
  try{
    const response=UrlFetchApp.fetch(url,{muteHttpExceptions:true,followRedirects:true,timeout:15000,headers:{Accept:'application/rss+xml, application/xml'}});
    if(response.getResponseCode()!==200)throw new Error('RSS_HTTP_'+response.getResponseCode());
    const doc=XmlService.parse(response.getContentText()),channel=doc.getRootElement().getChild('channel');
    if(!channel)throw new Error('RSS_CHANNEL_MISSING');
    leads=channel.getChildren('item').slice(0,20).map(it=>{
      const title=clean(it.getChildText('title')||''),link=String(it.getChildText('link')||'').trim(),date=String(it.getChildText('pubDate')||'').trim();
      const src=it.getChild('source'),publisher=src?clean(src.getText()):'';
      const summary=clean(it.getChildText('description')||'').slice(0,700);
      return {title:title.slice(0,240),url:/^https:\/\//i.test(link)?link:'',publisher:publisher.slice(0,120),publishedAt:date,excerpt:summary};
    }).filter(x=>x.url&&x.title&&norm(x.title).includes(norm(styleName))).slice(0,5);
  }catch(err){researchError=String(err&&err.message||err).slice(0,160);}
  // Kenya-first only. No global fallback: non-Kenyan editorial sources cannot
  // automatically become AQB source evidence. RSS is lead discovery, not DNB.
  leads=leads.filter(l=>/\b(kenya|nairobi)\b/i.test(l.title+' '+l.excerpt+' '+l.publisher));
  // Category recommendations are inference, NOT proof of the service or verified popularity.
  const name=norm(styleName),leadsText=norm(leads.map(l=>l.title+' '+l.excerpt).join(' '));
  const inferenceRules=[
    {re:/\b(braid|knotless|cornrow|fulani|feed.in|stitch lines)\b/,category:'Braiding Services',technique:'Braiding / sectioning'},
    {re:/\b(sisterlocks|microlocs|locs|dreadlocks|retie|interlock)\b/,category:'Sisterlocks & Microlocs',technique:'Loc styling / maintenance'},
    {re:/\b(wig|weav|sew.in|extensions)\b/,category:'Braiding Services',technique:'Track & sew / weave installation'},
    {re:/\b(twist|twist.out|bantu)\b/,category:'Natural Hair Styling',technique:'Textured twists / sets'},
    {re:/\b(bob|pixie|shag|butterfly cut|haircut|layered cut|fringe|bangs|blowout)\b/,category:'Natural Hair Styling',technique:'Haircut / layered styling'}
  ];
  const compound=/\b(sisterlocks|microlocs|locs)\b.*\b(bantu\s+knots?)\b/i.test(styleName);
  const waveSew=/\b(deep\s+wave|water\s+wave)\b.*\b(sew.in|weav)\b/i.test(styleName);
  const rule=compound?{category:'Sisterlocks & Microlocs',technique:'Bantu knot styling on established locs'}:waveSew?{category:'Braiding Services',technique:'Track-and-sew weave with deep/water wave extensions'}:inferenceRules.find(x=>x.re.test(name))||inferenceRules.find(x=>x.re.test(leadsText));
  if(!category&&rule)category=rule.category;
  const technique=rule?rule.technique:'';
  const lead=leads[0]||null;
  // Do not fabricate technique claims: label dictionary-derived observations as suggestions.
  const characteristics=[];
  const signals=[[/\blayer(s|ed|ing)?\b|feathered/i,'Layering / feathered finish'],[/\b(face.framing|curtain bangs|sweeping bangs)\b/i,'Face-framing detail'],[/\b(volume|voluminous|bouncy)\b/i,'Volume and movement'],[/\b(textur(e|ed)|wavy|curly)\b/i,'Texture emphasis'],[/\b(chin.length|shoulder.length|short bob)\b/i,'Short bob length']];
  const articleText=leads.map(l=>l.title+' '+l.excerpt).join(' ');
  signals.forEach(z=>{if(z[0].test(articleText))characteristics.push(z[1]);});
  const dated=leads.filter(l=>l.publishedAt);
  const suggestedDescription=catalogueDescription||(characteristics.length?styleName+' — a '+(technique||'hairstyling')+' look associated with '+characteristics.join(', ').toLowerCase()+'. Exact technique, client suitability and results require professional review.':'');
  // Reuse AQB's permanent catalogue editorial engines; research output is a draft only.
  // For known catalogue services preserve their authored description and photo brief.
  const draftParts=compound ? [
    styleName+' is a temporary Bantu-knot hairstyle made with existing Sisterlocks or microlocs.',
    'Established locs are gathered into sections, wrapped into compact knots and secured with suitable tension.',
    'Its raised knot pattern and visible fine-loc texture distinguish it from loose-hair Bantu knots.',
    'The client gets a defined, neatly arranged loc upstyle without starting or retightening locs.',
    'It suits clients with established locs who want a temporary protective styling finish.'
  ].join(' ') : waveSew ? [
    styleName+' is a sew-in extension style with deep-wave and water-wave curl textures.',
    'The stylist prepares secure foundation tracks and attaches the selected wavy wefts.',
    'Its distinctive feature is the contrast between defined deep waves and flowing water-wave texture.',
    'The client receives a fuller-looking, textured weave with a blended finish.',
    'It suits clients seeking a wavy extension style with an appropriate sew-in foundation.'
  ].join(' ') : /\b(zendaya\s+pixie|pixie)\b/i.test(styleName) ? [
    styleName+' is a short pixie-inspired hairstyle with cropped sides and a shaped top.',
    'The stylist trims and shapes the cut to the client’s hair texture and desired outline.',
    'Its distinguishing details are short length, close shaping and a textured or swept finish.',
    'The client gets a compact, easy-to-style short-hair silhouette.',
    'It suits clients requesting a short cut after consultation about texture, upkeep and suitability.'
  ].join(' ') : /\bbutterfly\s+bob\b/i.test(styleName) ? [
    styleName+' is a short bob with soft, airy, face-framing layers.',
    'The stylist shapes a bob with graduated, feathered layers and finishes it for volume and movement.',
    'Its distinctive features are soft layers around the face and a lightweight, bouncy silhouette.',
    'The client receives a textured bob with visible fullness, movement and a polished finish.',
    'It suits clients looking for a short layered style, with the technique adapted to their texture and hair condition.'
  ].join(' ') : AQBBuildCatalogueDescription(category||'Natural Hair Styling','',styleName,suggestedDescription);
  const fivePartDescription=catalogueDescription||draftParts;
  const existingId=matched&&cm['Catalogue ID']?String(matched[cm['Catalogue ID']-1]||''):'';
  const generatedPhotoBrief=AQBBuildCataloguePhotoBrief(existingId,category||'To Review','',styleName,fivePartDescription);
  // A candidate search is NOT a qualified, licensed, or automatically imported image.
  const imageQuery=[styleName,'hairstyle',technique,characteristics.slice(0,2).join(' '),'Nairobi Kenya'].filter(Boolean).join(' ');
  const googleImagesSearchUrl='https://www.google.com/search?tbm=isch&q='+encodeURIComponent(imageQuery);
  // Relevance = AQB editorial fit, NOT demand. All points require identifiable inputs.
  const relevanceComponents={categoryFit:category?25:0,techniqueFit:technique?25:0,catalogueMatch:matched?20:0,mobileSuitability:0,clientNeed:characteristics.length?15:0};
  const relevanceScore=Object.values(relevanceComponents).reduce((sum,n)=>sum+n,0);
  const relevance={score:relevanceScore,max:100,components:relevanceComponents,assessment:'PRELIMINARY_AQB_FIT',notes:'Category, technique and source-title characteristics are preliminary. Mobile suitability requires staff review. This is not a popularity score.'};
  // Google Trends does not provide reliable measurements through an ordinary search link.
  // Offer region-specific exploration without pretending to have retrieved a time series.
  const googleTrendsUrl='https://trends.google.com/trends/explore?date=today%203-m&geo=KE&q='+encodeURIComponent(styleName);
  const googleSearchUrl='https://www.google.com/search?q='+encodeURIComponent(styleName+' hairstyle Nairobi Kenya');
  const marketEvidence={discoveryChannel:'Google News RSS',leadCount:leads.length,regionalScope:'Kenya/Nairobi discovery only; no global fallback',regionalMentionCount:leads.filter(l=>/\b(kenya|nairobi|east africa)\b/i.test(l.title+' '+l.excerpt)).length,verifiedLocalDemand:false};
  const kenyaDemand={status:'INSUFFICIENT_MEASURED_DATA',interest90Days:null,interestPrevious90Days:null,trendDirection:'UNKNOWN',source:'Google Trends',googleTrendsUrl:googleTrendsUrl,notes:'Open Google Trends to review measured Kenya interest. No authenticated Trends data provider is configured.'};
  const evidence=lead?'Publication lead: '+lead.title+' ('+lead.publishedAt+'). Original article and techniques require verification.':'';
  return {success:true,readOnly:true,source:'MANUAL_PUBLIC_RSS_DISCOVERY',styleName,
    verified:false,evidenceStatus:'SOURCE_REVIEW_REQUIRED',researchError,
    inferredCategory:!matched&&!!category,metadataConfidence:matched?'CANONICAL_SERVICE':lead?'PRELIMINARY_SOURCE_LEAD':'INSUFFICIENT_EVIDENCE',
    minedMetadata:{technique,characteristics,variations:[],suitability:'Not established from retrieved source excerpts',regionRelevance:'Kenya relevance not verified',sourceLeadCount:leads.length,evidenceLimitations:'RSS titles and excerpts are discovery leads; verify original articles for full five-part description, variations and suitability.'},
    proposal:{styleName,category,description:fivePartDescription,photoBrief:generatedPhotoBrief,sourceUrl:'',source:'',sourceEvidence:evidence,locationRelevance:'Kenya/Nairobi search · local demand unverified',trendActivity:'Not established by search results',suggestedAction:matched?'Review existing AQBCAT metadata enrichment':'Review category and source before service creation'},
    relevance,kenyaDemand,marketEvidence,googleSearchUrl,additionalSources:leads,existingServiceMatches:matches,googleImagesSearchUrl,imageDiscoveryStatus:'SEARCH_ONLY_NOT_LICENSED',descriptionDraftStatus:catalogueDescription?'EXISTING_CANONICAL':'EDITORIAL_DRAFT_REQUIRES_REVIEW',requiresReview:true,
    message:lead?'Kenya-related discovery leads found; original Kenyan publisher URLs must be verified manually before approval.':'No attributable leads found. Supply a credible publisher source or try another name.'};
