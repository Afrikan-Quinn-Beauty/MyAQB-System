      if(flow.length!==1)throw new Error('Receipt exists but Cash Flow is missing or duplicated. Reconcile before retrying.');
      if(Number(prior['Amount']||0)!==amount)throw new Error('Receipt amount differs from agreed price. Reconcile before retrying.');
