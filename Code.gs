  const version = 'V16.21.15.6.5.3.15j';
  const families = (audit.families || []).map(function(f){
    const hasAnyImage = (f.variants||[]).some(function(v){ return !!v.hasImage; });
    const optionSummary = (f.variants||[]).map(function(v){
      return {
        id: v.catalogueId,
        label: v.optionLabel || v.serviceName,
        serviceName: v.serviceName,
        hasImage: !!v.hasImage,
        storedQualification: v.storedQualification || 'UNSPECIFIED'
      };
    });
    return {
      familyKey: f.familyKey,
      displayName: f.displayName,
      expertTier: f.expertTier,
      signaturePriority: f.signaturePriority,
      confidence: f.confidence,
      optionDimension: f.optionDimension,
      source: f.source,
      sourceCategories: f.canonicalSourceCategories || [],
      variants: optionSummary,
      variantCount: optionSummary.length,
      candidateImageState: hasAnyImage ? 'CANDIDATE_IMAGE_AVAILABLE' : 'IMAGE_NEEDED',
      photoReadiness: f.photoReadiness || 'NOT_VERIFIED',
      bookingCompatibility: f.bookingCompatibility || 'NOT_LIVE_TESTED',
