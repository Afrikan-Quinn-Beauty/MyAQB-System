  return {success:true,removed:removed};
}

function AQBBookAppointmentForExistingCustomer(payload){
  const user=AQBRequireUser();
  payload=payload||{};
  const customerId=String(payload.customerId||'').trim();
  if(!customerId) throw new Error('Customer ID is required.');

  const sheet=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS), lastRow=sheet.getLastRow();
  if(lastRow<2) throw new Error('Customer not found.');

  const customerMap=AQBBuildHeaderMap(sheet);
  const rows=sheet.getRange(2,1,lastRow-1,sheet.getLastColumn()).getValues();
  let customerRow=null;
  for(const row of rows){
    if(String(row[customerMap['Customer ID']-1]||'').trim()===customerId){
      customerRow=row;
      break;
    }
  }
  if(!customerRow) throw new Error('Customer not found. Please search for the customer again.');

  const service=String(payload.service||'').trim();
  if(!service) throw new Error('Please select a service.');
  const isSisterlocks=AQBIsSisterlocksService(service,'');
  const isRetie=AQBIsSisterlocksRetieService(service);
  if(payload.specialArrangement===true){
    AQBRequireAdmin();
    if(!String(payload.specialArrangementReason||'').trim())throw Error('Admin special-arrangement reason is required.');
    if(!payload.appointmentDate||!payload.startTime)throw Error('Choose a date and start time for the Admin special arrangement.');
  }
  const firstRetieBooking=isRetie && !AQBHasSisterlocksRetieHistory(customerId);
  let lastRetie=null,retieDates=null,historySource='';
  if(isRetie){
    const storedLast=customerRow[customerMap['Last Retie Date']-1];
    if(String(payload.lastRetieDate||'').trim()){
      lastRetie=AQBParseDateFromClient(payload.lastRetieDate);
      if(lastRetie>new Date())throw new Error('Last retie date cannot be in the future.');
      retieDates=AQBCalculateRetieDates(lastRetie); historySource='provided';
    }else if(storedLast instanceof Date && !isNaN(storedLast.getTime())){
      lastRetie=new Date(storedLast); lastRetie.setHours(0,0,0,0);
      retieDates=AQBCalculateRetieDates(lastRetie); historySource='customer record';
    }
  }

  const customerRowIndex=rows.findIndex(
    r=>String(r[customerMap['Customer ID']-1]||'').trim()===customerId
  )+2;

  // Sisterlocks Retightening for an existing customer follows the automatic
  // 42-day rule. The staff member supplies the last completed retie date;
  // the system calculates the next due date and, when within 0–42 days,
  // creates the next 3-hour retie in the earliest available 15-minute slot.
  if(isRetie){
    customerRow[customerMap['Service']-1]=service;
    customerRow[customerMap['Customer Status']-1]='Active';

    let result=null,age=null,overdue=false,automaticRetieApplied=false,daysOverdue=null;
    const storedNext=AQBParseRetieDate(customerRow[customerMap['Next Retie Date']-1]);
    let nextRetie=storedNext?new Date(storedNext):null;
    if(String(payload.lastRetieDate||'').trim() && lastRetie){
      customerRow[customerMap['Last Retie Date']-1]=lastRetie;
      nextRetie=AQBParseDateFromClient(retieDates.nextRetieDate);
      customerRow[customerMap['Next Retie Date']-1]=nextRetie;
      customerRow[customerMap['Reminder Date']-1]=AQBParseDateFromClient(retieDates.reminderDate);
      customerRow[customerMap['Reminder Sent']-1]='No';
    }else if(!nextRetie && lastRetie){
      nextRetie=AQBParseDateFromClient(retieDates.nextRetieDate);
      customerRow[customerMap['Next Retie Date']-1]=nextRetie;
      customerRow[customerMap['Reminder Date']-1]=AQBParseDateFromClient(retieDates.reminderDate);
      customerRow[customerMap['Reminder Sent']-1]='No';
    }else if(!nextRetie){
      nextRetie=new Date(); nextRetie.setHours(0,0,0,0);
      customerRow[customerMap['Next Retie Date']-1]=nextRetie;
      const reminder=new Date(nextRetie);reminder.setDate(reminder.getDate()-CONFIG.RETIE_REMINDER_DAYS);
      customerRow[customerMap['Reminder Date']-1]=reminder;
      customerRow[customerMap['Reminder Sent']-1]='No';
    }
    if(customerMap['Next Appointment Created'])customerRow[customerMap['Next Appointment Created']-1]='No';
    age=lastRetie?AQBGetDaysSinceDate(lastRetie):null;
    daysOverdue=age!==null?age:AQBGetDaysSinceDate(nextRetie);
    overdue=daysOverdue!==null && daysOverdue>CONFIG.RETIE_DAYS;

    const manualOverride=(payload.specialArrangement===true || payload.manualRetieOverride===true) && payload.appointmentDate && payload.startTime;
    if(manualOverride){
      const bookingPayload={service:service,serviceGroup:String(payload.serviceGroup||'').trim(),appointmentDate:payload.appointmentDate,startTime:payload.startTime,chargedPrice:payload.chargedPrice,paymentStatus:String(payload.paymentStatus||'Pending').trim()||'Pending',bookingSource:'Existing Customer Search — Manual Retie Override',notes:String(payload.notes||'').trim(),internalAppointment:true,specialArrangement:payload.specialArrangement===true,specialArrangementReason:String(payload.specialArrangementReason||'').trim()};
      result=AQBCreateAppointmentForCustomer(customerId,customerRow,bookingPayload,user,customerMap);
    }else if(daysOverdue===null || daysOverdue<=CONFIG.AUTO_BOOK_EXISTING_RETIE_MAX_DAYS){
      result=AQBCreateAutomaticRetieAppointmentForCustomer(customerRow,customerMap,firstRetieBooking);
      automaticRetieApplied=!!result;
      if(result && customerMap['Next Appointment Created'])customerRow[customerMap['Next Appointment Created']-1]='Yes';
    }

    // More than 42 days since the last completed retie: preserve the known/missed due date,
    // do not force a new appointment, and allow an optional manual date/time if staff chooses one.
    if(!result && daysOverdue!==null && daysOverdue>CONFIG.AUTO_BOOK_EXISTING_RETIE_MAX_DAYS){
      overdue=true;
      if(payload.appointmentDate && payload.startTime && payload.manualRetieOverride===true){
        const bookingPayload={service:service,serviceGroup:String(payload.serviceGroup||'').trim(),appointmentDate:payload.appointmentDate,startTime:payload.startTime,chargedPrice:payload.chargedPrice,paymentStatus:String(payload.paymentStatus||'Pending').trim()||'Pending',bookingSource:'Existing Customer Search — Manual Overdue Retie',notes:String(payload.notes||'').trim(),internalAppointment:true,specialArrangement:payload.specialArrangement===true,specialArrangementReason:String(payload.specialArrangementReason||'').trim()};
        result=AQBCreateAppointmentForCustomer(customerId,customerRow,bookingPayload,user,customerMap);
      }
    }
    // If there is no automatic slot, an explicitly selected manual override remains valid.
    if(!result && payload.manualRetieOverride===true && payload.appointmentDate && payload.startTime){
      const bookingPayload={service:service,serviceGroup:String(payload.serviceGroup||'').trim(),appointmentDate:payload.appointmentDate,startTime:payload.startTime,chargedPrice:payload.chargedPrice,paymentStatus:String(payload.paymentStatus||'Pending').trim()||'Pending',bookingSource:'Existing Customer Search — Manual Retie Override',notes:String(payload.notes||'').trim(),internalAppointment:true,specialArrangement:payload.specialArrangement===true,specialArrangementReason:String(payload.specialArrangementReason||'').trim()};
      result=AQBCreateAppointmentForCustomer(customerId,customerRow,bookingPayload,user,customerMap);
    }
    if(result && firstRetieBooking && !automaticRetieApplied){
      try{AQBSendBookingWhatsAppForAppointment(result,AQBGetCustomerFirstName(customerRow,customerMap));}
      catch(e){AQBLogAudit('WHATSAPP_BOOKING_ERROR','Appointment',result.appointmentId,String(e&&e.message||e));}
    }
    if(customerRowIndex>=2)sheet.getRange(customerRowIndex,1,1,sheet.getLastColumn()).setValues([customerRow]);
    let retieOverdueMessage=null;
    if(lastRetie && customerRowIndex>=2){
      retieOverdueMessage=AQBSendRetieKnownHistoryOverdue(sheet,customerRowIndex,customerRow,customerMap,'BOOK_EXISTING_CUSTOMER');
    }
    AQBLogAudit('BOOK_EXISTING_CUSTOMER','Customer',customerId,lastRetie ? ('Existing customer Sisterlocks Retightening processed using '+historySource+', Last Retie '+AQBFormatDateForClient(lastRetie)+', Next Retie '+AQBFormatDateForClient(nextRetie)+', '+Math.max(0,daysOverdue||0)+' days since last completed retie, automatic appointment '+(automaticRetieApplied?'created':'not created')+(overdue?' (overdue).':'')+(retieOverdueMessage?' Overdue evaluation: '+JSON.stringify(retieOverdueMessage):'')) : 'Existing customer Sisterlocks Retightening processed with no historical Last Retie. Next Retie set to today and automatic scheduling attempted.');
    return {success:true,customerId,customer:AQBBuildCustomerObject(customerRow,customerMap),appointment:result,existing:true,automaticRetieApplied,overdue,daysOverdue:Math.max(0,daysOverdue||0),daysSinceLastRetie:age,lastRetieProvided:!!lastRetie,historySource,retieOverdueMessage:retieOverdueMessage};
  }

  const bookingPayload={
    service:service,
    serviceGroup:String(payload.serviceGroup||'').trim(),
    appointmentDate:payload.appointmentDate,
    startTime:payload.startTime,
    chargedPrice:payload.chargedPrice,
    paymentStatus:String(payload.paymentStatus||'Pending').trim()||'Pending',
    bookingSource:'Existing Customer Search',
    notes:String(payload.notes||'').trim(),
    internalAppointment:true,
    specialArrangement:payload.specialArrangement===true,
    specialArrangementReason:String(payload.specialArrangementReason||'').trim()
  };

  const result=AQBCreateAppointmentForCustomer(customerId,customerRow,bookingPayload,user,customerMap);

  let whatsappSent=false;
  // Normal services always receive the existing booking-confirmation message.
  // Sisterlocks retie confirmation is handled separately for the first retie only.
  try{
    const firstName=AQBGetCustomerFirstName(customerRow,customerMap);
    const wa=AQBSendBookingWhatsAppForAppointment(result,firstName);
    whatsappSent=!!(wa&&wa.sent);
  }catch(e){
    AQBLogAudit('WHATSAPP_BOOKING_ERROR','Appointment',result.appointmentId,String(e&&e.message||e));
  }

  if(customerRowIndex>=2){
    if(customerMap['Service']) sheet.getRange(customerRowIndex,customerMap['Service']).setValue(service);
    if(customerMap['Customer Status']) sheet.getRange(customerRowIndex,customerMap['Customer Status']).setValue('Active');
  }

  result.whatsappSent=whatsappSent;
  result.customerFirstName=AQBGetCustomerFirstName(customerRow,customerMap);
  result.durationMinutes=AQBGetAppointmentDurationMinutes(service);

  AQBLogAudit(
    'BOOK_EXISTING_CUSTOMER',
    'Customer',
    customerId,
    'Booked '+service+
    ' for existing customer via customer search. Duration '+
    AQBGetAppointmentDurationMinutes(service)+' minutes. Appointment '+
    result.appointmentId+'.'
  );

  return result;
}

function AQBSyncCustomerAfterAppointmentReschedule(customerId,service,appointmentDate,appointmentId){
  const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),cn=cs.getLastRow();
  if(cn<2)return {updated:false,customerId:String(customerId||''),retie:false};
  const cm=AQBBuildHeaderMap(cs),rows=cs.getRange(2,1,cn-1,cs.getLastColumn()).getValues();
  const id=String(customerId||''),isRetie=AQBIsRetieAppointmentService(service);
  for(let i=0;i<rows.length;i++){
    const r=rows[i];
    if(String(r[cm['Customer ID']-1]||'')!==id)continue;
    if(cm['Service'])r[cm['Service']-1]=String(service||'').trim();
    if(cm['Next Appointment Created'])r[cm['Next Appointment Created']-1]='Yes';
    let nextRetie='',reminder='';
    if(isRetie){
      const next=new Date(appointmentDate);next.setHours(0,0,0,0);
      const rem=new Date(next);rem.setDate(rem.getDate()-CONFIG.REMINDER_DAYS);rem.setHours(0,0,0,0);
      if(cm['Next Retie Date'])r[cm['Next Retie Date']-1]=next;
      if(cm['Reminder Date'])r[cm['Reminder Date']-1]=rem;
      if(cm['Reminder Sent'])r[cm['Reminder Sent']-1]='No';
      nextRetie=AQBFormatDateForClient(next);reminder=AQBFormatDateForClient(rem);
    }
    cs.getRange(i+2,1,1,cs.getLastColumn()).setValues([r]);
    try{AQBLogAudit('AQB_APPOINTMENT_RESCHEDULE_CUSTOMER_SYNC','Customer',id,'Appointment '+String(appointmentId||'')+' rescheduled; customer appointment state synchronized'+(isRetie?'; Next Retie Date '+nextRetie+', Reminder Date '+reminder+'.':'.'));}catch(ignore){}
    return {updated:true,customerId:id,retie:isRetie,nextRetieDate:nextRetie,reminderDate:reminder};
  }
  return {updated:false,customerId:id,retie:isRetie,reason:'CUSTOMER_NOT_FOUND'};
}

function AQBEditExistingAppointment(payload){
  AQBRequireUser();
  payload=payload||{};
  const appointmentId=String(payload.appointmentId||'').trim();
  if(!appointmentId)throw new Error('Appointment ID is required.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
    if(n<2)throw new Error('No appointments found.');
    const rows=s.getRange(2,1,n-1,17).getValues();
    let idx=-1;
    for(let i=0;i<rows.length;i++){if(String(rows[i][0]||'').trim()===appointmentId){idx=i;break;}}
    if(idx<0)throw new Error('Appointment not found.');
    const r=rows[idx],status=String(r[8]||'').trim().toUpperCase();
    if(['COMPLETED','CANCELLED','NO SHOW'].includes(status))throw new Error('Completed, cancelled or no-show appointments cannot be edited.');

    const oldService=String(r[4]||'').trim(),oldDate=AQBParseRetieDate(r[5]),oldStart=AQBParseRetieDate(r[6]);
    const service=String(payload.service||r[4]||'').trim();
    const date=AQBParseDateFromClient(payload.appointmentDate||r[5]);
    const startTime=String(payload.startTime||AQBFormatTimeForClient(r[6])||'').trim();
    if(!service)throw new Error('Please select a service.');
    if(!date||!startTime)throw new Error('Appointment date and start time are required.');
    const specialArrangement=payload.specialArrangement===true;
    if(specialArrangement){AQBRequireAdmin();if(!String(payload.specialArrangementReason||'').trim())throw Error('Admin special-arrangement reason is required.');}
    AQBValidateInternalAppointmentStartTime(startTime,specialArrangement);
    const st=AQBParseTimeFromClient(startTime),start=AQBCombineDateAndTime(date,st);
    const end=new Date(start.getTime()+AQBGetAppointmentDurationMinutes(service)*60000);
    if(start<new Date())throw new Error('Appointment date/time cannot be in the past.');
    AQBValidateCustomerBookingHours(date,start,end,true,specialArrangement);
    AQBAssertNoDuplicateActiveAppointment(String(r[1]||''),service,appointmentId);
    if(AQBIsAppointmentSlotTaken(date,start,end,appointmentId))throw new Error('That appointment time conflicts with another booking. Please choose another time.');

    const pricing=AQBFindServicePricing(service,payload.serviceGroup||'');
    const agreedRaw=payload.chargedPrice!==undefined&&payload.chargedPrice!=='' ? payload.chargedPrice : (r[16]||r[14]||pricing.price);
    const chargedPrice=String(agreedRaw==null?'':agreedRaw).trim()==='' ? Number(pricing.priceAmount||AQBGetPublicStartingPriceNumber(pricing.price)) : Number(agreedRaw);
    if(!isFinite(chargedPrice)||chargedPrice<=0)throw new Error('No valid amount was entered and no usable Master List price is configured for this service.');
    const notes=(payload.notes!==undefined?String(payload.notes||'').trim():String(r[13]||''))+(specialArrangement?' [ADMIN SPECIAL ARRANGEMENT: '+String(payload.specialArrangementReason||'').trim()+']':'');
    const calendarEventId=String(r[11]||'').trim();
    if(calendarEventId){
      const calendar=CalendarApp.getCalendarById(CONFIG.CALENDAR_ID);
      if(!calendar)throw new Error('The configured African Quinn Beauty Centre Google Calendar could not be accessed.');
      const event=calendar.getEventById(calendarEventId);
      if(!event)throw new Error('The Google Calendar event for this appointment could not be found.');
      const customerName=String(r[2]||''),phone=String(r[3]||''),location=AQBGetCustomerLocationById(String(r[1]||''));
      event.setTitle(AQBGetCustomerFirstNameById(String(r[1]||''))+' - '+service);
      event.setTime(start,end);
      event.setDescription(['African Quinn Beauty Client Management','', 'Appointment ID: '+appointmentId,'Customer ID: '+String(r[1]||''),'Customer: '+customerName,'WhatsApp: '+phone,'Service: '+service,'Status: '+status,'Payment: '+(chargedPrice>0?'KES '+Number(chargedPrice).toLocaleString('en-KE'):'Pending'),notes?'Notes: '+notes:''].filter(Boolean).join('\n'));
      if(location)event.setLocation(location);
    }

    r[4]=service;r[5]=date;r[6]=start;r[7]=end;r[9]='Pending';r[13]=notes;
    r[15]=pricing.price||r[15]||'';r[16]=chargedPrice;
    s.getRange(idx+2,1,1,17).setValues([r]);

    const dateChanged=!oldDate||AQBFormatDateKey(oldDate)!==AQBFormatDateKey(date);
    const timeChanged=!oldStart||AQBFormatTimeForClient(oldStart)!==AQBFormatTimeForClient(start);
    const serviceChanged=oldService!==service;
    const customerSync=AQBSyncCustomerAfterAppointmentReschedule(String(r[1]||''),service,date,appointmentId);
    AQBLogAudit('AQB_EDIT_APPOINTMENT','Appointment',appointmentId,'Appointment updated in place. Service '+service+', '+AQBFormatDateForClient(date)+' '+AQBFormatTimeForClient(start)+'–'+AQBFormatTimeForClient(end)+'; same Appointment ID and Calendar event retained; customer sync '+(customerSync.updated?'completed':'not applied')+'.');
    if(dateChanged||timeChanged||serviceChanged){
      try{AQBLogAudit('AQB_APPOINTMENT_RESCHEDULED','Appointment',appointmentId,'Reschedule detected. Previous service/date/time: '+oldService+' / '+(oldDate?AQBFormatDateForClient(oldDate):'')+' / '+(oldStart?AQBFormatTimeForClient(oldStart):'')+'; new: '+service+' / '+AQBFormatDateForClient(date)+' / '+AQBFormatTimeForClient(start)+'.');}catch(ignore){}
    }
    return AQBBuildAppointmentObject(r);
  }finally{lock.releaseLock();}
}

function AQBEditAppointment(payload){return AQBEditExistingAppointment(payload);}

function AQBCancelAppointment(appointmentId){
  AQBRequireUser(); appointmentId=String(appointmentId||'').trim(); if(!appointmentId)throw new Error('Appointment ID is required.');
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow(); if(n<2)throw new Error('Appointment not found.'); const rows=s.getRange(2,1,n-1,17).getValues(); let idx=-1;
  for(let i=0;i<rows.length;i++)if(String(rows[i][0]||'').trim()===appointmentId){idx=i;break;} if(idx<0)throw new Error('Appointment not found.');
  const r=rows[idx],status=String(r[8]||'').trim().toUpperCase(); if(status==='COMPLETED'||status==='NO SHOW')throw new Error('Completed or no-show appointments cannot be cancelled.'); if(status==='CANCELLED')return AQBBuildAppointmentObject(r);
  const eventId=String(r[11]||'').trim(); if(eventId){try{const cal=CalendarApp.getCalendarById(CONFIG.CALENDAR_ID);const ev=cal&&cal.getEventById(eventId);if(ev)ev.deleteEvent();}catch(e){AQBLogAudit('CALENDAR_DELETE_ERROR','Appointment',appointmentId,String(e&&e.message||e));}}
  r[8]='CANCELLED'; s.getRange(idx+2,1,1,17).setValues([r]); AQBLogAudit('CANCEL_APPOINTMENT','Appointment',appointmentId,'Appointment cancelled. History retained; linked Calendar event removed when accessible.'); return AQBBuildAppointmentObject(r);
}

function AQBGetAdminSpecialSlots(dateValue,serviceValue,excludeId){
  AQBRequireAdmin();
  const date=AQBParseDateFromClient(dateValue);
  if(!date)throw Error('Choose a valid appointment date.');
  if(date.getDay()===0)throw Error('Sunday requires a separate authorized booking workflow.');
  const duration=AQBGetAppointmentDurationMinutes(serviceValue);
  if(!duration||duration<=0)throw Error('Choose a service first.');
  const today=new Date(),limit=new Date(today);limit.setHours(0,0,0,0);limit.setDate(limit.getDate()+60);
  if(date>limit)throw Error('Choose a date within 60 days.');
  const slots=[];
  for(let min=7*60;min<=23*60+45;min+=15){
    const start=new Date(date);start.setHours(Math.floor(min/60),min%60,0,0);
    const end=new Date(start.getTime()+duration*60000);
    const midnight=new Date(date);midnight.setDate(midnight.getDate()+1);midnight.setHours(0,0,0,0);
    if(end>midnight)continue;
    const available=start>today&&!AQBIsAppointmentSlotTaken(date,start,end,excludeId||null);
    slots.push({value:Utilities.formatDate(start,Session.getScriptTimeZone(),'HHmm'),label:Utilities.formatDate(start,Session.getScriptTimeZone(),'HH:mm')+' – '+Utilities.formatDate(end,Session.getScriptTimeZone(),'HH:mm')+' (Admin special)',endTime:Utilities.formatDate(end,Session.getScriptTimeZone(),'HH:mm'),available:available,reason:available?'':'Past or booked'});
  }
  return {adminSpecial:true,date:AQBFormatDateForClient(date),durationMinutes:duration,slots:slots};
}

