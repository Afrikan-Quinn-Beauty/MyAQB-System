function AQBHandleDarajaCallback(e,body){
 const json=x=>ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);
 const cfg=AQBDarajaConfig();const token=String(e&&e.parameter&&e.parameter.secret_token||'');
 if(!cfg.enabled||!cfg.token||!token||token!==cfg.token)return json({ResultCode:1,ResultDesc:'Rejected'});
 const cb=body&&body.Body&&body.Body.stkCallback;if(!cb||!cb.CheckoutRequestID)return json({ResultCode:1,ResultDesc:'Malformed'});
 const lock=LockService.getScriptLock();if(!lock.tryLock(8000))return json({ResultCode:1,ResultDesc:'Busy; retry'});
 try{
  const c=AQBDarajaEnsure(),rows=AQBDarajaRows(c.ps,c.pm),matches=rows.filter(o=>String(AQBDarajaVal(o,c.pm,'Daraja Checkout ID'))===String(cb.CheckoutRequestID));
  if(matches.length!==1)return json({ResultCode:1,ResultDesc:'Unmatched checkout'});
  const o=matches[0],state=String(AQBDarajaVal(o,c.pm,'Daraja Transaction State'));
  if(['RECONCILED','CONFIRMED','FAILED','CANCELLED'].includes(state))return json({ResultCode:0,ResultDesc:'Already handled'});
  const items=cb.CallbackMetadata&&cb.CallbackMetadata.Item||[];const meta={};items.forEach(x=>{if(x&&x.Name)meta[x.Name]=x.Value;});
  const expected=Number(AQBDarajaVal(o,c.pm,'Amount')),expectedPhone=String(AQBDarajaVal(o,c.pm,'Daraja Payer'));
  let status='EXCEPTION',reason='Callback requires independent verification';
  if(Number(cb.ResultCode)!==0){status=Number(cb.ResultCode)===1032?'CANCELLED':'FAILED';reason=String(cb.ResultDesc||'STK declined');}
  else if(meta.MpesaReceiptNumber&&Number(meta.Amount)===expected&&(!meta.PhoneNumber||AQBDarajaPhone(meta.PhoneNumber)===expectedPhone)){
    status='EXCEPTION';reason='Positive callback captured; verify with Safaricom/portal before ledger posting';
  }else{reason='Missing receipt or amount/payer mismatch';}
  AQBDarajaSet(c.ps,o.row,c.pm,{'Daraja Callback JSON':JSON.stringify(cb).slice(0,40000),'Daraja Receipt':status==='EXCEPTION'&&meta.MpesaReceiptNumber?String(meta.MpesaReceiptNumber):'','Daraja Transaction State':status,'Daraja Exception':reason});
  return json({ResultCode:0,ResultDesc:'Callback recorded'});
 }catch(err){return json({ResultCode:1,ResultDesc:'Ingestion unavailable'});}finally{lock.releaseLock();}
}


