function AQBGetSpreadsheet() {
  if (CONFIG.SPREADSHEET_ID) return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw new Error('No spreadsheet is connected. Put the Google Sheet ID in CONFIG.SPREADSHEET_ID, then run setupAfrikanQuinnSystem().');
  return ss;
}

function AQBEnsureSheet(sheetName, headers) {
  const ss = AQBGetSpreadsheet();
  let sheet = ss.getSheetByName(sheetName);
  if (!sheet) sheet = ss.insertSheet(sheetName);

  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  } else {
    const lastCol = Math.max(sheet.getLastColumn(), 1);
    const existing = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(v => String(v || '').trim());
    headers.forEach(function(header) {
      if (existing.indexOf(header) === -1) {
        const nextCol = sheet.getLastColumn() + 1;
        sheet.getRange(1, nextCol).setValue(header);
        existing.push(header);
      }
    });
  }
  sheet.setFrozenRows(1);
  return sheet;
}

function AQBBuildHeaderMap(sheet) {
  const n = sheet.getLastColumn();
  if (n < 1) return {};
  const headers = sheet.getRange(1, 1, 1, n).getValues()[0];
  const map = {};
  headers.forEach(function(h, i) {
    const key = String(h || '').trim();
    if (key) map[key] = i + 1;
  });
  return map;
}

function AQBAppendByHeaders(sheet, valuesByHeader) {
  const map = AQBBuildHeaderMap(sheet);
  const row = Array(sheet.getLastColumn()).fill('');
  Object.keys(valuesByHeader).forEach(function(header) {
    if (!map[header]) throw new Error('Required column missing: ' + header);
    row[map[header] - 1] = valuesByHeader[header];
  });
  const id=String(row[AQBBuildHeaderMap(sheet)['Customer ID']-1]||'').trim().toUpperCase();
  if(AQBIsTestCustomer(id))throw new Error('Reserved test customer ID cannot be assigned to a new customer: '+id);
  sheet.appendRow(row);
  const number=Number(id.replace(/^AQB/i,''));
  const props=PropertiesService.getScriptProperties();
  const high=Math.max(Number(props.getProperty('AQB_CUSTOMER_ID_HIGH_WATER')||0),number);
  if(Number.isSafeInteger(high))props.setProperty('AQB_CUSTOMER_ID_HIGH_WATER',String(high));
}

function AQBGetSheet(name) {
  const sheet = AQBGetSpreadsheet().getSheetByName(name);
  if (!sheet) throw new Error('Required sheet not found: ' + name + '. Run setupAfrikanQuinnSystem() once.');
  return sheet;
}

function AQBFormatSheets() {
  const ss = AQBGetSpreadsheet();
  Object.keys(CONFIG.SHEETS).forEach(function(k) {
    const sh = ss.getSheetByName(CONFIG.SHEETS[k]);
    if (!sh) return;
    if (sh.getLastColumn() > 0) {
      sh.getRange(1,1,1,sh.getLastColumn()).setFontWeight('bold');
      sh.autoResizeColumns(1, sh.getLastColumn());
    }
  });
}

