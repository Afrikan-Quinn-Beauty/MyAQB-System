function AQBWriteChannelSyncBatch(entries){
  entries=(entries||[]).filter(function(x){return x&&x.catalogueId&&x.channel;});
  if(!entries.length)return {written:0};
  const sh=AQBEnsureCatalogueChannelSyncSheet(),m=AQBBuildHeaderMap(sh),n=sh.getLastRow();
  const rows=n>=2?sh.getRange(2,1,n-1,sh.getLastColumn()).getValues():[],byKey={};
  rows.forEach(function(r,i){
    const key=String(r[m['Catalogue ID']-1]||'').trim()+'|'+String(r[m['Channel']-1]||'').trim().toUpperCase();
    if(key!=='|')byKey[key]=i;
  });
  const append=[];
  entries.forEach(function(x){
    const id=String(x.catalogueId||'').trim(),channel=String(x.channel||'').trim().toUpperCase(),key=id+'|'+channel;
    let r,idx=byKey[key];
    if(idx===undefined){
      r=Array(sh.getLastColumn()).fill('');
      r[m['Catalogue ID']-1]=id;
      r[m['Channel']-1]=channel;
      append.push(r); idx=rows.length+append.length-1; byKey[key]=idx;
    }else r=rows[idx];
    if(idx>=rows.length)r=append[idx-rows.length];
    if(x.remoteObjectId!==undefined && x.remoteObjectId!==null && String(x.remoteObjectId)!=='')r[m['Remote Object ID']-1]=String(x.remoteObjectId);
    if(x.status!==undefined)r[m['Sync Status']-1]=String(x.status||'');
    r[m['Synced At']-1]=x.syncedAt||new Date();
    if(x.error!==undefined)r[m['Error']-1]=String(x.error||'').slice(0,1000);
  });
  if(rows.length)sh.getRange(2,1,rows.length,sh.getLastColumn()).setValues(rows);
  append.forEach(function(r){sh.appendRow(r);});
  return {written:entries.length};
}

