    const updated=catalogueRows.filter(r=>String(r[headers['Catalogue ID']-1]||'').trim().toUpperCase()===preview.catalogueId);
    if(updated.length!==1||Number(updated[0][headers['Price']-1])!==preview.price)throw Error('Catalogue price synchronization not verified; inspect record before retry.');
    if(headers['Salon Price']&&String(updated[0][headers['Salon Price']-1]||'')!==String(preview.salonPrice||''))throw Error('Catalogue salon price synchronization not verified.');
    return {success:true,catalogueId:preview.catalogueId,price:preview.price,salonPrice:preview.salonPrice,descriptionUpdated:false};
  }catch(e){return {success:false,catalogueId:preview.catalogueId,masterUpdated:true,syncError:String(e&&e.message||e),actionRequired:'Inspect existing record and retry guarded sync; do not recreate service.'};}
}

/* V16.22.1.27: NEW service photo staging and opt-in AI image generation.
 * No approval or publication is performed by these functions.
 * Required Script Properties (set privately): AQB_AI_IMAGE_PROVIDER=GEMINI|OPENAI,
 * GEMINI_API_KEY or OPENAI_API_KEY, AQB_AI_STAGING_FOLDER_ID.
 * Optional: AQB_GEMINI_IMAGE_MODEL (default gemini-2.5-flash-image),
 * AQB_OPENAI_IMAGE_MODEL (default gpt-image-1).
 */
function AQBGetNewServicePhotoContext_(catalogueId){
  const id=String(catalogueId||'').trim().toUpperCase();
  if(!/^AQBCAT\d{3,}$/.test(id))throw Error('Invalid AQBCAT ID');
  const sh=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),hm=AQBBuildHeaderMap(sh);
  ['Catalogue ID','Service Name','Category','Active'].forEach(function(k){if(!hm[k])throw Error('Catalogue missing '+k);});
  const rows=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).getValues():[];
  const matches=rows.filter(function(r){return String(r[hm['Catalogue ID']-1]||'').trim().toUpperCase()===id;});
  if(matches.length!==1)throw Error('Expected one Catalogue service for '+id+'; found '+matches.length);
  const r=matches[0];
  return {catalogueId:id,serviceName:String(r[hm['Service Name']-1]||''),category:String(r[hm['Category']-1]||''),description:hm['Description']?String(r[hm['Description']-1]||''):'',photoBrief:hm['Photo Brief']?String(r[hm['Photo Brief']-1]||'').trim():'',active:AQBNormalizeBool(r[hm['Active']-1])};
}
function AQBBuildNewServiceImagePrompt_(service){
  // The canonical Catalogue Photo Brief is the primary visual specification.
  // Never substitute a generic category prompt for a missing editorial brief.
  const brief=String(service.photoBrief||'').trim();
  if(!brief)throw Error('Catalogue Photo Brief is missing for '+service.catalogueId+'; review editorial content before generating an image.');
  const id=String(service.catalogueId||'').trim(),name=String(service.serviceName||'').trim();
  if(!/^AQBCAT\d{3,}$/.test(id)||!name)throw Error('Invalid Catalogue identity for image prompt.');
  return 'Create one photorealistic professional AQB Studio service catalogue photograph. '
    +'Follow the exact service-specific Photo Brief as the primary visual specification; '
    +'do not substitute a visually similar service. '
    +'Catalogue ID: '+id+'. Service: '+name+'. Category: '+String(service.category||'')+'. '
    +'PHOTO BRIEF (authoritative): '+brief+'\n'
    +'Supporting service description (context only): '+String(service.description||'')+'. '
    +'Show accurate technique and realistic hair detail. No text, watermark, logos, collage, '
    +'unrelated hairstyle, or implication that this is a photograph of actual AQB client work. '
    +'Generated result is a candidate only and must not be published without approval.';
}

function AQBPrepareNewServicePhotoStaging(catalogueId){
  AQBRequireCataloguePhotoManager();
  const service=AQBGetNewServicePhotoContext_(catalogueId);
  const sh=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
  if(!sh)throw Error('AQB Photo Staging missing');
  const hm=AQBBuildHeaderMap(sh);
  if(!hm['Catalogue ID']||!hm['Candidate Image URL'])throw Error('Photo Staging missing Catalogue ID or Candidate Image URL');
  function findRows(){
    const values=sh.getLastRow()>1?sh.getRange(2,hm['Catalogue ID'],sh.getLastRow()-1,1).getValues():[];
    const matches=[];values.forEach(function(r,i){if(String(r[0]||'').trim().toUpperCase()===service.catalogueId)matches.push(i+2);});
    return matches;
  }
  let matches=findRows();
  // Existing staging rows are authoritative; do not re-sync and overwrite approved evidence.
  if(matches.length===0){
    AQBSyncChangedCatalogueIdsToPhotoStaging([service.catalogueId]);
    matches=findRows();
  }
  if(matches.length!==1)throw Error('Photo Staging identity mismatch for '+service.catalogueId+'; found '+matches.length);
  return {catalogueId:service.catalogueId,stagingRow:matches[0],status:'AWAITING_AI_IMAGE_REVIEW',prompt:AQBBuildNewServiceImagePrompt_(service),publicationWrites:0};
}
function AQBPreviewNewServiceAIPhoto(catalogueId){
  AQBRequireCataloguePhotoManager();
  const service=AQBGetNewServicePhotoContext_(catalogueId);
  // Active means the service can be booked; it is not an AI candidate approval state.
  return {service:service,prompt:AQBBuildNewServiceImagePrompt_(service),requiresManualGenerate:true,requiresApproval:true,publicationWrites:0,
    warning:service.active?'Active service: the current approved image and approval status must remain unchanged.':'New candidate remains unapproved.'};
}
function AQBGenerateNewServiceAIPhoto(input){
  AQBRequireCataloguePhotoManager();
  input=input||{};
  if(input.confirmGenerate!==true)throw Error('Explicit Generate Image confirmation required');
  const service=AQBGetNewServicePhotoContext_(input.catalogueId);
  // Candidate generation is allowed for active services; publication and approval remain separate.
  const lock=LockService.getScriptLock();if(!lock.tryLock(30000))throw Error('Photo staging busy');
  try{
    const stage=AQBPrepareNewServicePhotoStaging(service.catalogueId);
    const sh=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),hm=AQBBuildHeaderMap(sh);
    if(!hm['Candidate Image URL'])throw Error('Photo Staging missing Candidate Image URL');
    const existing=String(sh.getRange(stage.stagingRow,hm['Candidate Image URL']).getValue()||'').trim();
    if(existing){
      const qualification=hm['Qualification Status']?String(sh.getRange(stage.stagingRow,hm['Qualification Status']).getValue()||'').trim().toUpperCase():'';
      const decision=hm['Review Decision']?String(sh.getRange(stage.stagingRow,hm['Review Decision']).getValue()||'').trim().toUpperCase():'';
      if(['APPROVED','QUALIFIED','PUBLISHABLE'].includes(qualification)||decision==='APPROVED')
        throw Error('Existing staging candidate has approved or qualified status; use the protected Photo Manager replacement workflow.');
      if(!input.confirmReplaceUnapprovedCandidate)throw Error('Staging already has a candidate; explicitly confirm replacement of the unapproved candidate.');
    }
    const props=PropertiesService.getScriptProperties();
    const provider=String(input.provider||props.getProperty('AQB_AI_IMAGE_PROVIDER')||'').trim().toUpperCase();
    const folderId=String(props.getProperty('AQB_AI_STAGING_FOLDER_ID')||'').trim();
    if(!folderId)throw Error('Configure AQB_AI_STAGING_FOLDER_ID in Script Properties');
    const prompt=AQBBuildNewServiceImagePrompt_(service);
    let bytes,mime='image/png',model;
    if(provider==='GEMINI'){
      const key=props.getProperty('GEMINI_API_KEY');if(!key)throw Error('Gemini API key missing');
      model=props.getProperty('AQB_GEMINI_IMAGE_MODEL')||'gemini-2.5-flash-image';
      if(!/^[a-zA-Z0-9._-]+$/.test(model))throw Error('Invalid Gemini model');
      const response=UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/'+model+':generateContent',{
        method:'post',contentType:'application/json',headers:{'x-goog-api-key':key},
        payload:JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{responseModalities:['TEXT','IMAGE']}}),muteHttpExceptions:true});
      if(response.getResponseCode()!==200)throw Error('Gemini image request failed HTTP '+response.getResponseCode());
      const body=JSON.parse(response.getContentText()),parts=((body.candidates||[])[0]||{}).content;
      const item=((parts||{}).parts||[]).find(function(p){return p.inlineData&&p.inlineData.data;});
      if(!item)throw Error('Gemini returned no image data');
      mime=item.inlineData.mimeType||mime;bytes=Utilities.base64Decode(item.inlineData.data);
    }else if(provider==='OPENAI'){
      const key=props.getProperty('OPENAI_API_KEY');if(!key)throw Error('OpenAI API key missing');
      model=props.getProperty('AQB_OPENAI_IMAGE_MODEL')||'gpt-image-1';
      const response=UrlFetchApp.fetch('https://api.openai.com/v1/images/generations',{
        method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+key},
        payload:JSON.stringify({model:model,prompt:prompt,n:1,size:'1024x1024'}),muteHttpExceptions:true});
      if(response.getResponseCode()!==200)throw Error('OpenAI image request failed HTTP '+response.getResponseCode());
      const body=JSON.parse(response.getContentText()),b64=((body.data||[])[0]||{}).b64_json;
      if(!b64)throw Error('OpenAI returned no base64 image data');
      bytes=Utilities.base64Decode(b64);
    }else throw Error('Select GEMINI or OPENAI image provider');
    if(!bytes||bytes.length<10000||bytes.length>18000000||!/^image\/(png|jpeg|webp)$/.test(mime))throw Error('Generated image failed basic MIME/size validation');
    const ext=mime==='image/jpeg'?'jpg':mime==='image/webp'?'webp':'png';
    const file=DriveApp.getFolderById(folderId).createFile(Utilities.newBlob(bytes,mime,service.catalogueId+'_AQB_STUDIO_CANDIDATE.'+ext));
    const url='https://drive.google.com/uc?export=view&id='+file.getId();
    sh.getRange(stage.stagingRow,hm['Candidate Image URL']).setValue(url);
    if(hm['Candidate Source'])sh.getRange(stage.stagingRow,hm['Candidate Source']).setValue('AQB Studio');
    // Do not reset Qualification Status: it may certify the currently published image.
    // Do not overwrite existing approved-photo provenance with candidate provenance.
    AQBLogAudit('GENERATE_SERVICE_PHOTO_CANDIDATE','Photography',service.catalogueId,'AI image candidate staged for manual review; provider '+provider);
    return {success:true,catalogueId:service.catalogueId,provider:provider,model:model,stagingRow:stage.stagingRow,candidateFileId:file.getId(),status:'PENDING_REVIEW',approved:false,published:false};
  }finally{lock.releaseLock();}
}



/* AQB26 — Approval-before-staging temporary preview adapter.
 * Candidate image bytes live only in per-script CacheService for 30 minutes;
 * neither Photo Staging nor the permanent AQB Photo folder is written until stage.
 * Cache is ephemeral: expired previews must be regenerated/uploaded.
 */
function AQB26PreviewKey_(id){return 'AQB26_'+id+'_'+Utilities.getUuid().replace(/-/g,'');}
function AQB26StorePreview_(service,bytes,mime,source){
  if(!bytes||bytes.length<10000||bytes.length>2500000||!/^image\/(png|jpeg|webp)$/.test(mime))throw Error('Preview must be PNG/JPEG/WebP, 10KB–2.5MB. Resize image before retrying.');
  const cache=CacheService.getScriptCache(),token=AQB26PreviewKey_(service.catalogueId),b64=Utilities.base64Encode(bytes),parts=b64.match(/.{1,70000}/g)||[];
  if(parts.length>55)throw Error('Preview exceeds temporary cache limits');
  const actor=AQBRequireCataloguePhotoManager(),owner=String(actor.email||Session.getActiveUser().getEmail()||'').toLowerCase();
  if(!owner)throw Error('Reviewer email required for secure preview ownership');
  parts.forEach(function(x,i){cache.put(token+'_'+i,x,1800);});
  const digest=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes));
  cache.put(token,JSON.stringify({id:service.catalogueId,owner:owner,mime:mime,parts:parts.length,digest:digest,source:source,approved:false}),1800);
  return {success:true,catalogueId:service.catalogueId,previewToken:token,dataUrl:'data:'+mime+';base64,'+b64,source:source,approved:false,staged:false,published:false,expiresInMinutes:30};
}
function AQB26ReadPreview_(input,requireApproved){
  AQBRequireCataloguePhotoManager();const id=String(input.catalogueId||'').toUpperCase(),token=String(input.previewToken||'');
  if(!/^AQBCAT\d{3,}$/.test(id)||!/^AQB26_AQBCAT\d{3,}_[a-f0-9]{32}$/.test(token)||token.indexOf('AQB26_'+id+'_')!==0)throw Error('Invalid preview identity');
  const cache=CacheService.getScriptCache(),raw=cache.get(token);if(!raw)throw Error('Preview expired; generate or upload again');
  const meta=JSON.parse(raw),actor=AQBRequireCataloguePhotoManager(),owner=String(actor.email||Session.getActiveUser().getEmail()||'').toLowerCase();
  if(meta.id!==id||!owner||meta.owner!==owner)throw Error('Preview owner or service mismatch');
  if(requireApproved&&!meta.approved)throw Error('Approve exact preview before staging');
  const parts=[];for(let i=0;i<meta.parts;i++){const part=cache.get(token+'_'+i);if(!part)throw Error('Preview expired or incomplete');parts.push(part);}
  const bytes=Utilities.base64Decode(parts.join(''));
  if(Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes))!==meta.digest)throw Error('Preview checksum mismatch');
  return {cache:cache,meta:meta,bytes:bytes,token:token};
}
function AQB26GeneratePreview(input){
  AQBRequireCataloguePhotoManager();input=input||{};if(input.confirmGenerate!==true)throw Error('Explicit AI generation confirmation required');
  const service=AQBGetNewServicePhotoContext_(input.catalogueId);
    const props=PropertiesService.getScriptProperties();
    const provider=String(input.provider||props.getProperty('AQB_AI_IMAGE_PROVIDER')||'').trim().toUpperCase();
    const prompt=AQBBuildNewServiceImagePrompt_(service);
    let bytes,mime='image/png',model;
    if(provider==='GEMINI'){
      const key=props.getProperty('GEMINI_API_KEY');if(!key)throw Error('Gemini API key missing');
      model=props.getProperty('AQB_GEMINI_IMAGE_MODEL')||'gemini-2.5-flash-image';
      if(!/^[a-zA-Z0-9._-]+$/.test(model))throw Error('Invalid Gemini model');
      const response=UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/'+model+':generateContent',{
        method:'post',contentType:'application/json',headers:{'x-goog-api-key':key},
        payload:JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{responseModalities:['TEXT','IMAGE']}}),muteHttpExceptions:true});
      if(response.getResponseCode()!==200)throw Error('Gemini image request failed HTTP '+response.getResponseCode());
      const body=JSON.parse(response.getContentText()),parts=((body.candidates||[])[0]||{}).content;
      const item=((parts||{}).parts||[]).find(function(p){return p.inlineData&&p.inlineData.data;});
      if(!item)throw Error('Gemini returned no image data');
      mime=item.inlineData.mimeType||mime;bytes=Utilities.base64Decode(item.inlineData.data);
    }else if(provider==='OPENAI'){
      const key=props.getProperty('OPENAI_API_KEY');if(!key)throw Error('OpenAI API key missing');
      model=props.getProperty('AQB_OPENAI_IMAGE_MODEL')||'gpt-image-1';
      const response=UrlFetchApp.fetch('https://api.openai.com/v1/images/generations',{
        method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+key},
        payload:JSON.stringify({model:model,prompt:prompt,n:1,size:'1024x1024'}),muteHttpExceptions:true});
      if(response.getResponseCode()!==200)throw Error('OpenAI image request failed HTTP '+response.getResponseCode());
      const body=JSON.parse(response.getContentText()),b64=((body.data||[])[0]||{}).b64_json;
      if(!b64)throw Error('OpenAI returned no base64 image data');
      bytes=Utilities.base64Decode(b64);
    }else throw Error('Select GEMINI or OPENAI image provider');

  return AQB26StorePreview_(service,bytes,mime,'AQB Studio '+provider);
}
function AQB26UploadPreview(input){
  AQBRequireCataloguePhotoManager();input=input||{};
  const service=AQBGetNewServicePhotoContext_(input.catalogueId),mime=String(input.mime||'').toLowerCase(),data=String(input.base64||'');
  if(data.length>3500000||!(/^[a-zA-Z0-9+/=]+$/.test(data)))throw Error('Invalid or oversized uploaded image');
  return AQB26StorePreview_(service,Utilities.base64Decode(data),mime,'Own photo');
}
function AQB26ApprovePreview(input){
  input=input||{};if(input.confirm!==true||input.visualMatchConfirmed!==true)throw Error('Explicit approval and visual-match confirmation required');
  const r=AQB26ReadPreview_(input,false),service=AQBGetNewServicePhotoContext_(input.catalogueId);
  if(!service.photoBrief)throw Error('Canonical Photo Brief missing');
  const ss=AQBGetSpreadsheet();let ledger=ss.getSheetByName('AQB Photo Approval Decisions');
  if(!ledger){ledger=ss.insertSheet('AQB Photo Approval Decisions');ledger.appendRow(['Timestamp','Catalogue ID','Candidate Image URL','Decision','Reviewer','Review Note','Legacy Hold','Visual Match Confirmed','Version','Publication Writes']);}
  const approvalRef='PREVIEW_SHA256:'+r.meta.digest;
  ledger.appendRow([new Date(),service.catalogueId,approvalRef,'APPROVED',r.meta.owner,String(input.note||'').slice(0,1500),false,true,'AQB26',0]);
  r.meta.approved=true;r.cache.put(r.token,JSON.stringify(r.meta),1800);
  return {success:true,catalogueId:service.catalogueId,approved:true,staged:false,published:false,approvalRef:approvalRef};
}
function AQB26StageApprovedPreview(input){
  input=input||{};if(input.confirm!==true)throw Error('Explicit staging confirmation required');
  const lock=LockService.getScriptLock();if(!lock.tryLock(30000))throw Error('Photo staging busy');
  try{
    const r=AQB26ReadPreview_(input,true),service=AQBGetNewServicePhotoContext_(input.catalogueId),ss=AQBGetSpreadsheet();
    const ledger=ss.getSheetByName('AQB Photo Approval Decisions');if(!ledger)throw Error('Approval ledger missing');
    const lv=ledger.getDataRange().getValues(),approved=lv.slice(1).some(function(row){return String(row[1])===service.catalogueId&&String(row[2])==='PREVIEW_SHA256:'+r.meta.digest&&String(row[3])==='APPROVED'&&String(row[4]).toLowerCase()===r.meta.owner;});
    if(!approved)throw Error('Matching preview approval not found');
    const folderId=AQBNormalizeDriveFolderId(AQBGetSetupSetting('Catalogue Own Photo Folder ID'));
    if(!folderId)throw Error('Configure existing Catalogue Own Photo Folder ID in AQB Setup');
    const sh=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);if(!sh)throw Error('Photo Staging missing');
    const hm=AQBBuildHeaderMap(sh);if(!hm['Catalogue ID']||!hm['Candidate Image URL'])throw Error('Photo Staging columns missing');
    let rows=[];if(sh.getLastRow()>1)sh.getRange(2,hm['Catalogue ID'],sh.getLastRow()-1,1).getValues().forEach(function(x,i){if(String(x[0]).trim().toUpperCase()===service.catalogueId)rows.push(i+2);});
    if(rows.length>1)throw Error('Duplicate Photo Staging identity');
    if(rows.length===1){
      const existing=String(sh.getRange(rows[0],hm['Candidate Image URL']).getValue()||'').trim();
      if(existing){
        const m=existing.match(/[?&]id=([A-Za-z0-9_-]{15,})/);
        if(!m)throw Error('Existing candidate URL cannot be verified; no duplicate created');
        const oldFile=DriveApp.getFileById(m[1]);
        const oldDigest=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,oldFile.getBlob().getBytes()));
        if(oldDigest===r.meta.digest)return {success:true,catalogueId:service.catalogueId,staged:true,reused:true,published:false,fileId:oldFile.getId(),candidateUrl:existing,message:'Identical photo already staged; existing record reused'};
        throw Error('Different candidate already staged. Replacement requires explicit confirmation and protected approval; existing photo unchanged.');
      }
    }
    // Recheck before creating Drive file; the existing approved Catalogue photo is never overwritten.
    const ext=r.meta.mime==='image/jpeg'?'jpg':r.meta.mime==='image/webp'?'webp':'png';
    const file=DriveApp.getFolderById(folderId).createFile(Utilities.newBlob(r.bytes,r.meta.mime,service.catalogueId+'_AQB_APPROVED_'+r.meta.digest.slice(0,12)+'.'+ext));
    const url='https://drive.google.com/uc?export=view&id='+file.getId();
    try{
      if(!rows.length)throw Error('Photo Staging identity row missing; run existing read-only reconciliation and prepare identity before retrying');
      if(rows.length!==1)throw Error('Photo Staging row not uniquely established');
      if(String(sh.getRange(rows[0],hm['Candidate Image URL']).getValue()||'').trim())throw Error('Candidate appeared during staging; no overwrite');
      sh.getRange(rows[0],hm['Candidate Image URL']).setValue(url);
      // Bind the original visual approval to the exact permanent Drive asset.
      ledger.appendRow([new Date(),service.catalogueId,url,'APPROVED',r.meta.owner,'Approved own-photo preview SHA256 '+r.meta.digest,false,true,'AQB',0]);
      if(hm['Candidate Source'])sh.getRange(rows[0],hm['Candidate Source']).setValue(r.meta.source);
      AQBLogAudit('STAGE_APPROVED_PREVIEW','Photography',service.catalogueId,'Approved preview staged; Drive file '+file.getId());
    }catch(e){file.setTrashed(true);throw e;}
    r.cache.remove(r.token);for(let i=0;i<r.meta.parts;i++)r.cache.remove(r.token+'_'+i);
    return {success:true,catalogueId:service.catalogueId,staged:true,approved:true,published:false,fileId:file.getId(),candidateUrl:url,qualification:'REQUIRES_V16_RECONCILIATION'};
  }finally{lock.releaseLock();}
}

// ===== Consolidated from V17.0.7_CUSTOMER_DELETION_PREFLIGHT.gs =====
/** AQB V17.0.7 — exhaustive workbook-wide read-only customer reference inventory.
 * IMPORTANT: This inventory cannot certify external providers, backups, or free-text references.
 * Destructive operations remain disabled.
 */
function AQBGetCustomerDeletionPreview(customerId) {
  const actor=AQBRequireCustomerManager();
  const id=String(customerId||'').trim().toUpperCase();
  if(!/^AQB\d{3,}$/.test(id)||AQBIsTestCustomer(id))throw new Error('Invalid or reserved customer ID.');
  const ss=AQBGetSpreadsheet(),sheets=ss.getSheets(),results=[];
  let customerCount=0,totalReferences=0;
  sheets.forEach(function(sheet){
    const name=sheet.getName(),last=sheet.getLastRow(),width=sheet.getLastColumn();
    if(!last||!width){results.push({sheet:name,status:'EMPTY',count:0});return;}
    const headers=sheet.getRange(1,1,1,width).getDisplayValues()[0];
    const columns=[];
    headers.forEach(function(h,i){if(/^customer\s*(id|aqbid)$/i.test(String(h||'').trim())||/^aqbid$/i.test(String(h||'').trim()))columns.push(i+1);});
    if(!columns.length){results.push({sheet:name,status:'NO_EXPLICIT_ID_COLUMN',count:null});return;}
    let count=0;
    columns.forEach(function(col){if(last>1)sheet.getRange(2,col,last-1,1).getDisplayValues().forEach(function(row){if(String(row[0]||'').trim().toUpperCase()===id)count++;});});
    if(name===CONFIG.SHEETS.CUSTOMERS)customerCount=count;
    else totalReferences+=count;
    results.push({sheet:name,status:'CHECKED',count:count,columns:columns});
  });
  if(customerCount!==1)throw new Error('Customer missing or duplicated; deletion blocked.');
  return {customerId:id,actorRole:actor.role,readOnly:true,archiveAllowed:false,eraseAllowed:false,identityReuseAllowed:false,
    dependencies:results,totalExplicitReferences:totalReferences,
    blockers:['Workbook scan covers explicit AQBID columns only; implicit phone, text and foreign-key references may remain.',
      'WhatsApp/Meta, Google Contacts, calendar, retie triggers, backups, logs and retention requirements are not certified.',
      'No proven identity generation isolation or safe reusable-ID allocator is installed.'],
    message:'Preview only. No deletion, archive, restore or ID release is enabled.'};
}


