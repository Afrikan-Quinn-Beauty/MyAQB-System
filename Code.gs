function AQBVerifyMetaCatalogue(){
  AQBRequireAdmin();
  const data=AQBBuildChannelCatalogueRows('META'),expected={};
  data.rows.forEach(function(x){expected[x.id]=true;});
  const res=AQBSendMetaCatalogueRequest('get','/products?fields=id,retailer_id,name&limit=500'),
        existing=Array.isArray(res.data)?res.data:[],actual={},duplicates=[];
  existing.forEach(function(x){
    const id=String(x.retailer_id||x.id||'').trim();if(!id)return;
    if(actual[id])duplicates.push(id);actual[id]=x;
  });
  const missing=data.rows.map(function(x){return x.id;}).filter(function(id){return !actual[id];}),
        extra=Object.keys(actual).filter(function(id){return !expected[id];}),
        syncEntries=[];
  Object.keys(actual).forEach(function(id){
    if(expected[id])syncEntries.push({catalogueId:id,channel:'META',remoteObjectId:String(actual[id].id||''),status:'VERIFIED',syncedAt:new Date(),error:''});
  });
  AQBWriteChannelSyncBatch(syncEntries);
  return {success:missing.length===0&&extra.length===0&&duplicates.length===0,expected:data.rows.length,actual:existing.length,matched:data.rows.length-missing.length,missing:missing,extra:extra,duplicates:duplicates,identity:'Catalogue ID / retailer_id',message:(missing.length||extra.length||duplicates.length)?'Meta catalogue does not yet exactly match the current AQB eligible Catalogue ID set.':'Meta catalogue matches the current AQB eligible Catalogue ID set.'};
}

function AQBGetDefaultPublishChannels(){
  return 'WEB,META,TIKTOK,PINTEREST';
}

function AQBNormalizePublishChannels(value){
  const allowed={WEB:true,META:true,TIKTOK:true,PINTEREST:true},seen={},out=[];
  String(value||'').split(/[,;|]+/).forEach(function(v){
    const k=String(v||'').trim().toUpperCase();
    if(k&&allowed[k]&&!seen[k]){seen[k]=true;out.push(k);}
  });
  return out.join(',');
}

function AQBHasCatalogueChannel(row,cm,channel){
  channel=String(channel||'').trim().toUpperCase();
  if(!channel)return false;
  const explicit=cm['Publish Channels']?AQBNormalizePublishChannels(row[cm['Publish Channels']-1]):'';
  if(explicit)return explicit.split(',').indexOf(channel)>=0;

  // Compatibility bridge for pre-C.4.7.2 Catalogue sheets before migration.
  function legacyYes(h){
    if(!cm[h])return null;
    const v=String(row[cm[h]-1]||'').trim().toLowerCase();
    if(!v)return null;
    return !(v==='no'||v==='false'||v==='0'||v==='off'||v==='inactive');
  }
  if(channel==='META'){
    const vals=[legacyYes('Meta'),legacyYes('WhatsApp'),legacyYes('Instagram')].filter(function(v){return v!==null;});
    if(vals.length)return vals.some(Boolean);
  }
  if(channel==='TIKTOK'){
    const v=legacyYes('TikTok'); if(v!==null)return v;
  }
  if(channel==='WEB'){
    const v=legacyYes('Website'); if(v!==null)return v;
  }
  // Blank/unmigrated Catalogue rows inherit the AQB all-channel target.
  return AQBGetDefaultPublishChannels().split(',').indexOf(channel)>=0;
}

function AQBEnsureCatalogueUnifiedChannelFields(sheet,cm){
