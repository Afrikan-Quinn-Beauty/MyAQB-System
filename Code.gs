          repair.conflicts.push({row:i+2,trendId:trendId,reason:'CONFLICTING_EXISTING_CANONICAL_ID'});return;
        }
        if(!/^CAT-\d+$/.test(legacyId)){repair.conflicts.push({row:i+2,trendId:trendId,reason:'UNEXPECTED_LEGACY_ID'});return;}
        const notes=cell(td,r,'Review Notes');
        const marker='Legacy Catalogue ID: '+legacyId;
        const revisedNotes=notes.indexOf(marker)!==-1?notes:(notes?notes+' | ':'')+marker;
        plan.push({row:i+2,trendId:trendId,from:legacyId,to:target,notes:revisedNotes,oldNotes:notes,variant:variant});
      });
      repair.eligible=plan.length;
      repair.changes=plan.map(function(p){return {row:p.row,trendId:p.trendId,from:p.from,to:p.to,variant:p.variant};});
      // The known dataset comprises 50 approved trend rows. Fail closed on drift.
      if(commit){
        if(repair.conflicts.length||plan.length+repair.alreadyCanonical!==50||
           trendSummary.trendRows!==50||trendSummary.inboxRows!==8){
          throw new Error('TREND_IDENTITY_REPAIR_PREFLIGHT_FAILED: '+JSON.stringify({eligible:plan.length,already:repair.alreadyCanonical,conflicts:repair.conflicts.length,trendRows:trendSummary.trendRows,inboxRows:trendSummary.inboxRows}));
        }
        // Preserve history BEFORE changing the identifier on each row.
        const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('AQB AI Trends');
        plan.forEach(function(p){
          const currentId=String(sh.getRange(p.row,catalogueIdCol+1).getValue()||'').trim();
          const currentNotes=String(sh.getRange(p.row,notesCol+1).getValue()||'').trim();
          if(currentId!==p.from||currentNotes!==p.oldNotes)throw new Error('TREND_IDENTITY_CONCURRENT_CHANGE_ROW_'+p.row);
          sh.getRange(p.row,notesCol+1).setValue(p.notes);
          sh.getRange(p.row,catalogueIdCol+1).setValue(p.to);
          repair.updated++;repair.writes+=2;repair.legacyPreserved++;
        });
      }
    }
  }
  out.trendIdentityRepair=repair;
  out.readOnly=!commit;out.writes=repair.writes;
  Logger.log('=== AQB V16.21.15.3 CANONICAL TREND IDENTITY '+(commit?'COMMIT':'PREVIEW')+' ===');
  Logger.log(JSON.stringify(Object.assign({},repair,{changes:undefined,changeCount:repair.changes.length})));
  for(let i=0;i<repair.changes.length;i+=10)Logger.log('TREND_IDENTITY_PLAN '+JSON.stringify(repair.changes.slice(i,i+10)));
  out.trendReconciliation=trendSummary;
  Logger.log('=== AQB V16.21.15.2 READ-ONLY TREND IDENTITY AUDIT ===');
  const trendCompact=Object.assign({},trendSummary,{unresolved:undefined,unresolvedCount:trendSummary.unresolved.length});
  Logger.log(JSON.stringify(trendCompact));
  for(let i=0;i<trendSummary.unresolved.length;i+=5)Logger.log('TREND_UNRESOLVED '+JSON.stringify(trendSummary.unresolved.slice(i,i+5)));
  // V16.21.15.4.1: read-only DNB configuration/availability diagnostic.
  // Never invoke ensure helpers, URL fetchers, feed writers, or the daily job here.
  const dnbDiag={version:'V16.21.15.4.1',readOnly:true,writes:0,networkUsed:false,
    route:'doPost ?route=dnb-ingest',deliveryMode:'EXTERNAL_PUSH',expectedItems:5,
    externalSenderVerified:false,externalDeliveryTested:false,authenticationTested:false,
    errors:[],warnings:[],sheets:{},scriptProperties:{},dailyTriggers:[]};
  try{
    const props=PropertiesService.getScriptProperties();
    dnbDiag.scriptProperties.AQB_DNB_FEED_TOKEN_PRESENT=!!String(props.getProperty(CONFIG.DNB_FEED.TOKEN_PROPERTY)||'').trim();
    if(!dnbDiag.scriptProperties.AQB_DNB_FEED_TOKEN_PRESENT)dnbDiag.warnings.push('DNB_FEED_TOKEN_NOT_CONFIGURED');
  }catch(e){dnbDiag.errors.push('PROPERTIES_READ_FAILED: '+String(e&&e.message||e));}
  try{
    const ss=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
    [CONFIG.SHEETS.DNB_FEED,CONFIG.SHEETS.DNB_STATUS,'AQB AI Signals','AQB AI Trends'].forEach(function(name){
      const sh=ss.getSheetByName(name);
      dnbDiag.sheets[name]=sh?{exists:true,rows:Math.max(0,sh.getLastRow()-1),columns:sh.getLastColumn()}:{exists:false,rows:null};
      if(!sh)dnbDiag.warnings.push('MISSING_SHEET: '+name);
    });
    if(dnbDiag.sheets[CONFIG.SHEETS.DNB_FEED]&&dnbDiag.sheets[CONFIG.SHEETS.DNB_FEED].rows===0)dnbDiag.warnings.push('DNB_FEED_EMPTY');
    if(dnbDiag.sheets[CONFIG.SHEETS.DNB_STATUS]&&dnbDiag.sheets[CONFIG.SHEETS.DNB_STATUS].rows===0)dnbDiag.warnings.push('DNB_STATUS_EMPTY');
    const status=ss.getSheetByName(CONFIG.SHEETS.DNB_STATUS);
    if(status&&status.getLastRow()>1){
      const r=status.getRange(2,1,status.getLastRow()-1,Math.min(3,status.getLastColumn())).getValues();
      const allowed=['LAST_SUCCESSFUL_FEED','LAST_ATTEMPTED_FEED','ITEMS_RECEIVED','ITEMS_PROCESSED','ITEMS_REJECTED','API_STATUS','LAST_ERROR','BRIEF_DATE'];
      dnbDiag.statusMetrics={};
      r.forEach(function(v){const k=String(v[0]||'').trim();if(allowed.indexOf(k)!==-1){
        const x=v[1];dnbDiag.statusMetrics[k]=x instanceof Date?Utilities.formatDate(x,'Africa/Nairobi','yyyy-MM-dd HH:mm:ss'):String(x||'').slice(0,160);
      }});
    }
  }catch(e){dnbDiag.errors.push('SHEET_READ_FAILED: '+String(e&&e.message||e));}
  try{
    dnbDiag.dailyTriggers=ScriptApp.getProjectTriggers().filter(function(t){return t.getHandlerFunction()==='AQBRunDailyTrendIntelligence';}).map(function(t){return {handler:t.getHandlerFunction(),eventType:String(t.getEventType()),source:String(t.getTriggerSource())};});
    if(!dnbDiag.dailyTriggers.length)dnbDiag.warnings.push('DAILY_TREND_TRIGGER_NOT_VISIBLE_TO_RUNNER');
  }catch(e){dnbDiag.errors.push('TRIGGERS_READ_FAILED: '+String(e&&e.message||e));}
  dnbDiag.warnings.push('DAILY_HANDLER_CATCHES_ERRORS_AND_RETURNS_FAILURE_OBJECT: TRIGGER_FAILURE_RATE_NOT_PROOF_OF_SUCCESS');
  dnbDiag.warnings.push('DNB_PUSH_DELIVERY_AND_SENDER_OWNERSHIP_NOT_VERIFIED_BY_THIS_AUDIT');
  out.dnbConnectionDiagnostic=dnbDiag;
  Logger.log('=== AQB V16.21.15.4.1 DNB READ-ONLY CONNECTION DIAGNOSTIC ===');
  Logger.log(JSON.stringify(dnbDiag));
  Logger.log('=== AQB CATALOGUE TIER/CATEGORY AUTHORITY AUDIT ===');Logger.log(JSON.stringify(out));return out;
