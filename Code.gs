function AQBSetAQBDNBStatus(values){
  // V16.21.15.4: merge status metrics; never erase earlier success/error checkpoints.
  const s=AQBGetSheet(CONFIG.SHEETS.DNB_STATUS), headers=s.getRange(1,1,1,3).getValues()[0];
  if(headers.join('|')!==DNB_STATUS_HEADERS.join('|'))throw new Error('DNB status schema mismatch: refusing destructive update.');
  const n=s.getLastRow(), existing=n>1?s.getRange(2,1,n-1,3).getValues():[], index={};
  existing.forEach(function(r,i){const key=String(r[0]||'').trim();if(key && index[key]===undefined)index[key]=i+2;});
  const now=new Date();
  Object.keys(values||{}).forEach(function(k){
    const key=String(k||'').trim();if(!key)return;
    const row=[key,values[k],now];
    if(index[key]!==undefined)s.getRange(index[key],1,1,3).setValues([row]);
    else {s.appendRow(row);index[key]=s.getLastRow();}
  });
}

function AQBValidateAQBDNBFeed(payload){
  payload=payload||{};
  if(String(payload.feed||'').trim()!=='AQB_DNB')throw new Error('Invalid DNB feed identifier. Expected AQB_DNB.');
  if(String(payload.version||'').trim()!=='1.0')throw new Error('Unsupported DNB feed version. Expected 1.0.');
  const items=Array.isArray(payload.items)?payload.items:[];
  if(items.length!==CONFIG.DNB_FEED.EXPECTED_ITEMS)throw new Error('DNB feed must contain exactly '+CONFIG.DNB_FEED.EXPECTED_ITEMS+' items; received '+items.length+'.');
  const ids={}; items.forEach(function(item,i){
    if(!item||!String(item.id||item.item_id||'').trim())throw new Error('DNB item '+(i+1)+' is missing id.');
    const sourceId=String(item.id||item.item_id).trim(); if(ids[sourceId])throw new Error('Duplicate DNB item id: '+sourceId); ids[sourceId]=true;
    if(!String(item.headline||'').trim())throw new Error('DNB item '+item.id+' is missing headline.');
    const url=String(item.source_url||item.sourceUrl||'').trim(); if(!/^https:\/\/[^\s/]+/i.test(url))throw new Error('DNB item '+sourceId+' requires a valid HTTPS source_url.');
  });
  return items;
}

