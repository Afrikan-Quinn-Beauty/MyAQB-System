/**
 * Canonical Kenya phone normalization. Return an E.164 string for recognizable
 * Kenyan mobile/landline numbers; return '' for malformed input.
 * Keep phone fields as TEXT in Sheets to preserve the leading '+'.
 * Landlines may be retained as contact data, but must not pass WhatsApp validation.
 */
function AQBNormalizePhone(phone){
  const raw = String(phone == null ? '' : phone).trim();
  if (!raw) return '';
  const compact = raw.replace(/[\s\-().]/g, '');
  if (!/^\+?\d+$/.test(compact)) return '';
  let digits = compact.replace(/^\+/, '');
  if (/^0[17]\d{8}$/.test(digits)) digits = '254' + digits.substring(1);
  else if (/^[17]\d{8}$/.test(digits)) digits = '254' + digits;
  else if (/^020\d{7}$/.test(digits)) digits = '254' + digits.substring(1);
  // Preserve valid Kenya mobile or Nairobi landline; reject other shapes.
  if (/^254(?:[17]\d{8}|20\d{7})$/.test(digits)) return '+' + digits;
  return '';
}

/** WhatsApp/customer-booking mobile eligibility, not landline validation. */
function AQBIsValidPhone(phone){
  return /^\+254[17]\d{8}$/.test(AQBNormalizePhone(phone));
}

/** Explicit alias for WhatsApp send guards and new integrations. */
function AQBIsWhatsAppEligiblePhone(phone){
  return AQBIsValidPhone(phone);
}

