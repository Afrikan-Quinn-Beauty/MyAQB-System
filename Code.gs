}

function AQBRecordPayment(payload){
  const user=AQBRequireAdmin();if(!payload)throw new Error('Payment information is required.');const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const appointmentId=String(payload.appointmentId||'').trim(),customerId=String(payload.customerId||'').trim(),method=String(payload.paymentMethod||'').trim(),type=String(payload.paymentType||'').trim(),status=String(payload.paymentStatus||'Paid').trim(),amount=Number(payload.amount),amountDue=Number(payload.amountDue||0);
    if(!AQBGetMasterListValues('Payment Method').includes(method))throw new Error('Invalid payment method.');if(!AQBGetMasterListValues('Payment Type').includes(type))throw new Error('Invalid payment type.');if(!AQBGetMasterListValues('Payment Status').includes(status))throw new Error('Invalid payment status.');if(!isFinite(amount)||amount<=0)throw new Error('Please enter a valid positive payment amount.');if(status!=='Paid')throw new Error('Only verified Paid transactions can be recorded as income. Pending, failed and cancelled transactions require separate non-income tracking.');if(/m[ -]?pesa|stk|daraja/i.test(method))throw new Error('M-Pesa payments cannot be recorded through the manual income endpoint. Use the server-verified reconciliation pathway; no receipt was posted.');
    let customerName=String(payload.customerName||''),service=String(payload.service||'');
    if(appointmentId){const a=AQBFindAppointment(appointmentId);if(!a)throw new Error('Appointment not found.');customerName=a.customerName;service=a.service;payload.customerId=a.customerId;amountDue=Number(a.chargedPrice||a.amountDue||0);}
    const id=AQBGeneratePaymentID(),date=payload.date?AQBParseDateFromClient(payload.date):new Date();
    const actualCustomerId=String(payload.customerId||customerId||'');
    const pSheet=AQBGetSheet(CONFIG.SHEETS.PAYMENTS);
    AQBAppendByHeaders(pSheet, {'Payment ID':id,'Date':date,'Customer ID':actualCustomerId,'Customer Name':customerName,'Appointment ID':appointmentId,'Service':service,'Payment Type':type,'Amount Due':amountDue,'Amount':amount,'Payment Method':method,'Payment Status':status,'Description':String(payload.description||'').trim(),'Recorded By':user.email});
    // Every valid payment creates exactly one linked income transaction.
    const txId=AQBGenerateTransactionID();
    AQBAppendByHeaders(AQBGetSheet(CONFIG.SHEETS.CASH_FLOW), {'Transaction ID':txId,'Date':date,'Customer ID':actualCustomerId,'Customer Name':customerName,'Appointment ID':appointmentId,'Service':service,'Transaction Type':'Income','Payment Method':method,'Amount':amount,'Payment Status':status,'Description':'Payment '+id+' — '+type,'Recorded By':user.email,'Source Payment ID':id});
    const row=[id,date,actualCustomerId,customerName,appointmentId,service,type,amountDue,amount,method,status,String(payload.description||'').trim(),user.email];
    if(appointmentId)AQBUpdateAppointmentPaymentStatus(appointmentId);
    if(actualCustomerId)AQBUpdateCustomerPaymentStatus(actualCustomerId);
    let metaPurchase={sent:false,skipped:true};
    try{
      if(status!=='Cancelled'){
        const ap=appointmentId?AQBFindAppointment(appointmentId):null;
        metaPurchase=AQBSendMetaPurchaseForPayment(id,ap,amount,actualCustomerId,customerName,service);
      }
    }catch(metaError){AQBLogAudit('META_PURCHASE_ERROR','Payment',id,String(metaError&&metaError.message||metaError));metaPurchase={sent:false,error:String(metaError&&metaError.message||metaError)};}
    AQBLogAudit('RECORD_PAYMENT','Payment',id,'Payment of KES '+amount+' recorded via '+method+'. Cash Flow income '+txId+' created automatically. Meta Purchase '+(metaPurchase.sent?'sent':'not sent')+'.');
    return {success:true,paymentId:id,transactionId:txId,metaPurchase:metaPurchase};
  }finally{lock.releaseLock();}
}

function AQBUpdateCustomerPaymentStatus(customerId){
