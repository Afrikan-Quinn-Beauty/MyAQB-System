function AQBNormalizeVariantText(value){
  return String(value||'').toLowerCase().replace(/[–—]/g,'-').replace(/&/g,' and ').replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim();
}

function AQBGetUniqueVariantValues(arr){
  const out=[],seen={};
  (arr||[]).forEach(function(x){const v=String(x||'').trim(),k=AQBNormalizeVariantText(v);if(v&&k&&!seen[k]){seen[k]=1;out.push(v);}});
  return out;
}

function AQBStemVariantTerm(value){
  let t=AQBNormalizeVariantText(value);
  if(t.indexOf(' ')>=0)return t;
  if(t.length>4&&/s$/.test(t)&&!/ss$/.test(t))t=t.slice(0,-1);
  return t;
}

function AQBBuildVariantTokenSet(value){
  const set={};
  AQBNormalizeVariantText(value).split(' ').filter(Boolean).forEach(function(t){set[AQBStemVariantTerm(t)]=1;});
  return set;
}

function AQBHasVariantTerm(hay,term){
  const h=AQBNormalizeVariantText(hay), t=AQBNormalizeVariantText(term);
  if(!h||!t)return false;
  if(h.indexOf(t)>=0)return true;
  const hs=AQBBuildVariantTokenSet(h), parts=t.split(' ').filter(Boolean);
  return parts.length>0&&parts.every(function(p){return !!hs[AQBStemVariantTerm(p)];});
}

function AQBCountVariantHits(hay,terms){
  const hits=[];
  AQBGetUniqueVariantValues(terms).forEach(function(t){if(AQBHasVariantTerm(hay,t))hits.push(t);});
  return hits;
}

function AQBGetMeaningfulVariantTokens(value,maxCount){
  const stop={
    the:1,and:1,with:1,for:1,from:1,this:1,that:1,into:1,onto:1,over:1,under:1,
    client:1,clients:1,service:1,style:1,styles:1,hair:1,hairstyle:1,hairstyles:1,
    photo:1,photos:1,professional:1,beauty:1,salon:1,using:1,used:1,show:1,shows:1,
    primary:1,subject:1,result:1,results:1,finish:1,finished:1,clear:1,realistic:1,
    african:1,black:1,woman:1,women:1,model:1,texture:1,requested:1,exact:1,
    technique:1,desired:1,look:1,ideal:1,seeking:1,provide:1,provides:1
  };
  const out=[];
  AQBNormalizeVariantText(value).split(' ').forEach(function(t){
    const stem=AQBStemVariantTerm(t);
    if(stem.length<4||stop[stem]||/^\d+$/.test(stem))return;
    if(out.indexOf(stem)<0)out.push(stem);
  });
  return out.slice(0,Math.max(1,Number(maxCount||10)));
}

