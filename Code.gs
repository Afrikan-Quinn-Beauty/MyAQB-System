function AQBCollectCatalogueIdsFromEditedRange(range){
  if(!range)return [];
  const sh=range.getSheet(),hm=AQBBuildHeaderMap(sh),seen={},ids=[];
  if(!hm['Catalogue ID'])return ids;
  for(let r=Math.max(2,range.getRow());r<=range.getLastRow();r++){
    const id=String(sh.getRange(r,hm['Catalogue ID']).getValue()||'').trim().toUpperCase();
    if(/^AQBCAT\d{3}$/.test(id)&&!seen[id]){seen[id]=true;ids.push(id);}
  }
  return ids;
}

function AQBRefreshServiceEngine(){
  const ss=AQBGetSpreadsheet();
  const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE);
  const cm=AQBBuildHeaderMap(cat);
  const headers=[
    'SKU','ServiceName','WhatItIs','HowPerformed','Distinctive',
    'ClientGets','WhoItSuits','PhotoBrief','ImageURL','Category'
  ];

  let db=ss.getSheetByName(CONFIG.SHEETS.SERVICE_ENGINE_DB);
  if(!db)db=ss.insertSheet(CONFIG.SHEETS.SERVICE_ENGINE_DB);

  const rows=cat.getLastRow()>=2
    ?cat.getRange(2,1,cat.getLastRow()-1,cat.getLastColumn()).getValues()
    :[];
  const out=[];
  const sourceCounts={FIRST_CLASS_SKU:0,USER_SUPPLIED_EDITORIAL:0,STRUCTURED_FALLBACK:0};
  const fallbackServices=[];

  rows.forEach(function(r){
    const sku=String(r[cm['Catalogue ID']-1]||'').trim().toUpperCase();
    const name=String(r[cm['Service Name']-1]||'').trim();
    const category=String(r[cm['Category']-1]||'').trim();
    if(!/^AQBCAT\d{3}$/.test(sku)||!name)return;

    let imageUrl='';
    ['Own Photo','Image URL','Representative Image'].some(function(h){
      if(!cm[h])return false;
      const v=String(r[cm[h]-1]||'').trim();
      if(v){imageUrl=v;return true;}
      return false;
    });

    const compiled=AQBGetServiceEngineDefinition(sku,{
      category:category,
      service:name,
      imageUrl:imageUrl,
      price:cm['Price']?r[cm['Price']-1]:''
    });
    if(!compiled)return;

    const f=compiled.fivePartDescription;
    const source=String(compiled.definitionSource||'STRUCTURED_FALLBACK');
    sourceCounts[source]=(sourceCounts[source]||0)+1;
    if(source==='STRUCTURED_FALLBACK'){
      fallbackServices.push({sku:sku,category:category,service:name});
    }
    out.push([
      sku,name,
      f.whatItIs,f.howPerformed,f.distinctive,f.clientGets,f.whoItSuits,
      compiled.photoBrief,compiled.imageUrl,category
    ]);
  });

  out.sort(function(a,b){
    return String(a[9]||'').localeCompare(String(b[9]||''),undefined,{sensitivity:'base'}) ||
      String(a[1]||'').localeCompare(String(b[1]||''),undefined,{sensitivity:'base'});
  });

  db.clearContents();
  db.getRange(1,1,1,headers.length).setValues([headers]);
  if(out.length)db.getRange(2,1,out.length,headers.length).setValues(out);
  db.setFrozenRows(1);

  const result={
    version:AQB_PHOTO_PIPELINE_VERSION_,
    sheet:CONFIG.SHEETS.SERVICE_ENGINE_DB,
    records:out.length,
    source:'Catalogue + Code.gs first-class five-part registry',
    key:'SKU = Catalogue ID',
    firstClassSkuDefinitions:Object.keys(AQB_FIVE_PART_DEFINITIONS_).length,
    userSuppliedEditorialDefinitions:Object.keys(AQB_FIVE_PART_SERVICE_DEFINITIONS_).length,
    definitionSources:sourceCounts,
    fallbackCount:fallbackServices.length,
    fallbackServices:fallbackServices,
    fields:headers,
    success:true
  };
  Logger.log('=== AQB SERVICE ENGINE REFRESH ===');
  Logger.log(JSON.stringify(result));
  return result;
}

function AQBGetServiceEngineDefinition(targetSku,context){
  const sku=String(targetSku||'').trim().toUpperCase();
  if(!/^AQBCAT\d{3}$/.test(sku))return null;

  const ctx=context||{};
  let category=String(ctx.category||'').trim();
  let name=String(ctx.service||ctx.name||'').trim();
  let imageUrl=String(ctx.imageUrl||'').trim();
  let price=ctx.price==null?'':ctx.price;

  /*
   * PERFORMANCE RULE:
   * When the caller already supplies Category + Service Name, compile entirely
   * in memory. Do not re-read Catalogue merely because ImageURL is blank.
   * Catalogue lookup is reserved for direct SKU calls where identity metadata
   * was not supplied (for example Catalogue.html requesting one SKU).
   */
  if(!category||!name){
    try{
      const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(cat);
      const rows=cat.getLastRow()>=2
        ?cat.getRange(2,1,cat.getLastRow()-1,cat.getLastColumn()).getValues()
        :[];

      for(let i=0;i<rows.length;i++){
        if(String(rows[i][cm['Catalogue ID']-1]||'').trim().toUpperCase()!==sku)continue;

        category=category||String(rows[i][cm['Category']-1]||'').trim();
        name=name||String(rows[i][cm['Service Name']-1]||'').trim();
        if(price==='')price=cm['Price']?rows[i][cm['Price']-1]:'';

        if(!imageUrl){
          ['Own Photo','Image URL','Representative Image'].some(function(h){
            if(!cm[h])return false;
            const v=String(rows[i][cm[h]-1]||'').trim();
            if(v){imageUrl=v;return true;}
            return false;
          });
        }
        break;
      }
    }catch(ignore){}
  }

  const serviceKey=category+'|'+name;
  let definitionSource='STRUCTURED_FALLBACK';
  let five=AQB_FIVE_PART_DEFINITIONS_[sku]||null;

  if(five){
    definitionSource='FIRST_CLASS_SKU';
  }else if(AQB_FIVE_PART_SERVICE_DEFINITIONS_[serviceKey]){
    five=AQB_FIVE_PART_SERVICE_DEFINITIONS_[serviceKey];
    definitionSource='USER_SUPPLIED_EDITORIAL';
  }

  if(!five){
    five={
      category:category,
      service:name,
      whatItIs:name+' is the named AQB professional hair or beauty service selected from the current Catalogue.',
      howPerformed:'The service is prepared and performed according to its named technique, the client’s hair condition and the requested finish.',
      distinctive:'Its defining characteristics are the exact construction, treatment process, texture change or service outcome identified by the Catalogue service name and category.',
      clientGets:'The client receives the booked AQB service completed to a professional finish appropriate to the selected service and current hair condition.',
      whoItSuits:'It suits clients whose hair, styling goal or care requirement matches the named Catalogue service after the appropriate consultation or service assessment.'
    };
  }

  const description=[
    five.whatItIs,
    five.howPerformed,
    five.distinctive,
    five.clientGets,
    five.whoItSuits
  ].join(' ').replace(/\s+/g,' ').trim();

  const focus=(name+' '+category).toLowerCase();
  let composition='Use an authentic professional AQB-style salon image featuring a Black African client where appropriate. Show enough hair, scalp, process detail or finished result to verify the exact named service.';
  let avoid='generic beauty imagery, unrelated hairstyles, or a visually similar service that does not prove the exact named service.';

  if(/\b(relax|texturiz|chemical)\b/.test(focus)){
    composition='Show a professional full-head relaxer or texturizer service context: untreated natural starting texture or sectioned application where appropriate, controlled product application, neutralizing/conditioning context, or a finished texture result that clearly supports the named service.';
    avoid='generic straight-hair portraits, home relaxer kits, unrelated colouring services, medical claims, or imagery that cannot distinguish a professional virgin full-head texture service from a simple blow-dry or silk press.';
  }else if(/\b(braid|cornrow|twist|knotless|boho)\b/.test(focus)){
    composition='Show the finished hairstyle on a Black African client with enough scalp, root placement, braid construction, curl placement, lengths and overall silhouette to verify the exact named style.';
    avoid='a different braid or twist family, hidden roots, synthetic-looking generic curls, or a broad boho hairstyle that does not prove the named root and braid construction.';
  }

  const photoBrief=[
    'Catalogue ID: '+sku,
    'Subject: '+name+' — '+five.whatItIs,
    'Required visible evidence: '+five.distinctive+' '+five.howPerformed,
    'Client-result cue: '+five.clientGets,
    'Who it suits cue: '+five.whoItSuits,
    'Composition: '+composition,
    'Avoid: '+avoid,
    'Qualification: The image must match Catalogue ID '+sku+', the exact service "'+name+'", and the service-specific visible evidence above. Category similarity alone is insufficient.'
  ].join('\n');

  return {
    sku:sku,
    name:name,
    category:category,
    description:description,
    photoBrief:photoBrief,
    imageUrl:imageUrl,
    price:price,
    fivePartDescription:{
      whatItIs:five.whatItIs,
      howPerformed:five.howPerformed,
      distinctive:five.distinctive,
      clientGets:five.clientGets,
      whoItSuits:five.whoItSuits
    },
    definitionSource:definitionSource
  };
}

