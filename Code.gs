/** V17.0.7.7 — staff-authorized cash settlement for a COMPLETED appointment.
 * No direct Admin payment endpoint exposure. Retry-safe under the script lock.
 * This function NEVER posts M-Pesa, Pay Later or an unconfirmed cash receipt.
 */
function AQBRecordCompletedCashReceipt(appointmentId) {
  const actor=AQBRequireUser();
  const id=String(appointmentId||'').trim();
  if(!/^AQBA[0-9]+$/i.test(id))throw new Error('A valid AQB appointment reference is required.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try {
    const sh=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=sh.getLastRow();
    if(n<2)throw new Error('Appointment not found.');
    const rows=sh.getRange(2,1,n-1,17).getValues();
    const matches=rows.filter(r=>String(r[0]||'').trim()===id);
    if(matches.length!==1)throw new Error('Appointment identity is missing or ambiguous.');
    const r=matches[0];
    if(String(r[8]||'').trim().toUpperCase()!=='COMPLETED')throw new Error('Service must be completed before cash can be recorded.');
    const amount=Number(r[16]||r[14]);
    if(!Number.isFinite(amount)||amount<=0)throw new Error('Invalid final agreed service price.');
    const payments=AQBGetRowsAsObjects(CONFIG.SHEETS.PAYMENTS).filter(x=>String(x['Appointment ID']||'').trim()===id&&String(x['Payment Status']||'').trim().toUpperCase()==='PAID');
    if(payments.length>1)throw new Error('Multiple paid receipts exist; Management Centre reconciliation required.');
