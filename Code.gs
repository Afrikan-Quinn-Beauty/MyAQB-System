    staging={state:matches.length===1?'FOUND':matches.length===0?'NOT_FOUND':'AMBIGUOUS',rows:matches.map(x=>x.row)};
    if(matches.length===1){const v=matches[0].values;staging.candidatePresent=!!(hm['Candidate Image URL']&&String(v[hm['Candidate Image URL']-1]||'').trim());staging.candidateUrl=hm['Candidate Image URL']?String(v[hm['Candidate Image URL']-1]||'').trim():'';staging.qualificationStatus=hm['Qualification Status']?String(v[hm['Qualification Status']-1]||''):'';}
  }}
