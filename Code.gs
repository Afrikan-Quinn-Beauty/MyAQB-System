  const removeIds={'AQBA006':true,'AQBA016':true,'AQBA017':true};
  const removeActions={'CALENDAR_DELETE_ERROR':true,'CALENDAR_CLEANUP_WARNING':true};
  const keep=[]; let removed=0;
  rows.forEach(function(r){
    const action=String(r[3]||'').trim().toUpperCase();
    const recordId=String(r[5]||'').trim().toUpperCase();
    const description=String(r[6]||'');
