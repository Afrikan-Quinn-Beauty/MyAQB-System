function AQBGetCatalogueIdentityMap(){
  const s=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),n=s.getLastRow();
  if(n<2)return {};
  const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues(),out={};
  rows.forEach(function(r){
    const id=m['Catalogue ID']?String(r[m['Catalogue ID']-1]||'').trim().toUpperCase():'';
    const service=m['Service Name']?String(r[m['Service Name']-1]||'').trim():'';
    const category=m['Category']?String(r[m['Category']-1]||'').trim():'';
    if(!id||!service||!AQBIsCanonicalCatalogueId(id))return;
    const rec={catalogueId:id,service:service,category:category,price:m['Price']?String(r[m['Price']-1]||'').trim():''};
    out[AQBNormalizeMetaText(category)+'|'+AQBNormalizeMetaText(service)]=rec;
    if(!out[AQBNormalizeMetaText(service)])out[AQBNormalizeMetaText(service)]=rec;
  });
  return out;
}

function AQBGetCanonicalCatalogueIdentity(service,category){
  service=String(service||'').trim();category=String(category||'').trim();
  if(!service)return null;
  let map={};
  try{map=AQBGetCatalogueIdentityMap();}catch(e){map={};}
  return map[AQBNormalizeMetaText(category)+'|'+AQBNormalizeMetaText(service)]||map[AQBNormalizeMetaText(service)]||null;
}

function AQBDeriveServiceTier(category,service,description){
  const text=[category,service,description].join(' ').toLowerCase();
  // Faux/soft locs are temporary protective styles, not established-loc care.
  if(/\b(faux loc|soft loc|butterfly loc|goddess loc extension)\b/.test(text))return 'Protective Styling & Extensions';
  if(/\b(sisterlocks?|microlocs?|micro locs?|starter locs?|loc retie|loc retight|retightening|retwist|loc detox|loc maintenance|loc repair|loc colour|loc color|loc styling|instant locs?|traditional locs?|dreadlock maintenance)\b/.test(text))return 'Lock & Loc Care';
  if(/\b(braid|braiding|cornrow|feed[- ]?in|knotless|box braid|twist|crochet|weav|sew[- ]?in|wig|closure|frontal|track|extension|microlink|micro weaving|ghana weaving)\b/.test(text))return 'Protective Styling & Extensions';
  return 'Texture & Hair Care';
}

