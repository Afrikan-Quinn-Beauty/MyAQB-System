function AQBFindUniquePexelsServiceImage(service,category,description,reservedImages){
  throw new Error("PEXELS_RETIRED: Approved AQB Studio originals are the image authority.");
  const apiKey=String(PropertiesService.getScriptProperties().getProperty('PEXELS_API_KEY')||'').trim();
  if(!apiKey)return null;

  // The deterministic query builder remains the safe fallback if AI is unavailable.
  const queries=AQBBuildAIPexelsImageQueries(service,category,description).concat(AQBBuildPexelsImageQueries(service,category,description));
  let best=null;
  for(let i=0;i<queries.length;i++){
    const search=AQBSearchPexelsServiceImages(queries[i],service,category,description,reservedImages,apiKey, false);
    const candidates=search.items||[];
    candidates.forEach(function(c){if(!best || c.score>best.score)best=c;});
    if(best && best.score>=18){
      const ai=AQBEvaluatePexelsCandidateWithAI(service,category,description,best);
      if(!ai.configured || (ai.valid && ai.score>=70))return best;
    }
  }
  // Broaden only the search wording, not the audience/service intent. The relaxed
  // pass still enforces female/male/child representation and the core service type.
  const relaxedQueries=AQBBuildPexelsRelaxedQueries(service,category,description);
  for(let i=0;i<relaxedQueries.length;i++){
    const search=AQBSearchPexelsServiceImages(relaxedQueries[i],service,category,description,reservedImages,apiKey,true);
    const candidates=search.items||[];
    candidates.forEach(function(c){if(!best || c.score>best.score)best=c;});
    if(best && best.score>=18){
      const ai=AQBEvaluatePexelsCandidateWithAI(service,category,description,best);
      if(!ai.configured || (ai.valid && ai.score>=70))return best;
    }
  }
  return null;
}

