function AQBPhotoStagingCanonicalPlan_(){
  const ss=AQBGetSpreadsheet(),cat=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
  if(!cat||!stage)throw Error('Catalogue and AQB Photo Staging required');
  const cv=cat.getDataRange().getValues(),sv=stage.getDataRange().getValues();
  const ch=AQBBuildHeaderMap(cat),sh=AQBBuildHeaderMap(stage);
  const owned=['Catalogue ID','Category','Service Name','Price','Sort Order','Active','Service Tier','Catalogue Type','Description','Photo Brief'];
  ['Catalogue ID','Category','Service Name'].forEach(function(h){if(!ch[h]||!sh[h])throw Error('Missing identity field '+h);});
  const canonical=[],ids={},names={},byName={},stagingIds={},issues=[];
  function key(s){return String(s||'').trim().replace(/\s+/g,' ').toLowerCase();}
  for(let i=1;i<cv.length;i++){
    const r=cv[i],id=String(r[ch['Catalogue ID']-1]||'').trim().toUpperCase(),name=String(r[ch['Service Name']-1]||'').trim();
    if(!id&&!name)continue;
    if(!/^AQBCAT\d{3,}$/.test(id)||!name||ids[id]||names[key(name)])throw Error('Catalogue CATID/name not unique at row '+(i+1)+': '+id+' '+name);
    const entry={id:id,name:name,row:r};ids[id]=entry;names[key(name)]=entry;canonical.push(entry);
  }
  for(let i=1;i<sv.length;i++){
    const r=sv[i],id=String(r[sh['Catalogue ID']-1]||'').trim().toUpperCase(),name=String(r[sh['Service Name']-1]||'').trim();
    if(!id&&!name)continue;
    if(!name){issues.push({row:i+1,type:'MISSING_SERVICE_NAME'});continue;}
    const k=key(name);
    if(byName[k])issues.push({row:i+1,type:'DUPLICATE_STAGING_SERVICE_NAME',previousRow:byName[k].rowNumber,name:name});
    else byName[k]={row:r,rowNumber:i+1,id:id,name:name};
    (stagingIds[id]=stagingIds[id]||[]).push(i+1);
    if(!names[k])issues.push({row:i+1,type:'SERVICE_NOT_IN_CATALOGUE',id:id,name:name});
  }
  const mapping=[],missing=[],changes=[];
  canonical.forEach(function(c){
    const prior=byName[key(c.name)];if(!prior){missing.push({id:c.id,name:c.name});return;}
    mapping.push({fromRow:prior.rowNumber,fromCATID:prior.id,toCATID:c.id,service:c.name});
    if(prior.id!==c.id)changes.push({row:prior.rowNumber,from:prior.id,to:c.id,service:c.name});
  });
  const duplicates=Object.keys(stagingIds).filter(function(id){return id&&stagingIds[id].length>1;}).map(function(id){return {id:id,rows:stagingIds[id]};});
  return {ss:ss,cat:cat,stage:stage,cv:cv,sv:sv,ch:ch,sh:sh,owned:owned,canonical:canonical,mapping:mapping,missing:missing,issues:issues,changes:changes,duplicates:duplicates};
}

function AQBPhotoStagingIdentityFingerprint_(plan){
  const src=plan.canonical.map(function(c){return [c.id,c.name].concat(plan.owned.filter(function(h){return h!=='Catalogue ID'&&h!=='Service Name';}).map(function(h){return plan.ch[h]?String(c.row[plan.ch[h]-1]||''):'';}));});
  const stage=plan.sv.slice(1).filter(function(r){return String(r[plan.sh['Service Name']-1]||'').trim();}).map(function(r){return [String(r[plan.sh['Catalogue ID']-1]||''),String(r[plan.sh['Service Name']-1]||''),String(r[plan.sh['Candidate Image URL']?plan.sh['Candidate Image URL']-1:0]||'')];});
  const bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify({src:src,stage:stage,headers:plan.sv[0]}));
  return Utilities.base64EncodeWebSafe(bytes);
}

function AQBPreviewCataloguePhotoStagingSync(){
  AQBRequireCataloguePhotoManager();
  const p=AQBPhotoStagingCanonicalPlan_(),fp=AQBPhotoStagingIdentityFingerprint_(p);
  const report={version:'V16.21.16.8.14',mode:'PREVIEW',catalogue:p.canonical.length,stagingNamed:p.mapping.length+p.issues.filter(function(x){return x.type==='SERVICE_NOT_IN_CATALOGUE';}).length,matchedByServiceName:p.mapping.length,catidCorrections:p.changes,duplicateCATIDs:p.duplicates,missingServices:p.missing,issues:p.issues,readOnly:true,publicationWrites:0,approvalWrites:0,requiresCommit:true};
  PropertiesService.getScriptProperties().setProperty('AQB_PHOTO_STAGE_CANONICAL_PREVIEW',JSON.stringify({fp:fp,time:Date.now(),actor:AQBGetCurrentUser().email}));
  Logger.log('AQB_CANONICAL_PHOTO_STAGE_PREVIEW '+JSON.stringify(report));return Object.assign(report,{confirmToken:fp});
}

function AQBCommitCataloguePhotoStagingSync(input){
  const actor=AQBRequireCataloguePhotoManager(),lock=LockService.getScriptLock();
  if(!lock.tryLock(20000))throw Error('PHOTO_STAGING_SYNC_BUSY');
  try{
    const p=AQBPhotoStagingCanonicalPlan_(),fp=AQBPhotoStagingIdentityFingerprint_(p);
    const stored=JSON.parse(PropertiesService.getScriptProperties().getProperty('AQB_PHOTO_STAGE_CANONICAL_PREVIEW')||'null');
    if(!stored||stored.fp!==fp||!input||input.confirmToken!==fp||String(stored.actor)!==String(actor.email)||Date.now()-stored.time>15*60*1000)throw Error('Missing/stale preview or actor mismatch; run preview and pass token');
    if(p.issues.length)throw Error('Unsafe service identity ambiguity; '+JSON.stringify(p.issues.slice(0,5)));
    if(p.mapping.length+p.missing.length!==p.canonical.length)throw Error('Not all Catalogue services resolved');
    // One matching staging SERVICE NAME per service: move all evidence columns together, never select by old CATID.
    const nameMap={};function key(s){return String(s||'').trim().replace(/\s+/g,' ').toLowerCase();}
    p.sv.slice(1).forEach(function(r){const n=key(r[p.sh['Service Name']-1]);if(n)nameMap[n]=r;});
    const backupName='AQB Photo PRE-CANON '+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd_HHmmss');
    const backup=p.stage.copyTo(p.ss).setName(backupName);backup.hideSheet();
    // Mirror the same source columns as Catalogue, plus existing description/photo metadata.
    ['Price','Sort Order','Active'].forEach(function(h){if(!p.sh[h]&&p.ch[h]){p.stage.getRange(1,p.stage.getLastColumn()+1).setValue(h);}});
    const sm=AQBBuildHeaderMap(p.stage),width=p.stage.getLastColumn(),output=[];
    p.canonical.forEach(function(c){
      const original=nameMap[key(c.name)];const row=original?original.slice():[];
      while(row.length<width)row.push('');
      p.owned.forEach(function(h){if(sm[h]&&p.ch[h])row[sm[h]-1]=c.row[p.ch[h]-1];});
      if(!original&&sm['Qualification Status'])row[sm['Qualification Status']-1]='PENDING_REVIEW';
      output.push(row);
    });
    const oldCount=Math.max(0,p.stage.getLastRow()-1);
    if(oldCount)p.stage.getRange(2,1,oldCount,width).clearContent();
    if(output.length)p.stage.getRange(2,1,output.length,width).setValues(output);
    const report={version:'V16.21.16.8.14',mode:'COMMIT',catalogue:output.length,staging:output.length,catidCorrected:p.changes.length,created:p.missing.length,backupSheet:backupName,publicationWrites:0,approvalWrites:0,status:'CANONICAL_SYNC_COMPLETE_PENDING_REVIEW'};
    PropertiesService.getScriptProperties().deleteProperty('AQB_PHOTO_STAGE_CANONICAL_PREVIEW');
    Logger.log('AQB_CANONICAL_PHOTO_STAGE_COMMIT '+JSON.stringify(report));return report;
  }finally{lock.releaseLock();}
}

function AQBConfirmCataloguePhotoStagingSync(){
  const preview=AQBPreviewCataloguePhotoStagingSync();
  if(preview.issues.length)throw Error('Preview found ambiguous service identities; no changes');
  return AQBCommitCataloguePhotoStagingSync({confirmToken:preview.confirmToken});
}

function AQBUpsertPhotoStagingSourceRows(selectedIds){
  const lock=LockService.getScriptLock();if(!lock.tryLock(20000))throw Error('PHOTO_STAGING_SYNC_BUSY');
  try{
    const p=AQBPhotoStagingCanonicalPlan_();
    if(p.issues.length||p.duplicates.length||p.changes.length)throw Error('PHOTO_STAGING_IDENTITY_REPAIR_REQUIRED: preview AQBPreviewCataloguePhotoStagingSync; no changes');
    const wanted=selectedIds&&selectedIds.length?new Set(selectedIds.map(function(id){return String(id||'').trim().toUpperCase();})):null;
    if(wanted)wanted.forEach(function(id){if(!p.canonical.some(function(c){return c.id===id;}))throw Error('Unknown Catalogue CATID '+id);});
    const sm=p.sh,ch=p.ch,stage=p.stage,existing={};
    p.mapping.forEach(function(m){existing[m.toCATID]=m.fromRow;});
    // Introduce new mirror columns without creating duplicate headers.
    ['Price','Sort Order','Active'].forEach(function(h){if(!sm[h]&&ch[h]){stage.getRange(1,stage.getLastColumn()+1).setValue(h);}});
    const hm=AQBBuildHeaderMap(stage),width=stage.getLastColumn();
    let updated=0,unchanged=0,created=0;const additions=[];
    p.canonical.forEach(function(c){if(wanted&&!wanted.has(c.id))return;
      const n=existing[c.id];if(!n){const row=new Array(width).fill('');p.owned.forEach(function(h){if(hm[h]&&ch[h])row[hm[h]-1]=c.row[ch[h]-1];});if(hm['Qualification Status'])row[hm['Qualification Status']-1]='PENDING_REVIEW';additions.push(row);created++;return;}
      const changes=[];p.owned.forEach(function(h){if(!hm[h]||!ch[h])return;const value=c.row[ch[h]-1],old=hm[h]<=p.sv[n-1].length?p.sv[n-1][hm[h]-1]:'';if(String(value==null?'':value)!==String(old==null?'':old))changes.push({col:hm[h],value:value});});
      changes.forEach(function(x){stage.getRange(n,x.col).setValue(x.value);});if(changes.length)updated++;else unchanged++;
    });
    if(additions.length)stage.getRange(stage.getLastRow()+1,1,additions.length,width).setValues(additions);
    const report={version:'V16.21.16.8.14',created:created,updated:updated,unchanged:unchanged,publicationWrites:0,approvalWrites:0};Logger.log('AQB_CANONICAL_PHOTO_STAGE_INCREMENTAL '+JSON.stringify(report));return report;
  }finally{lock.releaseLock();}
}

function AQBRunSafePhotoSyncQueue(maxRows){
  const props=PropertiesService.getScriptProperties(),key='AQB_PHOTO_PIPELINE_QUEUE';
  let queue=[];try{queue=JSON.parse(props.getProperty(key)||'[]')||[];}catch(e){throw Error('Queue malformed; left unchanged.');}
  const unique=[...new Set(queue.map(function(id){return String(id||'').trim().toUpperCase();}).filter(function(id){return /^AQBCAT\d{3,}$/.test(id);}))];
  const count=Math.min(Math.max(1,Number(maxRows)||18),18),slice=unique.slice(0,count);
  if(!slice.length)return {version:'V16.21.16',success:true,processed:0,remainingQueue:0,publicationWrites:0};
  const result=AQBUpsertPhotoStagingSourceRows(slice);
  if(slice.length)props.setProperty(key,JSON.stringify(unique.slice(slice.length)));
  result.remainingQueue=Math.max(0,unique.length-slice.length);return result;
}

function AQBAuditCataloguePhotoSyncReadOnly(){
  const ss=AQBGetSpreadsheet(),cat=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
