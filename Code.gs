  const brief=dnb?{date:String(dnb.briefDate||''),headline:String(dnb.headline||''),summary:String(dnb.summary||''),hot:dnbHot,watch:dnbWatch,serviceOpportunities:0,catalogueOpportunities:0,contentOpportunities:0,actions:String(dnb.recommendedActions||'').split(/\r?\n/).filter(Boolean),status:'DNB',source:'DNB',sourceUrl:String(dnb.sourceUrl||''),briefId:String(dnb.briefId||'')}:null;
  return {success:true,brief:brief,pendingOpportunities:pending,monitoring:{dnbSignals:dnbHot.length+dnbWatch.length,trendInboxTotal:inboxRows.length,trendInboxPending:pendingInbox,approvedTrendCatalogue:(function(){
