function AQBGetPrimaryVariantFamily(service,category,description,photoBrief){
  const n=AQBNormalizeVariantText(service),
        all=AQBNormalizeVariantText([service,category,description,photoBrief].filter(Boolean).join(' '));
  if(/\bbridal\b/.test(n)&&/\bstyling\b/.test(n))return 'bridal';
  if(/cornrow|swahili line|lemonade|feed in/.test(n))return 'cornrow';
  if(/twist|marley|havana|senegalese|island|olivia|nnene|nnenne/.test(n))return 'twist';
  if(/sisterlock|\bloc\b|\blocs\b|dread/.test(n))return 'loc';
  if(/knotless|box braid|\bbraid\b|\bbraids\b|goddess|boho/.test(n))return 'braid';
  if(/weave|sew in|sew-in/.test(n))return 'weave';
  if(/\bwig\b|lace front/.test(n))return 'wig';
  if(/silk press|straighten/.test(n))return 'straight';
  if(/\bafro\b/.test(n))return 'afro';
  if(/curl|curly/.test(n))return 'curl';
  if(/\bbridal hairstyle\b|\bwedding updo\b|\bbridal updo\b|\bwedding hair\b/.test(all))return 'bridal';
  if(/cornrow|scalp braid/.test(all))return 'cornrow';
