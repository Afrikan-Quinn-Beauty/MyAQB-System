    if(list.length!==1){o.status=list.length?'DUPLICATE_STAGING_ID':'STAGING_ID_MISSING';result.results.push(o);return;}
    const row=list[0].data,url=String((uc>=0&&row[uc])||(sc>=0&&row[sc])||'');
    const m=url.match(/[?&]id=([A-Za-z0-9_-]{15,})/)||url.match(/\/d\/([A-Za-z0-9_-]{15,})/);
    if(!m){o.status='SOURCE_ID_NOT_FOUND';result.results.push(o);return;}
    o.sourceFileId=m[1];
    try{
      const file=DriveApp.getFileById(m[1]);
      o.sourceName=file.getName();o.sourceMime=file.getMimeType();o.sourceBytes=file.getSize();o.sourceUpdated=file.getLastUpdated().toISOString();
      o.md5='NOT_AVAILABLE_WITH_DRIVEAPP';
      if(typeof Drive!=='undefined'&&Drive.Files&&typeof Drive.Files.get==='function'){
        try{const meta=Drive.Files.get(m[1],{fields:'id,md5Checksum,modifiedTime'});o.md5=meta.md5Checksum||'UNAVAILABLE';if(meta.modifiedTime)o.sourceUpdated=meta.modifiedTime;}
        catch(ex){o.advancedDriveNote=String(ex.message||ex).slice(0,120);}
      }
      o.previewFileId=col('Preview File ID')>=0?String(row[col('Preview File ID')]||''):'';
      o.previewStatus=col('Preview Status')>=0?String(row[col('Preview Status')]||''):'SCHEMA_NOT_INSTALLED';
      o.status=o.previewFileId?'PREVIEW_REFERENCE_PRESENT':'PREVIEW_NOT_GENERATED';
    }catch(ex){o.status='SOURCE_ACCESS_ERROR';o.error=String(ex.message||ex).slice(0,160);}
    result.results.push(o);
  });
  result.counts=result.results.reduce(function(a,r){a[r.status]=(a[r.status]||0)+1;return a;},{});
  Logger.log('AQB_PHOTO_PREVIEW_AUDIT '+JSON.stringify(result));return result;
}

function AQBGeneratePhotoPreviewBatch() {
  AQBRequireCataloguePhotoManager();
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(30000))throw Error('AQB preview batch already running');
  try {
    const sh=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
    if(!sh)throw Error('AQB Photo Staging missing');
    const data=sh.getDataRange().getValues(),hm=AQBBuildHeaderMap(sh);
    const needed=['Catalogue ID','Candidate Image URL','Preview File ID','Preview Source File ID','Preview Source MD5','Preview Source Updated','Preview Status'];
    needed.forEach(function(h){if(!hm[h])throw Error('Missing Photo Staging column: '+h+' — run the successful three-photo test build first');});
    const at=function(r,k){return String(r[hm[k]-1]||'').trim();};
    const byId={},rows=[];
    data.slice(1).forEach(function(r,i){const id=at(r,'Catalogue ID').toUpperCase();if(!id)return;if(byId[id])throw Error('Duplicate staging CATID '+id);byId[id]=true;rows.push({id:id,row:i+2,data:r});});
    const catalogueCount=AQBGetSpreadsheet().getSheetByName('Catalogue').getDataRange().getValues().slice(1).filter(function(r){return /^AQBCAT\d{3,}$/.test(String(r[0]||'').trim());}).length;
    if(rows.length!==catalogueCount||Object.keys(byId).length!==catalogueCount)throw Error('Staging invariant failed: expected '+catalogueCount+' unique CATIDs');
    rows.sort(function(a,b){return a.id.localeCompare(b.id);});
    const MAX_ITEMS=8,MAX_MS=190000,started=Date.now();
    const props=PropertiesService.getScriptProperties();
    const cursorKey="AQB_PHOTO_PREVIEW_CURSOR_V2";
    const startIndex=Math.max(0,Math.min(rows.length-1,Number(props.getProperty(cursorKey)||0)||0));
    let scanned=0,nextIndex=startIndex;
    let generated=0,skipped=0,invalidated=0;
    const failures=[],results=[];
    const destination=DriveApp.getFolderById('1tk4u62FuJF4Y5TsWUxpXpxYinz1UXQe3');
    for(let i=0;i<rows.length;i++){
      if(generated>=MAX_ITEMS||Date.now()-started>MAX_MS)break;
      const idx=(startIndex+i)%rows.length;
      const obj=rows[idx],id=obj.id,r=obj.data;
      scanned++;nextIndex=(idx+1)%rows.length;
      const m=at(r,'Candidate Image URL').match(/[?&]id=([A-Za-z0-9_-]{15,})/)||at(r,'Candidate Image URL').match(/\/d\/([A-Za-z0-9_-]{15,})/);
      if(!m){failures.push({id:id,reason:'MISSING_MASTER_ID'});continue;}
      const srcId=m[1];
      try {
        const master=DriveApp.getFileById(srcId);
        if(master.getMimeType()!=='image/png'){failures.push({id:id,reason:'MASTER_NOT_PNG'});continue;}
        const oldId=at(r,'Preview File ID'),oldSrc=at(r,'Preview Source File ID'),oldMd5=at(r,'Preview Source MD5');
        const modified=master.getLastUpdated().toISOString();
        // Quick check: same Drive source and modified timestamp avoids downloading a multi-MB master.
        // A changed timestamp requires MD5 calculation to distinguish edits from metadata-only changes.
        let verifiedCached=false;
        if(oldId&&oldSrc===srcId&&at(r,'Preview Source Updated')===modified&&oldMd5&&at(r,'Preview Status')==='PREVIEW_READY'){
          try{const cached=DriveApp.getFileById(oldId);verifiedCached=cached.getSize()>0&&cached.getSize()<=600000;}catch(ex){}
        }
        if(verifiedCached){skipped++;continue;}
        const sourceMd5=Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,master.getBlob().getBytes()).map(function(n){return ('0'+((n+256)%256).toString(16)).slice(-2);}).join('');
        // If only metadata changed, retain the verified preview and refresh the timestamp.
        if(oldId&&oldSrc===srcId&&oldMd5===sourceMd5&&at(r,'Preview Status')==='PREVIEW_READY'){
          try{const cached=DriveApp.getFileById(oldId);if(cached.getSize()>0&&cached.getSize()<=600000){sh.getRange(obj.row,hm['Preview Source Updated']).setValue(modified);skipped++;continue;}}catch(ex){}
        }
        const p=AQBFetchVerifiedDrivePreview_(srcId);
        const ext=p.mime==='image/jpeg'?'jpg':'png';
        const derivative=destination.createFile(p.blob.copyBlob().setName('PREVIEW_'+id+'_'+sourceMd5+'.'+ext));
        const fields={'Preview File ID':derivative.getId(),'Preview Source File ID':srcId,'Preview Source MD5':sourceMd5,'Preview Source Updated':modified,'Preview Status':'PREVIEW_READY'};
        Object.keys(fields).forEach(function(k){sh.getRange(obj.row,hm[k]).setValue(fields[k]);});
        generated++;if(oldId)invalidated++;
        results.push({catId:id,status:'PREVIEW_READY',bytes:p.bytes,dimensions:p.dimensions,previewFileId:derivative.getId(),oldPreviewPreserved:!!oldId});
      }catch(e){failures.push({id:id,reason:String(e.message||e).slice(0,280)});}
    }
    props.setProperty(cursorKey,String(nextIndex));
    const report={version:'V16.21.16.8.21',mode:'CURSOR_RESUMABLE_BATCH',targetTotal:rows.length,maxItems:MAX_ITEMS,scanned:scanned,cursorStart:startIndex,cursorNext:nextIndex,created:generated,skippedValid:skipped,replacedPreviewMappings:invalidated,failures:failures,results:results,approvalWrites:0,publicationWrites:0,masterWrites:0,triggersInstalled:0};
    Logger.log('AQB_PHOTO_PREVIEW_BATCH '+JSON.stringify(report));return report;
  }finally{lock.releaseLock();}
}

