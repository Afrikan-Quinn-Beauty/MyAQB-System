var AQB_COMPLETION_REPLAY_IDS_=['AQBA008','AQBA022','AQBA003','AQBA034','AQBA040'];
var AQB_COMPLETION_EXCLUDE_IDS_=['AQBA036']; // Rosa: customer-confirmed receipt
function AQBCompletionDeliveryAudit_(appointmentIds){
  var s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),a=s.getDataRange().getValues(),out=[];
  var ws=AQBGetSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES),w=ws.getDataRange().getValues(),h=AQBBuildHeaderMap(ws);
  var customers=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),c=customers.getDataRange().getValues(),cm=AQBBuildHeaderMap(customers);
  (appointmentIds||[]).forEach(function(id){
    var matches=a.slice(1).filter(function(r){return String(r[0]).trim()===id;});
    if(matches.length!==1){out.push({appointmentId:id,status:'HOLD_APPOINTMENT_NOT_UNIQUE'});return;}
    var r=matches[0],cid=String(r[1]).trim(),status=String(r[8]).trim().toUpperCase();
    if(status!=='COMPLETED'){out.push({appointmentId:id,status:'HOLD_NOT_COMPLETED'});return;}
    var profile=c.slice(1).filter(function(x){return String(x[cm['Customer ID']-1]).trim()===cid;});
    if(profile.length!==1){out.push({appointmentId:id,status:'HOLD_CUSTOMER_NOT_UNIQUE'});return;}
    var phone=AQBNormalizePhone(profile[0][cm['WhatsApp Number']-1]);
    if(!AQBIsValidPhone(phone)||AQBNormalizePhone(r[3])!==phone){out.push({appointmentId:id,status:'HOLD_PHONE_MISMATCH'});return;}
    var alreadyAccepted=PropertiesService.getScriptProperties().getProperty('AQB_COMPLETION_WA_SENT_'+id);
    if(alreadyAccepted){out.push({appointmentId:id,customerId:cid,status:'ACCEPTED_PROPERTY_DO_NOT_RESEND'});return;}
    var evidence=w.slice(1).filter(function(x){
      var event=String(x[(h['Event ID']||13)-1]||'').trim(),type=String(x[(h['Message Type']||5)-1]||'').toUpperCase(),
          text=String(x[(h['Message Text']||6)-1]||'').toUpperCase(),name=String(x[(h['Template Name']||15)-1]||'').toUpperCase();
      return event==='AQB_COMPLETION:'+id && (/COMPLET/.test(type+' '+text+' '+name));
    });
    var accepted=evidence.some(function(x){var st=String(x[(h['Delivery Status']||17)-1]||x[(h['Status']||10)-1]||'').toUpperCase();return ['SUBMITTED','ACCEPTED','SENT','DELIVERED','READ','PENDING','QUEUED'].indexOf(st)!==-1;});
    var actual=AQBGetActualCompletionDateFromAppointment(r);
    out.push({appointmentId:id,customerId:cid,phone:phone,service:String(r[4]),actualCompletion:actual,status:accepted?'RECORDED_DO_NOT_RESEND':!actual?'HOLD_COMPLETION_DATE_UNVERIFIED':evidence.length?'REVIEW_FAILED_OR_UNKNOWN':'MISSING_LEDGER',customer:profile[0]});
  });
  return out;
}
/** Explicit admin replay. Defaults to dry run. Never replays Rosa. */
function AQBReplayMissingCompletionMessages(options){
