  }else if(/passion\s*twist/.test(s)){
    profile.required.push('passion twists'); profile.queryStyle='passion twists hairstyle';
  }else if(/senegalese/.test(s)){
    profile.required.push('senegalese twists'); profile.queryStyle='senegalese twists hairstyle';
  }else if(/box\s*braid/.test(s)){
    profile.required.push('box braids'); profile.queryStyle='box braids hairstyle';
    profile.forbidden.push('bob','wood','wooden box','box object','container','cabin');
  }else if(/knotless/.test(s)){
    profile.required.push('knotless braids'); profile.queryStyle='knotless braids hairstyle';
  }else if(/straight.?back\s*cornrow/.test(s)){
    profile.required.push('straight back cornrows','cornrows'); profile.queryStyle='straight back cornrows hairstyle';
  }else if(/cornrow|designer cornrows|feed.?in/.test(s)){
    profile.required.push('cornrows'); profile.queryStyle='cornrow hairstyle';
  }else if(/sisterlocks?/.test(s)){
    profile.required.push('sisterlocks'); profile.queryStyle='Sisterlocks hairstyle';
  }else if(/loc|dread/.test(s)){
    profile.required.push('locs'); profile.queryStyle='loc hairstyle';
  }else if(/micro\s*twist/.test(s)){
    profile.required.push('micro twists'); profile.queryStyle='micro twists hairstyle';
  }else if(/twist/.test(s)){
    profile.required.push('twists'); profile.queryStyle='twist hairstyle';
  }else if(/\bwash\b|shampoo|condition/.test(s)){
    profile.required.push('hair');
    profile.preferred.push('hair wash','hair washing','shampoo','conditioning','conditioner','salon');
    profile.queryStyle='hair wash conditioning salon';
    profile.forbidden.push('laundry','clothes washing','dishwashing');
  }else if(/hair.?care|education|consultation/.test(s)){
    profile.required.push('hair');
    profile.preferred.push('hair care','haircare','natural hair','salon','styling');
    profile.queryStyle='Black African hair care consultation salon';
  }else if(/wig/.test(s)){
    profile.required.push('wig'); profile.queryStyle='Black African woman wig hairstyle';
  }else if(/weave|extension/.test(s)){
    profile.required.push('weave'); profile.queryStyle='Black woman weave hairstyle';
  }else if(/natural hair|afro|wash.?and.?go/.test(s)){
    profile.required.push('natural hair'); profile.queryStyle='natural Black African hair';
  }else if(/relax|mizani|textur/.test(s)){
    profile.required.push('relaxed hair'); profile.queryStyle='Black African relaxed hair salon';
  }else if(/haircut|trim|cut/.test(s)){
    profile.required.push('haircut'); profile.queryStyle='Black African haircut hairstyle';
  }else if(/manicure|nail/.test(s)){
    profile.querySubject='Black African woman'; profile.required.push('nails'); profile.queryStyle='African woman manicure';
  }else if(/pedicure/.test(s)){
    profile.querySubject='Black African woman'; profile.required.push('pedicure'); profile.queryStyle='African woman pedicure';
  }else if(/makeup/.test(s)){
    profile.required.push('makeup'); profile.queryStyle='Black African woman makeup';
  }else if(/facial|skin/.test(s)){
    profile.required.push('facial'); profile.queryStyle='Black African woman facial skincare';
  }else if(/massage|spa/.test(s)){
    profile.required.push('massage'); profile.queryStyle='Black African woman spa treatment';
  }else if(/braid/.test(s)){
    profile.required.push('braids'); profile.queryStyle='Black African braided hairstyle';
  }else{
    profile.required.push('hair');
  }

  if(/\bvery\s+long\b|\bextra\s+long\b|\blong\b/.test(s)){
    profile.required.push('long'); profile.preferred.push('long hair','long braids','waist length');
