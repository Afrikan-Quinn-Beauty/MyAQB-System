function AQBPreviewImageDimensions_(bytes,mime){
  const u=function(n){return (bytes[n]||0)&255;};
  if(mime==='image/png'){
    if(bytes.length<24||u(0)!==137||u(1)!==80||u(2)!==78||u(3)!==71)return null;
    const n=function(o){return ((u(o)*16777216)+(u(o+1)<<16)+(u(o+2)<<8)+u(o+3))>>>0;};
    return {width:n(16),height:n(20)};
  }
  if(mime==='image/jpeg'){
    if(u(0)!==255||u(1)!==216)return null;
    let o=2;while(o<bytes.length-10){if(u(o)!==255){o++;continue;}const marker=u(o+1),len=u(o+2)*256+u(o+3);
      if([192,193,194,195,198,199,201,202].indexOf(marker)>=0)return{height:u(o+5)*256+u(o+6),width:u(o+7)*256+u(o+8)};
      if(len<2)break;o+=2+len;
    }return null;
  }
  return null;
}

function AQBGeneratePhotoPreviewTest3(){
