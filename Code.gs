function AQBFetchVerifiedDrivePreview_(id){
  const sizes=[800,640,480,320,240];
  const attempts=[];
  for(let i=0;i<sizes.length;i++){
    const width=sizes[i];
    try{
      const endpoint='https://drive.google.com/thumbnail?id='+encodeURIComponent(id)+'&sz=w'+width;
      const response=UrlFetchApp.fetch(endpoint,{muteHttpExceptions:true,followRedirects:true,headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()}});
      if(response.getResponseCode()!==200){attempts.push({width:width,error:'HTTP_'+response.getResponseCode()});continue;}
      const blob=response.getBlob(),bytes=blob.getBytes(),mime=String(blob.getContentType()||'').split(';')[0].toLowerCase();
      if(!/^image\/(png|jpeg)$/.test(mime)){attempts.push({width:width,error:'UNSUPPORTED_MIME_'+mime});continue;}
      const dimensions=AQBPreviewImageDimensions_(bytes,mime);
      if(!dimensions||!dimensions.width||!dimensions.height){attempts.push({width:width,error:'INVALID_IMAGE_HEADER'});continue;}
      if(dimensions.width>800||dimensions.height>1600){attempts.push({width:width,bytes:bytes.length,error:'DIMENSIONS_TOO_LARGE'});continue;}
      if(bytes.length>600000){attempts.push({width:width,bytes:bytes.length,error:'OVER_600KB'});continue;}
      return {blob:blob,mime:mime,bytes:bytes.length,dimensions:dimensions,requestedWidth:width};
    }catch(e){attempts.push({width:width,error:String(e.message||e).slice(0,80)});}
  }
  throw Error('PREVIEW_NOT_WITHIN_LIMITS '+JSON.stringify(attempts));
}

