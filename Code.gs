  const w=AQBGetWhatsAppSettings();
  const out={version:'V16.21.14-CleanApp',function:'AQBAuditRetieReminderAutomation',readOnly:true,writes:0,canonicalHandler:'AQBProcessRetieReminders',canonicalTriggerCount:canonical.length,legacyTriggerCount:legacy.length,whatsAppEnabled:!!w.enabled,whatsAppConfigured:!!AQBCheckWhatsAppConfigured(),lastRecordedReminderRun:lastRun||'NONE_RECORDED',rule:'Future booking controls advance reminders. For unresolved overdue appointments with known last retie, severity uses Last Retie Date +42 days (Sunday rolled to Monday); unknown history uses missed appointment date. Stages +7/+21/+42.',issues:[],success:canonical.length===1&&legacy.length===0};
  if(canonical.length!==1)out.issues.push({issue:'CANONICAL_TRIGGER_COUNT',actual:canonical.length,expected:1});
