function AQBValidatePrimaryIdentityContract(existingId,proposedId){
  const existing=String(existingId||'').trim().toUpperCase();
  const proposed=String(proposedId||'').trim().toUpperCase();

  if(existing){
    if(!AQBIsCanonicalCatalogueId(existing)){
      throw new Error(
        'INVALID_EXISTING_PRIMARY_KEY: '+existing+
        ' is not a canonical AQBCAT### identity.'
      );
    }

    if(proposed && proposed!==existing){
      Logger.log(
        '[IDENTITY GUARD] BLOCKED ID MUTATION: '+
        existing+' -> '+proposed
      );
      return {
        allowed:false,
        mutationBlocked:true,
        canonicalId:existing,
        attemptedId:proposed,
        action:'IDENTITY_MUTATION_BLOCKED_NON_IDENTITY_UPDATES_ALLOWED'
      };
    }

    return {
      allowed:true,
      mutationBlocked:false,
      canonicalId:existing,
      attemptedId:proposed||existing,
      action:'PRESERVE_EXISTING_ID'
    };
  }

  if(proposed){
    if(!AQBIsCanonicalCatalogueId(proposed)){
      throw new Error(
        'MALFORMED_PRIMARY_KEY: '+proposed+
        ' must match AQBCAT###.'
      );
    }

    if(AQBIsCatalogueIdInUse(proposed)){
      throw new Error(
        'PRIMARY_KEY_COLLISION: '+proposed+
        ' is already assigned.'
      );
    }

    return {
      allowed:true,
      mutationBlocked:false,
      canonicalId:proposed,
      attemptedId:proposed,
      action:'NEW_CANONICAL_ID'
    };
  }

  return {
    allowed:true,
    mutationBlocked:false,
    canonicalId:'',
    attemptedId:'',
    action:'NEW_ID_REQUIRED'
  };
}

function AQBValidateFivePartDescription(description,service){
  const t=String(description||'').trim();
  const name=String(service||'').trim();
  const sentences=t.split(/(?<=[.!?])\s+/).filter(Boolean);
  const issues=[];
  if(sentences.length<5)issues.push('Fewer than five description parts/sentences');
  if(name && !new RegExp(name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'i').test(t))issues.push('Service name not represented');
  if(/professional beauty service designed around the selected technique|neat, professionally finished service tailored to the intended outcome|personalized professional beauty service/i.test(t))issues.push('Generic catalogue wording detected');
  return {valid:issues.length===0,issues:issues,parts:sentences.length};
}

