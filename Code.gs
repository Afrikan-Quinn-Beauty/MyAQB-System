/* V17: Guarded existing-service edit. Master Lists remains first-write authority.
 * Never edits identifiers, approvals, images or customer-facing publication status.
 */
function AQBPreviewEditServiceManaged(input){
  AQBRequireCataloguePhotoManager();input=input||{};
  const id=String(input.catalogueId||'').trim().toUpperCase();
  if(!/^AQBCAT\d+$/.test(id))throw Error('Valid permanent AQBCAT ID required.');
  const sh=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),hm=AQBBuildHeaderMap(sh);
  ['Catalogue ID','Category','Service Name'].forEach(k=>{if(!hm[k])throw Error('Catalogue missing '+k);});
  const rows=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).getValues():[];
  const matches=rows.filter(r=>String(r[hm['Catalogue ID']-1]||'').trim().toUpperCase()===id);
  if(matches.length!==1)throw Error('Expected one Catalogue record for '+id+'; found '+matches.length);
  const old=matches[0],category=String(old[hm['Category']-1]||'').trim(),name=String(old[hm['Service Name']-1]||'').trim();
  const price=Number(input.price),salon=input.salonPrice==null||String(input.salonPrice).trim()===''?'':Number(input.salonPrice);
  const changeDescription=Object.prototype.hasOwnProperty.call(input,'description');
  const description=changeDescription?String(input.description||'').trim():null;
  if(changeDescription&&description.length>4000)throw Error('Description exceeds 4000 characters.');
  if(input.price==null||String(input.price).trim()===''||!Number.isFinite(price)||price<0)throw Error('Valid mobile Price required.');
  if(salon!==''&&(!Number.isFinite(salon)||salon<0))throw Error('Invalid Salon Price.');
  const schema=AQBGetMasterListsSchema(),ms=AQBGetSheet(CONFIG.SHEETS.LISTS),m=schema.map;
  if(!schema.serviceNameCol||!m['Category']||!m['Price']||salon!==''&&!m['Salon Price'])throw Error('Master Lists required pricing columns missing.');
  const matchesMaster=[];
  if(ms.getLastRow()>1)ms.getRange(2,1,ms.getLastRow()-1,ms.getLastColumn()).getValues().forEach((r,i)=>{
    if(schema.itemCol&&String(r[schema.itemCol-1]||'').trim().toLowerCase()!=='service')return;
    if(AQBNormalizeServiceKey(r[m['Category']-1],r[schema.serviceNameCol-1])===AQBNormalizeServiceKey(category,name))matchesMaster.push(i+2);
  });
  if(matchesMaster.length!==1)throw Error('Master Lists identity ambiguous ('+matchesMaster.length+'). No changes made.');
  return {valid:true,catalogueId:id,category:category,serviceName:name,masterRow:matchesMaster[0],price:price,salonPrice:salon,changeDescription:changeDescription,description:description,
    existingPrice:m['Price']?ms.getRange(matchesMaster[0],m['Price']).getValue():'',
    existingSalonPrice:m['Salon Price']?ms.getRange(matchesMaster[0],m['Salon Price']).getValue():'',
    existingDescription:m['Description']?String(ms.getRange(matchesMaster[0],m['Description']).getValue()||''):'',
    warning:'Edit Price, Salon Price and optional Description. Identity, photos and approvals remain unchanged.'};
}
function AQBEditServiceManaged(input){
  const user=AQBRequireCataloguePhotoManager(),lock=LockService.getScriptLock();lock.waitLock(30000);
  let preview;
  try{
    preview=AQBPreviewEditServiceManaged(input);
    const sh=AQBGetSheet(CONFIG.SHEETS.LISTS),m=AQBGetMasterListsSchema().map;
