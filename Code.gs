function AQBPreviewPhotoStagingDuplicateReconciliation(){
  AQBRequireCataloguePhotoManager();
  const ss=AQBGetSpreadsheet(),sheet=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
  if(!sheet)throw Error('AQB Photo Staging unavailable');
  const hm=AQBBuildHeaderMap(sheet),values=sheet.getDataRange().getValues(),groups={};
  if(!hm['Catalogue ID'])throw Error('Catalogue ID column missing');
  for(let i=1;i<values.length;i++){
    const id=String(values[i][hm['Catalogue ID']-1]||'').trim().toUpperCase();
    if(!id)continue;(groups[id]=groups[id]||[]).push({row:i+1,values:values[i]});
  }
  const duplicates=[];
  Object.keys(groups).sort().forEach(function(id){
    if(groups[id].length<2)return;
    const items=groups[id].map(function(item){
      const populated=item.values.filter(function(v){return v!==''&&v!=null;}).length;
      const evidence=item.values.map(function(v,i){
        const name=String(values[0][i]||'');
        return /photo|candidate|approval|qualification|provenance|review|image|url|brief|source|status|audit|credit/i.test(name)&&v!==''&&v!=null?name:null;
      }).filter(Boolean);
      return {row:item.row,populated:populated,evidenceFields:evidence};
    });
    duplicates.push({catid:id,rows:items,proposedKeeperRow:items.slice().sort(function(a,b){return b.evidenceFields.length-a.evidenceFields.length||b.populated-a.populated||a.row-b.row;})[0].row});
  });
  const result={version:'V16.21.16',readOnly:true,duplicateIds:duplicates.length,duplicateExtraRows:duplicates.reduce(function(n,d){return n+d.rows.length-1;},0),duplicates:duplicates};
  Logger.log('AQB_DUPLICATE_PREVIEW '+JSON.stringify(result));return result;
}

function AQBReconcilePhotoStagingDuplicatesProtected(){
  AQBRequireAdmin();
  const preview=AQBPreviewPhotoStagingDuplicateReconciliation();
  if(!preview.duplicateIds)return {version:'V16.21.16',unchanged:true,duplicates:0};
  const ss=AQBGetSpreadsheet(),stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),values=stage.getDataRange().getValues();
  // Fail closed on conflicting non-inherited evidence: require manual evaluation before deleting any duplicate.
  const inherited=new Set(['Catalogue ID','Service Name','Service Tier','Category','Catalogue Type','Description','Photo Brief']);
  const headers=values[0].map(function(h){return String(h||'').trim();});
  const conflict=[];
  preview.duplicates.forEach(function(d){
    headers.forEach(function(h,j){if(inherited.has(h))return;
      const distinct=[...new Set(d.rows.map(function(r){return String(values[r.row-1][j]||'').trim();}).filter(Boolean))];
      if(distinct.length>1)conflict.push({catid:d.catid,field:h,rows:d.rows.map(function(r){return r.row;})});
    });
  });
  if(conflict.length){Logger.log('AQB_DUPLICATE_CONFLICTS '+JSON.stringify(conflict));throw Error('Duplicate evidence conflicts found ('+conflict.length+'); no changes. Review logged CATIDs and fields.');}
  // Back up the entire sheet, then keep strongest row and archive all other original rows in that backup.
  const backupName='AQB Photo Staging PRE-DEDUP '+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd_HHmmss');
  const backup=stage.copyTo(ss).setName(backupName);backup.hideSheet();
  const drop=[];preview.duplicates.forEach(function(d){d.rows.forEach(function(r){if(r.row!==d.proposedKeeperRow)drop.push(r.row);});});
  drop.sort(function(a,b){return b-a;}).forEach(function(row){stage.deleteRow(row);});
  const result={version:'V16.21.16',backupSheet:backupName,removedDuplicateRows:drop.length,remainingDuplicateIds:AQBPreviewPhotoStagingDuplicateReconciliation().duplicateIds,publicationWrites:0,photoEvidenceBackedUp:true};
  Logger.log('AQB_PROTECTED_DEDUP '+JSON.stringify(result));return result;
}


