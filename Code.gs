/**
 * Non-mutating diagnostic. Use before enabling allocator.
 */
function AQBAuditCustomerIdCapacity_() {
  // Read-only diagnostic uses the same monotonic rules as the actual allocator.
  // No historical identifier is recycled to fit a count-based ceiling.
  const audit = AQBGetCustomerIdAllocationAudit_();
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty('AQB_CUSTOMER_ID_HIGH_WATER_V1');
  if (raw && !/^\d+$/.test(raw)) throw new Error('Invalid customer ID high-water property.');
  const historicalMax = Array.from(audit.used).concat(Array.from(audit.blocked)).reduce(function(max, id) {
    const match = /^AQB(\d+)$/i.exec(String(id));
    return match ? Math.max(max, Number(match[1])) : max;
  }, 3);
  const highWater = Math.max(historicalMax, raw ? Number(raw) : 3);
  const safe = Number.isSafeInteger(highWater) && highWater < Number.MAX_SAFE_INTEGER - 1;
  return {
    customers: audit.count,
    historicalMaximum: 'AQB' + String(historicalMax).padStart(3, '0'),
    highWater: raw || null,
