    {key:'pedicure',terms:['pedicure','pedicuring','foot care']},
    {key:'makeup',terms:['makeup','make up','cosmetic application']},
    {key:'facial',terms:['facial','skin treatment','skincare treatment']},
    {key:'massage',terms:['massage','massaging','spa treatment']}
  ];
  const detected=[];
  groups.forEach(function(g){
    if(g.terms.some(function(t){return AQBHasVariantTerm(low,t);})){detected.push(g);}
