// === AQB Customer Identity Guard V16.22.1.12 ===
/**
 * AQB Customer ID allocator — guarded patch (not deployed)
 * Replace the legacy generateCustomerID_ implementation with the wrapper below.
 * Keep every customer creation path calling generateCustomerID_() while migrating
 * to AQBAllocateCustomerId_().
 *
 * IMPORTANT: Allocation and append MUST happen under the SAME ScriptLock.
 * For import batches, call allocation after each appended row, not in advance.
 * Existing createWhatsAppCustomer_ already acquires a lock; avoid nested locks.
 */

function AQBNormalizeCustomerId_(value) {
  const match = String(value == null ? '' : value).trim().match(/^AQB(\d+)$/i);
  return match ? 'AQB' + String(Number(match[1])).padStart(3, '0') : '';
}

function AQBGetCustomerIdRegistry_() {
  const key = 'AQB_CUSTOMER_ID_RETIRED_V1';
  const properties = PropertiesService.getScriptProperties();
  let data = [];
  try { data = JSON.parse(properties.getProperty(key) || '[]'); }
  catch (e) { throw new Error('Customer ID retired registry is invalid: ' + e.message); }
  if (!Array.isArray(data)) throw new Error('Customer ID retired registry must be an array.');
  return new Set(data.map(AQBNormalizeCustomerId_).filter(Boolean));
}

function AQBRetireCustomerIds_(ids) {
  // Call only after a verified ID migration and its audit trail have been saved.
  const properties = PropertiesService.getScriptProperties();
  const retired = AQBGetCustomerIdRegistry_();
  ids.forEach(function(id) {
    const normalized = AQBNormalizeCustomerId_(id);
    if (!normalized) throw new Error('Invalid retired Customer ID: ' + id);
    retired.add(normalized);
  });
  properties.setProperty('AQB_CUSTOMER_ID_RETIRED_V1', JSON.stringify(Array.from(retired).sort()));
}

function AQBGetCustomerIdAllocationAudit_() {
  const customers = AQBGetSheet(CONFIG.SHEETS.CUSTOMERS);
  const values = customers.getDataRange().getValues();
  const headers = values.shift().map(function(v) { return String(v).trim(); });
  const idIndex = headers.indexOf('Customer ID');
  if (idIndex < 0) throw new Error('Customers sheet lacks Customer ID header.');
  const used = new Set();
  const phones = new Set();
  let count = 0;
  values.forEach(function(row) {
    const id = AQBNormalizeCustomerId_(row[idIndex]);
    if (!id) return;
    if (used.has(id)) throw new Error('Duplicate Customer ID detected: ' + id);
    used.add(id);
    count++;
  });

  const blocked = AQBGetCustomerIdRegistry_();
  ['AQB001', 'AQB002', 'AQB003'].forEach(function(id) { blocked.add(id); });
  ['AQB252','AQB254','AQB255','AQB256','AQB257','AQB258','AQB259','AQB260','AQB261','AQB262','AQB263'].forEach(function(id) { blocked.add(id); });
  const references = [
    ['Appointments', 'Customer ID'],
    ['Payments', 'Customer ID'],
    ['Cash Flow', 'Customer ID'],
    ['WhatsApp Messages', 'Customer ID'],
    ['WhatsApp Conversations', 'Customer ID'],
    ['Audit Log', 'Record ID']
  ];
  const spreadsheet = customers.getParent();
  references.forEach(function(entry) {
    const sheet = spreadsheet.getSheetByName(entry[0]);
    if (!sheet || sheet.getLastRow() < 2) return;
    const header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    const column = header.findIndex(function(v) { return String(v).trim() === entry[1]; });
    if (column < 0) throw new Error('Missing ' + entry[1] + ' in ' + entry[0]);
    const rows = sheet.getRange(2, column + 1, sheet.getLastRow() - 1, 1).getValues();
    rows.forEach(function(row) {
      const id = AQBNormalizeCustomerId_(row[0]);
      if (id) blocked.add(id);
    });
  });
  // ID changes recorded in the audit log can refer to retired IDs in descriptions.
  const audit = spreadsheet.getSheetByName('Audit Log');
  if (audit && audit.getLastRow() > 1) {
    const auditRows = audit.getDataRange().getDisplayValues();
    auditRows.slice(1).forEach(function(row) {
      row.forEach(function(value) {
        const matches = String(value || '').match(/\bAQB\d{3,}\b/g) || [];
        matches.forEach(function(id) { blocked.add(AQBNormalizeCustomerId_(id)); });
      });
    });
  }
  return { count: count, ceiling: count + 3, used: used, blocked: blocked };
}

function AQBAllocateCustomerId_() {
  const audit = AQBGetCustomerIdAllocationAudit_();
  // Monotonic allocation: do not recycle historical or retired customer identities.
  // IMPORTANT: caller must hold the SAME ScriptLock through customer-row insertion.
  const props = PropertiesService.getScriptProperties();
  const raw = props.getProperty('AQB_CUSTOMER_ID_HIGH_WATER_V1');
  if (raw && !/^\d+$/.test(raw)) throw new Error('Invalid customer ID high-water property; reconcile before creating customers.');
  const all = Array.from(audit.used).concat(Array.from(audit.blocked));
  const historicalMax = all.reduce(function(max,id) {
    const m = /^AQB(\d+)$/i.exec(String(id));
    return m ? Math.max(max,Number(m[1])) : max;
  }, 3);
  const highest = Math.max(historicalMax, raw ? Number(raw) : 3);
  if (raw && (!Number.isSafeInteger(Number(raw)) || Number(raw) < 3))
    throw new Error('Unsafe customer ID high-water; reconcile historical IDs before creating customers.');
  if (!Number.isSafeInteger(highest) || highest >= Number.MAX_SAFE_INTEGER-1)
    throw new Error('Customer ID sequence exhausted; manual reconciliation required.');
  const id = 'AQB' + String(highest + 1).padStart(3,'0');
  // Reserve before returning: never reuse this ID even if a later append fails.
  // ScriptLock MUST be held by the caller to serialize this reservation.
  props.setProperty('AQB_CUSTOMER_ID_HIGH_WATER_V1',String(highest+1));
  return id;
}

