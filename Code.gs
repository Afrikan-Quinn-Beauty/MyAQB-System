function AQBNormalizeWhatsAppText(text){return String(text||'').trim().replace(/\s+/g,' ');}

function AQBParseWhatsAppIntent(text){
  const t=AQBNormalizeWhatsAppText(text).toLowerCase();
  if(/\b(book|booking|appointment|available|availability|slot|schedule|tomorrow|today|next week)\b/.test(t))return 'BOOKING';
  if(/\b(price|cost|how much|starting price|rate|rates|charge)\b/.test(t))return 'PRICE';
  if(/\b(service|services|what do you|what can you|offer|catalogue|styles|hair)\b/.test(t))return 'SERVICES';
  if(/\b(where|location|located|address|directions)\b/.test(t))return 'LOCATION';
  if(/\b(home service|come to me|at home|house call|mobile service)\b/.test(t))return 'HOME_SERVICE';
  if(/\b(sisterlocks|retie|retighten|retightening)\b/.test(t))return 'RETIE';
  if(/^(hi|hello|hey|good morning|good afternoon|good evening)\b/.test(t))return 'GREETING';
  return 'GENERAL';
}

function AQBMatchWhatsAppService(text){
  const query=AQBNormalizeWhatsAppText(text).toLowerCase(); if(!query)return null;const services=[];
  try{AQBGetPublicServiceCatalog(true).forEach(function(x){services.push({name:x.service,category:x.category,price:x.price,catalogueId:x.catalogueId,source:'SERVICE'});});}catch(e){}
  try{AQBGetTrendCatalogue(false).forEach(function(x){if(String(x.website).toLowerCase()!=='no')services.push({name:x.styleName,category:x.category,price:x.price,catalogueId:x.catalogueId,source:'TREND',duration:x.duration});});}catch(e){}
  let best=null,bestScore=0;services.forEach(function(x){const n=String(x.name).toLowerCase(),compact=n.replace(/[^a-z0-9]+/g,' ');let score=0;if(query.indexOf(n)>=0)score+=100;const toks=compact.split(/\s+/).filter(t=>t.length>=3);toks.forEach(function(tok){if(query.indexOf(tok)>=0)score+=10;});if(/starter\s+locs?/.test(query)&&/starter\s+locs?/.test(compact))score+=80;if(/fulani/.test(query)&&/fulani/.test(compact))score+=80;if(/boho/.test(query)&&/boho/.test(compact))score+=50;if(/knotless/.test(query)&&/knotless/.test(compact))score+=50;if(score>bestScore){bestScore=score;best=x;}});return bestScore>=10?best:null;
}

function AQBGetWhatsAppToday(){const d=new Date();d.setHours(0,0,0,0);return d;}

function AQBParseWhatsAppDate(text){
  const t=AQBNormalizeWhatsAppText(text).toLowerCase(),today=AQBGetWhatsAppToday();if(/\btomorrow\b/.test(t)){today.setDate(today.getDate()+1);return today;}if(/\btoday\b/.test(t))return today;
  const iso=t.match(/\b(20\d{2})[-\/](\d{1,2})[-\/](\d{1,2})\b/);if(iso){const d=new Date(Number(iso[1]),Number(iso[2])-1,Number(iso[3]));d.setHours(0,0,0,0);return d;}
  const dmy=t.match(/\b(\d{1,2})[\/-](\d{1,2})(?:[\/-](20\d{2}))?\b/);if(dmy){const d=new Date(dmy[3]?Number(dmy[3]):today.getFullYear(),Number(dmy[2])-1,Number(dmy[1]));d.setHours(0,0,0,0);return d;}
  return null;
}

function AQBParseWhatsAppTime(text){const t=AQBNormalizeWhatsAppText(text).toLowerCase(),m=t.match(/\b(\d{1,2})(?::(\d{2}))?\s*(am|pm|hrs?|hours?)?\b/);if(!m)return null;let h=Number(m[1]),min=Number(m[2]||0),ap=m[3]||'';if(ap==='pm'&&h<12)h+=12;if(ap==='am'&&h===12)h=0;if(h>23||min>59)return null;return h*60+min;}

function AQBCreateWhatsAppCustomer(phone,name,service){
  // Customer Journey canonical guard: resolve and append under one ScriptLock.
  // Do not use an unlocked first-match lookup: duplicates must fail closed.
  const normalized=AQBNormalizeCustomerPhone_(phone);
  if(!normalized)throw new Error('Valid Kenyan mobile phone required for WhatsApp customer creation.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const identity=AQBResolveCustomerForCreate_(normalized);
    if(identity.existing){
      const existing=AQBFindCustomerByWhatsAppNumberPublic(normalized);
      if(!existing||String(existing.customerId)!==String(identity.customerId))throw new Error('Customer identity mismatch; manual review required.');
      return existing;
    }
    const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),m=AQBBuildHeaderMap(s),row=Array(s.getLastColumn()).fill('');
    const customerId=identity.customerId,full=String(name||'').trim(),parts=full.split(/\s+/),first=parts.shift()||full,last=parts.join(' ');
    row[m['Customer ID']-1]=customerId;row[m['Customer Name']-1]=full;row[m['First Name']-1]=first;row[m['Last Name']-1]=last;
    row[m['WhatsApp Number']-1]=normalized;row[m['Service']-1]=String(service||'').trim();row[m['Payment Status']-1]='Pending';
    row[m['Total Visits']-1]=0;row[m['Customer Status']-1]='New';row[m['Next Appointment Created']-1]='No';
    AQBAppendUniqueCustomerRow(s,row);
    return {customerId:customerId,customerName:full,firstName:first,phone:normalized,service:String(service||'').trim()};
  }finally{lock.releaseLock();}
}

