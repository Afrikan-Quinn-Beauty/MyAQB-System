function AQBRecordExpense(payload){
  const user=AQBRequireAdmin();
  if(!payload) throw new Error('Expense information is required.');
  const amount=Number(payload.amount);
  if(!isFinite(amount)||amount<=0) throw new Error('Please enter a valid positive expense amount.');
  const method=String(payload.paymentMethod||'').trim();
  if(!AQBGetMasterListValues('Payment Method').includes(method)) throw new Error('Invalid payment method.');

  const lock=LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    let cashFlow;
    try { cashFlow=AQBGetSheet(CONFIG.SHEETS.CASH_FLOW); }
    catch(e){ throw new Error('Expense could not access the Cash Flow sheet. '+e.message); }

    let id;
    try { id=AQBGenerateTransactionID(); }
    catch(e){ throw new Error('Expense could not generate a transaction ID from Cash Flow. '+e.message); }

    const date=payload.date?AQBParseDateFromClient(payload.date):new Date();
    const category=String(payload.category||'Other').trim();
    const desc=String(payload.description||'').trim();

    try {
      AQBAppendByHeaders(cashFlow,{
        'Transaction ID':id,'Date':date,'Customer ID':'','Customer Name':'','Appointment ID':'','Service':'',
        'Transaction Type':'Expense','Payment Method':method,'Amount':amount,'Payment Status':'Paid',
        'Description':category+(desc?' — '+desc:''),'Recorded By':user.email,'Source Payment ID':''
      });
    } catch(e) {
      throw new Error('Expense could not be written to Cash Flow. '+e.message);
    }

    AQBLogAudit('RECORD_EXPENSE','Cash Flow',id,'Expense of KES '+amount+' recorded.');
    return {success:true,transactionId:id};
  } finally {
    lock.releaseLock();
  }
}

