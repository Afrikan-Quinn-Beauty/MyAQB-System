/** Appointment-level recovery used by the universal hourly worker and manual review. */
function AQBRepairCompletedRetieByAppointment(appointmentId, options){
  AQBRequireAdmin(); options=options||{};
  const id=String(appointmentId||'').trim(); if(!id)throw new Error('Appointment ID required.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const ap=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS), ar=ap.getLastRow()>1?ap.getRange(2,1,ap.getLastRow()-1,17).getValues():[];
    const a=ar.filter(r=>String(r[0]||'').trim()===id);
    if(a.length!==1)throw new Error('Expected exactly one appointment '+id+'; found '+a.length);
    const r=a[0],cid=String(r[1]||'').trim();
    if(String(r[8]||'').trim().toUpperCase()!=='COMPLETED'||!AQBIsSisterlocksRetieService(r[4]))throw new Error('Only completed Sisterlocks reties can be repaired.');
    const actual=AQBGetActualCompletionDateFromAppointment(r);
    if(!actual)throw new Error('Explicit actual completion date missing in appointment notes; no dates inferred.');
    const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),m=AQBBuildHeaderMap(cs),data=cs.getRange(2,1,cs.getLastRow()-1,cs.getLastColumn()).getValues();
    const matches=data.map((v,i)=>({v,i})).filter(x=>String(x.v[m['Customer ID']-1]||'').trim()===cid);
    if(matches.length!==1)throw new Error('Customer identity ambiguous or missing: '+cid);
    const cr=matches[0].v,idx=matches[0].i+2;
    const phone=AQBNormalizePhone(cr[m['WhatsApp Number']-1]);if(!AQBIsValidPhone(phone))throw new Error('Customer WhatsApp number is invalid: '+cid);
    const latest=ar.filter(x=>String(x[1]||'').trim()===cid&&String(x[8]||'').trim().toUpperCase()==='COMPLETED'&&AQBIsSisterlocksRetieService(x[4]))
      .map(x=>({id:String(x[0]),date:AQBGetActualCompletionDateFromAppointment(x)})).filter(x=>x.date).sort((x,y)=>y.date.getTime()-x.date.getTime());
    if(latest.length&&latest[0].date.getTime()>actual.getTime())throw new Error('A newer evidenced completed retie exists; refusing to overwrite customer cycle.');
    const dates=AQBCalculateRetieDates(actual);
    const next=dates.nextRetieDate,reminder=dates.reminderDate;
    const current=cr[m['Last Retie Date']-1],currentDate=AQBParseRetieDate(current);
    if(currentDate&&currentDate.getTime()>actual.getTime())throw new Error('Customer already has a newer last retie date.');
    const changed=!currentDate||Utilities.formatDate(currentDate,'Africa/Nairobi','yyyy-MM-dd')!==Utilities.formatDate(actual,'Africa/Nairobi','yyyy-MM-dd');
    const active=AQBFindActiveSameTypeAppointments(cid,AQBGetAutomaticRetieService(r[4]),null);
    const preview={appointmentId:id,customerId:cid,actualCompletionDate:Utilities.formatDate(actual,'Africa/Nairobi','yyyy-MM-dd'),nextRetieDate:next,reminderDate:reminder,profileNeedsUpdate:changed,existingActiveAppointments:active.map(x=>x.appointmentId),willSendWhatsApp:!!options.sendWhatsApp};
    if(options.dryRun!==false)return Object.assign({success:true,dryRun:true},preview);
    cr[m['Last Retie Date']-1]=actual;cr[m['Next Retie Date']-1]=AQBParseDateFromClient(next);cr[m['Reminder Date']-1]=AQBParseDateFromClient(reminder);
    cr[m['Reminder Sent']-1]='No';cr[m['Service']-1]=String(r[4]);
    // Derive visits from completed appointment IDs; never increment blindly on a retry.
    cr[m['Total Visits']-1]=ar.filter(x=>String(x[1]||'').trim()===cid&&String(x[8]||'').trim().toUpperCase()==='COMPLETED').length;
    cr[m['Next Appointment Created']-1]=active.length?'Yes':'No';
    [ 'Last Retie Date','Next Retie Date','Reminder Date','Reminder Sent','Service','Total Visits','Next Appointment Created' ].forEach(function(header){
      cs.getRange(idx,m[header]).setValue(cr[m[header]-1]);
    });
    let booked=null,bookingError='';
    if(!active.length){
      try{booked=AQBCreateAutomaticRetieAppointmentForCustomer(cr,m,false);if(booked&&booked.appointmentId){
            // Re-resolve by AQBID after booking; never assume fixed row positions.
            const refreshed=cs.getRange(2,1,cs.getLastRow()-1,cs.getLastColumn()).getValues();
            const found=refreshed.map((v,i)=>({v,i})).filter(x=>String(x.v[m['Customer ID']-1]||'').trim()===cid);
            if(found.length!==1)throw new Error('Customer identity changed after booking: '+cid);
            cs.getRange(found[0].i+2,m['Next Appointment Created']).setValue('Yes');
          }}
      catch(e){bookingError=String(e&&e.message||e);AQBLogAudit('RETIE_REPAIR_BOOKING_FAILED','Appointment',id,bookingError);}
    }
    let wa={status:'NOT_REQUESTED'};
    if(options.sendWhatsApp===true){
      const evidence=AQBGetCompletionNotificationEvidence_(id,cid,actual);
      if(evidence.exists){wa={status:'HELD_EXISTING_EVIDENCE',reason:evidence.reason};}
      else if(!booked&&!active.length){wa={status:'HELD_NO_BOOKING'};}
      else if(!AQBIsWhatsAppRecoverySendHour_()){wa={status:'HELD_QUIET_HOURS'};}
      else{
        const props=PropertiesService.getScriptProperties();
        props.setProperty('AQB_COMPLETION_RECOVERY_INTENT_'+id,new Date().toISOString());
        try{
          const customer=AQBFindCustomerByIdForWhatsApp(cid);
          const result=AQBSendSisterlocksCompletionWhatsApp(customer,booked||active[0]);
          wa={status:result&&result.sent?'SUBMITTED':'HELD_UNCERTAIN',error:String(result&&result.error||result&&result.reason||'')};
          try{AQBTrackAppointmentWhatsApp_(id,'COMPLETION',result);}catch(e){wa.trackingError=String(e&&e.message||e);AQBLogAudit('AQB_COMPLETION_RECOVERY_TRACKING_ERROR','Appointment',id,wa.trackingError);}
          if(result&&result.sent)props.setProperty('AQB_COMPLETION_WA_SENT_'+id,new Date().toISOString());
        }catch(e){wa={status:'HELD_UNCERTAIN',error:String(e&&e.message||e)};}
      }
    }
    const out=Object.assign({success:true,dryRun:false,booked:booked&&booked.appointmentId||'',bookingError,whatsApp:wa},preview);
    AQBLogAudit('AQB_COMPLETED_RETIE_SCOPED_REPAIR','Appointment',id,JSON.stringify(out));return out;
  }finally{lock.releaseLock();}
}

