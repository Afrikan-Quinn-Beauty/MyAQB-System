}
function AQBAddServiceManaged(payload){
  const user=AQBRequireCataloguePhotoManager();
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  let result;
  try{
    const preview=AQBPreviewAddService(payload);
    if(!preview.valid)throw new Error('SERVICE_ALREADY_EXISTS: '+JSON.stringify(preview.matches));
    const sheet=AQBGetSheet(CONFIG.SHEETS.LISTS),schema=AQBGetMasterListsSchema(),m=schema.map;
    ['Item','Category','Service Name','Price','Salon Price','Active','Trending','Sort Order'].forEach(function(k){if(!m[k])throw new Error('Master Lists schema missing '+k+'; no record created.');});
    if(!schema.serviceNameCol)throw new Error('Master Lists service name column missing; no record created.');
    const catSheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),catMap=AQBBuildHeaderMap(catSheet);
    ['Catalogue ID','Category','Service Name','Active'].forEach(function(k){if(!catMap[k])throw new Error('Catalogue schema missing '+k+'; no record created.');});
    if(preview.salonPrice!==''&&!m['Salon Price'])throw new Error('Salon Price column missing; no record created.');
    const row=Array(sheet.getLastColumn()).fill('');
    if(!schema.itemCol)throw new Error('Master Lists Item column missing; no record created.');
    row[m['Item']-1]='Service';
    row[schema.serviceNameCol-1]=preview.serviceName;
    row[m['Category']-1]=preview.category;
    row[m['Price']-1]=preview.price;
    row[m['Active']-1]=!!preview.active;
    // Sort Order is based only on existing Item=Service rows, not all Master Lists rows.
    const existing=sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).getValues():[];
    const usedOrders=existing.filter(r=>String(r[m['Item']-1]||'').trim().toLowerCase()==='service').map(r=>Number(r[m['Sort Order']-1])).filter(n=>Number.isFinite(n)&&n>=0);
    row[m['Sort Order']-1]=(usedOrders.length?Math.max.apply(null,usedOrders):0)+1;
    if(preview.salonPrice!=='')row[m['Salon Price']-1]=preview.salonPrice;

    if(!m['Trending'])throw new Error('Master Lists Trending header missing; no record created.');
    row[m['Trending']-1]=preview.trending?'Yes':'No';
    // Apply only formatting from the nearest existing Service row, never its values.
    // This prevents the bold/category style inherited from adjacent section rows.
    const templateRow=(function(){
      for(let i=existing.length-1;i>=0;i--){
        if(String(existing[i][m['Item']-1]||'').trim().toLowerCase()==='service')return i+2;
      }
      return 0;
    })();
    sheet.appendRow(row);
    const newRow=sheet.getLastRow();
    if(templateRow){
      sheet.getRange(templateRow,1,1,sheet.getLastColumn())
        .copyTo(sheet.getRange(newRow,1,1,sheet.getLastColumn()),SpreadsheetApp.CopyPasteType.PASTE_FORMAT,false);
      // Consistent regular text for new service entries, including Category.
      sheet.getRange(newRow,1,1,sheet.getLastColumn()).setFontWeight('normal');
    }
    result={success:true,masterRow:newRow,serviceName:preview.serviceName,category:preview.category,
      item:'Service',price:preview.price,salonPrice:preview.salonPrice,active:preview.active,trending:preview.trending,sortOrder:row[m['Sort Order']-1],publication:'PENDING_EXISTING_PUBLICATION_WORKFLOW',syncRequired:true};
    AQBLogAudit('ADD_SERVICE_MASTER','Catalogue',preview.category+' / '+preview.serviceName,
      user.email+' created Master Lists service (Active='+row[m['Active']-1]+', Trending='+row[m['Trending']-1]+'); catalogue synchronization required.');
  }finally{lock.releaseLock();}
  // Existing synchronization owns AQBCAT allocation. No new ID allocator is introduced.
  try{
    const sync=AQBSyncOfficialServiceCatalogue();
    const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(cat);
    // A successful sync must produce exactly one canonical identity, even on an empty Catalogue.
    ['Catalogue ID','Category','Service Name','Active'].forEach(function(header){
      if(!cm[header])throw new Error('Catalogue verification column missing: '+header);
    });
    if(cat.getLastRow()<2)throw new Error('Catalogue synchronization produced no service records.');
    {
      const rows=cat.getRange(2,1,cat.getLastRow()-1,cat.getLastColumn()).getValues();
      const found=rows.filter(r=>AQBNormalizeServiceKey(r[cm['Category']-1],r[cm['Service Name']-1])===AQBNormalizeServiceKey(result.category,result.serviceName));
      if(found.length!==1)throw new Error('Expected exactly one matching Catalogue row; found '+found.length);
      result.catalogueId=String(found[0][cm['Catalogue ID']-1]||'');
      if(!/^AQBCAT\d+$/.test(result.catalogueId))throw new Error('Catalogue ID missing/invalid after sync.');
      result.catalogueActive=cm['Active']?AQBNormalizeBool(found[0][cm['Active']-1]):null;
      result.publication=result.catalogueActive?'ACTIVE_IN_CATALOGUE':'INACTIVE_IN_CATALOGUE';
    }
    // Prepare staging for this new identity only. Never publish or overwrite an approved photo.
    try { result.photoStaging=AQBPrepareNewServicePhotoStaging(result.catalogueId); }
    catch(stageError){ result.photoStagingError=String(stageError&&stageError.message||stageError); result.actionRequired='Catalogue service exists. Repair photo staging by CATID; do not add service again.'; }
    result.syncRequired=false;result.sync=sync;
  }catch(e){result.success=false;result.syncError=String(e&&e.message||e);result.actionRequired='Review Master Lists row '+result.masterRow+' and run guarded Catalogue sync; do not add service again.';}
  return result;
}
