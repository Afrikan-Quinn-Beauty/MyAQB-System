function AQBNormalizeCustomerPhone_(input) {
  let digits = String(input == null ? '' : input).replace(/\D/g, '');
  if (/^0[17]\d{8}$/.test(digits)) digits = '254' + digits.slice(1);
  else if (/^[17]\d{8}$/.test(digits)) digits = '254' + digits;
  if (!/^254[17]\d{8}$/.test(digits)) return '';
  return digits;
}

function AQBAuditDuplicateCustomers_() {
  const sheet = getSheet_(CONFIG.SHEETS.CUSTOMERS);
  const values = sheet.getDataRange().getValues();
  const headers = values[0].map(v => String(v).trim());
  const idCol = headers.indexOf('Customer ID');
  const phoneCol = headers.indexOf('WhatsApp Number');
  const nameCol = headers.indexOf('Customer Name');
  if (idCol < 0 || phoneCol < 0) throw new Error('Customers schema missing Customer ID or WhatsApp Number');
  const ids = new Map(), phones = new Map(), duplicateIds = [], duplicatePhones = [], invalidPhones = [];
  const nameGroups = new Map();
  for (let i = 1; i < values.length; i++) {
    const row = values[i], rowNumber = i + 1;
    if (!row.some(v => String(v).trim())) continue;
    const id = AQBNormalizeCustomerId_(row[idCol]);
    const phone = AQBNormalizeCustomerPhone_(row[phoneCol]);
    if (!id) throw new Error('Invalid or missing Customer ID at row ' + rowNumber);
    if (ids.has(id)) duplicateIds.push({id, rows:[ids.get(id), rowNumber]});
    else ids.set(id, rowNumber);
    if (!phone) invalidPhones.push(rowNumber);
    else if (phones.has(phone)) duplicatePhones.push({phone, rows:[phones.get(phone), rowNumber]});
    else phones.set(phone, rowNumber);
    const name = nameCol >= 0 ? String(row[nameCol] || '').trim().toLowerCase().replace(/\s+/g, ' ') : '';
    if (name) { if (!nameGroups.has(name)) nameGroups.set(name, []); nameGroups.get(name).push(rowNumber); }
  }
  return {
    customerCount: ids.size,
    duplicateIds, duplicatePhones, invalidPhones,
    possibleNameDuplicates: Array.from(nameGroups.entries()).filter(([name, rows]) => rows.length > 1)
      .map(([name, rows]) => ({name, rows})),
    clean: duplicateIds.length === 0 && duplicatePhones.length === 0 && invalidPhones.length === 0
  };
}
