  .map(function(r){return {service:String(r[schema.serviceNameCol-1]).trim(),price:String(r[m['Price']-1]||''),group:String(r[m['Category']-1]||''),category:String(r[m['Category']-1]||''),item:schema.legacyNoItem?'Service':String(r[m['Item']-1]||''),sortOrder:Number(r[m['Sort Order']-1]||0)||0};})
  .filter(function(x){const k=x.service.toLowerCase();if(seen[k])return false;seen[k]=true;return true;})
