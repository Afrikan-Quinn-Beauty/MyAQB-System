function AQBGetCatalogueExistingVariantLanguage(row,cm,service){
  const out=[];
  ['Customer-Facing Name','Customer Search Names','Service Synonyms'].forEach(function(h){
    if(!cm[h])return;
    AQBSplitCatalogueVariants(row[cm[h]-1]).forEach(function(v){
      const k=AQBNormalizeCatalogueVariantText(v);
      if(k&&k!==AQBNormalizeCatalogueVariantText(service))out.push(v);
