    if(old)s.getRange(old,1,1,s.getLastColumn()).setValues([row]);else s.appendRow(row);
  });
  const hot=items.map(AQBNormalizeAQBDNBItem).sort(function(a,b){return (a.rank||999)-(b.rank||999);});
  const briefPayload={feed:'AQB_DNB',briefId:feedId,externalId:feedId,briefDate:briefDate,headline:String(payload.headline||hot[0].headline||'Daily Hair & Beauty Briefing').trim(),summary:String(payload.summary||hot[0].summary||'').trim(),hotTrends:hot.map(function(x){return x.headline+' — '+x.category;}),watchItems:[],recommendedActions:hot.map(function(x){return x.aqb_opportunity;}).filter(Boolean),status:'READY',sourceUrl:String(payload.source_url||payload.sourceUrl||hot[0].source_url||'').trim()};
  AQBUpsertDNBBrief(briefPayload);
  AQBSetAQBDNBStatus({LAST_SUCCESSFUL_FEED:now,LAST_ATTEMPTED_FEED:now,LAST_PROCESSED_FEED:feedId,ITEMS_RECEIVED:items.length,ITEMS_PROCESSED:items.length,ITEMS_REJECTED:0,LAST_ERROR:'NONE',FEED_VERSION:payload.version,API_STATUS:'OK',LAST_PROCESSED_HASH:hash,BRIEF_DATE:briefDate});
  try{AQBLogAudit('DNB_FEED_IMPORTED','Trend Intelligence',feedId,'Structured DNB feed accepted and stored: '+items.length+' items.');}catch(ignore){}
  return {success:true,duplicate:false,feedId:feedId,feedHash:hash,itemsReceived:items.length,itemsProcessed:items.length,briefDate:briefDate};
