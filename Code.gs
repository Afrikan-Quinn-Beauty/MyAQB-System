function AQBGetWhatsAppQuietTimeStatus(when){
  const cfg=AQBGetWhatsAppQuietTimeConfig(),now=when instanceof Date?new Date(when):new Date();
  function mins(v){
    const m=String(v||'').match(/^(\d{1,2}):(\d{2})$/);
    if(!m)return null;
    const h=Number(m[1]),mi=Number(m[2]);
    if(h>23||mi>59)return null;
    return h*60+mi;
  }
  const start=mins(cfg.start),end=mins(cfg.end),
        local=Utilities.formatDate(now,cfg.timezone,'HH:mm'),
        current=mins(local);
  if(!cfg.enabled)return {quiet:false,allowed:true,enabled:false,localTime:local,timezone:cfg.timezone,start:cfg.start,end:cfg.end};
  if(start===null||end===null||current===null)return {quiet:true,allowed:false,enabled:true,reason:'INVALID_QUIET_TIME_CONFIG',localTime:local,timezone:cfg.timezone,start:cfg.start,end:cfg.end};
  const allowed=start<end?(current>=start&&current<end):(current>=start||current<end);
  return {quiet:!allowed,allowed:allowed,enabled:true,localTime:local,timezone:cfg.timezone,start:cfg.start,end:cfg.end,reason:allowed?'SEND_WINDOW_OPEN':'QUIET_TIME'};
}

