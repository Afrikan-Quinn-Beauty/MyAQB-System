function AQBGetLatestAQBDNBRecord(){
  // A generated AQB snapshot/brief is NOT eligible to become DNB by itself.
  const s=AQBEnsureConsolidatedIntelligenceSheet(), n=s.getLastRow();
  if(n<2)return null;
  const m=AQBBuildHeaderMap(s), rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  const candidates=rows.map(function(r,i){
    const rt=m['Record Type']?String(r[m['Record Type']-1]||'').trim().toUpperCase():'';
    const source=m['DNB Source']?String(r[m['DNB Source']-1]||'').trim().toUpperCase():'';
    const ext=m['DNB External ID']?String(r[m['DNB External ID']-1]||'').trim():'';
    const url=m['DNB Source URL']?String(r[m['DNB Source URL']-1]||'').trim():'';
    // Explicit provenance is mandatory. This prevents the old circular
    // AQB-inbox -> generated brief -> Trending path from masquerading as DNB.
    if(source!=='DNB' && rt!=='DNB_DAILY_BRIEF' && !ext && !/^https?:\/\/chat\.openai\.com\/share\//i.test(url) && !/^https?:\/\/chatgpt\.com\/share\//i.test(url))return null;
    if(rt!=='DAILY_BRIEF' && rt!=='DNB_DAILY_BRIEF')return null;
    const bid=m['Brief ID']?String(r[m['Brief ID']-1]||'').trim():'';
    if(!bid)return null;
    return {row:r,rowNumber:i+2};
  }).filter(Boolean);
  if(!candidates.length)return null;
  candidates.sort(function(a,b){
    const da=m['DNB Verified At']?new Date(a.row[m['DNB Verified At']-1]||0).getTime():0;
    const db=m['DNB Verified At']?new Date(b.row[m['DNB Verified At']-1]||0).getTime():0;
    const ba=m['Brief Date']?new Date(a.row[m['Brief Date']-1]||0).getTime():0;
    const bb=m['Brief Date']?new Date(b.row[m['Brief Date']-1]||0).getTime():0;
    return db-da||bb-ba||b.rowNumber-a.rowNumber;
  });
  const x=candidates[0], r=x.row, get=function(h){return m[h]?r[m[h]-1]:'';};
  return {
    recordId:String(get('Record ID')||''),
    briefId:String(get('Brief ID')||get('Record ID')||''),
    briefDate:get('Brief Date')||'',
    headline:String(get('Headline')||''),
    summary:String(get('Summary')||''),
    hotTrends:String(get('Hot Trends')||''),
    watchItems:String(get('Watch Items')||''),
    recommendedActions:String(get('Recommended Actions')||''),
    source:String(get('DNB Source')||'DNB'),
    sourceUrl:String(get('DNB Source URL')||''),
    externalId:String(get('DNB External ID')||''),
    verifiedAt:get('DNB Verified At')||''
  };
}

