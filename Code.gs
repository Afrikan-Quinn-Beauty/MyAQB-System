function AQBResetAIIntelligence(options){
  AQBRequireAdmin();
  options=options||{};
  const dryRun=options.dryRun!==false;
  if(!dryRun&&options.confirm!=='PRESERVE_13_RESET_HISTORICAL_AI')
    throw new Error('AI_SIGNALS_RESET_CONFIRMATION_REQUIRED');
  const ss=AQBGetSpreadsheet();
  const names=['AQB AI Signals','AQB AI Trends','AQB AI Collections'];
  const expected={signals:164,pending:13,retired:50};
  // Preserve the approved 13 Trend IDs, not just the count. No new records
  // or changes to their contents are made by this post-reset check.
  const expectedPendingIds=['AQB-TI-3B1A3C75','AQB-TI-B34C59E1','AQB-TI-B9E34297',
    'AQB-TI-1D72176A','AQB-TI-1B1A9925','AQB-TI-6DF850C4','AQB-TI-F0F9DA69',
    'AQB-TI-6DBDF8AF','AQB-TI-EC550FB3','AQB-TI-433AF5DA',
    'AQB-TI-06227D3D','AQB-TI-1C96AF6F','AQB-TI-CE9D35F5'];
  const sheets=names.map(function(name){const sh=ss.getSheetByName(name);if(!sh)throw new Error('AI_RESET_MISSING_SHEET: '+name);return sh;});
  const signals=sheets[0],sm=AQBBuildHeaderMap(signals);
  if(!sm['Record Type']||!sm['Status']||!sm['Record ID']||!sm['Trend ID'])throw new Error('AI_RESET_SIGNALS_SCHEMA_INVALID');
  const sigRows=signals.getLastRow()>1?signals.getRange(2,1,signals.getLastRow()-1,signals.getLastColumn()).getValues():[];
  const retained=sigRows.filter(function(r){return String(r[sm['Record Type']-1]||'').trim().toUpperCase()==='TREND_INBOX'&&String(r[sm['Status']-1]||'').trim().toUpperCase()==='PENDING';});
  const ids={},duplicateIds=[];
  retained.forEach(function(r){const id=String(r[sm['Record ID']-1]||'').trim(),tid=String(r[sm['Trend ID']-1]||'').trim();if(!id||!tid||ids[id])duplicateIds.push({recordId:id,trendId:tid});ids[id]=true;});
  const trends=sheets[1],tm=AQBBuildHeaderMap(trends);
  if(!tm['Record Type']||!tm['Trend Status']||!tm['Active'])throw new Error('AI_RESET_TRENDS_SCHEMA_INVALID');
  const trendRows=trends.getLastRow()>1?trends.getRange(2,1,trends.getLastRow()-1,trends.getLastColumn()).getValues():[];
  const retired=trendRows.filter(function(r){return String(r[tm['Record Type']-1]||'').trim().toUpperCase()==='TREND_CATALOGUE'&&String(r[tm['Trend Status']-1]||'').trim().toUpperCase()==='PROMOTED'&&['NO','FALSE'].includes(String(r[tm['Active']-1]||'').trim().toUpperCase());});
  const collectionsRows=Math.max(0,sheets[2].getLastRow()-1);
  const result={version:'V16.21.15.5.5',dryRun:dryRun,readOnly:dryRun,signalsBefore:sigRows.length,pendingPreserved:retained.length,signalsDiscarded:sigRows.length-retained.length,retiredTrends:retired.length,totalTrendRows:trendRows.length,collectionsRows:collectionsRows,writes:0,backupSheets:[],protectedSheets:['Master Lists','Catalogue','Appointments','Customers','Payments','Users','Audit Log','DNB Feed','DNB System Status'],retainedTrendIds:retained.map(function(r){return String(r[sm['Trend ID']-1]||'').trim();}),issues:[]};
  const sortedIds=result.retainedTrendIds.slice().sort();
  const identityCorrect=sortedIds.length===expectedPendingIds.length&&
    sortedIds.every(function(id,i){return id===expectedPendingIds.slice().sort()[i];});
  if(duplicateIds.length)result.issues.push('BLANK_OR_DUPLICATE_PENDING_IDENTITY');
  if(!identityCorrect)result.issues.push('PENDING_TREND_IDENTITY_DRIFT');
  if(!sheets[2].getLastColumn())result.issues.push('COLLECTIONS_HEADER_MISSING');
  // A completed reset is a valid terminal state, never a reason to reset again.
  const cleanState=sigRows.length===expected.pending&&retained.length===expected.pending&&
    trendRows.length===0&&collectionsRows===0;
  result.alreadyClean=cleanState&&result.issues.length===0;
  if(!cleanState){
    if(sigRows.length!==expected.signals)result.issues.push('SIGNALS_ROW_COUNT_DRIFT');
    if(retained.length!==expected.pending)result.issues.push('PENDING_COUNT_DRIFT');
    if(retired.length!==expected.retired||trendRows.length!==expected.retired)result.issues.push('TREND_HISTORY_NOT_FULLY_RETIRED');
  }
  if(dryRun){Logger.log('=== AQB AI SIGNALS CLEAN SLATE PREVIEW ===');Logger.log(JSON.stringify(result));return result;}
  if(result.alreadyClean)throw new Error('AI_RESET_ALREADY_COMPLETED: No further cleanup is permitted. Use dryRun:true for verification.');
  if(result.issues.length)throw new Error('AI_RESET_PREFLIGHT_FAILED: '+JSON.stringify(result.issues));
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(30000))throw new Error('AI_RESET_LOCK_UNAVAILABLE');
  try{
    // Recheck live row cardinality under lock; never repeat reset after completion.
    if(signals.getLastRow()-1!==expected.signals||trends.getLastRow()-1!==expected.retired)
      throw new Error('AI_RESET_CONCURRENT_ROW_CHANGE');
    const stamp=Utilities.formatDate(new Date(),'Africa/Nairobi','yyMMddHHmmss');
    const prefixes=['AI_SIG_BAK_','AI_TRD_BAK_','AI_COL_BAK_'];
    const backupNames=prefixes.map(function(x){return x+stamp;});
    if(backupNames.some(function(n){return !!ss.getSheetByName(n);} ))throw new Error('AI_RESET_BACKUP_NAME_CONFLICT');
    // Copy and verify every source BEFORE clearing a single source cell.
    sheets.forEach(function(sh,i){const cp=sh.copyTo(ss);cp.setName(backupNames[i]);cp.hideSheet();result.backupSheets.push(backupNames[i]);
      if(cp.getLastRow()!==sh.getLastRow()||cp.getLastColumn()!==sh.getLastColumn())throw new Error('AI_RESET_BACKUP_VERIFICATION_FAILED: '+sh.getName());});
    // Retain every value of all 13 pending records, including JSON and evidence.
    signals.getRange(2,1,sigRows.length,signals.getLastColumn()).clearContent();
    signals.getRange(2,1,retained.length,signals.getLastColumn()).setValues(retained);
    result.writes+=2;
    if(trendRows.length){trends.getRange(2,1,trendRows.length,trends.getLastColumn()).clearContent();result.writes++;}
    if(collectionsRows){sheets[2].getRange(2,1,collectionsRows,sheets[2].getLastColumn()).clearContent();result.writes++;}
    // Clear the empty tail so getLastRow returns 14 (header + 13 pending).
    if(signals.getLastRow()!==retained.length+1)throw new Error('AI_RESET_POSTCHECK_SIGNALS_ROWS');
    if(trends.getLastRow()!==1)throw new Error('AI_RESET_POSTCHECK_TREND_HISTORY');
    if(sheets[2].getLastRow()>1)throw new Error('AI_RESET_POSTCHECK_COLLECTIONS');
    AQBLogAudit('AI_SIGNALS_CLEAN_SLATE','System',stamp,'Preserved '+retained.length+' pending Inbox records. Archived '+(sigRows.length-retained.length)+' historical signal rows and '+retired.length+' retired trends to protected backup sheets: '+backupNames.join(', '));
    result.writes++;result.success=true;
    Logger.log('=== AQB AI SIGNALS CLEAN SLATE COMMIT ===');Logger.log(JSON.stringify(result));
    return result;
  }finally{lock.releaseLock();}
}

