function AQBCountMasterListServiceRecords(){
  const master=AQBGetSheet(CONFIG.SHEETS.LISTS);
  const schema=AQBGetMasterListsSchema();
  const m=schema.map;
  const n=master.getLastRow();
  if(n<2)return 0;
  const rows=master.getRange(2,1,n-1,master.getLastColumn()).getValues();
  const keys={};
  rows.forEach(function(r){
    const item=schema.legacyNoItem?'service':String(r[m['Item']-1]||'').trim().toLowerCase();
    const category=String(r[m['Category']-1]||'').trim();
    const service=String(r[schema.serviceNameCol-1]||'').trim();
    if(item==='service'&&category&&service){
      keys[AQBGetCanonicalServiceKey(category,service)]=true;
    }
  });
  return Object.keys(keys).length;
}

function AQBGenerateLowestAvailableCatalogueId(){
  const catalogue=AQBGetSheet(CONFIG.SHEETS.CATALOGUE);
  const cm=AQBEnsureCatalogueMetaColumns();

  if(!cm['Catalogue ID']){
    throw new Error('Catalogue ID column is required.');
  }

  const serviceCount=AQBCountMasterListServiceRecords();
  if(serviceCount<1){
    throw new Error(
      'CATALOGUE_ID_CAPACITY_EXCEEDED: Master Lists contains no unique Item=Service records.'
    );
  }

  const used={};
  const lastRow=catalogue.getLastRow();

  if(lastRow>=2){
    const values=catalogue.getRange(
      2,
      cm['Catalogue ID'],
      lastRow-1,
      1
    ).getValues();

    values.forEach(function(row){
      const id=String(row[0]||'').trim().toUpperCase();
      if(!AQBIsCanonicalCatalogueId(id))return;
      const n=Number(id.substring('AQBCAT'.length));
      if(n>=1&&n<=999)used[n]=true;
    });
  }

  /*
   * HARD CATALOGUE CAPACITY RULE
   *
   * If Master Lists has N unique Item=Service records,
   * the current legal Catalogue identity range is:
   * AQBCAT001 ... AQBCATN.
   *
   * The allocator may fill an unused identity INSIDE that range,
   * but it must never create AQBCAT(N+1) during the same sync.
   *
   * When a genuinely new Master List service is added, N itself
   * increases first, which makes the next identity legal.
   */
  for(let n=1;n<=serviceCount;n++){
    if(!used[n]){
      return 'AQBCAT'+String(n).padStart(3,'0');
    }
  }

  throw new Error(
    'CATALOGUE_ID_CAPACITY_EXCEEDED: Master Lists contains '+
    serviceCount+
    ' unique Item=Service records and all legal AQBCAT001–AQBCAT'+
    String(serviceCount).padStart(3,'0')+
    ' identities are already occupied. Existing service matching or duplicate reconciliation is required; AQBCAT'+
    String(serviceCount+1).padStart(3,'0')+
    ' will not be created.'
  );
}

function AQBIsCatalogueIdInUse(catalogueId){
  const id=String(catalogueId||'')
    .trim()
    .toUpperCase();

  if(!AQBIsCanonicalCatalogueId(id))return false;

  const catalogue=AQBGetSheet(
    CONFIG.SHEETS.CATALOGUE
  );

  const cm=AQBBuildHeaderMap(catalogue);

  if(!cm['Catalogue ID']){
    throw new Error(
      'Catalogue ID column is required.'
    );
  }

  const lastRow=catalogue.getLastRow();
  if(lastRow<2)return false;

  const values=catalogue.getRange(
    2,
    cm['Catalogue ID'],
    lastRow-1,
    1
  ).getValues();

  return values.some(function(row){
    return String(row[0]||'')
      .trim()
      .toUpperCase()===id;
  });
}

function AQBProcessCatalogueIdentityGuard(existingCatalogueRow, masterItem){
  const canonicalId=String(existingCatalogueRow && existingCatalogueRow.catalogueId || '').trim().toUpperCase();
  const incomingId=String(masterItem && masterItem.proposedId || '').trim().toUpperCase();

  if(canonicalId){
    /*
     * Existing identity is authoritative.
     *
     * A non-canonical existing ID is structural corruption, not a
     * permission for sync to silently invent a replacement. Stop the
     * transaction and require the dedicated identity reset/reconciliation.
     */
    if(!AQBIsCanonicalCatalogueId(canonicalId)){
      try{
        logIdentityConflictForAudit_({
          serviceKey:masterItem.serviceKey||'',
          canonicalId:canonicalId,
          attemptedId:incomingId||'',
          severity:'NON_CANONICAL_EXISTING_ID_BLOCKED',
          actionTaken:'SYNC_BLOCKED_NO_ID_REWRITE',
          timestamp:new Date()
        });
      }catch(ignoreAudit){}
      throw new Error(
        'NON_CANONICAL_EXISTING_CATALOGUE_ID: '+
        canonicalId+
        ' for '+(masterItem.serviceKey||'')+
        '. Run the dedicated Catalogue identity reconciliation/reset.'
      );
    }

    const result=AQBValidatePrimaryIdentityContract(canonicalId,incomingId);
    if(result.mutationBlocked){
      try{
        logIdentityConflictForAudit_({
          serviceKey:masterItem.serviceKey||'',
          canonicalId:canonicalId,
          attemptedId:incomingId,
          severity:'CRITICAL_COLLISION_PREVENTED',
          actionTaken:'IDENTITY_MUTATION_BLOCKED_NON_IDENTITY_UPDATES_ALLOWED',
          timestamp:new Date()
        });
      }catch(ignoreAudit){}
      Logger.log('[IDENTITY GUARD] Preserved '+canonicalId+'; blocked attempted replacement '+incomingId);
    }

    masterItem.proposedId=canonicalId;
    return canonicalId;
  }

  const newId=AQBGenerateLowestAvailableCatalogueId();
  masterItem.proposedId=newId;
  Logger.log('[IDENTITY GUARD] NEW SERVICE -> '+newId);
  return newId;
}

function AQBAuditCanonicalCatalogueIdentityGuard(){

  const catalogue=AQBGetSheet(
    CONFIG.SHEETS.CATALOGUE
  );

  const cm=AQBBuildHeaderMap(catalogue);
  const lastRow=catalogue.getLastRow();

  if(!cm['Catalogue ID']){
    throw new Error(
      'Catalogue ID column is required.'
    );
  }

  const issues=[];
  const ids={};

  if(lastRow>=2){

    const rows=catalogue.getRange(
      2,1,lastRow-1,catalogue.getLastColumn()
    ).getValues();

    rows.forEach(function(row,i){

      const rowNumber=i+2;

      const id=String(
        row[cm['Catalogue ID']-1]||''
      ).trim().toUpperCase();

      const service=String(
        cm['Service Name']
          ? row[cm['Service Name']-1]||''
          : ''
      ).trim();

      if(!service)return;

      if(!AQBIsCanonicalCatalogueId(id)){
        issues.push({
          row:rowNumber,
          id:id,
          service:service,
          issue:'NON_CANONICAL_CATALOGUE_ID'
        });
        return;
      }

      if(ids[id]){
        issues.push({
          row:rowNumber,
          id:id,
          service:service,
          issue:'DUPLICATE_CATALOGUE_ID',
          firstRow:ids[id]
        });
      }else{
        ids[id]=rowNumber;
      }
    });
  }

  const result={
    version:AQB_IDENTITY_GUARD_VERSION,
    readOnly:true,
    networkUsed:false,
    writes:0,
    catalogueRows:Math.max(0,lastRow-1),
    canonicalIds:Object.keys(ids).length,
    issues:issues,
    success:issues.length===0
  };

  Logger.log(
    '=== C.4.8.25.19 CANONICAL CATALOGUE IDENTITY GUARD AUDIT ==='
  );
  Logger.log(JSON.stringify(result));

  return result;
}

function AQBProtectCatalogueIdentityColumn(){

  const cat=AQBGetSheet(
    CONFIG.SHEETS.CATALOGUE
  );

  const cm=AQBBuildHeaderMap(cat);

  if(!cm['Catalogue ID']){
    throw new Error(
      'Catalogue ID column is required.'
    );
  }

  const column=cm['Catalogue ID'];

  const existing=cat.getProtections(
    SpreadsheetApp.ProtectionType.RANGE
  );

  existing.forEach(function(protection){

    const range=protection.getRange();

    if(
      range.getSheet().getSheetId()===cat.getSheetId() &&
      range.getColumn()===column &&
      range.getNumColumns()===1
    ){
      try{
        protection.remove();
      }catch(ignore){}
    }
  });

  const range=cat.getRange(
    1,
    column,
    Math.max(1,cat.getMaxRows()),
    1
  );

  const protection=range.protect();

  protection.setDescription(
    AQB_IDENTITY_GUARD_VERSION+
    ' — Catalogue ID immutable primary key'
  );

  /*
   * Keep the current effective user as the only editor
   * where Apps Script permits the operation.
   */
  try{
    protection.setWarningOnly(false);
  }catch(ignoreWarning){}

  return {
    success:true,
    sheet:cat.getName(),
    column:column,
    header:'Catalogue ID',
    protection:'RANGE_PROTECTED',
    note:'Application-level identity guard remains authoritative for script writes.'
  };
}

function AQBCheckPriceValue(value){
  const s=String(value==null?'':value).trim();
  if(!s)return false;
  return /^(?:KES|KSH)\s*[\d,.]+(?:\s*(?:PP|\/MO|\/LOC))?$|^CUSTOM\s+QUOTE$|^[\d,.]+\s*(?:PP|\/MO|\/LOC)$/i.test(s);
}

function AQBAuditCatalogueColumnAlignment(){
  const sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE);
  const m=AQBBuildHeaderMap(sheet);
  const required=['Catalogue ID','Category','Service Name','Price','Salon Price','Sort Order','Active','Description','Photo Brief'];
  const missing=required.filter(function(h){return !m[h];});
  const issues=[];const samples=[];let checked=0;
  if(missing.length)return {version:'V16.21.16.8.39',readOnly:true,success:false,checked:0,missingHeaders:missing,issues:[],reason:'MISSING_REQUIRED_HEADERS'};
  const n=sheet.getLastRow();
  const values=n>1?sheet.getRange(2,1,n-1,sheet.getLastColumn()).getValues():[];
  values.forEach(function(r,i){
    const id=String(r[m['Catalogue ID']-1]||'').trim().toUpperCase();
    if(!/^AQBCAT\d{3,}$/.test(id))return;
    checked++;
    const active=r[m['Active']-1],sort=r[m['Sort Order']-1];
    const salon=r[m['Salon Price']-1];
    const activeText=String(active==null?'':active).trim();
    const sortText=String(sort==null?'':sort).trim();
    const salonText=String(salon==null?'':salon).trim();
    const desc=String(r[m['Description']-1]||'').trim();
    const brief=String(r[m['Photo Brief']-1]||'').trim();
    const flags=[];
    if(activeText.length>100 || /\bCatalogue ID:\s*AQBCAT\d+/.test(activeText))flags.push('DESCRIPTION_IN_ACTIVE');
    if(typeof sort==='boolean' || /^(TRUE|FALSE)$/i.test(sortText))flags.push('BOOLEAN_IN_SORT_ORDER');
    if(/^(TRUE|FALSE)$/i.test(salonText))flags.push('BOOLEAN_IN_SALON_PRICE');
    if(/^Catalogue ID:\s*AQBCAT\d+/i.test(desc))flags.push('PHOTO_BRIEF_IN_DESCRIPTION');
    if(flags.length){
      const issue={row:i+2,catalogueId:id,flags:flags};
      issues.push(issue);
      if(samples.length<20)samples.push(issue);
    }
  });
  return {version:'V16.21.16.8.39',function:'AQBAuditCatalogueColumnAlignment',readOnly:true,success:issues.length===0,checked:checked,misaligned:issues.length,missingHeaders:missing,samples:samples,issues:issues,repair:'STOP_SYNC_AND_RECOVER_BY_CATALOGUE_ID_FROM_BACKUP'};
}

function AQBRefreshCatalogue(webAppUrl){
  const base=String(webAppUrl||ScriptApp.getService().getUrl()||'').replace(/\/$/,'');
  const cat=AQBEnsureSheet(CONFIG.SHEETS.CATALOGUE,CATALOGUE_HEADERS);
  const alignment=AQBAuditCatalogueColumnAlignment();
  if(!alignment.success)throw new Error('CATALOGUE_COLUMN_ALIGNMENT_BLOCKED: '+alignment.misaligned+' shifted record(s) detected. Run AQBAuditCatalogueColumnAlignment and restore affected columns from a verified workbook backup by AQBCAT ID before refreshing.');
  const cm=AQBEnsureCatalogueMetaColumns();
  const master=AQBBuildCanonicalMasterServiceRows();
  const services=master.rows;
  const serviceCount=services.length;

  CATALOGUE_HEADERS.forEach(function(h){
    if(!cm[h])throw new Error('CATALOGUE_SCHEMA_ERROR: missing Catalogue column '+h);
  });

  if(!serviceCount){
    return {
      version:AQB_PHOTO_PIPELINE_VERSION_,
      source:'Master Lists Item=Service',
      masterUniqueServices:0,
      catalogueRows:cat.getLastRow()>1?cat.getLastRow()-1:0,
      success:true
    };
  }

  const legalIds=[];
  for(let i=1;i<=serviceCount;i++){
    legalIds.push('AQBCAT'+String(i).padStart(3,'0'));
  }

  const oldRows=cat.getLastRow()>=2
    ?cat.getRange(2,1,cat.getLastRow()-1,cat.getLastColumn()).getValues()
    :[];

  const oldByKey={};
  oldRows.forEach(function(r){
    const category=String(r[cm['Category']-1]||'').trim();
    const service=String(r[cm['Service Name']-1]||'').trim();
    const id=String(r[cm['Catalogue ID']-1]||'').trim().toUpperCase();
    if(!category||!service||!/^AQBCAT\d{3}$/.test(id))return;

    const key=AQBGetCanonicalServiceKey(category,service);
    if(!oldByKey[key]){
      oldByKey[key]={id:id,row:r.slice()};
    }
  });

  // Preserve IDs only for services that still exist by normalized
  // Category + Service Name. Everything else is refreshed from Master Lists.
  const assignedIds={},assignments=[],unmatched=[];
  services.forEach(function(s){
    const old=oldByKey[s.key];
    if(old && legalIds.indexOf(old.id)>=0 && !assignedIds[old.id]){
      assignedIds[old.id]=true;
      assignments.push({service:s,id:old.id,oldRow:old.row,identityChanged:false});
    }else{
      unmatched.push(s);
    }
  });

  // Guard permanent CATID identity: an unmatched key at unchanged cardinality
  // may be a rename/category move. Require explicit review rather than recycling
  // an existing CATID and attaching the wrong staged photograph.
  if(oldRows.length===serviceCount && unmatched.length && oldRows.length){
    throw Error('CATID_IDENTITY_REVIEW_REQUIRED: '+unmatched.length+' changed Category/Service keys at unchanged service count. Reconcile identity before refresh; no Catalogue rows written.');
  }
  const freeIds=legalIds.filter(function(id){return !assignedIds[id];});
  if(unmatched.length!==freeIds.length){
    throw new Error(
      'CATALOGUE_REFRESH_ID_MISMATCH: '+unmatched.length+
      ' unmatched Master service(s) but '+freeIds.length+
      ' legal Catalogue ID slot(s) are available.'
    );
  }

  unmatched.forEach(function(s,i){
    const id=freeIds[i];
    assignedIds[id]=true;
    assignments.push({service:s,id:id,oldRow:null,identityChanged:true});
  });

  const output=[];
  const changedIds=[];
  const publicWhatsApp=cm['WhatsApp Link']?AQBGetPublicWhatsAppNumber():'';

  assignments.forEach(function(a){
    const s=a.service;
    const row=a.oldRow?a.oldRow.slice():Array(cat.getLastColumn()).fill('');

    row[cm['Catalogue ID']-1]=a.id;

    // Master-owned fields: the only fields copied from Item=Service.
    row[cm['Category']-1]=s.category;
    row[cm['Service Name']-1]=s.service;
    row[cm['Price']-1]=AQBNormalizePriceText(s.price).display||String(s.price||'');
    if(cm['Salon Price'])row[cm['Salon Price']-1]=s.salonPrice==null?'':(AQBNormalizePriceText(s.salonPrice).display||String(s.salonPrice||''));
    row[cm['Sort Order']-1]=s.sort;
    row[cm['Active']-1]=s.active;

    // Catalogue-owned fields are derived after the source refresh.
    if(cm['Category ID'])row[cm['Category ID']-1]=AQBGetCategoryId(s.category);

    const description=AQBGetServiceDescription(s.category,s.service,a.id);
    // A generated fallback is allowed for continuity, but remains editorially
    // unqualified until reviewed against the named service.
    const editorialDefinition=AQB_FIVE_PART_DEFINITIONS_[a.id];
    if(!editorialDefinition && /professional beauty service offered to achieve the requested result|selected braiding or twisting technique/.test(description)){
      try{AQBLogAudit('CATALOGUE_DESCRIPTION_FALLBACK',CONFIG.SHEETS.CATALOGUE,a.id,s.service);}catch(ignoreEditorialLog){}
    }
    if(cm['Description'])row[cm['Description']-1]=description;

    if(cm['Service Tier']){
      row[cm['Service Tier']-1]=AQBDeriveServiceTier(s.category,s.service,description);
    }

    if(cm['Photo Brief']){
      row[cm['Photo Brief']-1]=AQBBuildCataloguePhotoBrief(
        a.id,
        s.category,
        cm['Subcategory']?String(row[cm['Subcategory']-1]||'').trim():'',
        s.service,
        description
      );
    }

    if(cm['Photo Brief'] && /^Catalogue ID: .*\nSubject: /m.test(String(row[cm['Photo Brief']-1]||''))){
      try{AQBLogAudit('CATALOGUE_PHOTO_BRIEF_FALLBACK',CONFIG.SHEETS.CATALOGUE,a.id,s.service);}catch(ignoreBriefLog){}
    }

    if(cm['Customer Category']){
      row[cm['Customer Category']-1]=AQBResolveCatalogueCustomerCategory({
        category:s.category,
        serviceName:s.service,
        variants:cm['Customer Variant Names']?String(row[cm['Customer Variant Names']-1]||''):'',
        description:description,
        photoBrief:cm['Photo Brief']?String(row[cm['Photo Brief']-1]||''):''
      });
    }

    if(cm['Description Required'])row[cm['Description Required']-1]=description?'Yes':'No';
    if(cm['Catalogue Section'])row[cm['Catalogue Section']-1]=s.category;
    if(cm['Display in Catalogue'])row[cm['Display in Catalogue']-1]=s.active?'Yes':'No';
    if(cm['Display Reason'])row[cm['Display Reason']-1]=s.active?'Active Service':'Inactive in Master Lists';
    if(cm['Catalogue Type'])row[cm['Catalogue Type']-1]='Service';

    if(cm['Booking Link']&&base){
      row[cm['Booking Link']-1]=base+'?page=booking&service='+encodeURIComponent(s.service)+'&catalogue_id='+encodeURIComponent(a.id);
    }

    if(cm['WhatsApp Link']){
      row[cm['WhatsApp Link']-1]=
        'https://wa.me/'+publicWhatsApp+
        '?text='+encodeURIComponent(
          'Hello Afrikan Quinn Beauty Centre 💛\n'+
          'I would like to enquire about the price for '+s.service+
          '. Please share the current starting price and any information I should know.'
        );
    }

    if(cm['Recommended Catalogue Price']){
      row[cm['Recommended Catalogue Price']-1]=AQBNormalizePriceText(s.price).display||String(s.price||'');
    }
    if(cm['Pricing Basis'])row[cm['Pricing Basis']-1]='Master Lists price';

    if(cm['Publish Channels']){
      row[cm['Publish Channels']-1]=
        AQBNormalizePublishChannels(row[cm['Publish Channels']-1])||
        AQBGetDefaultPublishChannels();
    }

    // A reused/free ID represents a new service identity. Do not carry stale
    // image/evidence fields from the service that previously occupied that ID.
    if(a.identityChanged){
      [
        'Own Photo','Image URL','Photo Qualification Status','Photo Provenance',
        'Candidate Image URL','Candidate Source URL','Candidate Source',
        'Discovery Score','Review Reason','Search Status',
        'Visual Score','Qualification Status','Signal Attainment','Gate Outcome'
      ].forEach(function(h){
        if(cm[h])row[cm[h]-1]='';
      });
    }

    output.push(row);
    changedIds.push(a.id);
  });

  // Catalogue display order is independent of AQBCAT identity.
  output.sort(function(a,b){
    return String(a[cm['Category']-1]||'').localeCompare(
      String(b[cm['Category']-1]||''),undefined,{sensitivity:'base'}
    ) ||
    String(a[cm['Service Name']-1]||'').localeCompare(
      String(b[cm['Service Name']-1]||''),undefined,{sensitivity:'base'}
    );
  });

  if(cat.getLastRow()>1){
    cat.getRange(2,1,cat.getLastRow()-1,cat.getLastColumn()).clearContent();
  }
  if(output.length){
    cat.getRange(2,1,output.length,cat.getLastColumn()).setValues(output);
  }

  try{CacheService.getScriptCache().remove('AQB_PUBLIC_CATALOGUE_V1605');}catch(ignore){}

  // V16.21.16: synchronous CATID-safe source propagation (no photo publication).
  // The routine scans 263 records but writes only missing/changed inherited cells.
  let sourcePhotoSync={success:false};
  try{sourcePhotoSync=AQBUpsertPhotoStagingSourceRows();}
  catch(syncError){
    const detail=String(syncError&&syncError.message||syncError);
    try{AQBLogAudit('PHOTO_STAGING_SOURCE_SYNC_FAILED',CONFIG.SHEETS.PHOTO_STAGING,'CATALOGUE_REFRESH',detail);}catch(ignoreAudit){}
    throw Error('CATALOGUE_DOWNSTREAM_PHOTO_STAGING_SYNC_FAILED: '+detail);
  }

  // Row-aware downstream propagation: compare fingerprints after refresh and
  // synchronize only changed Catalogue IDs to Photo Staging.
  let serviceEngine={success:false,skipped:true};
  try{
    serviceEngine=AQBRefreshServiceEngine();
  }catch(err){
    serviceEngine={success:false,error:String(err&&err.message?err.message:err)};
    try{AQBLogAudit('SERVICE_ENGINE_REFRESH_ERROR',CONFIG.SHEETS.SERVICE_ENGINE_DB,'CATALOGUE_REFRESH',serviceEngine.error);}catch(ignoreEngineLog){}
  }

  /*
   * FULL REFRESH PERFORMANCE RULE:
   * Catalogue refresh never performs synchronous per-row Photo Staging writes.
   * AQBQueueChangedPhotoRows_ compares fingerprints in memory and queues only
   * changed Catalogue IDs. AQBRunQueuedPhotoPipeline() owns staged propagation
   * in controlled batches.
   */
  // Source inheritance was completed synchronously above. Do not schedule
  // the discovery/promotion pipeline merely because a Catalogue field changed.
  const photoStagingQueue={queued:0,ids:[],success:true,deferredTo:null,rowAware:true,byCatalogueId:true};

  const out={
    version:AQB_PHOTO_PIPELINE_VERSION_,
    sourceContract:'Item=Service -> Category, Service Name, Price, Sort Order, Active',
    masterUniqueServices:serviceCount,
    duplicateMasterRows:master.duplicateRows,
    catalogueRows:output.length,
    preservedIds:assignments.filter(function(x){return !x.identityChanged;}).length,
    refreshedIds:assignments.filter(function(x){return x.identityChanged;}).length,
    legalMaxCatalogueId:legalIds[legalIds.length-1],
    sortedBy:['Category','Service Name'],
    serviceEngine:serviceEngine,
    photoStagingQueue:photoStagingQueue,
    sourcePhotoSync:sourcePhotoSync,
    success:photoStagingQueue.success!==false&&sourcePhotoSync.success!==false
  };

  Logger.log('=== AQB CATALOGUE REFRESH ===');
  Logger.log(JSON.stringify(out));
  return out;
}

function AQBGetServiceDeliverySettings(){
  AQBRequireDeliverySettingsManager();
  return {
    mobileEnabled:String(AQBGetSetupSetting('Mobile Booking Enabled')||'TRUE').toUpperCase()==='TRUE',
    salonEnabled:String(AQBGetSetupSetting('Salon Booking Enabled')||'FALSE').toUpperCase()==='TRUE'
  };
}

function AQBSaveServiceDeliverySettings(payload){
  const user=AQBRequireDeliverySettingsManager();payload=payload||{};
  if(typeof payload.mobileEnabled!=='boolean'||typeof payload.salonEnabled!=='boolean')throw new Error('Both delivery switches require boolean values.');
  if(payload.salonEnabled){
    const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(cat);
    if(!cm['Salon Price'])throw new Error('Salon Price column is missing. Run the authorized schema migration first.');
    // No silent fallback to mobile prices when Salon is opened.
    const master=AQBGetSheet(CONFIG.SHEETS.LISTS),mm=AQBBuildHeaderMap(master);
    if(!mm['Salon Price'])throw new Error('Master List Salon Price column is missing.');
    const rows=master.getLastRow()>1?master.getRange(2,1,master.getLastRow()-1,master.getLastColumn()).getValues():[];
    const missing=rows.filter(function(r){return String(r[(mm['Item']||1)-1]).trim()==='Service' && AQBNormalizeBool(r[mm['Active']-1]) && !(Number(String(r[mm['Salon Price']-1]||'').replace(/[^0-9.]/g,''))>0);});
    if(missing.length)throw new Error('Cannot activate Salon: '+missing.length+' active services are missing valid Salon Prices.');
  }
  const before=AQBGetServiceDeliverySettings();
  AQBSetSetupSetting('Mobile Booking Enabled',payload.mobileEnabled?'TRUE':'FALSE');
  AQBSetSetupSetting('Salon Booking Enabled',payload.salonEnabled?'TRUE':'FALSE');
  AQBLogAudit('SERVICE_DELIVERY_SETTINGS','Settings','Delivery Modes',JSON.stringify({from:before,to:payload,by:user.email}));
  return AQBGetServiceDeliverySettings();
}

function AQBResolveServiceDeliveryPrice(service,mode){
  const selected=String(mode||'MOBILE').toUpperCase();
  const mobile=String(AQBGetSetupSetting('Mobile Booking Enabled')||'TRUE').toUpperCase()==='TRUE';
  const salon=String(AQBGetSetupSetting('Salon Booking Enabled')||'FALSE').toUpperCase()==='TRUE';
  if(selected==='MOBILE'&&!mobile || selected==='SALON'&&!salon)throw new Error('Selected booking mode is disabled.');
  if(selected!=='MOBILE'&&selected!=='SALON')throw new Error('Invalid service delivery mode.');
  const value=selected==='SALON'?service['Salon Price']:service.Price;
  if(value==null||String(value).trim()==='')throw new Error('Approved '+selected+' price is unavailable.');
  const price=Number(String(value).replace(/[^0-9.]/g,''));
  if(!Number.isFinite(price)||price<=0)throw new Error('Invalid approved service price.');
  return price;
}

function AQBGetCatalogueAdminData(){
  const user=AQBRequireCataloguePhotoManager();
  const sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),n=sheet.getLastRow(),cm=AQBBuildHeaderMap(sheet),services=[],usage={};
  try{
    AQBGetServiceOptions().forEach(function(x){usage[String(x.service||'').trim().toLowerCase()]={usageCount:Number(x.usageCount||0),mostlyUsedRank:Number(x.mostlyUsedRank||0)};});
  }catch(ignoreUsage){}
  if(n>=2){
    sheet.getRange(2,1,n-1,sheet.getLastColumn()).getValues().forEach(function(r){
      const service=cm['Service Name']?String(r[cm['Service Name']-1]||'').trim():'';if(!service)return;
      const active=cm['Active']===undefined?true:r[cm['Active']-1];
      if(active===false||String(active).toLowerCase()==='false'||String(active)==='0')return;
      const category=cm['Category']?String(r[cm['Category']-1]||'').trim():'',u=usage[service.toLowerCase()]||{};
      const searchParts=[service,category];
      ['Customer-Facing Name','Customer Search Names','Service Synonyms','Customer Variant Names'].forEach(function(h){if(cm[h])searchParts.push(String(r[cm[h]-1]||'').trim());});
      if(/retighten/i.test(service))searchParts.push('retie retie locs retie sisterlocks retie microlocs retie maintenance');
      if(/sisterlocks|microlocs|loc/i.test(service))searchParts.push('loc locks locs sister locks sisterlocks micro locs microlocs');
      services.push({
        catalogueId:cm['Catalogue ID']?String(r[cm['Catalogue ID']-1]||'').trim():AQBResolveOrAllocateCatalogueId(category,service),
        category:category,
        service:service,
        price:cm['Price']?String(r[cm['Price']-1]||'').trim():'',
        active:true,
        sortOrder:cm['Sort Order']?Number(r[cm['Sort Order']-1]||0)||0:0,
        usageCount:Number(u.usageCount||0),
        mostlyUsedRank:Number(u.mostlyUsedRank||0),
        searchText:searchParts.filter(Boolean).join(' | '),
        photoBrief:cm['Photo Brief']?String(r[cm['Photo Brief']-1]||'').trim():'',
        description:cm['Description']?String(r[cm['Description']-1]||'').trim():'',
        ownPhoto:cm['Own Photo']?String(r[cm['Own Photo']-1]||'').trim():'',
        imageUrl:cm['Image URL']?String(r[cm['Image URL']-1]||'').trim():'',
        imageStatus:cm['Image Status']?String(r[cm['Image Status']-1]||'').trim():'',
        imageSource:cm['Image Source']?String(r[cm['Image Source']-1]||'').trim():'',
        imageUseNote:cm['Image Use Note']?String(r[cm['Image Use Note']-1]||'').trim():''
      });
    });
  }
  services.sort(function(a,b){return a.category.localeCompare(b.category,undefined,{sensitivity:'base'})||a.service.localeCompare(b.service,undefined,{sensitivity:'base'});});
  return {success:true,version:'V16.21.14-CleanApp',user:{name:user.name,email:user.email},services:services,folder:AQBGetCataloguePhotoFolder()};
}

function AQBEnsureCatalogueApprovalFields(sheet, cm){
  const required=['Catalogue Approval Status','Catalogue Approved At','Catalogue Approved By'];
  let changed=false;
  required.forEach(function(h){
    if(!cm[h]){sheet.getRange(1,sheet.getLastColumn()+1).setValue(h);changed=true;}
  });
  return changed?AQBBuildHeaderMap(sheet):cm;
}

function AQBApproveAllActiveCatalogueServices(){
  const user=AQBRequireCataloguePhotoManager();
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(10000))throw new Error('Catalogue approval is already running. Please wait a moment and try again.');
  try{
    try{AQBRefreshCatalogue();}
    catch(e){throw new Error('Catalogue approval could not reconcile Master Lists: '+String(e&&e.message||e));}

    const sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE);
    let cm=AQBEnsureCatalogueMetaColumns();
    cm=AQBEnsureCatalogueApprovalFields(sheet,cm);
    const master=AQBBuildCanonicalMasterServiceRows();
    const expected={};
    master.rows.forEach(function(x){if(x.active)expected[AQBGetCanonicalServiceKey(x.category,x.service)]={category:x.category,service:x.service};});
    const n=sheet.getLastRow();
    if(n<2)return {success:true,approved:0,expected:master.activeUnique,publicationReady:0,notYetApproved:master.activeUnique,message:'No Catalogue rows found.'};

    const rows=sheet.getRange(2,1,n-1,sheet.getLastColumn()).getValues();
    const seen={}; let approved=0;
    rows.forEach(function(r){
      const active=cm['Active']?AQBNormalizeBool(r[cm['Active']-1]):false;
      const category=String(cm['Category']?r[cm['Category']-1]||'':'').trim();
      const service=String(cm['Service Name']?r[cm['Service Name']-1]||'':'').trim();
      const key=AQBGetCanonicalServiceKey(category,service);
      if(!active||!expected[key]||seen[key])return;
      seen[key]=true;
      r[cm['Catalogue Approval Status']-1]='APPROVED';
      r[cm['Catalogue Approved At']-1]=new Date();
      r[cm['Catalogue Approved By']-1]=user.email||'';
      approved++;
    });
    // One write instead of one Spreadsheet service call per row. This substantially
    // reduces transient "Service Spreadsheets failed while accessing document" errors.
    sheet.getRange(2,1,rows.length,sheet.getLastColumn()).setValues(rows);

    const readiness=AQBEvaluateCataloguePublicationReadiness({writeStatus:false});
    const publicationReady=readiness.ready;
    AQBLogAudit('APPROVE_ALL_CATALOGUE_SERVICES','Catalogue','ALL',user.email+' approved '+approved+' active canonical AQB Catalogue services for Catalogue processing. Public publication remains protected by the photo/publication safety gate.');
    return {success:true,approved:approved,expected:master.activeUnique,publicationReady:publicationReady,notYetApproved:Math.max(0,master.activeUnique-approved),message:'Catalogue approval completed for '+approved+' of '+master.activeUnique+' active AQB services. Approval does not bypass the public photo/publication safety gate.'};
  }catch(e){
    try{AQBLogAudit('APPROVE_ALL_CATALOGUE_SERVICES_FAILED','Catalogue','ALL',(user&&user.email||'')+' approval failed: '+String(e&&e.message||e));}catch(ignore){}
    throw new Error('Catalogue approval failed: '+String(e&&e.message||e));
  }finally{lock.releaseLock();}
}

function AQBGetCatalogueApprovalSummary(){
  AQBRequireCataloguePhotoManager();
  const sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE); let cm=AQBEnsureCatalogueMetaColumns(); cm=AQBEnsureCatalogueApprovalFields(sheet,cm);
  const master=AQBBuildCanonicalMasterServiceRows(); const expected={}; master.rows.forEach(function(x){if(x.active)expected[AQBGetCanonicalServiceKey(x.category,x.service)]=true;});
  const n=sheet.getLastRow();let approved=0;
  if(n>=2){sheet.getRange(2,1,n-1,sheet.getLastColumn()).getValues().forEach(function(r){const key=AQBGetCanonicalServiceKey(cm['Category']?r[cm['Category']-1]:'',cm['Service Name']?r[cm['Service Name']-1]:'');if(!expected[key])return;if(String(r[cm['Catalogue Approval Status']-1]||'').toUpperCase()==='APPROVED')approved++;});}
  const readiness=AQBEvaluateCataloguePublicationReadiness({writeStatus:false});
  return {success:true,expected:master.activeUnique,approved:approved,publicationReady:readiness.ready,publicationBlocked:readiness.blocked,publicationBlockReasons:readiness.reasonCounts,remainingApproval:Math.max(0,master.activeUnique-approved)};
}

function AQBGetCatalogueEditorialContent(category,service){
  const key=String(category||'').trim()+'|'+String(service||'').trim();
  return AQB_CATALOGUE_EDITORIAL_CONTENT[key]||null;
}

function AQBBuildCatalogueDescription(category,subcategory,service,currentDescription){
  const c=String(category||'').trim(), sc=String(subcategory||'').trim(), n=String(service||'').trim();
  const editorial=AQBGetCatalogueEditorialContent(c,n);
  if(editorial&&String(editorial.description||'').trim())return String(editorial.description).trim();
  const f=(c+' '+sc+' '+n).toLowerCase();
  const existing=String(currentDescription||'').trim().replace(/\s+/g,' ');
  const first=existing.match(/^(.+?[.!?])(?:\s|$)/);
  const intro=first && first[1].length>=n.length ? first[1] : n+' is a professional beauty service offered to achieve the requested result.';
  let how,result,distinctive,suits;
  if(/wash|shampoo|cleanse/.test(f)){
    how='The hair and scalp are cleansed using a suitable washing technique, followed by the agreed conditioning or finishing step.';
    distinctive='The service focuses on thorough cleansing and refreshing the hair and scalp while preparing the hair for its next stage of care.';
    result='Clients receive freshly cleansed, refreshed and more manageable hair and scalp.';
    suits='It suits clients needing routine cleansing, a refresh, or preparation before another hair service.';
  } else if(/removal|take.?down/.test(f)){
    how='The existing style is carefully taken down section by section with attention to the natural hair and scalp.';
    distinctive='The service is focused on controlled removal rather than creating a new hairstyle, helping prepare the hair for its next stage of care.';
    result='Clients receive hair that has been safely released from the previous style and prepared for cleansing, treatment or restyling.';
    suits='It suits clients ending a protective style or needing professional assistance with a difficult or time-consuming takedown.';
  } else if(/consultation|assessment/.test(f)){
    how='The stylist reviews the client\'s hair or scalp condition, goals and maintenance needs before discussing suitable options.';
    distinctive='The service is centered on personalized assessment and practical recommendations rather than immediate styling.';
    result='Clients receive a clear service or care plan matched to their hair, condition and desired outcome.';
    suits='It suits clients who want professional guidance before choosing, changing or planning a service.';
  } else if(/treatment|therapy|conditioning|detox|steam|oil|scalp|massage/.test(f)){
    how='The hair or scalp is prepared and the selected treatment is applied according to the client\'s current care needs.';
    distinctive='The service targets the selected hair or scalp care objective rather than simply providing a styling finish.';
    result='Clients receive focused care aimed at the selected conditioning, moisture, strength, scalp-care or restorative goal.';
    suits='It suits clients looking for targeted hair or scalp care or a restorative professional care session.';
  } else if(/repair/.test(f)){
    how='The affected hair or loc areas are assessed and the appropriate repair technique is applied carefully to restore the service result.';
    distinctive='The service concentrates on correcting or strengthening affected areas while preserving the surrounding hair or existing style.';
    result='Clients receive improved continuity, neatness and support in the areas requiring repair.';
    suits='It suits clients with weak, damaged or compromised areas needing focused professional attention.';
  } else if(/maintenance|retie|retightening|retwist|refit|grooming/.test(f)){
    how='The existing style, locs or installed hair are assessed and the affected areas are carefully refreshed, maintained or refitted.';
    distinctive='The service maintains an existing result instead of replacing it with an unrelated new style.';
    result='Clients receive a cleaner, refreshed and more manageable existing style.';
    suits='It suits clients maintaining an established hairstyle, loc journey or installed service.';
  } else if(/mobile/.test(f)){
    how='The agreed beauty service is prepared and delivered at the confirmed client location, with travel arrangements handled according to the booking.';
    distinctive='The service combines the selected beauty treatment with the convenience of an agreed off-site location.';
    result='Clients receive the selected professional beauty service without needing to visit the salon.';
    suits='It suits clients who prefer beauty services delivered at an agreed location.';
  } else if(/group|corporate|bridal|package|membership|day/.test(f)){
    how='The selected services or package elements are planned and delivered around the client group, occasion or agreed benefits.';
    distinctive='The service is structured around a shared occasion, package or ongoing-care arrangement rather than a single standalone treatment.';
    result='Clients receive a coordinated professional beauty experience matched to the selected package or occasion.';
    suits='It suits clients arranging group services, special occasions or structured ongoing beauty care.';
  } else if(/weave|wig|extension|crochet/.test(f)){
    how='The natural hair is prepared and the selected installation or finishing technique is completed according to the desired coverage, length, volume and style.';
    distinctive='The service is defined by the named installation technique and the intended coverage, length, volume or finish.';
    result='Clients receive a secure, polished installed finish with the intended coverage, length or volume.';
    suits='It suits clients seeking installed hair, protective styling, added coverage, length or volume.';
  } else if(/loc|microloc|sisterlocks/.test(f)){
    how='The hair or locs are prepared and the named loc technique is carried out with careful sectioning, maintenance and finishing.';
    distinctive='The service is defined by the named loc technique and the precision needed to maintain or create its characteristic pattern.';
    result='Clients receive a neat, consistent loc result that respects the existing pattern or planned loc journey.';
    suits='It suits clients beginning, maintaining, repairing or styling an existing loc journey.';
  } else if(/braid|cornrow|twist|knotless|fulani|boho|updo|silk press|finger coil|bantu knot|flat twist/.test(f)){
    how='The hair is sectioned and prepared before the named braiding, twisting or styling technique is completed and neatly finished.';
    distinctive='The service is defined by the named style and its characteristic pattern, construction, finish or visible detailing.';
    result='Clients receive the requested defined style with its characteristic appearance, finish and wearability.';
    suits='It suits clients seeking the named protective, statement, everyday or occasion-ready style.';
  } else {
    how='The hair is prepared and the named technique is carried out with the finish adjusted to the client\'s hair condition and requested look.';
    distinctive='The service is defined by the specific technique or outcome named in the catalogue rather than a generic beauty treatment.';
    result='Clients receive a neat, professionally finished result tailored to the intended outcome.';
    suits='It suits clients seeking the named beauty service and a professional finish appropriate to their hair and requested result.';
  }
  return [intro,how,distinctive,result,suits].join(' ');
}

function AQBEvaluateCataloguePublicationReadiness(options){
  const opt=options||{},writeStatus=!!opt.writeStatus,sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),m=AQBBuildHeaderMap(sheet),master=AQBBuildCanonicalMasterServiceRows();
  const expected={};master.rows.forEach(function(x){if(x.active)expected[AQBGetCanonicalServiceKey(x.category,x.service)]=true;});
  const holds=(typeof AQBGetCataloguePhotoHolds==='function')?AQBGetCataloguePhotoHolds():{};
  const approvedPhoto={STRONG:true,GOOD:true,ACCEPTABLE:true,QUALIFIED:true,AUTO_APPROVED_STRONG:true,AUTO_APPROVED_GOOD:true,AUTO_APPROVED_ACCEPTABLE:true};
  const reasonCounts={},blockers=[],readyIds=[];let checked=0,ready=0,missingCatalogueRows=0;
  const seen={};
  function addReason(reason){reasonCounts[reason]=(reasonCounts[reason]||0)+1;}
  function publicationFor(reasons){
    if(!reasons.length)return 'PUBLISHABLE';
    if(reasons.indexOf('NOT_APPROVED')>=0)return 'PENDING APPROVAL';
    if(reasons.indexOf('MISSING_DESCRIPTION')>=0)return 'PENDING DESCRIPTION';
    if(reasons.indexOf('MISSING_PRICE')>=0)return 'PENDING PRICE';
    if(reasons.indexOf('MISSING_PHOTO')>=0)return 'PENDING PHOTO';
    if(reasons.indexOf('INVALID_PHOTO_URL')>=0)return 'BLOCKED INVALID PHOTO';
    if(reasons.indexOf('MANUAL_OR_IDENTITY_HOLD')>=0)return 'PENDING MANUAL PHOTO';
    if(reasons.indexOf('PHOTO_NOT_QUALIFIED')>=0)return 'PENDING PHOTO REVIEW';
    if(reasons.indexOf('DISPLAY_DISABLED')>=0)return 'NOT PUBLIC';
    return 'PENDING REVIEW';
  }
  const rows=sheet.getLastRow()>=2?sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).getValues():[];
  rows.forEach(function(r,i){
    const category=String(m['Category']?r[m['Category']-1]||'':'').trim(),service=String(m['Service Name']?r[m['Service Name']-1]||'':'').trim(),key=AQBGetCanonicalServiceKey(category,service);
    if(!expected[key]||seen[key])return;seen[key]=true;checked++;
    const id=String(m['Catalogue ID']?r[m['Catalogue ID']-1]||'':'').trim().toUpperCase(),reasons=[];
    const approval=m['Catalogue Approval Status']?String(r[m['Catalogue Approval Status']-1]||'').trim().toUpperCase():'APPROVED';
    const display=m['Display in Catalogue']?String(r[m['Display in Catalogue']-1]||'YES').trim().toUpperCase():'YES';
    const description=m['Description']?String(r[m['Description']-1]||'').trim():'';
    const priceText=m['Price']?String(r[m['Price']-1]||'').trim():'';
    const price=m['Price']?AQBNormalizePriceText(r[m['Price']-1]).amount:0;
    const quotePrice=/\b(?:custom\s+quote|quote(?:\s+on\s+request)?)\b/i.test(priceText);
    const own=m['Own Photo']?String(r[m['Own Photo']-1]||'').trim():'';
    const online=m['Image URL']?String(r[m['Image URL']-1]||'').trim():'';
    const studioCurrent=String(m['Image Source']?r[m['Image Source']-1]||'':'').trim().toUpperCase()==='AQB STUDIO' && String(m['Photo Qualification Status']?r[m['Photo Qualification Status']-1]||'':'').trim().toUpperCase()==='QUALIFIED';
    const localAsset=studioCurrent?null:(AQB_CATALOGUE_LOCAL_ASSETS[id]||null);
    let image=studioCurrent?online:(own||online);
    let qualification=m['Photo Qualification Status']?String(r[m['Photo Qualification Status']-1]||'').trim().toUpperCase():'';
    if(localAsset){
      image='AQB_LOCAL_ASSET:'+id;
      qualification='LOCAL_ASSET_APPROVED';
      if(writeStatus){
        if(m['Image Source'])r[m['Image Source']-1]='AQB Brand Asset';
        if(m['Image Source URL'])r[m['Image Source URL']-1]='';
        if(m['Image Status'])r[m['Image Status']-1]='AQB Brand Asset';
        if(m['Photo Qualification Status'])r[m['Photo Qualification Status']-1]='LOCAL_ASSET_APPROVED';
        if(m['Photo Provenance'])r[m['Photo Provenance']-1]='AQB GENERATED LOCAL ASSET';
        if(m['Representative Image'])r[m['Representative Image']-1]='Yes';
      }
    }
    if(approval!=='APPROVED')reasons.push('NOT_APPROVED');
    if(display==='NO'||display==='FALSE'||display==='0')reasons.push('DISPLAY_DISABLED');
    if(!description)reasons.push('MISSING_DESCRIPTION');
    if(!(price>0)&&!quotePrice)reasons.push('MISSING_PRICE');
    if(!localAsset&&!studioCurrent&&holds[id])reasons.push('MANUAL_OR_IDENTITY_HOLD');
    if(!image)reasons.push('MISSING_PHOTO');
    else if(!localAsset&&!/^https?:\/\//i.test(image))reasons.push('INVALID_PHOTO_URL');
    if(!localAsset&&image&&!own&&!approvedPhoto[qualification])reasons.push('PHOTO_NOT_QUALIFIED');
    if(!reasons.length){ready++;readyIds.push(id);}else{
      reasons.forEach(addReason);
      if(blockers.length<100)blockers.push({row:i+2,catalogueId:id,serviceName:service,reasons:reasons,qualificationStatus:qualification});
    }
    if(writeStatus&&m['Publication Status'])r[m['Publication Status']-1]=publicationFor(reasons);
  });
  Object.keys(expected).forEach(function(k){if(!seen[k]){missingCatalogueRows++;addReason('MISSING_CATALOGUE_ROW');}});
  if(writeStatus&&rows.length)sheet.getRange(2,1,rows.length,sheet.getLastColumn()).setValues(rows);
  return {success:true,authority:'CURRENT_CATALOGUE_PHOTO_QUALIFICATION',checked:master.activeUnique,ready:ready,blocked:Math.max(0,master.activeUnique-ready),readyIds:readyIds,reasonCounts:reasonCounts,blockers:blockers,missingCatalogueRows:missingCatalogueRows,legacyDuplicateUrlGate:false};
}

function AQBAuditCatalogueSourceOfTruth(){
  const VERSION='V16.21.14-CleanApp';
  const s=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),m=AQBBuildHeaderMap(s),issues=[],counts={rows:0,tier:0,customerCategory:0,description:0,photoBrief:0,bookingIdentity:0};
  const required=['Catalogue ID','Category','Customer Category','Service Name','Service Tier','Description','Photo Brief','Booking Link'];
  required.forEach(function(h){if(!m[h])issues.push({row:1,issue:'MISSING_CATALOGUE_AUTHORITY_COLUMN',column:h});});
  const canonical=['Braids','Bridal & Special Occasions','Colour','Home, Office & Mobile','Kids','Locs','Mizani Professional Care','Natural Hair','Quick Services','Sisterlocks & Microlocs','Treatments & Hair Spa','Twists','Weaving & Wigs'];
  if(s.getLastRow()>=2&&required.every(function(h){return !!m[h];})){
    s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues().forEach(function(r,i){
      const id=String(r[m['Catalogue ID']-1]||'').trim().toUpperCase(),service=String(r[m['Service Name']-1]||'').trim();
      if(!id||!service)return;
      const catalogueType=m['Catalogue Type']?String(r[m['Catalogue Type']-1]||'Service').trim().toUpperCase():'SERVICE';
      if(catalogueType&&catalogueType!=='SERVICE')return;
      counts.rows++;
      const category=String(r[m['Category']-1]||'').trim(),tier=String(r[m['Service Tier']-1]||'').trim(),customerCategory=String(r[m['Customer Category']-1]||'').trim();
      const description=String(r[m['Description']-1]||'').trim(),photoBrief=String(r[m['Photo Brief']-1]||'').trim(),booking=String(r[m['Booking Link']-1]||'').trim();
      const expectedCustomer=AQBResolveCatalogueCustomerCategory({category:category,serviceName:service,variants:m['Customer Variant Names']?r[m['Customer Variant Names']-1]:'',description:description,photoBrief:photoBrief});
      if(AQBIsValidServiceTier(tier))counts.tier++;else issues.push({row:i+2,id:id,service:service,issue:'INVALID_STORED_SERVICE_TIER',value:tier});
      if(customerCategory&&canonical.indexOf(customerCategory)!==-1&&customerCategory===expectedCustomer)counts.customerCategory++;else issues.push({row:i+2,id:id,service:service,issue:'CUSTOMER_CATEGORY_NOT_AUTHORITATIVE',stored:customerCategory,expected:expectedCustomer});
      if(description)counts.description++;else issues.push({row:i+2,id:id,service:service,issue:'MISSING_STORED_DESCRIPTION'});
      if(photoBrief&&photoBrief.toLowerCase().indexOf(service.toLowerCase())!==-1)counts.photoBrief++;else issues.push({row:i+2,id:id,service:service,issue:'MISSING_OR_NONIDENTITY_PHOTO_BRIEF'});
      if(booking&&booking.indexOf('catalogue_id='+encodeURIComponent(id))!==-1)counts.bookingIdentity++;else issues.push({row:i+2,id:id,service:service,issue:'BOOKING_LINK_MISSING_CATALOGUE_ID',booking:booking});
    });
  }
  const out={version:VERSION,function:'AQBAuditCatalogueSourceOfTruth',readOnly:true,networkUsed:false,writes:0,authorityFields:['Catalogue ID','Category','Customer Category','Service Name','Service Tier','Description','Photo Brief','Booking Link'],counts:counts,issues:issues.slice(0,100),issueCount:issues.length,success:issues.length===0};
  Logger.log('=== AQB CATALOGUE SOURCE OF TRUTH AUDIT ===');Logger.log(JSON.stringify(out));return out;
}

