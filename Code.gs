function AQBAuditCatalogueCardinalityReconciliation(){
  const VERSION='V16.21.14-CleanApp';
  const issues=[];
  const master=AQBGetSheet(CONFIG.SHEETS.LISTS),ms=AQBGetMasterListsSchema(),mm=ms.map;
  const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(cat);
  const masterByKey={},catalogueByKey={},catalogueById={},duplicateIds=[],duplicateKeys=[],blankIdentityRows=[],excludedFromSourceOfTruth=[],typeCounts={};

  if(master.getLastRow()>=2){
    master.getRange(2,1,master.getLastRow()-1,master.getLastColumn()).getValues().forEach(function(r,i){
      const item=ms.legacyNoItem?'service':String(r[mm['Item']-1]||'').trim().toLowerCase();
      const category=String(r[mm['Category']-1]||'').trim();
      const service=String(r[ms.serviceNameCol-1]||'').trim();
      if(item!=='service'||!category||!service)return;
      const active=mm['Active']?AQBNormalizeBool(r[mm['Active']-1]):true;
      if(!active)return;
      const key=AQBGetCanonicalServiceKey(category,service);
      if(!masterByKey[key])masterByKey[key]=[];
      masterByKey[key].push({row:i+2,category:category,serviceName:service});
    });
  }

  if(cat.getLastRow()>=2){
    cat.getRange(2,1,cat.getLastRow()-1,cat.getLastColumn()).getValues().forEach(function(r,i){
      const row=i+2;
      const id=cm['Catalogue ID']?String(r[cm['Catalogue ID']-1]||'').trim().toUpperCase():'';
      const category=cm['Category']?String(r[cm['Category']-1]||'').trim():'';
      const service=cm['Service Name']?String(r[cm['Service Name']-1]||'').trim():'';
      const tier=cm['Service Tier']?String(r[cm['Service Tier']-1]||'').trim():'';
      const type=cm['Catalogue Type']?String(r[cm['Catalogue Type']-1]||'Service').trim().toUpperCase():'SERVICE';
      if(!id&&!service&&!category)return;
      if(!id||!service||!category){
        blankIdentityRows.push({row:row,catalogueId:id,category:category,serviceName:service,catalogueType:type,serviceTier:tier});
        return;
      }
      typeCounts[type||'(BLANK)']=(typeCounts[type||'(BLANK)']||0)+1;
      const key=AQBGetCanonicalServiceKey(category,service);
      if(catalogueById[id])duplicateIds.push({catalogueId:id,first:catalogueById[id],duplicate:{row:row,category:category,serviceName:service,catalogueType:type}});
      else catalogueById[id]={row:row,category:category,serviceName:service,catalogueType:type,serviceTier:tier,key:key};
      if(catalogueByKey[key])duplicateKeys.push({key:key,first:catalogueByKey[key],duplicate:{row:row,catalogueId:id,category:category,serviceName:service,catalogueType:type}});
      else catalogueByKey[key]={row:row,catalogueId:id,category:category,serviceName:service,catalogueType:type,serviceTier:tier};
      if(type&&type!=='SERVICE')excludedFromSourceOfTruth.push({row:row,catalogueId:id,category:category,serviceName:service,catalogueType:type,serviceTier:tier,reason:'CATALOGUE_TYPE_NOT_SERVICE'});
    });
  }

  const masterKeys=Object.keys(masterByKey),catalogueKeys=Object.keys(catalogueByKey);
  const masterOnly=masterKeys.filter(function(k){return !catalogueByKey[k];}).map(function(k){return {key:k,masterRows:masterByKey[k]};});
  const catalogueOnly=catalogueKeys.filter(function(k){return !masterByKey[k];}).map(function(k){return Object.assign({key:k},catalogueByKey[k]);});
  const expectedIds=[];for(let n=1;n<=232;n++)expectedIds.push('AQBCAT'+String(n).padStart(3,'0'));
  const missingExpectedIds=expectedIds.filter(function(id){return !catalogueById[id];});
  const idsOutsideExpected=Object.keys(catalogueById).filter(function(id){return expectedIds.indexOf(id)===-1;}).sort();

  const tierPopulation=Object.keys(catalogueById).filter(function(id){const x=catalogueById[id];return !!x.serviceTier;}).length;
  const sourceOfTruthPopulation=Object.keys(catalogueById).filter(function(id){const x=catalogueById[id];return !x.catalogueType||x.catalogueType==='SERVICE';}).length;
  const masterUnique=masterKeys.length;
  const catalogueUnique=Object.keys(catalogueById).length;

  if(masterOnly.length)issues.push({issue:'ACTIVE_MASTER_SERVICES_MISSING_FROM_CATALOGUE',count:masterOnly.length,records:masterOnly.slice(0,50)});
  if(catalogueOnly.length)issues.push({issue:'CATALOGUE_SERVICES_NOT_IN_ACTIVE_MASTER',count:catalogueOnly.length,records:catalogueOnly.slice(0,50)});
  if(duplicateIds.length)issues.push({issue:'DUPLICATE_CATALOGUE_IDS',count:duplicateIds.length,records:duplicateIds.slice(0,50)});
  if(duplicateKeys.length)issues.push({issue:'DUPLICATE_CATALOGUE_SERVICE_KEYS',count:duplicateKeys.length,records:duplicateKeys.slice(0,50)});
  if(blankIdentityRows.length)issues.push({issue:'BLANK_OR_PARTIAL_CATALOGUE_IDENTITIES',count:blankIdentityRows.length,records:blankIdentityRows.slice(0,50)});
  if(masterUnique!==catalogueUnique)issues.push({issue:'MASTER_CATALOGUE_UNIQUE_COUNT_MISMATCH',masterUnique:masterUnique,catalogueUnique:catalogueUnique});
  if(tierPopulation!==sourceOfTruthPopulation)issues.push({issue:'TIER_SOURCE_OF_TRUTH_POPULATION_MISMATCH',tierPopulation:tierPopulation,sourceOfTruthPopulation:sourceOfTruthPopulation,excludedFromSourceOfTruth:excludedFromSourceOfTruth});

  const out={
    version:VERSION,function:'AQBAuditCatalogueCardinalityReconciliation',readOnly:true,networkUsed:false,writes:0,
    historicalExpectedCatalogueCount:232,
    counts:{masterUnique:masterUnique,catalogueUnique:catalogueUnique,tierPopulation:tierPopulation,sourceOfTruthPopulation:sourceOfTruthPopulation,physicalCatalogueRows:Math.max(0,cat.getLastRow()-1)},
    catalogueTypeCounts:typeCounts,
    excludedFromSourceOfTruth:excludedFromSourceOfTruth,
    masterOnly:masterOnly,
    catalogueOnly:catalogueOnly,
    duplicateIds:duplicateIds,
    duplicateServiceKeys:duplicateKeys,
    blankIdentityRows:blankIdentityRows,
    missingExpectedIds:missingExpectedIds,
    idsOutsideExpectedRange:idsOutsideExpected,
    issues:issues,
    issueCount:issues.length,
    success:issues.length===0
  };
  Logger.log('=== AQB CATALOGUE CARDINALITY RECONCILIATION AUDIT ===');
  Logger.log(JSON.stringify(out));
  return out;
}

