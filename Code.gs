    Logger.log('AQB_PHOTO_57_COMPLETE '+JSON.stringify({version:'V16.21.15.6.5.7',rowsAudited:232,sheetWrites:0,qualificationsChanged:0,imagesPromoted:0,externalImagesInspected:false,runComplete:true}));
    return {complete:true,rowsAudited:232};
  }
  const selected={'AQBCAT009':1,'AQBCAT013':1,'AQBCAT053':1,'AQBCAT059':1,'AQBCAT100':1,'AQBCAT102':1,'AQBCAT103':1,'AQBCAT104':1,'AQBCAT142':1,'AQBCAT227':1};
  const rows=[],counts={};
  for(const id of ids.slice(cursor,cursor+18)){
    const status=v(S,id,'Qualification Status')||'UNSPECIFIED';counts[status]=(counts[status]||0)+1;
    const candidate=v(S,id,'Candidate Image URL'),source=v(S,id,'Candidate Source URL');
    const canonical=v(C,id,'Image URL')||v(C,id,'Own Photo');
    const asset=v(F,id,'Card Asset Review Locator');
    const evidence=v(S,id,'Candidate Evidence JSON');
    let parsed=false,evidenceVersion='';
    if(evidence){try{const e=JSON.parse(evidence);parsed=true;evidenceVersion=String(e&&e.visualQuality&&e.visualQuality.version||'');}catch(ignore){}}
    const record={id:id,service:v(C,id,'Service Name'),status:status,score:v(S,id,'Visual Score'),gate:v(S,id,'Gate Outcome'),hasCandidate:!!candidate,hasCanonical:!!canonical,hasSource:!!source,hasEvidence:!!evidence,evidenceJsonValid:parsed,evidenceVersion:evidenceVersion,hasPhotoBrief:!!v(C,id,'Photo Brief'),photoTrack:v(S,id,'Photo Track'),selectedLocalCard:!!selected[id],hasLocalCard:!!asset,localCardState:v(F,id,'Card Asset Review State'),hold:!!AQBGetCataloguePhotoHolds()[id]};
    const blockers=[];
    if(!record.hasPhotoBrief)blockers.push('PHOTO_BRIEF_MISSING');
