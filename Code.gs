function AQBRollbackCreatedAppointment(appointmentId,calendarEventId){
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
    if(n>=2){const rows=s.getRange(2,1,n-1,17).getValues();for(let i=rows.length-1;i>=0;i--){if(String(rows[i][0]||'')===String(appointmentId||'')){s.deleteRow(i+2);break;}}}
  }catch(e){AQBLogAudit('ROLLBACK_ERROR','Appointment',String(appointmentId||''),'Could not remove rolled-back appointment row: '+String(e&&e.message||e));}
  AQBDeleteCalendarEvent(calendarEventId,appointmentId);
}

function AQBDeleteCalendarEvent(eventId,appointmentId,appointmentDate){
  eventId=String(eventId||'').trim(); appointmentId=String(appointmentId||'').trim();
  // A blank stored ID is already a clean terminal state. Do not search old dates
  // repeatedly just to prove that nothing exists.
  if(!eventId)return true;
  try{
    const calendarId=String(CONFIG.CALENDAR_ID||'').trim();
    if(!calendarId)throw new Error('Google Calendar is not configured.');
    const cal=CalendarApp.getCalendarById(calendarId);
    if(!cal)throw new Error('Configured AQB calendar could not be accessed.');

    // First use the exact stored ID. Google/CalendarApp may stop returning an event
    // after deleteEvent(); absence is therefore success, not an error.
    let ev=null;
    try{ev=cal.getEventById(eventId);}catch(ignore){ev=null;}
    if(ev){
      ev.deleteEvent();
      AQBLogAudit('CALENDAR_EVENT_DELETED','Appointment',appointmentId,'Calendar event deleted from the configured AQB calendar. Event ID: '+eventId);
      return true;
    }

    // Migration safety: if the stored ID is stale, search the appointment date for
    // an event carrying this AQB Appointment ID. If found, delete that current event.
    let center=appointmentDate instanceof Date?new Date(appointmentDate):new Date(String(appointmentDate||''));
    if(!isNaN(center.getTime()) && appointmentId){
      center.setHours(12,0,0,0);
      const from=new Date(center.getTime()-3*86400000),to=new Date(center.getTime()+3*86400000);
      const events=cal.getEvents(from,to);
      for(let i=0;i<events.length;i++){
        const candidate=events[i];
        const description=String(candidate.getDescription()||'');
        if(description.indexOf('Appointment ID: '+appointmentId)===-1)continue;
        const liveId=String(candidate.getId()||'');
        candidate.deleteEvent();
        AQBLogAudit('CALENDAR_EVENT_RECOVERED_AND_DELETED','Appointment',appointmentId,'Stored Calendar Event ID was stale; matching event on the configured AQB calendar was deleted. Stored='+eventId+' Current='+liveId+'.');
        return true;
      }
    }

    // If neither the stored event nor an Appointment-ID match exists on the current
    // AQB calendar, the old event is already absent. This is a successful cleanup.
    AQBLogAudit('CALENDAR_EVENT_ALREADY_DELETED','Appointment',appointmentId,'Calendar event was already absent from the configured AQB calendar. Event ID: '+eventId);
    return true;
  }catch(e){
    AQBLogAudit('CALENDAR_DELETE_ERROR','Appointment',appointmentId,String(e&&e.message||e)+' Event ID: '+eventId);
    return false;
  }
}

function AQBClearCompletedCalendarEventId(appointmentId,expectedEventId){
  appointmentId=String(appointmentId||'').trim(); expectedEventId=String(expectedEventId||'').trim();
  if(!appointmentId)return false;
  const lock=LockService.getScriptLock(); if(!lock.tryLock(5000))return false;
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow(); if(n<2)return false;
    const rows=s.getRange(2,1,n-1,17).getValues();
    for(let i=0;i<rows.length;i++){
      const r=rows[i]; if(String(r[0]||'').trim()!==appointmentId)continue;
      if(String(r[8]||'').trim().toUpperCase()!=='COMPLETED')return false;
      const live=String(r[11]||'').trim();
      if(!live)return true;
      if(expectedEventId && live!==expectedEventId)return false;
      s.getRange(i+2,12).clearContent();
      AQBLogAudit('CALENDAR_EVENT_ID_CLEARED','Appointment',appointmentId,'Completed appointment Calendar Event ID cleared after successful/terminal Calendar cleanup. Previous Event ID: '+live);
      return true;
    }
    return false;
  }finally{lock.releaseLock();}
}

function AQBSaveCustomerAndAppointment(payload){
  const user=AQBRequireUser(); if(!payload)throw new Error('No customer information was received.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const legacyName=String(payload.customerName||'').trim();
    const suppliedFirst=String(payload.firstName||'').trim();
    const suppliedLast=String(payload.lastName||'').trim();
    const parsedName=AQBSplitCustomerName(legacyName);
    const firstName=suppliedFirst||parsedName.firstName;
    const lastName=suppliedLast||parsedName.lastName;
    const name=AQBBuildCustomerFullName(firstName,lastName,legacyName);
    const phone=AQBNormalizePhone(payload.whatsappNumber);
    const selectedType=String(payload.customerType||'').trim();
    const rawService=String(payload.service||'').trim();
    const other=String(payload.otherService||'').trim();
    const isSisterlocks=AQBIsSisterlocksService(rawService)||selectedType==='Sisterlocks Retightening';
    const isRetie=AQBIsSisterlocksRetieService(rawService)||selectedType==='Sisterlocks Retightening';
    let finalService=rawService;
    if(!isSisterlocks&&rawService==='Other'&&other)finalService=other;
    const bookNow=payload.bookNow===true;
    if(isRetie && String(payload.lastRetieDate||'').trim()){
      const suppliedLastRetie=AQBParseDateFromClient(payload.lastRetieDate);
      if(suppliedLastRetie>new Date())throw new Error('Last retie date cannot be in the future.');
    }
    // Last Retie Date is optional. If the client does not wish to disclose it,
    // AQB may still register/book the Sisterlocks Retightening manually.
    // The 42-day automatic rule is applied only when a last-retie date is supplied.
    if(!name)throw new Error('Customer name is required.');
    if(!AQBIsValidPhone(phone))throw new Error('Please enter a valid Kenyan WhatsApp number.');
    if(!isSisterlocks&&!bookNow&&!finalService)finalService='Other Service Customer';
    if(!isSisterlocks&&bookNow&&!finalService)throw new Error('Please select a service before booking.');

    const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow(),m=AQBBuildHeaderMap(s),lastCol=s.getLastColumn();let rowNum=null,row=null;
    if(n>=2){const rows=s.getRange(2,1,n-1,lastCol).getValues();let matches=0;for(let i=0;i<rows.length;i++){if(AQBNormalizePhone(rows[i][m['WhatsApp Number']-1])===phone){matches++;rowNum=i+2;row=rows[i];}}if(matches>1)throw new Error('Duplicate customer WhatsApp identity: '+matches+' records. Correct Customers sheet before booking.');if(row)AQBAssertSingleCustomerMatch(row[m['Customer ID']-1]);}

    if(rowNum){
      if(payload.confirmExisting!==true)throw new Error('This WhatsApp number already belongs to an existing customer. Please confirm that you want to use the existing customer.');
      const customerId=String(row[m['Customer ID']-1]||'');
      const firstRetieBooking=isRetie && !AQBHasSisterlocksRetieHistory(customerId);
      row[m['Customer Name']-1]=name;row[m['First Name']-1]=firstName;row[m['Last Name']-1]=lastName;
      if(payload.customerLocation!==undefined)row[m['Customer Location']-1]=String(payload.customerLocation||'').trim();
      if(payload.notes!==undefined)row[m['Notes']-1]=String(payload.notes||'').trim();
      if(isSisterlocks)row[m['Service']-1]=finalService;
      else if(bookNow)row[m['Service']-1]=finalService;
      else if(!String(row[m['Service']-1]||'').trim())row[m['Service']-1]='Other Service Customer';
      let appointment=null,automaticRetieApplied=false;
      if(isRetie){
        const storedLast=AQBParseRetieDate(row[m['Last Retie Date']-1]),storedNext=AQBParseRetieDate(row[m['Next Retie Date']-1]);
        let lastRetie=storedLast?new Date(storedLast):null,nextRetie=storedNext?new Date(storedNext):null,reminderDate=null;
        if(String(payload.lastRetieDate||'').trim()){
          lastRetie=AQBParseDateFromClient(payload.lastRetieDate);
          if(lastRetie>new Date())throw new Error('Last retie date cannot be in the future.');
          const c=AQBCalculateRetieDates(lastRetie);nextRetie=AQBParseDateFromClient(c.nextRetieDate);reminderDate=AQBParseDateFromClient(c.reminderDate);
          row[m['Last Retie Date']-1]=lastRetie;row[m['Next Retie Date']-1]=nextRetie;row[m['Reminder Date']-1]=reminderDate;row[m['Reminder Sent']-1]='No';
        }else if(nextRetie){
          nextRetie.setHours(0,0,0,0);
          reminderDate=new Date(nextRetie);reminderDate.setDate(reminderDate.getDate()-CONFIG.RETIE_REMINDER_DAYS);
          row[m['Reminder Date']-1]=reminderDate;
        }else if(lastRetie){
          const c=AQBCalculateRetieDates(lastRetie);nextRetie=AQBParseDateFromClient(c.nextRetieDate);reminderDate=AQBParseDateFromClient(c.reminderDate);
          row[m['Next Retie Date']-1]=nextRetie;row[m['Reminder Date']-1]=reminderDate;
        }else{
          nextRetie=new Date();nextRetie.setHours(0,0,0,0);
          reminderDate=new Date(nextRetie);reminderDate.setDate(reminderDate.getDate()-CONFIG.RETIE_REMINDER_DAYS);
          row[m['Next Retie Date']-1]=nextRetie;row[m['Reminder Date']-1]=reminderDate;
        }
        row[m['Reminder Sent']-1]='No';
        const daysSinceLastRetie=lastRetie?AQBGetDaysSinceDate(lastRetie):null,daysOverdue=daysSinceLastRetie!==null?daysSinceLastRetie:AQBGetDaysSinceDate(nextRetie),manualOverride=payload.manualRetieOverride===true && payload.appointmentDate && payload.startTime;
        if(manualOverride && bookNow){
          payload.internalAppointment=true; appointment=AQBCreateAppointmentForCustomer(customerId,row,payload,user,m);
        }else if(bookNow && (daysOverdue===null || daysOverdue<=CONFIG.AUTO_BOOK_EXISTING_RETIE_MAX_DAYS) && String(row[m['Next Appointment Created']-1]||'').trim().toLowerCase()!=='yes'){
          const a=AQBCreateAutomaticRetieAppointmentForCustomer(row,m,firstRetieBooking);if(a){appointment=a;automaticRetieApplied=true;row[m['Next Appointment Created']-1]='Yes';}
        }
        // More than 42 days since the last completed retie: preserve the known/missed Next Retie Date and save
        // without forcing a future booking. The overdue WhatsApp ladder runs below.
        if(appointment && firstRetieBooking && !automaticRetieApplied){
          try{AQBSendBookingWhatsAppForAppointment(appointment,firstName);}catch(e){AQBLogAudit('WHATSAPP_ERROR','Appointment',appointment.appointmentId,e.message);}
        }
      } else if(!isRetie&&bookNow){
        payload.internalAppointment=true;
        appointment=AQBCreateAppointmentForCustomer(customerId,row,payload,user,m);
        try{AQBSendBookingWhatsAppForAppointment(appointment,firstName);}catch(e){AQBLogAudit('WHATSAPP_ERROR','Appointment',appointment.appointmentId,e.message);}
      }
      s.getRange(rowNum,1,1,lastCol).setValues([row]);
      let retieOverdueMessage=null;
      if(isRetie && (row[m['Next Retie Date']-1]||row[m['Last Retie Date']-1])){
        retieOverdueMessage=AQBSendRetieKnownHistoryOverdue(s,rowNum,row,m,'SAVE_EXISTING_CUSTOMER');
      }
      AQBLogAudit('USE_EXISTING_CUSTOMER','Customer',customerId,'Existing customer updated; booking is optional and Sisterlocks scheduling remains automatic.'+(retieOverdueMessage?' Retie overdue evaluation: '+JSON.stringify(retieOverdueMessage):''));
      return {success:true,customerId,customer:AQBBuildCustomerObject(row,m),appointment,existing:true,retieOverdueMessage:retieOverdueMessage};
    }

    const customerId=AQBGenerateCustomerID(); let lastRetie='',nextRetie='',reminder='';
    // Retie date is driven by the selected Sisterlocks Retightening service;
    // there is no separate "Sisterlocks History" question.
    if(isRetie&&payload.lastRetieDate){
      lastRetie=AQBParseDateFromClient(payload.lastRetieDate);const c=AQBCalculateRetieDates(lastRetie);nextRetie=AQBParseDateFromClient(c.nextRetieDate);reminder=AQBParseDateFromClient(c.reminderDate);
    }
    const newRow=Array(lastCol).fill('');
    newRow[m['Customer ID']-1]=customerId;newRow[m['Customer Name']-1]=name;newRow[m['WhatsApp Number']-1]=phone;newRow[m['Customer Location']-1]=String(payload.customerLocation||'').trim();newRow[m['Service']-1]=finalService;
    newRow[m['First Name']-1]=firstName;newRow[m['Last Name']-1]=lastName;newRow[m['Last Retie Date']-1]=lastRetie;newRow[m['Next Retie Date']-1]=nextRetie;newRow[m['Reminder Date']-1]=reminder;newRow[m['Reminder Sent']-1]=nextRetie?'No':'';newRow[m['Payment Status']-1]='Pending';newRow[m['Total Visits']-1]=0;newRow[m['Notes']-1]=String(payload.notes||'').trim();newRow[m['Customer Status']-1]='New';newRow[m['Next Appointment Created']-1]='No';
    let appointment=null;
    // Transaction order: validate/create the appointment first. Only persist the
    // customer after the appointment succeeds, preventing orphan customer rows.
    if(bookNow){
      payload.internalAppointment=true;
      appointment=AQBCreateAppointmentForCustomer(customerId,newRow,payload,user,m);
    }
    try{
      AQBAppendUniqueCustomerRow(s,newRow);
      s.getRange(s.getLastRow(),m['WhatsApp Number']).setNumberFormat('@').setValue(phone);
    }catch(e){
      if(appointment)AQBRollbackCreatedAppointment(appointment.appointmentId,appointment.calendarEventId);
      throw new Error('Customer could not be saved after appointment creation. The appointment was rolled back. '+String(e&&e.message||e));
    }
    if(appointment){
      s.getRange(s.getLastRow(),1,1,lastCol).setValues([newRow]);
      s.getRange(s.getLastRow(),m['WhatsApp Number']).setNumberFormat('@').setValue(phone);
      // Normal first booking confirmations remain unchanged.
      try{AQBSendBookingWhatsAppForAppointment(appointment,firstName);}catch(e){AQBLogAudit('WHATSAPP_ERROR','Appointment',appointment.appointmentId,e.message);}
    }
    AQBLogAudit('CREATE_CUSTOMER','Customer',customerId,isSisterlocks ? 'New customer registered. First Sisterlocks appointment is manual; the 42-day retie cycle starts after completion. Last retie date is optional.' : 'New customer registered.');
    return {success:true,customerId,customer:AQBBuildCustomerObject(newRow,m),appointment,existing:false};
  }finally{lock.releaseLock();}
}

function AQBGetAppointmentDurationMinutes(service){
  const trendDuration=AQBGetTrendDurationMinutes(service); if(trendDuration>0)return trendDuration;
  const s=String(service||'').trim().toLowerCase();
  if(s.includes('sisterlocks installation')) return 480;
  if(s.includes('sisterlocks retightening') || /sisterlocks\s+retightening/.test(s)) return 180;
  if(/consultation/i.test(s)) return 45;
  return 120;
}

function AQBValidateInternalAppointmentStartTime(startTime,specialArrangement){
  const st=AQBParseTimeFromClient(startTime);
  if(!st)throw new Error('Please choose an appointment start time.');
  const mins=st.hours*60+st.minutes;
  if(mins<7*60 || mins>(specialArrangement===true?23*60+45:19*60))throw new Error('Appointment start time is outside permitted hours.');
  if(st.minutes%15!==0)throw new Error('Appointment start time must use 15-minute intervals (0700, 0715, 0730 … 1900 hrs).');
  return st;
}

function AQBValidateCustomerBookingHours(date,start,end,internalAppointment,specialArrangement){
  const day=date.getDay();
  if(day===0) throw new Error('Sunday bookings are by special appointment only. Please contact Afrikan Quinn Beauty Centre.');
  const open=new Date(date);open.setHours(7,0,0,0);
  const close=new Date(date);close.setHours(19,0,0,0);
  if(specialArrangement===true && internalAppointment===true){
    AQBRequireAdmin();
    const midnight=new Date(date);midnight.setDate(midnight.getDate()+1);midnight.setHours(0,0,0,0);
    if(start<open||end>midnight)throw Error('Special-arrangement appointments must start after 07:00 and finish before midnight.');
    return;
  }
  if(start<open || end>close){
    throw new Error(internalAppointment
      ? 'Appointments are available Monday–Saturday from 0700 hrs to 1900 hrs. Please choose a start time that allows the full service to finish by 1900 hrs.'
      : 'Online bookings are available Monday–Saturday from 7:00 AM to 7:00 PM. Please choose a time within our business hours.');
  }
}

function AQBCreateAppointmentForCustomer(customerId,customerRow,payload,user,customerMap){
  const date=AQBParseDateFromClient(payload.appointmentDate);
  const st=AQBParseTimeFromClient(payload.startTime);
  if(!date||!st)throw new Error('Appointment date and start time are required.');

  const selectedService=String(payload.service||customerRow[customerMap['Service']-1]||'').trim();
  if(!selectedService)throw new Error('Please select a service.');

  const internalAppointment=payload.internalAppointment===true;
  const specialArrangement=payload.specialArrangement===true;
  if(specialArrangement){AQBRequireAdmin();if(!String(payload.specialArrangementReason||'').trim())throw Error('Admin special-arrangement reason is required.');}
  AQBValidateInternalAppointmentStartTime(payload.startTime,specialArrangement);
  const start=AQBCombineDateAndTime(date,st);
  const end=new Date(start.getTime()+AQBGetAppointmentDurationMinutes(selectedService)*60000);
  const now=new Date();

  if(start<now)throw new Error('Appointment date/time cannot be in the past. Please choose a future time.');
  const maxDate=new Date(now);maxDate.setHours(0,0,0,0);maxDate.setDate(maxDate.getDate()+60);
  if(date>maxDate)throw new Error('Appointment date must be within the next 60 days.');
  AQBValidateCustomerBookingHours(date,start,end,internalAppointment,specialArrangement);
  AQBAssertNoDuplicateActiveAppointment(customerId,selectedService,null);
  if(AQBIsAppointmentSlotTaken(date,start,end,null))throw new Error('That appointment time is already booked. Please choose another time.');

  const id=AQBGenerateAppointmentID();
  const day=Utilities.formatDate(date,Session.getScriptTimeZone(),'EEEE');
  const time=Utilities.formatDate(start,Session.getScriptTimeZone(),'HH:mm');
  const paymentStatus=String(payload.paymentStatus||'Pending').trim();

  const pricing=AQBFindServicePricing(selectedService,payload.serviceGroup);
  const agreedRaw=payload.chargedPrice!==undefined&&payload.chargedPrice!=='' ? payload.chargedPrice : payload.amountDue;
  const chargedPrice=String(agreedRaw==null?'':agreedRaw).trim()==='' ? Number(pricing.priceAmount||AQBGetPublicStartingPriceNumber(pricing.price)) : Number(agreedRaw);
  if(!isFinite(chargedPrice)||chargedPrice<=0)throw new Error('No valid amount was entered and no usable Master List price is configured for '+selectedService+'. Check Master Lists > Price, or enter the actual Charged Price.');

  const location=String(customerRow[customerMap['Customer Location']-1]||'').trim();
  const calendarEventId=AQBCreateGoogleCalendarEvent(
    id,
    customerId,
    customerRow[customerMap['Customer Name']-1],
    customerRow[customerMap['WhatsApp Number']-1],
    selectedService,
    start,
    end,
    String(payload.notes||'').trim()+(specialArrangement?' [ADMIN SPECIAL ARRANGEMENT: '+String(payload.specialArrangementReason||'').trim()+']':''),
    chargedPrice,
    location
  );

  const bookingSource=String(payload.bookingSource||'Web App').trim()||'Web App';
  const row=[
    id,
    customerId,
    customerRow[customerMap['Customer Name']-1],
    customerRow[customerMap['WhatsApp Number']-1],
    selectedService,
    date,
    start,
    end,
    'BOOKED',
    'Pending',
    paymentStatus,
    calendarEventId,
    bookingSource,
    String(payload.notes||'').trim()+(specialArrangement?' [ADMIN SPECIAL ARRANGEMENT: '+String(payload.specialArrangementReason||'').trim()+']':''),
    '',
    pricing.price,
    chargedPrice
  ];

  AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS).appendRow(row);
  AQBLogAudit(
    'CREATE_APPOINTMENT',
    'Appointment',
    id,
    'Appointment booked for '+customerId+
    ' on '+AQBFormatDateForClient(date)+
    '; duration '+AQBGetAppointmentDurationMinutes(selectedService)+' minutes; Google Calendar event '+
    calendarEventId+' created with staff access invitations.'
  );
  try{AQBSortAppointmentsCurrentToOld();}catch(ignore){}

  return {
    appointmentId:id,
    customerId,
    customerName:customerRow[customerMap['Customer Name']-1],
    whatsappNumber:customerRow[customerMap['WhatsApp Number']-1],
    service:selectedService,
    appointmentDate:AQBFormatDateForClient(date),
    startTime:AQBFormatTimeForClient(start),
    endTime:AQBFormatTimeForClient(end),
    durationMinutes:AQBGetAppointmentDurationMinutes(selectedService),
    status:'BOOKED',
    confirmation:'Pending',
    paymentStatus,
    calendarEventId,
    appointmentDay:day,
    appointmentTime:time,
    amountDue:chargedPrice,
    servicePrice:pricing.price,
    chargedPrice
  };
}

function AQBCreateGoogleCalendarEvent(appointmentId,customerId,customerName,phone,service,start,end,notes,chargedPrice,location,appointmentStatus){
  appointmentStatus=String(appointmentStatus||'BOOKED').toUpperCase();
  const calendarId=String(CONFIG.CALENDAR_ID||'').trim();
  if(!calendarId) throw new Error('Google Calendar is not configured. Add CONFIG.CALENDAR_ID first.');

  const calendar=CalendarApp.getCalendarById(calendarId);
  if(!calendar) throw new Error('The configured African Quinn Beauty Centre Google Calendar could not be accessed. Check the Calendar ID and Google account permissions.');

  const firstName=AQBGetCustomerFirstNameById(customerId)||AQBSplitCustomerName(customerName).firstName||String(customerName||'').trim();
  const title=firstName+' - '+String(service||'').trim();
  const description=[
    'African Quinn Beauty Client Management',
    '',
    'Appointment ID: '+appointmentId,
    'Customer ID: '+customerId,
    'Customer: '+customerName,
    'WhatsApp: '+phone,
    'Service: '+service,
    'Status: '+appointmentStatus,
    'Payment: '+(chargedPrice>0?'KES '+Number(chargedPrice).toLocaleString('en-KE'):'Pending'),
    notes?'Notes: '+notes:''
  ].filter(Boolean).join('\n');

  const options={description:description};
  if(String(location||'').trim()) options.location=String(location).trim();
  const event=calendar.createEvent(title,start,end,options);
  if(!event || !event.getId()) throw new Error('Google Calendar event could not be created.');

  // Give every active AQB user access to this appointment through a Google Calendar invitation.
  // This keeps the central calendar usable by staff without requiring each staff member to own it.
  if(CONFIG.CALENDAR_INVITE_STAFF){
    try{ AQBInviteActiveUsersToCalendarEvent(event); }catch(e){ /* never block booking if an invitation fails */ }
  }
  return event.getId();
}

function AQBInviteActiveUsersToCalendarEvent(event){
  if(!event)return;
  const organizerEmail=String(Session.getActiveUser().getEmail()||'').trim().toLowerCase();
  const existing=(event.getGuestList?event.getGuestList():[]).map(g=>String(g.getEmail()||'').trim().toLowerCase());
  const existingMap={}; existing.forEach(e=>existingMap[e]=true);
  AQBGetActiveUserEmails().forEach(function(email){
    if(!email || email===organizerEmail || existingMap[email])return;
    try{ event.addGuest(email); }catch(e){ /* one unavailable guest must not block the appointment */ }
  });
}

function AQBSyncCalendarGuestsForAllUsers(){
  AQBRequireAdmin();
  const calendarId=String(CONFIG.CALENDAR_ID||'').trim();
  if(!calendarId)throw new Error('Google Calendar is not configured.');
  const calendar=CalendarApp.getCalendarById(calendarId);
  if(!calendar)throw new Error('The configured AQB Google Calendar could not be accessed by this account.');
  const activeEmails=AQBGetActiveUserEmails();
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
  let eventsUpdated=0,guestsAdded=0;
  if(n<2)return {success:true,eventsUpdated,guestsAdded,activeUsers:activeEmails.length};
  const rows=s.getRange(2,1,n-1,17).getValues();
  const now=new Date();
  rows.forEach(function(r){
    const eventId=String(r[11]||'').trim();
    if(!eventId)return;
    const event=calendar.getEventById(eventId);
    if(!event)return;
    if(event.getStartTime()<now)return;
    const existing={};
    event.getGuestList().forEach(function(g){existing[String(g.getEmail()||'').trim().toLowerCase()]=true;});
    let addedHere=0;
    activeEmails.forEach(function(email){
      if(!email||existing[email])return;
      try{event.addGuest(email);existing[email]=true;addedHere++;}catch(e){}
    });
    if(addedHere){eventsUpdated++;guestsAdded+=addedHere;}
  });
  return {success:true,eventsUpdated,guestsAdded,activeUsers:activeEmails.length};
}

function AQBFindCalendarEventByAppointmentId(calendar,appointmentId,start,end){
  if(!calendar||!appointmentId)return null;
  try{
    const from=new Date(start.getTime()-24*60*60*1000);
    const to=new Date(end.getTime()+24*60*60*1000);
    const events=calendar.getEvents(from,to);
    const marker='Appointment ID: '+appointmentId;
    for(let i=0;i<events.length;i++){
      try{if(String(events[i].getDescription()||'').indexOf(marker)>=0)return events[i];}catch(ignore){}
    }
  }catch(ignore){}
  return null;
}

function AQBIsCalendarEventMatch(event,appointmentId,start,end){
  if(!event||!appointmentId||!start||!end)return false;
  try{
    const description=String(event.getDescription()||'');
    if(description.indexOf('Appointment ID: '+appointmentId)<0)return false;
    const es=event.getStartTime(),ee=event.getEndTime();
    // Allow a small tolerance for Calendar normalization while still rejecting stale/wrong events.
    return Math.abs(es.getTime()-start.getTime())<=60000 && Math.abs(ee.getTime()-end.getTime())<=60000;
  }catch(e){return false;}
}

function AQBSyncAppointmentsWithLiveCalendar(){
  const user=AQBRequireUser();
  const calendarId=String(CONFIG.CALENDAR_ID||'').trim();
  if(!calendarId)throw new Error('Google Calendar is not configured.');
  const calendar=CalendarApp.getCalendarById(calendarId);
  if(!calendar)throw new Error('The configured AQB Google Calendar could not be accessed by this account.');
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
  if(n<2)return {success:true,checked:0,updated:0,created:0,missing:0,skippedPast:0};
  const rows=s.getRange(2,1,n-1,17).getValues(),now=new Date();
  let checked=0,updated=0,created=0,missing=0,skippedPast=0;
  rows.forEach(function(r){
    const appointmentId=String(r[0]||'').trim(),status=String(r[8]||'').trim().toUpperCase();
    if(!appointmentId||['CANCELLED','COMPLETED','NO SHOW'].includes(status))return;
    if(!(r[5] instanceof Date)||!(r[6] instanceof Date)||!(r[7] instanceof Date))return;
    const start=r[6],end=r[7]; if(end<now){skippedPast++;return;}
    checked++;
    const service=String(r[4]||'').trim(),customerId=String(r[1]||'').trim(),customerName=String(r[2]||'').trim(),phone=String(r[3]||'').trim(),notes=String(r[13]||'').trim(),location=AQBGetCustomerLocationById(customerId),chargedPrice=Number(r[16]||r[14]||0);
    let eventId=String(r[11]||'').trim(),event=null;
    if(eventId){
      try{
        const candidate=calendar.getEventById(eventId);
        if(candidate && AQBIsCalendarEventMatch(candidate,appointmentId,start,end)) event=candidate;
      }catch(e){event=null;}
    }
    if(!event)event=AQBFindCalendarEventByAppointmentId(calendar,appointmentId,start,end);
    if(event){
      const liveId=String(event.getId()||'').trim();
      if(liveId && liveId!==eventId){const previousEventId=eventId;r[11]=liveId;s.getRange(rows.indexOf(r)+2,1,1,17).setValues([r]);eventId=liveId;AQBLogAudit('CALENDAR_EVENT_LINKED','Appointment',appointmentId,'Re-linked stale Calendar Event ID to the matching event on the configured AQB calendar. Previous='+previousEventId+' New='+liveId+'.');}
      event.setTitle((AQBGetCustomerFirstNameById(customerId)||customerName)+' - '+service);
      event.setTime(start,end);
      event.setDescription(['African Quinn Beauty Client Management','', 'Appointment ID: '+appointmentId,'Customer ID: '+customerId,'Customer: '+customerName,'WhatsApp: '+phone,'Service: '+service,'Status: '+status,'Payment: '+(chargedPrice>0?'KES '+Number(chargedPrice).toLocaleString('en-KE'):'Pending'),notes?'Notes: '+notes:''].filter(Boolean).join('\n'));
      if(location)event.setLocation(location);
      updated++;
    }else{
      try{
        eventId=AQBCreateGoogleCalendarEvent(appointmentId,customerId,customerName,phone,service,start,end,notes,chargedPrice,location,status);
        r[11]=eventId;s.getRange(rows.indexOf(r)+2,1,1,17).setValues([r]);created++;
      }catch(e){missing++;AQBLogAudit('CALENDAR_SYNC_CREATE_ERROR','Appointment',appointmentId,String(e&&e.message||e));}
    }
  });
  AQBLogAudit('SYNC_APPOINTMENTS_LIVE_CALENDAR','Calendar','AQB','Checked '+checked+' future appointments; updated '+updated+', created '+created+', missing '+missing+'.');
  return {success:true,checked,updated,created,missing,skippedPast};
}

function AQBIsAppointmentSlotTaken(date,start,end,excludeId){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<2)return false;const target=AQBFormatDateKey(date),rows=s.getRange(2,1,n-1,17).getValues();
  for(const r of rows){const id=String(r[0]||''),status=String(r[8]||'').trim();if(excludeId&&id===excludeId)continue;if(['CANCELLED','NO SHOW','COMPLETED'].includes(status))continue;if(!(r[5] instanceof Date)||AQBFormatDateKey(r[5])!==target)continue;if(!(r[6] instanceof Date)||!(r[7] instanceof Date))continue;if(start<r[7]&&end>r[6])return true;}return false;
}

function AQBBuildAppointmentObject(r){
  const charged=Number(r[16]||r[14]||0);
  return {appointmentId:String(r[0]||''),customerId:String(r[1]||''),customerName:String(r[2]||''),whatsappNumber:String(r[3]||''),service:String(r[4]||''),appointmentDate:AQBFormatDateForClient(r[5]),startTime:AQBFormatTimeForClient(r[6]),endTime:AQBFormatTimeForClient(r[7]),status:String(r[8]||''),confirmation:String(r[9]||''),paymentStatus:String(r[10]||''),calendarEventId:String(r[11]||''),bookingSource:String(r[12]||''),notes:String(r[13]||''),amountDue:charged,servicePrice:String(r[15]||''),chargedPrice:charged};
}

function AQBGetTodaysAppointments(){
  AQBRequireUser();const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<2)return [];const key=AQBFormatDateKey(new Date());
  const out=s.getRange(2,1,n-1,17).getValues().filter(r=>r[5] instanceof Date&&AQBFormatDateKey(r[5])===key&&!['COMPLETED','CANCELLED','NO SHOW'].includes(String(r[8]||'').trim().toUpperCase())).map(AQBBuildAppointmentObject);
  out.sort((a,b)=>a.startTime.localeCompare(b.startTime));return out;
}

function AQBGetUpcomingAppointments(){
  AQBRequireUser();
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
  if(n<2)return [];
  const now=new Date(),todayKey=AQBFormatDateKey(now);
  const end=new Date(now);end.setHours(0,0,0,0);end.setDate(end.getDate()+90);end.setHours(23,59,59,999);
  // An unresolved past appointment remains in the staff Appointments queue.
  const out=s.getRange(2,1,n-1,17).getValues()
    .filter(r=>r[5] instanceof Date&&r[5]<=end&&!['COMPLETED','CANCELLED','NO SHOW'].includes(String(r[8]||'').trim().toUpperCase()))
    .map(AQBBuildAppointmentObject);
  out.forEach(a=>{a.overdue=String(a.appointmentDate||'')<todayKey;});
  // Prioritize overdue work, then chronological upcoming appointments.
  out.sort((a,b)=>(a.appointmentDate+a.startTime).localeCompare(b.appointmentDate+b.startTime));
  return out;
}

function AQBCountAppointmentsInRange(start,end){const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<2)return 0;return s.getRange(2,1,n-1,17).getValues().filter(r=>r[5] instanceof Date&&AQBIsDateInRange(r[5],start,end)&&!['COMPLETED','CANCELLED','NO SHOW'].includes(String(r[8]||'').trim().toUpperCase())).length;}

function AQBEnsureCompletedAppointmentPayment(appointmentId,appointment,amount,userEmail){
  // Deprecated auto-posting helper: payment method cannot be inferred from completion.
  // Kept for caller compatibility, but never fabricates a Cash receipt.
  throw new Error('Completion cannot assume Cash received. Use verified payment collection and reconciliation.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const d=AQBGetPaymentRecoveryRows(),pm=d.pm,cm=d.cm;
    const existing=d.payments.filter(function(r){return String(r[pm['Appointment ID']-1]||'').trim()===appointmentId && String(r[pm['Payment Status']-1]||'').toLowerCase()!=='cancelled';});
    if(existing.length){
      if(existing.length!==1 || Number(existing[0][pm['Amount']-1])!==amount)
        throw new Error('Existing payment ledger conflicts with completion amount; review manually: '+appointmentId);
      return {reused:true,paymentId:String(existing[0][pm['Payment ID']-1]||''),incomeCreated:false};
    }
    const candidates=AQBFindCompletionLedgerCandidate(d,appointmentId);
    if(candidates.length>1)throw new Error('Multiple unlinked income rows; manual reconciliation required: '+appointmentId);
    if(candidates.length && Number(candidates[0].row[cm['Amount']-1])!==amount)
      throw new Error('Existing income amount differs from completion amount; manual reconciliation required: '+appointmentId);
    if(candidates.length && String(candidates[0].row[cm['Payment Status']-1]||'').toLowerCase()!=='paid')
      throw new Error('Existing income is not marked Paid; verify before reconciliation: '+appointmentId);
    const method=candidates.length?String(candidates[0].row[cm['Payment Method']-1]||'').trim():'Cash';
    const paymentId=AQBGeneratePaymentID();
    const date=candidates.length?candidates[0].row[cm['Date']-1]:new Date();
    AQBAppendByHeaders(d.ps,{'Payment ID':paymentId,'Date':date,'Customer ID':String(appointment[1]||''),
      'Customer Name':String(appointment[2]||''),'Appointment ID':appointmentId,'Service':String(appointment[4]||''),
      'Payment Type':'Full Payment','Amount Due':amount,'Amount':amount,'Payment Method':method,
      'Payment Status':'Paid','Description':'Completion payment; original Cash Flow '+(candidates.length?String(candidates[0].row[cm['Transaction ID']-1]||''):'new')+'; method '+(candidates.length?'recovered':'assumed Cash'),
      'Recorded By':String(userEmail||'')});
    let transactionId='';
    if(candidates.length){
      const c=candidates[0];transactionId=String(c.row[cm['Transaction ID']-1]||'');
      d.cs.getRange(c.rowNumber,cm['Source Payment ID']).setValue(paymentId);
    }else if(amount>0){
      transactionId=AQBGenerateTransactionID();
      AQBAppendByHeaders(d.cs,{'Transaction ID':transactionId,'Date':date,'Customer ID':String(appointment[1]||''),
        'Customer Name':String(appointment[2]||''),'Appointment ID':appointmentId,'Service':String(appointment[4]||''),
        'Transaction Type':'Income','Payment Method':method,'Amount':amount,'Payment Status':'Paid',
        'Description':'Completion payment '+paymentId+' — assumed Cash; verify method if needed',
        'Recorded By':String(userEmail||''),'Source Payment ID':paymentId});
    }
    AQBLogAudit('COMPLETE_PAYMENT_LINKED','Appointment',appointmentId,'Payment '+paymentId+' linked to Cash Flow '+(transactionId||'none (zero value)')+' at KES '+amount+'.');
    return {created:true,paymentId:paymentId,transactionId:transactionId,incomeCreated:!candidates.length&&amount>0,linkedExistingIncome:!!candidates.length};
  }finally{lock.releaseLock();}
}

function AQBEnsureCompletedAppointmentIncome(appointmentId,appointment,paidPrice,userEmail){
  throw new Error('Completion is not proof of income. Collect and verify payment before posting Cash Flow.');
  const amount=Number(paidPrice||0);
  if(!isFinite(amount)||amount<=0)return {created:false,reason:'No positive paid amount.'};
  const sheet=AQBGetSheet(CONFIG.SHEETS.CASH_FLOW),m=AQBBuildHeaderMap(sheet),n=sheet.getLastRow();
  if(n>=2){
    const rows=sheet.getRange(2,1,n-1,sheet.getLastColumn()).getValues();
    for(let i=0;i<rows.length;i++){
      const r=rows[i];
      if(String(r[m['Appointment ID']-1]||'').trim()!==String(appointmentId||'').trim())continue;
      if(String(r[m['Transaction Type']-1]||'').trim()!=='Income')continue;
      if(String(r[m['Source Payment ID']-1]||'').trim())continue;
      // A prior completion/payment path may have left this income row Pending.
      // Completing the appointment is authoritative: mark the transaction Paid.
      r[m['Amount']-1]=amount;
      r[m['Payment Method']-1]='Cash';
      r[m['Payment Status']-1]='Paid';
      r[m['Description']-1]='Completed service — paid price KES '+amount;
      if(m['Recorded By'])r[m['Recorded By']-1]=String(userEmail||r[m['Recorded By']-1]||'');
      sheet.getRange(i+2,1,1,sheet.getLastColumn()).setValues([r]);
      return {created:false,updated:true,transactionId:String(r[m['Transaction ID']-1]||'')};
    }
  }
  const txId=AQBGenerateTransactionID();
  const date=appointment[5] instanceof Date?appointment[5]:new Date();
  AQBAppendByHeaders(sheet,{
    'Transaction ID':txId,'Date':date,'Customer ID':String(appointment[1]||''),
    'Customer Name':String(appointment[2]||''),'Appointment ID':String(appointmentId||''),
    'Service':String(appointment[4]||''),'Transaction Type':'Income','Payment Method':'Cash',
    'Amount':amount,'Payment Status':'Paid','Description':'Completed service — paid price KES '+amount,
    'Recorded By':String(userEmail||''),'Source Payment ID':''
  });
  return {created:true,transactionId:txId};
}

// V17.0.7.3 — two-source completion price; no saved-price fallback.
function AQBResolveCompletionCataloguePrice(serviceName){
 const sh=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),h=AQBBuildHeaderMap(sh);
 if(!h['Service Name']||!h['Price'])throw new Error('Catalogue service/price columns missing.');
 const key=String(serviceName||'').trim().toLowerCase();
 const rows=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).getValues():[];
 const matches=rows.filter(function(row){const active=h['Active']?row[h['Active']-1]:true;return String(row[h['Service Name']-1]||'').trim().toLowerCase()===key && active!==false && !['false','0','inactive'].includes(String(active).toLowerCase());});
 if(matches.length!==1)throw new Error('Catalogue lookup requires one unique active service: '+serviceName+' ('+matches.length+' matches).');
 return AQBResolveServiceDeliveryPrice({Price:matches[0][h['Price']-1]},'MOBILE');
}

function AQBCompleteAppointment(appointmentId,actualRetieDate,paidPrice){
  AQBRequireUser();
  appointmentId=String(appointmentId||'').trim();
  if(!appointmentId)throw new Error('Appointment ID is required.');

  // Critical section #1: only protect the appointment state transition. Calendar,
  // income and WhatsApp work must not hold the global script lock.
  let r,idx,s,finalPaidPrice,actualKey;
  const lock=LockService.getScriptLock();
  lock.waitLock(30000);
  try{
    s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS);
    const n=s.getLastRow(); if(n<2)throw new Error('No appointments found.');
    const rows=s.getRange(2,1,n-1,17).getValues(); idx=-1;
    for(let i=0;i<rows.length;i++)if(String(rows[i][0])===appointmentId){idx=i;break;}
    if(idx<0)throw new Error('Appointment not found.');
    r=rows[idx];
    const status=String(r[8]||'').trim().toUpperCase();
    if(status==='COMPLETED')throw new Error('This appointment has already been completed.');
    if(['CANCELLED','NO SHOW'].includes(status))throw new Error('Cancelled or no-show appointments cannot be completed.');
    // Validate customer identity BEFORE the appointment COMMITTED transition.
    AQBAssertSingleCustomerMatch(String(r[1]||''));
    const customerSheet=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),customerMap=AQBBuildHeaderMap(customerSheet);
    const customerRows=customerSheet.getLastRow()>1?customerSheet.getRange(2,customerMap['Customer ID'],customerSheet.getLastRow()-1,1).getValues():[];
    if(!customerRows.some(x=>String(x[0]||'').trim()===String(r[1]||'').trim()))throw new Error('Cannot complete: customer '+String(r[1]||'')+' not found.');
    // Completing an early, overdue, or future-dated booking requires the actual date.
    const actualDate=actualRetieDate?AQBParseDateFromClient(actualRetieDate):null;
    if(actualDate){actualDate.setHours(0,0,0,0);const currentDate=new Date();currentDate.setHours(0,0,0,0);if(actualDate>currentDate)throw new Error('Actual service date cannot be in the future.');}

    const hasEntered=paidPrice!==undefined&&paidPrice!==null&&String(paidPrice).trim()!=='';
    const priceSource=hasEntered?'COMPLETION':'CATALOGUE';
    finalPaidPrice=hasEntered?Number(paidPrice):AQBResolveCompletionCataloguePrice(String(r[4]||''));
    if(!Number.isFinite(finalPaidPrice)||finalPaidPrice<=0)throw new Error('Completion price must be positive.');
    // Preserve the original scheduled date in column 6; record the actual service date
    // as immutable completion evidence in the existing Notes column (no schema change).
    const completedDate=actualDate||new Date();
    actualKey=Utilities.formatDate(completedDate,'Africa/Nairobi','yyyy-MM-dd');
    const priorNotes=String(r[13]||'');
    r[13]=(priorNotes?priorNotes+'\n':'')+'[AQB_ACTUAL_COMPLETION_DATE:'+actualKey+']'+'\n[AQB_COMPLETION_PRICE_SOURCE:'+priceSource+']';
    r[16]=finalPaidPrice; r[14]=finalPaidPrice; r[8]='COMPLETED'; r[9]='Confirmed'; /* Payment status is independent of service completion. */
    s.getRange(idx+2,1,1,17).setValues([r]);
  }finally{lock.releaseLock();}

  // Critical section #2 is customer-specific completion processing. It may create
  // the next retie appointment, but it is isolated from the external WhatsApp call.
  // No payment or income is created from completion. Journey 4 records verified receipts.
  const completedIncome={skipped:true,reason:'PAYMENT_REQUIRES_EXPLICIT_COLLECTION'};
  const completedEventId=String(r[11]||'').trim();
  const calendarDeleted=AQBDeleteCalendarEvent(completedEventId,appointmentId,r[5]);
  const calendarEventIdCleared=calendarDeleted?AQBClearCompletedCalendarEventId(appointmentId,completedEventId):false;
  if(!calendarDeleted)AQBLogAudit('CALENDAR_DELETE_WARNING','Appointment',appointmentId,'Appointment was completed, but the linked Calendar event could not be deleted. Completed Task Repair will retry.');
  // All completion paths (including Admin special arrangements) use the same
  // canonical customer/retie completion route; do not infer success from the call.
  const result=AQBUpdateCustomerAfterCompletion(String(r[1]),r,actualKey);
  const retieService=AQBIsSisterlocksRetieService(String(r[4]||''));
  const nextRetieOutcome=!retieService?'NOT_APPLICABLE':result&&result.appointmentId?'CREATED_OR_REUSED':'NOT_CREATED';
  if(retieService && nextRetieOutcome==='NOT_CREATED')
    AQBLogAudit('RETIE_NEXT_APPOINTMENT_MISSING','Appointment',appointmentId,'Completed retie has no automatic next booking; inspect service identity, due date, and slots before retrying.');

  let whatsapp=null;
  try{
    // V17.0.7.5: reserved test identities must never send live completion WhatsApp.
    const testIdentity=AQBIsTestCustomer(String(r[1]));
    const customer=testIdentity?null:AQBFindCustomerByIdForWhatsApp(String(r[1]));
    if(testIdentity)whatsapp={sent:false,skipped:true,reason:'Reserved AQB test customer: external completion message suppressed.'};
    if(customer){
      const completionMarker='AQB_COMPLETION_WA_SENT_'+appointmentId;
      if(!PropertiesService.getScriptProperties().getProperty(completionMarker)){
        if(AQBIsSisterlocksService(r[4]) && result)whatsapp=AQBSendSisterlocksCompletionWhatsApp(customer,result);
        else if(!AQBIsSisterlocksService(r[4]))whatsapp=AQBSendServiceCompletionWhatsApp(customer,String(r[4]||''));
        if(whatsapp&&whatsapp.sent)PropertiesService.getScriptProperties().setProperty(completionMarker,new Date().toISOString());
      }else whatsapp={sent:false,skipped:true,reason:'Completion message already sent for this appointment.'};
    }
  }catch(e){AQBLogAudit('WHATSAPP_ERROR','Appointment',appointmentId,e.message);whatsapp={sent:false,error:e.message};}
  try{if(!(whatsapp&&whatsapp.skipped))AQBTrackAppointmentWhatsApp_(appointmentId,'COMPLETION',whatsapp);}catch(trackError){AQBLogAudit('WHATSAPP_TRACKER_ERROR','Appointment',appointmentId,String(trackError.message||trackError));}
  AQBLogAudit('COMPLETE_APPOINTMENT','Appointment',appointmentId,'Appointment marked COMPLETED at agreed service amount KES '+finalPaidPrice+'; Calendar deletion '+(calendarDeleted?'verified':'queued for retry')+'; next retie outcome '+nextRetieOutcome+(result&&result.appointmentId?' ('+result.appointmentId+')':'')+'.');
  return {success:true,appointmentId:appointmentId,status:'COMPLETED',paidPrice:finalPaidPrice,serviceAmount:finalPaidPrice,actualCompletionDate:actualKey,isRetieService:retieService,paymentStatus:'UNVERIFIED',paymentCollectionRequired:true,incomeTransaction:completedIncome,calendarDeleted:calendarDeleted,calendarEventIdCleared:calendarEventIdCleared,nextAppointment:result,nextRetieOutcome:nextRetieOutcome,whatsapp:whatsapp};
}

function AQBPreviewAutomaticRetieAppointment(payload){
  AQBRequireUser();
  payload=payload||{};
  const customerId=String(payload.customerId||'').trim();
  const service=String(payload.service||'').trim();
  if(!customerId)throw new Error('Customer ID is required.');
  if(!AQBIsSisterlocksRetieService(service))throw new Error('Automatic scheduling applies only to Sisterlocks Retightening.');

  const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),cn=cs.getLastRow();
  if(cn<2)throw new Error('Customer not found.');
  const cm=AQBBuildHeaderMap(cs),rows=cs.getRange(2,1,cn-1,cs.getLastColumn()).getValues();
  let customerRow=null;
  for(const r of rows){if(String(r[cm['Customer ID']-1]||'').trim()===customerId){customerRow=r;break;}}
  if(!customerRow)throw new Error('Customer not found.');

  const storedLast=AQBParseRetieDate(customerRow[cm['Last Retie Date']-1]);
  const storedNext=AQBParseRetieDate(customerRow[cm['Next Retie Date']-1]);
  const suppliedText=String(payload.lastRetieDate||'').trim();
  let lastRetie=null,nextRetie=null,reminderDate=null,historySource='';

  // A staff-supplied Last Retie Date is an explicit correction and recalculates the due date.
  if(suppliedText){
    lastRetie=AQBParseDateFromClient(suppliedText);
    if(lastRetie>new Date())throw new Error('Last retie date cannot be in the future.');
    const d=AQBCalculateRetieDates(lastRetie);
    nextRetie=AQBParseDateFromClient(d.nextRetieDate);reminderDate=AQBParseDateFromClient(d.reminderDate);historySource='provided Last Retie Date';
  // Otherwise use stored history. The last completed retie date controls cycle age; Next Retie Date remains the due-date record.
  }else if(storedNext){
    nextRetie=new Date(storedNext);nextRetie.setHours(0,0,0,0);
    lastRetie=storedLast?new Date(storedLast):null;
    reminderDate=new Date(nextRetie);reminderDate.setDate(reminderDate.getDate()-CONFIG.RETIE_REMINDER_DAYS);
    historySource='customer Next Retie Date';
  }else if(storedLast){
    lastRetie=new Date(storedLast);lastRetie.setHours(0,0,0,0);
    const d=AQBCalculateRetieDates(lastRetie);
    nextRetie=AQBParseDateFromClient(d.nextRetieDate);reminderDate=AQBParseDateFromClient(d.reminderDate);historySource='customer Last Retie Date';
  }else{
    nextRetie=new Date();nextRetie.setHours(0,0,0,0);
    reminderDate=new Date(nextRetie);reminderDate.setDate(reminderDate.getDate()-CONFIG.RETIE_REMINDER_DAYS);
    historySource='today fallback';
  }

  const daysSinceLastRetie=lastRetie?AQBGetDaysSinceDate(lastRetie):null;
  const cycleAgeDays=daysSinceLastRetie!==null?daysSinceLastRetie:AQBGetDaysSinceDate(nextRetie);
  const overdue=cycleAgeDays!==null && cycleAgeDays>CONFIG.RETIE_DAYS;
  if(cycleAgeDays!==null && cycleAgeDays>CONFIG.AUTO_BOOK_EXISTING_RETIE_MAX_DAYS){
    return {success:true,eligible:false,overdue:true,daysOverdue:cycleAgeDays,daysSinceLastRetie:daysSinceLastRetie,lastRetieDate:lastRetie?AQBFormatDateForClient(lastRetie):'',nextRetieDate:AQBFormatDateForClient(nextRetie),reminderDate:reminderDate?AQBFormatDateForClient(reminderDate):'',historySource,appointment:null,message:'This client is '+cycleAgeDays+' days since the last completed retie and is overdue. The missed retie due date was '+AQBFormatDateForClient(nextRetie)+'. No automatic reappointment will be created. You may save now or choose a manual appointment date/time.'};
  }

  const slot=AQBFindNextAvailableRetieSlot(nextRetie,180);
  if(!slot)return {success:true,eligible:true,overdue:overdue,daysOverdue:Math.max(0,cycleAgeDays||0),daysSinceLastRetie:daysSinceLastRetie,lastRetieDate:lastRetie?AQBFormatDateForClient(lastRetie):'',nextRetieDate:AQBFormatDateForClient(nextRetie),reminderDate:reminderDate?AQBFormatDateForClient(reminderDate):'',historySource,appointment:null,message:'No 3-hour retie slot is currently available within the automatic scheduling window. You may save now or choose a manual date and time.'};
  const todayKey=AQBFormatDateKey(new Date()),dueKey=AQBFormatDateKey(nextRetie);
  let message='The client is within 42 days of the last completed retie. The earliest available 3-hour slot has been selected.';
  if(historySource==='today fallback')message='Last completed retie history is not recorded. AQB will use today as the current due-date fallback and select the earliest available 3-hour slot.';
  else if(cycleAgeDays!==null)message='This client is '+cycleAgeDays+' days since the last completed retie and remains within the 42-day automatic scheduling window. The earliest available 3-hour slot has been selected.';
  else if(dueKey===todayKey)message='Retie is due today. The earliest available 3-hour slot has been selected.';
  return {success:true,eligible:true,overdue:overdue,daysOverdue:Math.max(0,cycleAgeDays||0),daysSinceLastRetie:daysSinceLastRetie,lastRetieDate:lastRetie?AQBFormatDateForClient(lastRetie):'',nextRetieDate:AQBFormatDateForClient(nextRetie),reminderDate:reminderDate?AQBFormatDateForClient(reminderDate):'',historySource,appointment:{appointmentDate:AQBFormatDateForClient(slot.date),appointmentStart:AQBFormatTimeForClient(slot.start),appointmentEnd:AQBFormatTimeForClient(slot.end)},message:message};
}

function AQBBuildAppointmentTypeKey(service){
  const s=String(service||'').trim();
  if(AQBIsSisterlocksRetieService(s))return 'SISTERLOCKS_RETIE';
  if(/sisterlocks/i.test(s)&&/install/i.test(s))return 'SISTERLOCKS_INSTALLATION';
  if(/microlocs/i.test(s)&&/retie|retight|maintenance/i.test(s))return 'MICROLOCS_RETIE';
  return 'SERVICE:'+s.toLowerCase().replace(/\s+/g,' ');
}

function AQBFindActiveSameTypeAppointments(customerId,service,excludeAppointmentId){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<2)return [];
  const rows=s.getRange(2,1,n-1,17).getValues(),typeKey=AQBBuildAppointmentTypeKey(service),today=new Date();today.setHours(0,0,0,0),out=[];
  rows.forEach(function(r,i){
    const id=String(r[0]||'').trim();if(excludeAppointmentId&&id===String(excludeAppointmentId))return;
    if(String(r[1]||'').trim()!==String(customerId||'').trim())return;
    if(AQBBuildAppointmentTypeKey(r[4])!==typeKey)return;
    const status=String(r[8]||'').trim().toUpperCase();
    if(['COMPLETED','CANCELLED','NO SHOW'].includes(status))return;
    const d=AQBParseRetieDate(r[5]);if(!d)return;d.setHours(0,0,0,0);if(d<today)return;
    out.push({rowIndex:i+2,row:r,appointmentId:id,appointmentDate:d,calendarEventId:String(r[11]||''),status:status,service:String(r[4]||'')});
  });
  out.sort(function(a,b){return a.appointmentDate-b.appointmentDate;});
  return out;
}

function AQBAssertNoDuplicateActiveAppointment(customerId,service,excludeAppointmentId){
  const matches=AQBFindActiveSameTypeAppointments(customerId,service,excludeAppointmentId);
  if(!matches.length)return true;
  const a=matches[0];
  throw new Error('This customer already has an active '+String(service||'service')+'-type appointment ('+a.appointmentId+') on '+AQBFormatDateForClient(a.appointmentDate)+'. Reschedule or cancel the existing appointment instead of creating a duplicate.');
}

function AQBEnsureCalendarForAppointmentRow(r){
  const appointmentId=String(r[0]||'').trim(),eventId=String(r[11]||'').trim();
  try{
    const calendar=CalendarApp.getCalendarById(CONFIG.CALENDAR_ID);
    if(calendar&&eventId){const ev=calendar.getEventById(eventId);if(ev)return eventId;}
  }catch(ignore){}
  const created=AQBCreateGoogleCalendarEvent(appointmentId,String(r[1]||''),String(r[2]||''),String(r[3]||''),String(r[4]||''),r[6],r[7],String(r[13]||''),Number(r[16]||r[14]||0),AQBGetCustomerLocationById(String(r[1]||'')),'SCHEDULED');
  r[11]=created||'';
  return r[11];
}

function AQBCancelDuplicateAppointmentRow(sheet,rowIndex,r,canonicalAppointmentId){
  const id=String(r[0]||'').trim(),eventId=String(r[11]||'').trim();
  if(eventId){try{AQBDeleteCalendarEvent(eventId,id,r[5]);}catch(ignore){}}
  r[8]='CANCELLED';r[11]='';
  const note=String(r[13]||'').trim(),msg='Duplicate same-type schedule automatically cancelled; canonical appointment '+canonicalAppointmentId+'.';
  r[13]=note?(note+' '+msg):msg;
  sheet.getRange(rowIndex,1,1,17).setValues([r]);
  AQBLogAudit('AQB_DUPLICATE_APPOINTMENT_CANCELLED','Appointment',id,msg);
}

function AQBSortAppointmentsCurrentToOld(){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<3)return;
  const rows=s.getRange(2,1,n-1,17).getValues();
  rows.sort(function(a,b){
    const ad=AQBParseRetieDate(a[5]),bd=AQBParseRetieDate(b[5]),at=ad?ad.getTime():-8640000000000000,bt=bd?bd.getTime():-8640000000000000;
    if(bt!==at)return bt-at;
    const as=AQBParseRetieDate(a[6]),bs=AQBParseRetieDate(b[6]);return (bs?bs.getTime():0)-(as?as.getTime():0);
  });
  s.getRange(2,1,rows.length,17).setValues(rows);
}

/** Manual-only Customers sort. Native Sheets sorting never rewrites a stale full-row snapshot.
 * The helper key places valid Next Retie Dates first, blanks last. No triggers or
 * appointment/retie workers may invoke this function.
 */
function AQBSortCustomersByAppointmentDate(){
  AQBRequireAdmin();
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const sh=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=sh.getLastRow();
    if(n<3)return {success:true,rows:Math.max(0,n-1)};
    const m=AQBBuildHeaderMap(sh),dateCol=m['Next Retie Date'];
    if(!dateCol)throw new Error('Next Retie Date header missing.');
    const width=sh.getLastColumn(),keyCol=width+1;
    if(sh.getMaxColumns()<keyCol)sh.insertColumnAfter(width);
    const vals=sh.getRange(2,dateCol,n-1,1).getValues();
    const keys=vals.map(function(r){return [AQBParseRetieDate(r[0])?0:1];});
    // Temporary helper is removed in finally; the original data columns are never
    // copied back from JavaScript, so concurrent stale snapshots cannot overwrite them.
    sh.getRange(1,keyCol).setValue('AQB_TEMP_SORT_KEY');
    try{
      sh.getRange(2,keyCol,keys.length,1).setValues(keys);
      sh.getRange(2,1,n-1,keyCol).sort([{column:keyCol,ascending:true},{column:dateCol,ascending:false}]);
    }finally{sh.deleteColumn(keyCol);}
    AQBLogAudit('AQB_MANUAL_CUSTOMER_SORT','Customer','Customers','Sorted by Next Retie Date descending, blanks last using native sort.');
    return {success:true,rows:n-1,sort:'Next Retie Date descending; blanks last'};
  }finally{lock.releaseLock();}
}

function AQBCreateAutomaticRetieAppointmentForCustomer(customerRow,m,sendBookingWhatsApp){
  sendBookingWhatsApp=sendBookingWhatsApp===true;
  const dueDate=AQBParseRetieDate(customerRow[m['Next Retie Date']-1]); if(!dueDate)return null;
  const customerId=String(customerRow[m['Customer ID']-1]||''),customerService=String(customerRow[m['Service']-1]||'').trim();
  if(!AQBIsSisterlocksRetieService(customerService))return null;
  // Do not schedule against missing or duplicated customer identities. Never create a customer here.
  AQBAssertSingleCustomerMatch(customerId);
  const service=AQBGetAutomaticRetieService(customerService);
  // A stale Yes flag must not suppress a missing appointment.
  // Check actual active bookings first; the caller reconciles the flag.
  const sameType=AQBFindActiveSameTypeAppointments(customerId,service,null);
  const existing=sameType.length?{appointmentId:sameType[0].appointmentId,calendarEventId:sameType[0].calendarEventId,appointmentDate:AQBFormatDateForClient(sameType[0].appointmentDate),startTime:AQBFormatTimeForClient(sameType[0].row[6]),endTime:AQBFormatTimeForClient(sameType[0].row[7]),status:sameType[0].status}:AQBFindFutureAppointmentForCustomer(customerId,service);
  if(existing){
    // Older automatic-retie appointments may predate the WhatsApp marker. If so,
    // send the confirmation once and record the successful send.
    const markerKey='AQB_AUTO_RETIE_WA_SENT_'+existing.appointmentId;
    let whatsapp=null;
    if(sendBookingWhatsApp && !PropertiesService.getScriptProperties().getProperty(markerKey)){
      try{
        const customerFirst=AQBGetCustomerFirstName(customerRow,m);
        whatsapp=AQBSendBookingWhatsAppForAppointment({appointmentId:existing.appointmentId,customerId:customerId,customerName:String(customerRow[m['Customer Name']-1]||''),firstName:customerFirst,whatsappNumber:String(customerRow[m['WhatsApp Number']-1]||''),service:service,appointmentDate:existing.appointmentDate,startTime:existing.startTime,endTime:existing.endTime},customerFirst);
        if(whatsapp&&whatsapp.sent)PropertiesService.getScriptProperties().setProperty(markerKey,new Date().toISOString());
      }catch(e){AQBLogAudit('WHATSAPP_ERROR','Appointment',existing.appointmentId,e.message);whatsapp={sent:false,error:e.message};}
    }
    return Object.assign({},existing,{whatsapp:whatsapp});
  }

  // Automatic Sisterlocks reties always use a 3-hour block.
  const durationMinutes=180;
  const slot=AQBFindNextAvailableRetieSlot(dueDate,durationMinutes);
  if(!slot)throw new Error('No 3-hour automatic retie slot was available within the scheduling window.');

  const id=AQBGenerateAppointmentID(),name=String(customerRow[m['Customer Name']-1]||''),phone=String(customerRow[m['WhatsApp Number']-1]||''),location=String(customerRow[m['Customer Location']-1]||'').trim();
  const pricing=AQBFindServicePricing(service);
  const amountDue=AQBGetPublicStartingPriceNumber(pricing.price);
  const calendarEventId=AQBCreateGoogleCalendarEvent(id,customerId,name,phone,service,slot.start,slot.end,'Automatic next retie appointment — 3 hours',amountDue,location,'SCHEDULED');
  const row=[id,customerId,name,phone,service,slot.date,slot.start,slot.end,'SCHEDULED','Pending','Pending',calendarEventId,'Automatic Retie','Automatically created; 3-hour retie block.', amountDue||'', pricing.price||'', amountDue||''];
  AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS).appendRow(row);
  AQBLogAudit('AUTO_CREATE_RETIE','Appointment',id,'Automatic 3-hour next retie created for '+customerId+' on '+AQBFormatDateForClient(slot.date)+' at '+AQBFormatTimeForClient(slot.start)+'; Calendar event '+calendarEventId+'.');
  try{AQBSortAppointmentsCurrentToOld();}catch(ignore){}
  let whatsapp=null;
  if(sendBookingWhatsApp){
    try{
      const customerFirst=AQBGetCustomerFirstName(customerRow,m);
      whatsapp=AQBSendBookingWhatsAppForAppointment({
        appointmentId:id,customerId:customerId,customerName:name,firstName:customerFirst,
        whatsappNumber:phone,service:service,appointmentDate:AQBFormatDateForClient(slot.date),
        startTime:AQBFormatTimeForClient(slot.start),endTime:AQBFormatTimeForClient(slot.end)
      },customerFirst);
      if(whatsapp&&whatsapp.sent)PropertiesService.getScriptProperties().setProperty('AQB_AUTO_RETIE_WA_SENT_'+id,new Date().toISOString());
    }catch(e){
      AQBLogAudit('WHATSAPP_ERROR','Appointment',id,e.message);
      whatsapp={sent:false,error:e.message};
    }
  }
  return {appointmentId:id,calendarEventId,appointmentDate:AQBFormatDateForClient(slot.date),startTime:AQBFormatTimeForClient(slot.start),endTime:AQBFormatTimeForClient(slot.end),status:'SCHEDULED',whatsapp};
}

function AQBFindNextAvailableRetieSlot(preferredDate,durationMinutes){
  const startDate=new Date(preferredDate);startDate.setHours(0,0,0,0);
  const now=new Date();
  const todayStart=new Date(now);todayStart.setHours(0,0,0,0);
  if(startDate<todayStart)startDate.setTime(todayStart.getTime());
  // Automatic reties are internal scheduling and may start from 07:00, but never
  // run past the 19:00 business close. Search in 15-minute increments.
  for(let dayOffset=0;dayOffset<=30;dayOffset++){
    const date=new Date(startDate);date.setDate(date.getDate()+dayOffset);date.setHours(0,0,0,0);
    if(date.getDay()===0)continue;
    for(let minute=7*60;minute+durationMinutes<=19*60;minute+=15){
      const start=new Date(date);start.setHours(Math.floor(minute/60),minute%60,0,0);
      const end=new Date(start);end.setMinutes(end.getMinutes()+durationMinutes);
      if(start<=now)continue;
      if(!AQBIsAppointmentSlotTaken(date,start,end,null))return {date,start,end};
    }
  }
  return null;
}

function AQBFindFutureAppointmentForCustomer(customerId,service){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<2)return null;
  const rows=s.getRange(2,1,n-1,17).getValues(),now=new Date();
  for(const r of rows){
    if(String(r[1])!==String(customerId)||String(r[4]||'').trim()!==String(service||'').trim())continue;
    const status=String(r[8]||'').trim().toUpperCase(),d=r[5] instanceof Date?r[5]:new Date(r[5]);
    if(['COMPLETED','CANCELLED','NO SHOW'].includes(status)||isNaN(d.getTime()))continue;
    if(d>=new Date(now.getFullYear(),now.getMonth(),now.getDate()))return {appointmentId:String(r[0]||''),calendarEventId:String(r[11]||''),appointmentDate:AQBFormatDateForClient(d),startTime:AQBFormatTimeForClient(r[6]),endTime:AQBFormatTimeForClient(r[7]),status:status};
  }
  return null;
}

function AQBRunAutomaticRetieAppointments(){
  const lock=LockService.getScriptLock();lock.waitLock(30000);try{
    const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow();if(n<2)return {created:0,skipped:0};const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();let created=0,skipped=0;
    const idColumn=m['Customer ID']-1;
    const counts={};rows.forEach(x=>{const id=String(x[idColumn]||'').trim();if(id)counts[id]=(counts[id]||0)+1;});
    rows.forEach(function(snapshot,i){
      const cid=String(snapshot[idColumn]||'').trim();
      if(!cid||counts[cid]!==1){skipped++;AQBLogAudit('RETIE_WORKER_IDENTITY_HELD','Customer',cid||'(blank)','Missing or duplicate Customer ID; no customer row created.');return;}
      // Re-read current row by ID because previous iterations can sort Customers.
      const live=s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues();
      const matches=live.map((v,j)=>({v,j})).filter(x=>String(x.v[idColumn]||'').trim()===cid);
      if(matches.length!==1){skipped++;return;}
      const r=matches[0].v,liveRow=matches[0].j+2;
      const service=String(r[m['Service']-1]||'').trim();
      if(!AQBIsSisterlocksService(service) || AQBIsConsultationService(service)){skipped++;return;}
      const last=AQBParseRetieDate(r[m['Last Retie Date']-1]);
      let next=AQBParseRetieDate(r[m['Next Retie Date']-1]);
      if(String(r[m['Next Appointment Created']-1]||'').trim().toLowerCase()==='yes'){
        // Reconcile the flag against an actual active same-type booking.
        // Never create a duplicate when the appointment still exists.
        const customerId=String(r[m['Customer ID']-1]||'').trim();
        const retieService=AQBGetAutomaticRetieService(service);
        const active=AQBFindActiveSameTypeAppointments(customerId,retieService,null);
        const future=active.length?null:AQBFindFutureAppointmentForCustomer(customerId,retieService);
        if(active.length||future){skipped++;return;}
        r[m['Next Appointment Created']-1]='No';
        s.getRange(liveRow,m['Next Appointment Created']).setValue('No');
        AQBLogAudit('RETIE_STALE_FLAG_CLEARED','Customer',customerId,
          'Next Appointment Created was Yes, but no active same-type booking exists.');
      }
      if(!next){
        if(last){
          const c=AQBCalculateRetieDates(last);
          next=AQBParseDateFromClient(c.nextRetieDate);
          r[m['Next Retie Date']-1]=next;
          r[m['Reminder Date']-1]=AQBParseDateFromClient(c.reminderDate);
        }else{
          next=new Date(); next.setHours(0,0,0,0);
          r[m['Next Retie Date']-1]=next;
          const reminder=new Date(next);reminder.setDate(reminder.getDate()-CONFIG.RETIE_REMINDER_DAYS);
          r[m['Reminder Date']-1]=reminder;
        }
      }
      const cycleAgeDays=last?AQBGetDaysSinceDate(last):AQBGetDaysSinceDate(next);
      // Automatic scheduling is anchored to the last completed retie. Once more than
      // 42 days have passed, preserve the missed due date and do not auto-create.
      if(cycleAgeDays!==null && cycleAgeDays>CONFIG.AUTO_BOOK_EXISTING_RETIE_MAX_DAYS){skipped++;return;}
      const a=AQBCreateAutomaticRetieAppointmentForCustomer(r,m);
      if(a){
        r[m['Next Appointment Created']-1]='Yes';
        // Re-resolve the row after the appointment helper sorts Customers.
        const refreshed=s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues();
        const now=refreshed.map((v,j)=>({v,j})).filter(x=>String(x.v[idColumn]||'').trim()===cid);
        if(now.length!==1)throw new Error('Customer identity changed after retie booking: '+cid);
        s.getRange(now[0].j+2,m['Next Appointment Created']).setValue('Yes');
        created++;
      }else skipped++;
    });
    return {created,skipped};
  }finally{lock.releaseLock();}
}

function AQBGetActualCompletionDateFromAppointment(row){
  // Only explicit, saved service-completion evidence qualifies. Booking date is NOT evidence.
  const notes=String(row&&row[13]||'');
  const found=notes.match(/\[AQB_ACTUAL_COMPLETION_DATE:(\d{4}-\d{2}-\d{2})\]/g);
  if(!found||!found.length)return null;
  const key=found[found.length-1].match(/(\d{4}-\d{2}-\d{2})/)[1];
  const d=AQBParseDateFromClient(key);
  if(!d||isNaN(d.getTime()))return null;
  return d;
}

