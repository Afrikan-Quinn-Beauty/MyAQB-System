function AQBGetCurrentApprovedTrendingItems(items){
  const list=Array.isArray(items)?items:[],byId={},byKey={};
  list.forEach(function(x){const id=String(x.catalogueId||'').trim();const key=String(x.category||'').trim().toLowerCase()+'|'+String(x.name||'').trim().toLowerCase();if(id)byId[id]=x;if(key)byKey[key]=x;});
  const trends=AQBGetTrendCatalogue(false),out=[],seen={};
  trends.forEach(function(t){
    if(String(t.trendStatus||'').toUpperCase()!=='ACTIVE')return;
    const tid=String(t.catalogueId||'').trim();
    const key=String(t.category||'').trim().toLowerCase()+'|'+String(t.styleName||'').trim().toLowerCase();
    const x=(tid&&byId[tid])||byKey[key];
    if(!x)return;
    const id=String(x.catalogueId||key).trim();
    if(seen[id])return; seen[id]=true;
    out.push(Object.assign({},x,{isTrend:true,featured:'YES',trendStatus:'ACTIVE',trendSource:t.source||x.trendSource||'',trendStart:t.trendStart||x.trendStart||'',trendEnd:t.trendEnd||x.trendEnd||'',collectionIds:t.collectionIds||x.collectionIds||''}));
  });
  return out.sort(function(a,b){return String(a.name).localeCompare(String(b.name));});
}

