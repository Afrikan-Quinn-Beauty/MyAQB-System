  return rows.map(r=>AQBBuildCustomerObject(r,m,nextMap)).filter(x=>String(x.customerId||'').trim()&&!AQBIsCustomerArchived_(x.customerId)).sort((a,b)=>{
    const aHas=!!String(a.nextAppointment||'').trim(), bHas=!!String(b.nextAppointment||'').trim();
    if(aHas!==bHas)return aHas?-1:1;
    if(aHas&&bHas){
      const ap=String(a.nextAppointment||''),bp=String(b.nextAppointment||'');
      const byDate=ap.localeCompare(bp); if(byDate!==0)return byDate;
    }
    return String(a.customerName||'').localeCompare(String(b.customerName||''),undefined,{sensitivity:'base'});
  }).slice(0,500);
}

