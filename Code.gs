function AQBSetOpportunityStatus(opportunityId,status,note){
  const user=AQBRequireAdmin();
  // Accept both the canonical positional API and the object payload used by older clients.
  if(opportunityId && typeof opportunityId==='object' && !Array.isArray(opportunityId)){
    const payload=opportunityId;
    opportunityId=payload.opportunityId;
    status=payload.status;
    note=payload.note;
  }
  status=String(status||'').trim().toUpperCase();
  const aliases={APPROVE:'APPROVED',IGNORE:'DECLINED',REJECT:'DECLINED',DEFER:'WATCH'};
  status=aliases[status]||status;
  if(['PENDING','APPROVED','WATCH','DECLINED','APPLIED'].indexOf(status)<0)throw new Error('Invalid opportunity status. Use APPROVED, WATCH, DECLINED, or APPLIED.');
  const s=AQBGetSheet(CONFIG.SHEETS.OPPORTUNITIES),m=AQBBuildHeaderMap(s),n=s.getLastRow();
  for(let i=2;i<=n;i++){
    const r=s.getRange(i,1,1,s.getLastColumn()).getValues()[0];
    if(String(r[m['Opportunity ID']-1]||'').trim()!==String(opportunityId||'').trim())continue;
    r[m['Status']-1]=status;r[m['Updated At']-1]=new Date();
    s.getRange(i,1,1,s.getLastColumn()).setValues([r]);
    try{AQBLogAudit('AQB_OPPORTUNITY_STATUS','Trend Intelligence',opportunityId,user.email+' set opportunity to '+status+(note?': '+note:''));}catch(ignore){}
    return {success:true,opportunityId:opportunityId,status:status};
  }
  throw new Error('AQB opportunity not found.');
}

