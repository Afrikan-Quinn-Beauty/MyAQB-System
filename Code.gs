function AQBGenerateCustomerVariantsForRecord(catalogueId,service,category,description,photoBrief,row,cm,variantIndex){
  const signature=AQBGetCatalogueVariantVisualSignature(service,category,description,photoBrief,row,cm),
        evidence=[service,description,AQBGetCataloguePositivePhotoBrief(photoBrief)].concat(AQBGetCatalogueExistingVariantLanguage(row,cm,service)).join(' | '),
        variants=[],basis=[],sources=[],serviceRows=(variantIndex.service[catalogueId]||[]),
        familyRows=(signature.recordType==='STYLE'&&signature.family)?(variantIndex.family[String(signature.family).toUpperCase()]||[]):[];

  serviceRows.forEach(function(v){
    if(!AQBMatchCatalogueVariantRule(v,evidence))return;
    variants.push(v.variantName);sources.push(v.sourceName||v.sourceType||'SERVICE');
  });
  familyRows.forEach(function(v){
    if(!AQBMatchCatalogueVariantRule(v,evidence))return;
    variants.push(v.variantName);sources.push(v.sourceName||v.sourceType||'FAMILY');
  });

  const clean=AQBGetUniqueCatalogueVariants(variants).filter(function(v){return AQBNormalizeCatalogueVariantText(v)!==AQBNormalizeCatalogueVariantText(service);}).slice(0,20);
  const uniqueSources=AQBGetUniqueCatalogueVariants(sources);
  basis.push('ID='+catalogueId);
  basis.push('TYPE='+signature.recordType);
  if(signature.family)basis.push('FAMILY='+String(signature.family).toUpperCase());
  if(signature.size)basis.push('SIZE='+signature.size.toUpperCase());
  if(signature.count)basis.push('COUNT='+signature.count);
  if(signature.pattern.length)basis.push('PATTERN='+signature.pattern.join(',').toUpperCase());
  if(signature.construction.length)basis.push('CONSTRUCTION='+signature.construction.join(',').toUpperCase());
  if(signature.finish.length)basis.push('FINISH='+signature.finish.join(',').toUpperCase());
  if(signature.action.length)basis.push('ACTION='+signature.action.join(',').toUpperCase());
  basis.push('SOURCE=SERVICEVARIANTS');
  if(uniqueSources.length)basis.push('REFERENCES='+uniqueSources.slice(0,5).join(', '));

  let status='REVIEW';
  const serviceMatches=serviceRows.filter(function(v){return AQBMatchCatalogueVariantRule(v,evidence)&&AQBNormalizeCatalogueVariantText(v.variantName)!==AQBNormalizeCatalogueVariantText(service);}).length;
  const familyMatches=familyRows.filter(function(v){return AQBMatchCatalogueVariantRule(v,evidence)&&AQBNormalizeCatalogueVariantText(v.variantName)!==AQBNormalizeCatalogueVariantText(service);}).length;
  if(clean.length&&serviceMatches>0)status='HIGH';
  else if(clean.length&&familyMatches>0)status='MEDIUM';
  if(signature.recordType==='SERVICE'&&clean.length&&serviceMatches>0)status='HIGH';

  return {variants:clean,status:status,basis:basis.join(' | '),signature:signature,serviceMatches:serviceMatches,familyMatches:familyMatches,sources:uniqueSources};
}

function AQBPreviewCustomerProfileConsolidation(){
  AQBRequireAdmin();
  const sh=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),hm=AQBBuildHeaderMap(sh),n=sh.getLastRow();
  const rows=n>1?sh.getRange(2,1,n-1,sh.getLastColumn()).getValues():[];
  const groups={};
  rows.forEach(function(r,i){const id=String(r[hm['Customer ID']-1]||'').trim().toUpperCase();if(id)(groups[id]||(groups[id]=[])).push({rowNumber:i+2,row:r});});
  const duplicates=Object.keys(groups).filter(id=>groups[id].length>1).map(function(id){
    const entries=groups[id];
    const phones=[...new Set(entries.map(x=>AQBNormalizePhone(x.row[hm['WhatsApp Number']-1])))];
    const lastDates=entries.map(function(x){const d=AQBParseRetieDate(x.row[hm['Last Retie Date']-1]);return {row:x.rowNumber,date:d?AQBFormatDateKey(d):''};});
    const eligible=phones.length===1&&!!phones[0]&&AQBIsValidPhone(phones[0]);
    return {customerId:id,rows:entries.map(x=>x.rowNumber),phoneConsistent:eligible,lastRetieDates:lastDates,
      status:eligible?'REVIEW':'BLOCKED_PHONE_CONFLICT'};
  });
  const result={version:'V16.21.16.8.51',readOnly:true,writes:0,checked:rows.length,duplicates:duplicates};
  Logger.log('=== AQB CUSTOMER PROFILE CONSOLIDATION PREVIEW ===');Logger.log(JSON.stringify(result));
  return result;
}

function AQBCommitCustomerProfileConsolidation(options){
  AQBRequireAdmin();options=options||{};
  if(options.confirm!=='CONSOLIDATE_CUSTOMER_PROFILES')throw new Error('Explicit confirmation required.');
  const ids=[...new Set((options.customerIds||[]).map(x=>String(x||'').trim().toUpperCase()))];
  if(!ids.length||ids.length>10)throw new Error('Select 1–10 explicit Customer IDs.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const sh=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),hm=AQBBuildHeaderMap(sh),cols=sh.getLastColumn(),n=sh.getLastRow();
    const rows=n>1?sh.getRange(2,1,n-1,cols).getValues():[];
    const plan=[];
    ids.forEach(function(id){
      const matches=[];rows.forEach((r,i)=>{if(String(r[hm['Customer ID']-1]||'').trim().toUpperCase()===id)matches.push({rowNumber:i+2,row:r});});
      if(matches.length<2)throw new Error(id+': no duplicate rows; no changes made.');
      const phones=[...new Set(matches.map(x=>AQBNormalizePhone(x.row[hm['WhatsApp Number']-1])))];
      if(phones.length!==1||!phones[0]||!AQBIsValidPhone(phones[0]))throw new Error(id+': conflicting WhatsApp numbers; abort.');
      const candidates=matches.map(function(x){const d=AQBParseRetieDate(x.row[hm['Last Retie Date']-1]);return {entry:x,date:d};});
      candidates.sort(function(a,b){return (b.date?b.date.getTime():0)-(a.date?a.date.getTime():0)||a.entry.rowNumber-b.entry.rowNumber;});
      const selected=candidates[0];
      const merged=selected.entry.row.slice();
      // Keep the oldest row position; copy the most recent current-state profile to it.
      const first=matches[0].rowNumber;
      const last=selected.date;
      if(last){
        const calc=AQBCalculateRetieDates(last);
        merged[hm['Next Retie Date']-1]=AQBParseDateFromClient(calc.nextRetieDate);
        merged[hm['Reminder Date']-1]=AQBParseDateFromClient(calc.reminderDate);
      }
      // Prefer completed-profile state without adding visits together.
      if(hm['Total Visits'])merged[hm['Total Visits']-1]=Math.max(...matches.map(x=>Number(x.row[hm['Total Visits']-1]||0)));
      if(hm['Next Appointment Created']&&matches.some(x=>String(x.row[hm['Next Appointment Created']-1]).trim()==='Yes'))merged[hm['Next Appointment Created']-1]='Yes';
      plan.push({id:id,first:first,merged:merged,remove:matches.slice(1).map(x=>x.rowNumber),source:selected.entry.rowNumber});
    });
    // Confirm all records and identities before any write. Preserve full original rows in a sheet backup.
    const ss=AQBGetSpreadsheet();const backup=sh.copyTo(ss);
    const backupName='Customers BACKUP '+Utilities.formatDate(new Date(),'Africa/Nairobi','yyyyMMdd_HHmmss');backup.setName(backupName);
    SpreadsheetApp.flush();
    plan.forEach(p=>sh.getRange(p.first,1,1,cols).setValues([p.merged]));
    [...new Set(plan.flatMap(p=>p.remove))].sort((a,b)=>b-a).forEach(row=>sh.deleteRow(row));
    const result={version:'V16.21.16.8.51',success:true,backupSheet:backupName,
      consolidated:plan.map(p=>({customerId:p.id,retainedOriginalRow:p.first,selectedStateSourceRow:p.source,removedRows:p.remove})),
      appointmentsChanged:0,paymentsChanged:0};
    AQBLogAudit('AQB_CUSTOMER_PROFILE_CONSOLIDATION','Customer',ids.join(','),JSON.stringify(result));
