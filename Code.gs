function AQBQueuePhotoPipelineIds(ids){
  const p=PropertiesService.getScriptProperties(),
    key='AQB_PHOTO_PIPELINE_QUEUE',
    cur={},manualHeld=AQBGetPhotoManualQueueGuardState();

  try{
    (JSON.parse(p.getProperty(key)||'[]')||[]).forEach(function(x){
      x=String(x||'').trim().toUpperCase();
      if(/^AQBCAT\d{3}$/.test(x)&&!manualHeld[x])cur[x]=1;
    });
  }catch(e){}

  (ids||[]).forEach(function(x){
    x=String(x||'').trim().toUpperCase();
    if(/^AQBCAT\d{3}$/.test(x)&&!manualHeld[x])cur[x]=1;
  });

  const out=Object.keys(cur).sort();
  p.setProperty(key,JSON.stringify(out));
  return out.length;
