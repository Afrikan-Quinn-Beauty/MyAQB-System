  });

  ['Customer Variant Names','Customer Variant Status','Customer Variant Basis'].forEach(function(h){sheet.getRange(2,cm[h],rows.length,1).setValues(rows.map(function(r){return [r[cm[h]-1]];}));});
  const result={
