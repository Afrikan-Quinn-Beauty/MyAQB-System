function AQBDarajaConfirmSettlement(paymentId,receipt,verifiedAmount,verifiedPhone,verificationReference){
 const admin=AQBRequireAdmin();const cfg=AQBDarajaConfig();if(!cfg.enabled)throw new Error('Daraja disabled');
 const ref=String(verificationReference||'').trim(),rcpt=String(receipt||'').trim().toUpperCase(),amount=Number(verifiedAmount),phone=AQBDarajaPhone(verifiedPhone);
 if(!/^[A-Z0-9]{8,24}$/.test(rcpt)||!ref||ref.length<8||!Number.isFinite(amount)||amount<=0)throw new Error('Independent settlement evidence, receipt and amount required');
 const lock=LockService.getScriptLock();lock.waitLock(25000);
 try{
  const c=AQBDarajaEnsure(),rows=AQBDarajaRows(c.ps,c.pm),matches=rows.filter(o=>String(AQBDarajaVal(o,c.pm,'Payment ID'))===String(paymentId));if(matches.length!==1)throw new Error('Payment ID not unique');const o=matches[0];
