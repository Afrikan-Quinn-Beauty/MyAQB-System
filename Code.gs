function AQBGetRegisteredWhatsAppTemplate(name,language){
  const s=AQBGetSheet(CONFIG.SHEETS.SETUP);
  const rows=s.getRange(30,4,Math.min(100,Math.max(1,s.getMaxRows()-29)),9).getValues();
  if(String(rows[0][0]||'').trim()!=='Template Name')throw new Error('AQB Setup template registry header missing at D30.');
  const matches=rows.slice(1).filter(function(r){return String(r[0]||'').trim()===name;});
  if(!matches.length)throw new Error('WhatsApp template not registered in Setup: '+name);
  const requested=String(language||'').trim();
  const row=requested?matches.find(function(r){return String(r[2]||'').trim()===requested;}):matches.find(function(r){return String(r[2]||'').trim()==='en_US';})||matches[0];
  if(!row)throw new Error('Template '+name+' has no registered language '+requested);
  if(!/^Active/i.test(String(row[3]||'')))throw new Error('Template '+name+' ['+row[2]+'] is not active in Setup: '+row[3]);
  return {name:name,language:String(row[2]),category:String(row[1]),bodyVariables:Number(row[4])};
}

function AQBResolveWhatsAppTemplate(templateName,languageCode){
  const name=String(templateName||'').trim();
  if(!name)throw new Error('WhatsApp template is not configured.');
  const registered=AQBGetRegisteredWhatsAppTemplate(name,languageCode);
  const templates=AQBGetMetaWhatsAppTemplates();
  const matches=templates.filter(function(t){return String(t.name||'').trim()===name && String(t.language||'').trim()===registered.language;});
  if(!matches.length)throw new Error('Meta does not contain registered WhatsApp template '+name+' ['+registered.language+'].');
  const approved=matches.filter(function(t){return String(t.status||'').toUpperCase()==='APPROVED';});
  if(!approved.length)throw new Error('WhatsApp template "'+name+'" exists in Meta, but no APPROVED language version was found. Available versions: '+matches.map(function(t){return String(t.language||'')+' ['+String(t.status||'')+']';}).join(', '));
  const preferred=approved[0];
  return {name:name,language:String(preferred.language||CONFIG.WHATSAPP_TEMPLATE_LANGUAGE_FALLBACK),status:String(preferred.status||''),category:String(preferred.category||'')};
}


/** Format customer-visible calendar dates without changing stored ISO dates. */
function AQBFormatCustomerFacingDate(value){
  if(value===null||value===undefined||value==='')return '';
  let date;
  if(value instanceof Date){date=value;}
  else {
    const raw=String(value).trim();
    const iso=raw.match(/^(\d{4})-(\d{2})-(\d{2})(?:[T\s].*)?$/);
    if(iso){
      date=new Date(Number(iso[1]),Number(iso[2])-1,Number(iso[3]),12,0,0);
      if(date.getFullYear()!==Number(iso[1])||date.getMonth()!==Number(iso[2])-1||date.getDate()!==Number(iso[3]))return raw;
    }else{
      // Do not guess ambiguous numeric dates or modify already-human-formatted text.
      return raw;
    }
  }
  if(isNaN(date.getTime()))return String(value);
  const tz='Africa/Nairobi';
  const day=Number(Utilities.formatDate(date,tz,'d'));
  const suffix=(day%100>=11&&day%100<=13)?'th':({1:'st',2:'nd',3:'rd'}[day%10]||'th');
  return Utilities.formatDate(date,tz,'EEEE')+' '+day+suffix+' '+Utilities.formatDate(date,tz,'MMMM yyyy');
}

/** Normalize only date positions in approved AQB template parameters, immediately before Meta submission. */
function AQBFormatWhatsAppTemplateDates_(templateName,components){
  const key=String(templateName||'').toLowerCase();
  const datePosition={
    aqb_sisterlocks_complete:1,
    aqb_appointment_confirmation:2,
    aqb_retie_reminder:1,
    aqb_retie_overdue:1,
    aqb_retie_overdue_21d:1,
    aqb_retie_overdue_42d:1
  };
  if(!Object.prototype.hasOwnProperty.call(datePosition,key))return components;
  return (components||[]).map(function(c){
    if(!c||c.type!=='body'||!Array.isArray(c.parameters))return c;
    const index=datePosition[key];
    const parameters=c.parameters.map(function(p,i){
      if(i!==index||!p||p.type!=='text')return p;
      return Object.assign({},p,{text:AQBFormatCustomerFacingDate(p.text)});
    });
    return Object.assign({},c,{parameters:parameters});
  });
}

function AQBSendWhatsAppTemplate(phone,templateName,languageCode,components){
  const contact=AQBResolveWhatsAppNumber(phone);
  if(!contact.valid)return {sent:false,skipped:true,reason:'Invalid/missing Kenyan WhatsApp number.',rawPhone:contact.raw,normalizedPhone:contact.normalized};
  const w=AQBGetWhatsAppSettings();if(!w.enabled)return {sent:false,skipped:true,reason:'WhatsApp automation is disabled.',normalizedPhone:contact.normalized};
  if(!w.phoneNumberId||!w.accessToken||!w.graphApiVersion||!w.businessAccountId) return {sent:false,skipped:true,reason:'WhatsApp credentials/WABA configuration are not complete.',normalizedPhone:contact.normalized};
  const resolved=AQBResolveWhatsAppTemplate(templateName,languageCode);
  const provided=(Array.isArray(components)?components:[]).filter(function(c){return c&&c.type==='body';});
  const params=provided.length&&Array.isArray(provided[0].parameters)?provided[0].parameters.length:0;
  const registry=AQBGetRegisteredWhatsAppTemplate(resolved.name,resolved.language);
  if(params!==registry.bodyVariables)throw new Error('Template '+resolved.name+' requires '+registry.bodyVariables+' body variables; got '+params);
  const url='https://graph.facebook.com/'+encodeURIComponent(w.graphApiVersion)+'/'+encodeURIComponent(w.phoneNumberId)+'/messages';
  const payload={messaging_product:'whatsapp',to:contact.normalized.replace('+',''),type:'template',template:{name:resolved.name,language:{code:resolved.language}}};
  const customerFacingComponents=AQBFormatWhatsAppTemplateDates_(resolved.name,components);
  if(Array.isArray(customerFacingComponents)&&customerFacingComponents.length)payload.template.components=customerFacingComponents;
  const res=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+w.accessToken},payload:JSON.stringify(payload),muteHttpExceptions:true});
  const code=res.getResponseCode(),body=res.getContentText();
  if(code<200||code>=300)throw new Error('WhatsApp Business API error ('+code+') using template '+resolved.name+' ['+resolved.language+']: '+body);
  return {sent:true,template:resolved,normalizedPhone:contact.normalized,response:JSON.parse(body)};
}

