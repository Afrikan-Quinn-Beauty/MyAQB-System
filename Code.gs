  const sync=AQBRefreshCatalogue();
  const dedupe=AQBCanonicalizeCatalogueSheet();
  const after=AQBGetCatalogueIntegrityReport();
  try{AQBLogAudit('CANONICALIZE_AQB_CATALOGUE','Catalogue','INTEGRITY',user.email+' canonicalized the Catalogue from Master Lists. Removed '+dedupe.removed+' duplicate Catalogue row(s); channel-eligible '+after.catalogue.eligibleForChannels+'.');}catch(ignore){}
  return {success:true,before:before, sync:sync, dedupe:dedupe, after:after, message:'AQB Catalogue canonicalization completed. Master Lists was not rewritten. Review duplicate Master Lists rows before any source-data cleanup.'};
}

