function AQBNormalizeMpesaExpressPhone(value){
  const v=String(value||'').replace(/[\s()-]/g,'');
  let digits=v.replace(/^\+/,'');
  if(/^0[17]\d{8}$/.test(digits))digits='254'+digits.slice(1);
  if(/^7\d{8}$/.test(digits)||/^1\d{8}$/.test(digits))digits='254'+digits;
  return /^254[17]\d{8}$/.test(digits)?digits:'';
}
/** Deliberately fail closed until authenticated Daraja initiation, callback validation,
