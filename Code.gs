}

function AQBRepairCompletedTasksCore(options){
  options=options||{};
  const sh=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=sh.getLastRow();
  const rows=n>1?sh.getRange(2,1,n-1,17).getValues():[];
  const issues=[];let checked=0,calendarCleared=0,calendarFailed=0,sisterlocksChecked=0;
  const latestByCustomer={};
  rows.forEach(function(r){
    if(String(r[8]||'').trim().toUpperCase()!=='COMPLETED')return;
    checked++;
    const id=String(r[0]||'').trim(),event=String(r[11]||'').trim();
    if(event&&!options.dryRun){
      try{if(AQBDeleteCalendarEvent(event,id,r[5])){if(AQBClearCompletedCalendarEventId(id,event))calendarCleared++;}
        else{calendarFailed++;issues.push(id+': calendar cleanup needs review');}}
      catch(e){calendarFailed++;issues.push(id+': calendar cleanup error '+String(e&&e.message||e));}
    }
    if(!AQBIsSisterlocksRetieService(String(r[4]||'')))return;
    sisterlocksChecked++;
    const actual=AQBGetActualCompletionDateFromAppointment(r);
    if(!actual){issues.push(id+': actual completion date not evidenced; held');return;}
    const cid=String(r[1]||'').trim();if(!cid){issues.push(id+': customer ID missing');return;}
    const old=latestByCustomer[cid];
    if(!old||actual.getTime()>old.date.getTime()||(actual.getTime()===old.date.getTime()&&id>old.id))
      latestByCustomer[cid]={id:id,date:actual};
  });
  const out={version:'V16.22.1.7',checked:checked,calendarCleared:calendarCleared,calendarFailed:calendarFailed,
    sisterlocksChecked:sisterlocksChecked,retieCyclesRepaired:0,nextAppointmentsRepaired:0,whatsAppsRepaired:0,
    scheduleStateChanges:0,customerProfileWrites:0,held:0,issues:issues,repairs:[]};
  if(options.calendarOnly!==true){
    Object.keys(latestByCustomer).sort().forEach(function(cid){
      const id=latestByCustomer[cid].id;
      try{
        const result=AQBRepairCompletedRetieByAppointment(id,{dryRun:options.dryRun===true,sendWhatsApp:options.sendWhatsApp!==false});
        out.repairs.push({customerId:cid,appointmentId:id,dryRun:result.dryRun===true,
          profileNeedsUpdate:result.profileNeedsUpdate,booked:result.booked||'',bookingError:result.bookingError||'',whatsApp:result.whatsApp||null});
        if(result.dryRun)return;
        if(result.profileNeedsUpdate){out.retieCyclesRepaired++;out.customerProfileWrites++;}
        if(result.booked)out.nextAppointmentsRepaired++;
        if(result.whatsApp&&result.whatsApp.status==='SUBMITTED')out.whatsAppsRepaired++;
        if(result.bookingError||result.whatsApp&&['FAILED','HELD_NO_BOOKING','HELD_UNCERTAIN'].includes(result.whatsApp.status)){
          out.held++;issues.push(id+': '+(result.bookingError||result.whatsApp.error||result.whatsApp.status));
        }
      }catch(e){out.held++;issues.push(id+': '+String(e&&e.message||e));}
    });
  }
  // A preview is strictly observational: never write an audit row or mutate a flag.
  if(options.dryRun===true){
    out.dryRun=true;
    out.staleAppointmentFlags=[];
    out.flagScanChecked=0;
    const customerSheet=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS);
    const customerMap=AQBBuildHeaderMap(customerSheet);
    const required=['Customer ID','Service','Next Appointment Created'];
    const missing=required.filter(function(h){return !customerMap[h];});
    if(missing.length){out.issues.push('Flag scan unavailable: missing customer headers '+missing.join(', '));}
    else if(customerSheet.getLastRow()>1){
      const customerRows=customerSheet.getRange(2,1,customerSheet.getLastRow()-1,customerSheet.getLastColumn()).getValues();
      const activeStatuses=['SCHEDULED','CONFIRMED','PENDING','RESCHEDULED'];
      const activeByCustomer={};
      rows.forEach(function(a){
        const status=String(a[8]||'').trim().toUpperCase();
        if(activeStatuses.indexOf(status)===-1)return;
        const cid=String(a[1]||'').trim();
        if(!cid||!AQBIsSisterlocksRetieService(String(a[4]||'')))return;
        (activeByCustomer[cid]||(activeByCustomer[cid]=[])).push(String(a[0]||'').trim());
      });
      customerRows.forEach(function(c,index){
        const cid=String(c[customerMap['Customer ID']-1]||'').trim();
        if(!cid||!AQBIsSisterlocksRetieService(String(c[customerMap['Service']-1]||'')))return;
        out.flagScanChecked++;
        const flag=String(c[customerMap['Next Appointment Created']-1]||'').trim().toLowerCase();
        const ids=activeByCustomer[cid]||[];
        if((flag==='yes'&&!ids.length)||(flag!=='yes'&&ids.length)){
          out.staleAppointmentFlags.push({row:index+2,customerId:cid,storedFlag:flag||'(blank)',activeRetieAppointmentIds:ids,expectedFlag:ids.length?'Yes':'No'});
        }
      });
    }
    out.staleAppointmentFlagCount=out.staleAppointmentFlags.length;
  }else{
    AQBLogAudit('AQB_COMPLETED_TASK_REPAIR_RUN','System','COMPLETED_TASK_REPAIR',JSON.stringify(out));
  }
  Logger.log('=== AQB UNIVERSAL COMPLETED RETIE REPAIR ===');Logger.log(JSON.stringify(out));return out;
}
