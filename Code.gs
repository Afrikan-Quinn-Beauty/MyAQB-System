function AQBAuditCustomerRetiePhotoDependenciesReadOnly(){
  AQBRequireAdmin();
  const ss=AQBGetSpreadsheet(),cs=ss.getSheetByName(CONFIG.SHEETS.CUSTOMERS),as=ss.getSheetByName(CONFIG.SHEETS.APPOINTMENTS);
  if(!cs||!as)throw new Error('Customers and Appointments sheets are required.');
  const cm=AQBBuildHeaderMap(cs),am=AQBBuildHeaderMap(as);
  const customers=cs.getLastRow()>1?cs.getRange(2,1,cs.getLastRow()-1,cs.getLastColumn()).getValues():[];
  const appointments=as.getLastRow()>1?as.getRange(2,1,as.getLastRow()-1,as.getLastColumn()).getValues():[];
  const byId={},byPhone={},issues=[],completionByCustomer={};
  customers.forEach(function(r,i){
    const id=String(r[cm['Customer ID']-1]||'').trim().toUpperCase();
    const phone=AQBNormalizePhone(r[cm['WhatsApp Number']-1]);
    if(id)(byId[id]||(byId[id]=[])).push(i+2);
    if(phone)(byPhone[phone]||(byPhone[phone]=[])).push({id:id,row:i+2});
    if(!id||!phone)issues.push({type:'MISSING_CUSTOMER_IDENTITY',row:i+2,id:id});
  });
  Object.keys(byId).forEach(function(id){if(byId[id].length>1)issues.push({type:'DUPLICATE_CUSTOMER_ID',customerId:id,rows:byId[id]});});
  Object.keys(byPhone).forEach(function(phone){const a=byPhone[phone];if(a.length>1)issues.push({type:'DUPLICATE_WHATSAPP_NUMBER',customerIds:a.map(x=>x.id),rows:a.map(x=>x.row)});});
  appointments.forEach(function(r,i){
    const status=String(r[am['Status']-1]||'').trim().toUpperCase();
    if(status!=='COMPLETED')return;
    const id=String(r[am['Customer ID']-1]||'').trim().toUpperCase();
    if(!id||!byId[id])issues.push({type:'COMPLETED_APPOINTMENT_MISSING_CUSTOMER',appointmentId:String(r[am['Appointment ID']-1]||''),customerId:id});
    const service=String(r[am['Service']-1]||'');
    if(!AQBIsSisterlocksRetieService(service))return;
    const actual=AQBGetActualCompletionDateFromAppointment(r);
    if(!actual){issues.push({type:'NO_ACTUAL_COMPLETION_DATE_EVIDENCE',appointmentId:String(r[am['Appointment ID']-1]||''),customerId:id});return;}
    const key=AQBFormatDateKey(actual);
    if(!completionByCustomer[id]||key>completionByCustomer[id].date)completionByCustomer[id]={date:key,appointmentId:String(r[am['Appointment ID']-1]||'')};
  });
  customers.forEach(function(r){
    const id=String(r[cm['Customer ID']-1]||'').trim().toUpperCase(),latest=completionByCustomer[id];
    if(!latest||!AQBIsSisterlocksRetieService(String(r[cm['Service']-1]||'')))return;
    const last=AQBParseRetieDate(r[cm['Last Retie Date']-1]),lastKey=last?AQBFormatDateKey(last):'';
    if(lastKey!==latest.date)issues.push({type:'LAST_RETIE_DIFFERS_FROM_LATEST_EVIDENCED_COMPLETION',customerId:id,actual:lastKey,expected:latest.date,appointmentId:latest.appointmentId});
  });
  const out={version:'V16.21.16.8.52',readOnly:true,writes:0,customersChecked:customers.length,appointmentsChecked:appointments.length,
    duplicateIds:issues.filter(x=>x.type==='DUPLICATE_CUSTOMER_ID').length,duplicatePhones:issues.filter(x=>x.type==='DUPLICATE_WHATSAPP_NUMBER').length,
    completionEvidenceCount:Object.keys(completionByCustomer).length,issues:issues,
    staticWarnings:['AQBSyncRetieDateAuthority uses future appointment dates as next-retie authority; do not use for completion-date repair.',
      'AQBRefreshAllCustomerRetieDates recalculates +42 days from the stored Last Retie Date (retains any stale Last Retie).',
      'Pexels network entry points throw PEXELS_RETIRED, but legacy helper definitions remain in Code.gs.']};
  Logger.log('=== AQB CUSTOMER / RETIE / PHOTO DEPENDENCY AUDIT (READ ONLY) ===');Logger.log(JSON.stringify(out));return out;
}

