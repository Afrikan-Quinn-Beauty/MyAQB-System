  const rec=foundCatalogue[0],r=rec.values,id=String(r[cm['Catalogue ID']-1]||'').trim().toUpperCase();
  if(!/^AQBCAT\d+$/.test(id))return {canResume:false,reason:'Catalogue identity missing or invalid; inspect existing record.'};
