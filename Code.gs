function AQBPromotePhotoToCatalogue(options){
  const VERSION='V16.21.16.8.26', opts=Array.isArray(options)?{ids:options}:options||{};
  const publish=opts.publish===true, ids=Array.isArray(opts.ids)?opts.ids.map(function(x){return String(x||'').trim().toUpperCase();}):[];
  if(publish&&(opts.confirm!==true||!ids.length||ids.length>18||new Set(ids).size!==ids.length))throw Error('EXPLICIT_SCOPED_PUBLICATION_REQUIRED: confirm:true, 1–18 unique IDs.');
  if(publish)AQBRequireCataloguePhotoManager();
  const lock=publish?LockService.getScriptLock():null;
  if(lock&&!lock.tryLock(30000))throw Error('Photo promotion busy');
  try{
    const ss=AQBGetSpreadsheet(),stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),cat=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),ledger=ss.getSheetByName('AQB Photo Approval Decisions');
    if(!stage||!cat||!ledger)throw Error('Current staging, Catalogue and approval ledger are all required');
    const sm=AQBBuildHeaderMap(stage),cm=AQBBuildHeaderMap(cat),lm=AQBBuildHeaderMap(ledger);
    function req(map,keys,sheet){keys.forEach(function(h){if(!map[h])throw Error(sheet+' missing required column: '+h);});}
    req(sm,['Catalogue ID','Candidate Image URL','Candidate Source','Photo Provenance','Qualification Status'],'Staging');
    req(cm,['Catalogue ID','Image URL','Image Source','Image Source URL','Image Status','Photo Qualification Status','Photo Provenance','Representative Image'],'Catalogue');
    req(lm,['Catalogue ID','Candidate Image URL','Decision','Legacy Hold','Visual Match Confirmed'],'Approval ledger');
    const at=function(r,m,k){return m[k]?String(r[m[k]-1]==null?'':r[m[k]-1]).trim():'';};
    function group(sheet,map){const o={};sheet.getDataRange().getValues().slice(1).forEach(function(r,i){const id=at(r,map,'Catalogue ID').toUpperCase();if(id)(o[id]||(o[id]=[])).push({r:r,n:i+2});});return o;}
    const staged=group(stage,sm),catalogue=group(cat,cm),approvals={};
    ledger.getDataRange().getValues().slice(1).forEach(function(r){const id=at(r,lm,'Catalogue ID').toUpperCase();if(id)approvals[id]=r;});
    // Legacy candidate holds and incumbent publication states are not new Studio-original authority.
    const all=ids.length?ids:Object.keys(staged).sort(),results=[],writes=[];
    const driveId=function(u){const m=String(u||'').match(/(?:[?&]id=|\/file\/d\/|\/d\/)([A-Za-z0-9_-]{15,})/);return m?m[1]:'';};
    for(const id of all){
      const st=staged[id]||[],ct=catalogue[id]||[],ar=approvals[id];let reason='READY';
      const sr=st.length===1?st[0].r:null,cr=ct.length===1?ct[0].r:null;
      if(!/^AQBCAT\d{3}$/.test(id)||ct.length!==1)reason='INVALID_CANONICAL_MAPPING';
      else if(st.length!==1)reason='AMBIGUOUS_STAGING';
      else if(at(sr,sm,'Candidate Source')!=='AQB Studio')reason='NOT_AQB_STUDIO';
      else if(!/AI.generated|representative|concept/i.test(at(sr,sm,'Photo Provenance')))reason='PROVENANCE_UNVERIFIED';
      else if(!driveId(at(sr,sm,'Candidate Image URL')))reason='ORIGINAL_DRIVE_FILE_REQUIRED';
      else if(!ar||at(ar,lm,'Decision').toUpperCase()!=='APPROVED'||at(ar,lm,'Candidate Image URL')!==at(sr,sm,'Candidate Image URL'))reason='CURRENT_APPROVAL_MISSING';
      // Studio current-original approval is the human qualification and authorization to
      // replace the old representative image in this explicit, operator-run workflow.
      // Obsolete legacy holds, incumbent Own Photo flags and prior Publication Status
      // are deliberately excluded. Historic fields and approval ledger remain intact.
      // Image-use permissions still remain an organizational responsibility.
      else if(sm['Preview File ID']&&driveId(at(sr,sm,'Candidate Image URL'))===at(sr,sm,'Preview File ID'))reason='PREVIEW_NOT_MASTER';
      else if(at(cr,cm,'Image URL')===at(sr,sm,'Candidate Image URL'))reason='ALREADY_CURRENT';
      if(reason==='READY')writes.push({id:id,row:ct[0].n,candidate:at(sr,sm,'Candidate Image URL'),sourceUrl:at(sr,sm,'Candidate Source URL')});
      results.push({id:id,status:reason,stagingRows:st.length,catalogueRows:ct.length,qualificationAuthority:(ar&&sr&&at(ar,lm,'Decision').toUpperCase()==='APPROVED'&&at(ar,lm,'Candidate Image URL')===at(sr,sm,'Candidate Image URL'))?'MATCHING_MANUAL_APPROVAL':'NONE'});
    }
    if(publish){
      if(results.some(function(r){return r.status!=='READY'&&r.status!=='ALREADY_CURRENT';}))throw Error('PROMOTION_PREFLIGHT_BLOCKED: '+JSON.stringify(results.filter(function(r){return r.status!=='READY'&&r.status!=='ALREADY_CURRENT';})));
      // Writes are restricted to photo presentation fields of existing canonical rows.
      writes.forEach(function(w){
        const fields={'Image URL':w.candidate,'Image Source':'AQB Studio','Image Source URL':w.sourceUrl,'Image Status':'Qualified Representative Image','Photo Qualification Status':'QUALIFIED','Photo Provenance':'AQB STUDIO — AI-GENERATED REPRESENTATIVE','Representative Image':'YES'};
        if(cm['Photo Candidate URL'])fields['Photo Candidate URL']=w.candidate;
        if(cm['Photo Candidate Match'])fields['Photo Candidate Match']='CURRENT ORIGINAL MANUALLY APPROVED — STUDIO QUALIFIED';
        if(cm['Photo Candidate Search Basis'])fields['Photo Candidate Search Basis']='Current-original manual approval supplies Studio qualification; no legacy candidate authority';
        Object.keys(fields).forEach(function(h){if(cm[h])cat.getRange(w.row,cm[h]).setValue(fields[h]);});
      });
      SpreadsheetApp.flush();
    }
    const counts={};results.forEach(function(r){counts[r.status]=(counts[r.status]||0)+1;});
    const out={version:VERSION,function:'AQBPromotePhotoToCatalogue',readOnly:!publish,networkUsed:false,checked:results.length,eligible:writes.length,promoted:publish?writes.length:0,unchanged:counts.ALREADY_CURRENT||0,counts:counts,results:results,resultCount:results.length,success:true,publicationCacheRefreshed:false};
    Logger.log('=== AQB STUDIO CURRENT ORIGINAL PROMOTION '+(publish?'EXPLICIT WRITE':'READ ONLY')+' ===');Logger.log(JSON.stringify({version:VERSION,readOnly:!publish,checked:out.checked,eligible:out.eligible,promoted:out.promoted,unchanged:out.unchanged,counts:counts,sample:results.filter(function(r){return r.status!=='ALREADY_CURRENT';}).slice(0,12)}));return out;
  }finally{if(lock)lock.releaseLock();}
}

function AQBReconcileStudioPhotoQualification(options){
  const VERSION='V16.21.16.8.25', opts=options||{},apply=opts.apply===true;
  AQBRequireCataloguePhotoManager();
  const lock=apply?LockService.getScriptLock():null;
  if(lock&&!lock.tryLock(30000))throw Error('Studio qualification reconciliation busy');
  try{
    const ss=AQBGetSpreadsheet(),stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),cat=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),ledger=ss.getSheetByName('AQB Photo Approval Decisions');
    if(!stage||!cat||!ledger)throw Error('Catalogue, Photo Staging and Photo Approval Decisions are required');
    const sm=AQBBuildHeaderMap(stage),cm=AQBBuildHeaderMap(cat),lm=AQBBuildHeaderMap(ledger);
    const req=function(m,fields,place){fields.forEach(function(f){if(!m[f])throw Error(place+' missing '+f);});};
    req(sm,['Catalogue ID','Candidate Image URL','Candidate Source','Photo Provenance','Qualification Status'],'Staging');
    req(cm,['Catalogue ID'],'Catalogue');
    req(lm,['Catalogue ID','Candidate Image URL','Decision'],'Approval ledger');
    const v=function(r,m,k){return String(m[k]&&r[m[k]-1]!=null?r[m[k]-1]:'').trim();};
    const cv=cat.getDataRange().getValues(),sv=stage.getDataRange().getValues(),lv=ledger.getDataRange().getValues();
    const catCounts={},stageCounts={},latest={};
    cv.slice(1).forEach(function(r){const id=v(r,cm,'Catalogue ID').toUpperCase();if(id)catCounts[id]=(catCounts[id]||0)+1;});
    sv.slice(1).forEach(function(r){const id=v(r,sm,'Catalogue ID').toUpperCase();if(id)stageCounts[id]=(stageCounts[id]||0)+1;});
    // Ledger is append-only. Most recent recorded decision is authoritative.
    lv.slice(1).forEach(function(r){const id=v(r,lm,'Catalogue ID').toUpperCase();if(id)latest[id]=r;});
    const extractId=function(u){const m=String(u||'').match(/(?:[?&]id=|\/file\/d\/|\/d\/)([A-Za-z0-9_-]{15,})/);return m?m[1]:'';};
    const counts={},issues=[],changes=[];let alreadyQualified=0,approvedMatches=0,staged=0;
    function count(k,id){counts[k]=(counts[k]||0)+1;if(k!=='ALREADY_QUALIFIED'&&k!=='READY_TO_QUALIFY'&&issues.length<40)issues.push({id:id,status:k});}
    for(let i=1;i<sv.length;i++){
      const sr=sv[i],id=v(sr,sm,'Catalogue ID').toUpperCase();if(!id)continue;staged++;
      const url=v(sr,sm,'Candidate Image URL'),ar=latest[id],fid=extractId(url);
      let reason='READY_TO_QUALIFY';
      if(!/^AQBCAT\d{3}$/.test(id)||catCounts[id]!==1)reason='CANONICAL_ID_MISMATCH';
      else if(stageCounts[id]!==1)reason='DUPLICATE_STAGING_ID';
      else if(v(sr,sm,'Candidate Source')!=='AQB Studio')reason='NOT_STUDIO_ORIGINAL';
      else if(!fid)reason='ORIGINAL_FILE_ID_MISSING';
      else if(sm['Preview File ID']&&fid===v(sr,sm,'Preview File ID'))reason='PREVIEW_IS_NOT_ORIGINAL';
      else if(!/AI.generated|representative|concept/i.test(v(sr,sm,'Photo Provenance')))reason='PROVENANCE_MISSING';
      else if(!ar||v(ar,lm,'Decision').toUpperCase()!=='APPROVED'||v(ar,lm,'Candidate Image URL')!==url)reason='CURRENT_APPROVAL_MISSING';
      else {
        approvedMatches++;
        if(v(sr,sm,'Qualification Status').toUpperCase()==='QUALIFIED'){reason='ALREADY_QUALIFIED';alreadyQualified++;}
      }
      count(reason,id);
      if(reason==='READY_TO_QUALIFY')changes.push({row:i+1,id:id,source:url});
    }
    if(apply){
      // Check that all data is still the same under lock before any write.
      const latestSV=stage.getDataRange().getValues(),latestLV=ledger.getDataRange().getValues(),recent={};
      latestLV.slice(1).forEach(function(r){const id=v(r,lm,'Catalogue ID').toUpperCase();if(id)recent[id]=r;});
      changes.forEach(function(x){const r=latestSV[x.row-1],ar=recent[x.id];if(v(r,sm,'Catalogue ID').toUpperCase()!==x.id||v(r,sm,'Candidate Image URL')!==x.source||!ar||v(ar,lm,'Decision').toUpperCase()!=='APPROVED'||v(ar,lm,'Candidate Image URL')!==x.source)throw Error('APPROVAL_OR_STAGING_CHANGED: '+x.id);});
      // Write only the qualification column; preserve all approval history and other fields.
      changes.forEach(function(x){stage.getRange(x.row,sm['Qualification Status']).setValue('QUALIFIED');});
      SpreadsheetApp.flush();
    }
    const result={version:VERSION,function:'AQBReconcileStudioPhotoQualification',readOnly:!apply,staged:staged,matchingApprovedOriginals:approvedMatches,previouslyQualified:alreadyQualified,newlyQualified:apply?changes.length:0,readyToQualify:apply?0:changes.length,qualifiedAfter:alreadyQualified+(apply?changes.length:0),blocked:staged-approvedMatches,counts:counts,issues:issues,publicationWrites:0,approvalWrites:0,legacyCandidateChecks:0,success:true};
    Logger.log('=== AQB STUDIO MANUAL APPROVAL -> QUALIFICATION '+(apply?'APPLIED':'DRY RUN')+' ===');Logger.log(JSON.stringify(result));return result;
  }finally{if(lock)lock.releaseLock();}
}

