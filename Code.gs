function AQBFindRetieAppointmentAuthority(customerId){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<2)return null;
  const rows=s.getRange(2,1,n-1,17).getValues(),today=new Date();today.setHours(0,0,0,0),future=[],past=[];
  rows.forEach(function(r){
    if(String(r[1]||'')!==String(customerId||''))return;
    const status=String(r[8]||'').trim().toUpperCase();
    if(['COMPLETED','CANCELLED','NO SHOW'].includes(status)||!AQBIsRetieAppointmentService(r[4]))return;
    const d=AQBParseRetieDate(r[5]);if(!d)return;d.setHours(0,0,0,0);
    const rec={appointmentId:String(r[0]||''),service:String(r[4]||''),date:d,appointmentDate:AQBFormatDateForClient(d),startTime:AQBFormatTimeForClient(r[6]),endTime:AQBFormatTimeForClient(r[7]),status:status};
    if(d>=today)future.push(rec);else past.push(rec);
  });
  future.sort(function(a,b){return a.date-b.date;});
  past.sort(function(a,b){return b.date-a.date;});
  return future.length?future[0]:(past.length?past[0]:null);
}

