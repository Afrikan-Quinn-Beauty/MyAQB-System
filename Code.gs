          template=CONFIG.WHATSAPP_TEMPLATES.SISTERLOCKS_COMPLETE;
          vars=[customer.firstName,AQBFormatDateForClient(customer.nextRetieDate)];
        }else{template=CONFIG.WHATSAPP_TEMPLATES.SERVICE_COMPLETE;vars=[customer.firstName,x.service];}
        var result=AQBSendWhatsAppTemplate(customer.phone,template,'en_US',AQBBuildWhatsAppBodyVariables(vars));
        if(!result.sent){x.status='NOT_SENT';x.error=String(result.reason||'Template not accepted');return;}
        var mid=String(result.response&&result.response.messages&&result.response.messages[0]&&result.response.messages[0].id||'');
        if(!mid)throw new Error('Meta returned no message ID: verify provider response before retry');
        var ws=AQBGetSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES),h=AQBBuildHeaderMap(ws),row=Array(ws.getLastColumn()).fill('');
        function put(k,v){if(h[k])row[h[k]-1]=v;}
        put('Message ID',mid);put('WhatsApp Number',x.phone);put('Direction','OUT');put('Timestamp',new Date());put('Message Type','COMPLETION_TEMPLATE');
        put('Message Text','Completion notification | appointment '+x.appointmentId+' | '+x.service);put('Customer ID',x.customerId);
        put('Intent','SERVICE_COMPLETION');put('Service',x.service);put('Status','ACCEPTED');put('Event ID','AQB_COMPLETION:'+x.appointmentId);
        put('Template Name',result.template&&result.template.name||template);put('Delivery Status','ACCEPTED');put('Delivery Updated At',new Date());
        PropertiesService.getScriptProperties().setProperty('AQB_COMPLETION_WA_SENT_'+x.appointmentId,mid);ws.appendRow(row);
        AQBLogAudit('AQB_COMPLETION_REPLAY_ACCEPTED','Appointment',x.appointmentId,JSON.stringify({customerId:x.customerId,messageId:mid}));
        x.status='ACCEPTED';x.messageId=mid;
      }catch(e){x.status='FAILED_REVIEW_REQUIRED';x.error=String(e&&e.message||e);AQBLogAudit('AQB_COMPLETION_REPLAY_FAILED','Appointment',x.appointmentId,x.error);}
    });
  }finally{lock.releaseLock();}
  return out.map(function(x){var y=Object.assign({},x);delete y.customer;return y;});
}
