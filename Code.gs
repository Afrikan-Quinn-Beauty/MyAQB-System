/** Universal, idempotent completed-retie repair. A trigger may run this as its installer. */

/** Conservative recovery: any recorded submission or uncertain attempt blocks automatic resend. */
function AQBGetCompletionNotificationEvidence_(appointmentId,customerId,actualDate){
  const props=PropertiesService.getScriptProperties();
  if(props.getProperty('AQB_COMPLETION_RECOVERY_INTENT_'+appointmentId))return {exists:true,reason:'Prior recovery intent: manual reconciliation required'};
  if(AQBIsCompletionWhatsAppSent(appointmentId,customerId,actualDate))return {exists:true,reason:'Completion marker or historical audit evidence'};
  const sh=AQBGetSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES),m=AQBBuildHeaderMap(sh);
  if(sh.getLastRow()<2)return {exists:false};
  const rows=sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).getValues();
  const v=(r,k)=>m[k]?String(r[m[k]-1]||'').trim():'';
  for(let i=rows.length-1;i>=0;i--){
    const r=rows[i];if(!v(r,'Message Type').toUpperCase().includes('COMPLETION'))continue;
    if(v(r,'Appointment ID')===appointmentId||v(r,'Notification Key')==='AQB_COMPLETION_'+appointmentId||v(r,'Event ID')==='AQB_COMPLETION_'+appointmentId)
      return {exists:true,reason:'Existing WhatsApp ledger row '+(i+2)+'; reconcile status'};
  }
  return {exists:false};
}
