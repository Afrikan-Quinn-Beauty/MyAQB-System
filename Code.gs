function AQBSelectPhotoCandidate(rec,query,photos){
  if(!photos || !photos.length) return {found:false};
  const stop={the:1,and:1,with:1,hair:1,black:1,woman:1,women:1,salon:1,style:1,styling:1,service:1,professional:1};
  const identity=(rec.serviceName+" "+rec.variants).toLowerCase();
  const tokens=identity.replace(/[^a-z0-9 ]/g," ").split(/\s+/).filter(function(t){return t.length>2&&!stop[t];});
  let best=null;
  photos.forEach(function(p,idx){
    const alt=String(p.alt||"").toLowerCase();
    if(/\b(man|male|boy|gentleman|beard|barber)\b/.test(alt)) return;
    let hits=0; tokens.forEach(function(t){if(alt.indexOf(t)!==-1) hits++;});
    const overlap=tokens.length?hits/tokens.length:0;
    const score=Math.min(95,Math.round(55+(overlap*30)+Math.max(0,10-idx)));
    const src=p.src||{};
    const image=String(src.large2x||src.large||src.medium||src.original||"").trim();
    if(!image) return;
    const c={found:true,imageUrl:image,sourceUrl:String(p.url||"").trim(),discoveryScore:score,pexelsId:String(p.id||""),alt:String(p.alt||""),query:query};
    if(!best || c.discoveryScore>best.discoveryScore) best=c;
  });
  return best||{found:false};
}

function AQBSchedulePhotoPipelineContinuation(reason,providerReset){
  const handler="AQBRunQueuedPhotoPipeline";
  ScriptApp.getProjectTriggers().forEach(function(t){if(t.getHandlerFunction&&t.getHandlerFunction()===handler)ScriptApp.deleteTrigger(t);});
  let when=new Date(Date.now()+2*60*1000);
  if((reason==="PROVIDER_BUDGET_FLOOR_REACHED"||reason==="PROVIDER_RATE_LIMITED") && providerReset){
    const resetMs=providerReset>1000000000000?providerReset:providerReset*1000;
    when=new Date(Math.max(Date.now()+2*60*1000,resetMs+60*1000));
  } else if(reason==="PROVIDER_RATE_LIMITED") when=new Date(Date.now()+20*60*1000);
  ScriptApp.newTrigger(handler).timeBased().at(when).create();
  return when;
}

