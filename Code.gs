function AQBIsConsultationService(service,category){ return /consultation/i.test(String(service||'').trim()) || /consultation/i.test(String(category||'').trim()); }

function AQBNormalizePriceText(value){
  const raw=String(value==null?'':value).trim();
  if(!raw)return {amount:0,display:'',currency:'KSh'};
  const m=raw.replace(/,/g,'').match(/(?:KShs?|KES|Kenya\s+Shillings?)?\s*(\d+(?:\.\d+)?)/i);
  const amount=m?Number(m[1]):0;
  if(!isFinite(amount)||amount<=0)return {amount:0,display:'',currency:'KSh'};
  const rounded=Math.round(amount*100)/100;
  const formatted='KSh '+rounded.toLocaleString('en-KE',{minimumFractionDigits:rounded%1?2:0,maximumFractionDigits:2});
  const display=/^from\b/i.test(raw)?'From '+formatted:formatted;
  return {amount:rounded,display:display,currency:'KSh'};
}

function AQBFindServicePricing(service,group){
  const s=AQBGetSheet(CONFIG.SHEETS.LISTS), n=s.getLastRow();
  if(n<2)return {price:'',priceAmount:0,group:''};
  const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  const target=String(service||'').trim().toLowerCase(), targetGroup=String(group||'').trim().toLowerCase();
  let serviceOnly=null;
  for(const r of rows){
    if(!['Service','Package','Membership','Mobile Fee'].includes(String(r[m['Item']-1]||'').trim()))continue;
    const name=String(r[m['Service Name']-1]||'').trim().toLowerCase();
    if(name!==target)continue;
    const normalized=AQBNormalizePriceText(r[m['Price']-1]);
    const candidate={price:normalized.display||String(r[m['Price']-1]||''),priceAmount:normalized.amount,group:String(r[m['Category']-1]||'')};
    if(targetGroup && candidate.group.trim().toLowerCase()===targetGroup && candidate.priceAmount>0)return candidate;
    if(serviceOnly===null || candidate.priceAmount>0)serviceOnly=candidate;
  }
  return serviceOnly||{price:'',priceAmount:0,group:''};
}

