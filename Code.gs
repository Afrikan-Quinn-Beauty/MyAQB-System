    return {success:true,updated:true,renamed:renaming,previousName:renaming?priorName:'',styleName:name,trendId:String(keeperRow[rm['Trend ID']-1]||''),duplicateIds,approvalAutomatic:false};
  }

  if(payload.variationMode===true || String(payload.variationMode||'').toLowerCase()==='true') throw new Error('Variation update blocked: no existing Pending record was updated. No new suggestion was created.');
  const s=AQBGetSheet(CONFIG.SHEETS.TREND_INBOX),m=AQBBuildHeaderMap(s),rows=s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,s.getLastColumn()).getValues():[];
  const duplicate=rows.find(function(r){return String(r[m['Record Type']-1]||'').toUpperCase()==='TREND_INBOX'&&normName(r[m['Style Name']-1])===normName(name);});
  if(duplicate){const dismissed=['ARCHIVED','DELETED','REJECTED','DECLINED'].includes(String(duplicate[m['Status']-1]||'').trim().toUpperCase());return {success:false,duplicate:true,dismissed:dismissed,trendId:String(duplicate[m['Trend ID']-1]||''),message:dismissed?'This suggestion was previously dismissed. Review its preserved history before reconsidering it.':'This trend already exists in the AQB Trend Inbox.'};}
