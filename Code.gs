    const col = s.getLastColumn() + 1;
    s.getRange(1,col).setValue('Catalogue ID');
    if (s.getLastRow() > 1) s.getRange(2,col,s.getLastRow()-1,1).setValue('');
  }
  return AQBBuildHeaderMap(s);
