    const record={row:i+2,customerId:value(r,'Customer ID'),appointmentId:value(r,'Appointment ID'),key:key,status:status};
    if(['QUEUED','PENDING','SUBMITTED','ACCEPTED','SENT',''].indexOf(status)>=0)unresolved.push(record);
