  });
  // Use the existing customer-facing category resolver rather than inventing database category keys.
  const categoryReport=Object.values(counts).sort((a,b)=>a.raw.localeCompare(b.raw)).map(c=>{
    const exact=canonicalCategories.find(k=>k===c.trimmed)||null;
