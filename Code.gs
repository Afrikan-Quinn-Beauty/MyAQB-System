}

function AQBIsTestCustomer(customerId){
  return /^(AQB001|AQB002|AQB003)$/i.test(String(customerId||'').trim());
}

function AQBGetCustomerIdHighWater(){
  const sources=[
    [CONFIG.SHEETS.CUSTOMERS,'Customer ID'],
    [CONFIG.SHEETS.APPOINTMENTS,'Customer ID'],
    [CONFIG.SHEETS.PAYMENTS,'Customer ID'],
    [CONFIG.SHEETS.CASH_FLOW,'Customer ID']
  ];
  let max=3;
  sources.forEach(function(source){
    const sh=AQBGetSpreadsheet().getSheetByName(source[0]);
    if(!sh||sh.getLastRow()<2)return;
    const hm=AQBBuildHeaderMap(sh),col=hm[source[1]];
    if(!col)return;
    sh.getRange(2,col,sh.getLastRow()-1,1).getValues().forEach(function(r){
      const m=String(r[0]||'').trim().match(/^AQB(\d+)$/i);
      if(m)max=Math.max(max,Number(m[1]));
    });
  });
  const saved=Number(PropertiesService.getScriptProperties().getProperty('AQB_CUSTOMER_ID_HIGH_WATER')||0);
  return Math.max(max,isFinite(saved)?saved:0);
}

