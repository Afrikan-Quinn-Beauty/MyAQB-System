function AQBParseHeaderInt(headers,name){
  const target=String(name).toLowerCase();
  const keys=Object.keys(headers||{});
  for(let i=0;i<keys.length;i++) if(String(keys[i]).toLowerCase()===target){const n=parseInt(headers[keys[i]],10);return isNaN(n)?null:n;}
  return null;
}

function AQBCountRemainingDiscovery(stage,hm){
  const v=stage.getDataRange().getValues(); let n=0;
  for(let i=1;i<v.length;i++){
    const pex=String(v[i][hm["Pexels Required"]]).toLowerCase();
    if(pex!=="true") continue;
    const st=String(v[i][hm["Search Status"]]||"").trim();
    const cand=String(v[i][hm["Candidate Image URL"]]||"").trim();
    if(cand) continue;
    if(st==="PEXELS_EXHAUSTED") continue;
    n++;
  }
  return n;
}

function AQBCalculateSignalAttainment(signals) {
  var strictPassCount = 0;
  var weightedAttained = 0;
  var keys = Object.keys(AQB_SIGNAL_REGISTRY);
  keys.forEach(function(key) {
    var status = String((signals || {})[key] || "").toUpperCase();
    if (status === "PASS") {
      strictPassCount++;
      weightedAttained += 1;
    } else if (status === "PARTIAL") {
      weightedAttained += 0.5;
    }
  });
  var strictPercent = keys.length ? (strictPassCount / keys.length) * 100 : 0;
  var weightedPercent = keys.length ? (weightedAttained / keys.length) * 100 : 0;
  return {
    strictPassCount: strictPassCount,
    strictMaximum: keys.length,
    weightedAttained: weightedAttained,
    weightedMaximum: keys.length,
    strictPercent: strictPercent,
    weightedPercent: weightedPercent,
    strictLabel: strictPercent.toFixed(2) + "%",
    weightedLabel: weightedPercent.toFixed(2) + "%"
  };
}

function AQBResolveStrongestSignal(scores) {
  var strongestSignal = null;
  var strongestEvidence = -1;
  Object.keys(scores || {}).forEach(function(signal) {
    if (!Object.prototype.hasOwnProperty.call(AQB_SIGNAL_REGISTRY, signal)) return;
    var value = Number(scores[signal]);
    if (!isFinite(value)) return;
    if (value > strongestEvidence) {
      strongestEvidence = value;
      strongestSignal = signal;
    }
  });
  return {signal: strongestSignal, evidence: strongestEvidence < 0 ? 0 : strongestEvidence};
}

function AQBResolveMandatorySignals(target, summary) {
  // S1 remains the identity anchor. Identity/structural contradiction is
  // independently evaluated as a hard blocker; the other signals corroborate.
  return ["S1"];
}

function AQBResolveBottleneckDimension(signal, summary) {
  signal = String(signal || "").toUpperCase();
  summary = summary || {};
  if (signal === "S1") return "CANONICAL_IDENTITY";
  if (signal === "S2") return "FAMILY";
  if (signal === "S3") return "DESCRIPTION";
  if (signal === "S4") return "PHOTO_BRIEF";
  if (signal === "S5") return "ROUTER";
  if (signal === "S7") return "TYPE_CONTEXT";
  if (signal === "S8") return "FAMILY_CONTEXT";
  if (signal === "S6") {
    var s6 = summary.s6Evidence || {};
    var missing = (s6.missing || []).map(String).join(" ").toLowerCase();
    var contradictions = (s6.contradictions || []).map(String).join(" ").toLowerCase();
    var all = missing + " " + contradictions;
    if (/length|short|medium|long|waist|bob|chin/.test(all)) return "LENGTH";
    if (/dens|thick|fine|density/.test(all)) return "DENSITY";
    if (/install|installation|unbraid|detangl|removal|remove|retie|retight|process|application|cutting|cut/.test(all)) return "ACTION_PROCESS";
    if (/finish|curl|wave|boho|bead|volume|fluffy|defined/.test(all)) return "FINISH";
    return "ACTION_PROCESS";
  }
  return "UNKNOWN";
}

function AQBEvaluateQualificationGate(score, weightedAttainmentPercent, identityContradiction, mandatoryFailures) {
  score = Number(score);
  weightedAttainmentPercent = Number(weightedAttainmentPercent) || 0;
  mandatoryFailures = mandatoryFailures || [];
  if (identityContradiction === true) {
    return {tier:'HARD_IDENTITY_CONTRADICTION',minimumScoreExclusive:65,minimumAttainmentPercent:50,signalRequirementMet:false,scoreRequirementMet:false,qualified:false};
  }
  if (mandatoryFailures.length > 0) {
    return {tier:'MANDATORY_GATE_FAILURE',minimumScoreExclusive:65,minimumAttainmentPercent:50,signalRequirementMet:false,scoreRequirementMet:isFinite(score)&&score>65,qualified:false};
  }
  var scoreGate = isFinite(score) && score > 65;
  var attainmentGate = weightedAttainmentPercent >= 50;
  var qualified = scoreGate && attainmentGate;
  var tier = 'RESEARCH_AGAIN';
  if (qualified) {
    if (score < 80) tier = 'ACCEPTABLE';
    else if (score < 90) tier = 'GOOD';
    else tier = 'STRONG';
  }
  return {
    tier: tier,
    minimumScoreExclusive: 65,
    minimumAttainmentPercent: 50,
    signalRequirementMet: attainmentGate,
    scoreRequirementMet: scoreGate,
    qualified: qualified
  };
}

function AQBBuildGateOutcome(candidateScore, incumbentScore, evidence) {
  evidence = evidence || {};
  var score = Number(candidateScore);
  var mandatoryFailures = Array.isArray(evidence.mandatoryFailures) ? evidence.mandatoryFailures : [];
  return {
    identityContradiction: evidence.identityContradiction === true,
    mandatoryStructureFailure: mandatoryFailures.length > 0,
    numericalThresholdFailure: !isFinite(score) || score <= 65,
    challengerImprovementFailure: isFinite(Number(incumbentScore)) ? score <= Number(incumbentScore) : false
  };
}

function AQBClassifyCandidateDisposition(gate, qualification) {
  gate = gate || {};
  qualification = qualification || {};
  if (gate.identityContradiction) return "HARD_IDENTITY_CONTRADICTION";
  if (gate.mandatoryStructureFailure) return "INSUFFICIENT_MANDATORY_EVIDENCE";
  if (!qualification.qualified) return "RESEARCH_AGAIN";
  if (gate.challengerImprovementFailure) return "COMPATIBLE_NOT_BETTER";
  return "QUALIFIED";
}

function AQBBuildCandidateEvidence(signals, structuralScores, target, summary, gateFacts) {
  signals = signals || {};
  summary = summary || {};
  gateFacts = gateFacts || {};
  var attainment = AQBCalculateSignalAttainment(signals);
  var strongest = AQBResolveStrongestSignal(structuralScores || {});
  var mandatorySignals = AQBResolveMandatorySignals(target, summary);
  var mandatoryFailures = mandatorySignals.filter(function(signal) {
    return String(signals[signal] || "").toUpperCase() !== "PASS";
  });
  var bottleneckSignal = gateFacts.bottleneckSignal || null;
  if (!bottleneckSignal) {
    var ordered = Object.keys(structuralScores || {}).filter(function(k) {
      return Object.prototype.hasOwnProperty.call(AQB_SIGNAL_REGISTRY, k);
    }).sort(function(a, b) { return Number(structuralScores[a]) - Number(structuralScores[b]); });
    bottleneckSignal = ordered.length ? ordered[0] : null;
  }
  var candidateScore = Number(gateFacts.candidateScore);
  var identityContradiction = gateFacts.identityContradiction === true;
  var qualification = AQBEvaluateQualificationGate(
    candidateScore,
    attainment.weightedPercent,
    identityContradiction,
    mandatoryFailures
  );
  var gateOutcome = AQBBuildGateOutcome(candidateScore, gateFacts.incumbentScore, {
    identityContradiction: identityContradiction,
    mandatoryFailures: mandatoryFailures
  });
  var evidence = {
    signalStatuses: signals,
    signalScores: Object.keys(structuralScores || {}).reduce(function(out, key) {
      var value = Number(structuralScores[key]);
      out[key] = isFinite(value) ? (value <= 1 ? value * 100 : value) : 0;
      return out;
    }, {}),
    strictPassCount: attainment.strictPassCount,
    weightedAttained: attainment.weightedAttained,
    strictAttainmentPercent: attainment.strictPercent,
    weightedAttainmentPercent: attainment.weightedPercent,
    signalAttainment: attainment.weightedLabel,
    strongestStructuralSignal: strongest.signal,
    strongestStructuralEvidence: Number(strongest.evidence.toFixed(2)),
    mandatorySignals: mandatorySignals,
    mandatoryFailures: mandatoryFailures,
    bottleneckSignal: bottleneckSignal,
    bottleneckDimension: gateFacts.bottleneckDimension || AQBResolveBottleneckDimension(bottleneckSignal, summary),
    primaryBottleneck: bottleneckSignal,
    secondaryBottlenecks: gateFacts.secondaryBottlenecks || [],
    s6Evidence: summary.s6Evidence || null,
    qualification: {
      score: isFinite(candidateScore) ? candidateScore : 0,
      tier: qualification.tier,
      minimumScore: qualification.minimumScore,
      minimumAttainmentPercent: qualification.minimumAttainmentPercent,
      scoreRequirementMet: qualification.scoreRequirementMet,
      signalRequirementMet: qualification.signalRequirementMet,
      qualified: qualification.qualified
    },
    gateOutcome: gateOutcome
  };
  evidence.candidateDisposition = gateFacts.disposition || AQBClassifyCandidateDisposition(gateOutcome, qualification);
  evidence.incumbentAction = gateFacts.incumbentAction ||
    (qualification.qualified && !gateOutcome.challengerImprovementFailure ? "REPLACE" : "RETAIN");
  return evidence;
}

function AQBBuildSignalEvidence(gate, rec, route, target, querySpec, summary, context) {
  gate = gate || {}; rec = rec || {}; route = route || {}; target = target || {}; querySpec = querySpec || {}; summary = summary || {}; context = context || {};
  var familyHits = Array.isArray(summary.familyHits) ? summary.familyHits : [];
  var descHits = Array.isArray(summary.independentDescHits) ? summary.independentDescHits : [];
  var briefHits = Array.isArray(summary.independentBriefHits) ? summary.independentBriefHits : [];
  var hardEvidence = Array.isArray(summary.hardEvidence) ? summary.hardEvidence : [];
  var hardMissing = Array.isArray(summary.hardMissing) ? summary.hardMissing : [];
  var activityHits = Array.isArray(summary.activityHits) ? summary.activityHits : [];
  var catalogueIdentityPass = context.catalogueIdentityPass === true;
  var routerPass = !!String(route.searchStrategy || route.track || querySpec.kind || '').trim();
  var typePass = !!String(target.type || route.track || '').trim();
  var familyContextPass = !!String(rec.category || route.businessFamily || '').trim();
  var familyPass = familyHits.length > 0;
  var s6Status='PASS', targetType=String(target.type||'').toUpperCase(), subtype=String(route.subtype||'').toUpperCase(), track=String(route.track||'').toUpperCase();

  if(hardMissing.length>0){
    s6Status='FAIL';
  }else if(targetType==='SERVICE' && subtype==='PROCESS'){
    if(activityHits.length===0)s6Status='FAIL';
    else if(hardEvidence.length===0)s6Status='PARTIAL';
  }else if(targetType==='SERVICE' && subtype==='RESULT'){
    if(hardEvidence.length>0 || familyHits.length>0)s6Status='PASS';
    else if(descHits.length>0 || briefHits.length>0)s6Status='PARTIAL';
    else s6Status='FAIL';
  }else if(targetType==='SERVICE' && subtype==='EXPERIENCE'){
    if(familyHits.length>0 || descHits.length>0 || briefHits.length>0)s6Status='PASS';
    else s6Status='PARTIAL';
  }else if(track==='STYLE_IDENTITY' || targetType==='STYLE'){
    if(hardEvidence.length>0 || familyHits.length>0)s6Status='PASS';
    else if(descHits.length>0 || briefHits.length>0)s6Status='PARTIAL';
    else s6Status='FAIL';
  }else if(targetType==='SERVICE'){
    if(activityHits.length===0 && hardEvidence.length===0)s6Status='PARTIAL';
  }

  var signals = {
    S1: catalogueIdentityPass ? 'PASS' : 'FAIL',
    S2: familyPass ? 'PASS' : 'FAIL',
    S3: descHits.length ? 'PASS' : 'PARTIAL',
    S4: briefHits.length ? 'PASS' : 'PARTIAL',
    S5: routerPass ? 'PASS' : 'FAIL',
    S6: s6Status,
    S7: typePass ? 'PASS' : 'FAIL',
    S8: familyContextPass ? 'PASS' : 'FAIL'
  };
  var scores = {
    S1: catalogueIdentityPass ? 100 : 0,
    S2: familyPass ? 80 : 20,
    S3: descHits.length ? 70 : 30,
    S4: briefHits.length ? 70 : 30,
    S5: routerPass ? 75 : 20,
    S6: s6Status === 'PASS' ? 90 : (s6Status === 'PARTIAL' ? 45 : 5),
    S7: typePass ? 85 : 20,
    S8: familyContextPass ? 80 : 20
  };
  return {signals:signals,scores:scores};
}

function AQBDeriveSignalAssessment(gate, rec, route, target, querySpec, summary) {
  var pass = !!(rec && /^AQBCAT\d{3}$/.test(String(rec.catalogueId || '').trim().toUpperCase()));
  return AQBBuildSignalEvidence(gate, rec, route, target, querySpec, summary, {catalogueIdentityPass:pass});
}

