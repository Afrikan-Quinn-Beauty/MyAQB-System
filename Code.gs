function AQBGetCatalogueVariantRecordType(service,category,description){
  const n=AQBNormalizeCatalogueVariantText([service,category].join(' '));
  // Explicit booked activities win before any visual hairstyle-family inference.
  if(/\bconsultation|treatment|conditioning|relaxer|wash|blow dry|retightening|retie|retwist|repair|removal|take down|takedown|grooming|maintenance\b/.test(n))return 'SERVICE';
  if(/bridal.*styling|special occasion|occasion updo/.test(n))return 'SERVICE';
  try{
    const t=AQBClassifyPhotoTarget(service,category,description)||{};
    if(t.type)return String(t.type).toUpperCase();
  }catch(ignore){}
  return 'STYLE';
}

function AQBGetCatalogueVariantFamilyFromService(service,category){
  const n=AQBNormalizeCatalogueVariantText([service,category].join(' '));
  if(/\bcornrow|cornrows|lines\b/.test(n))return 'cornrow';
  if(/\btwist|twists\b/.test(n))return 'twist';
  if(/\bloc|locs|dreadlock|dreadlocks|sisterlocks|microlocs\b/.test(n))return 'loc';
  if(/\bbox braid|box braids|knotless|braid|braids|braiding\b/.test(n))return 'braid';
  if(/\bweave|weaving|sew in\b/.test(n))return 'weave';
  if(/\bwig|wigs\b/.test(n))return 'wig';
  if(/\bcurl|curls|curly\b/.test(n))return 'curl';
  if(/\bafro\b/.test(n))return 'afro';
  if(/\bsilk press|straightening|straight hair\b/.test(n))return 'straight';
  return '';
}

function AQBGetCatalogueVariantKey(scope,parentKey,variant){
  return String(scope||'').trim().toUpperCase()+'|'+String(parentKey||'').trim().toUpperCase()+'|'+AQBNormalizeCatalogueVariantText(variant);
}

function AQBIsCatalogueVariantActive(value){
  const n=String(value==null?'YES':value).trim().toLowerCase();
  return !['no','false','0','inactive','disabled'].includes(n);
}

function AQBGetCatalogueVariantKeywordGroups(value){
  return String(value||'').split(';').map(function(group){
    return String(group||'').split('||').map(function(x){return String(x||'').trim();}).filter(Boolean);
  }).filter(function(group){return group.length>0;});
}

function AQBMatchCatalogueVariantRule(record,evidenceText){
  const excludes=AQBGetCatalogueVariantKeywordGroups(record.excludeKeywords||'');
  for(let i=0;i<excludes.length;i++){
    if(excludes[i].some(function(p){return AQBHasCatalogueVariantPhrase(evidenceText,p);} ))return false;
  }
  const mode=String(record.matchMode||'ANY').trim().toUpperCase();
  if(mode==='ALWAYS')return true;
  const groups=AQBGetCatalogueVariantKeywordGroups(record.matchKeywords||'');
  if(!groups.length)return AQBHasCatalogueVariantPhrase(evidenceText,record.variantName||'');
  if(mode==='ALL')return groups.every(function(g){return g.some(function(p){return AQBHasCatalogueVariantPhrase(evidenceText,p);} );});
  return groups.some(function(g){return g.some(function(p){return AQBHasCatalogueVariantPhrase(evidenceText,p);} );});
}

