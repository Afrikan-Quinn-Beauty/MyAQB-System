function AQBGetCompletedAppointmentRevenue(start,end){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
  if(n<2)return 0;
  const paymentSheet=AQBGetSheet(CONFIG.SHEETS.PAYMENTS),pn=paymentSheet.getLastRow(),paidAppointmentIds={};
  if(pn>=2){paymentSheet.getRange(2,1,pn-1,13).getValues().forEach(function(r){
    const id=String(r[4]||'').trim(),status=String(r[10]||'').trim();
    if(id&&status!=='Cancelled'&&Number(r[8]||0)>0)paidAppointmentIds[id]=true;
  });}
  let total=0;
  s.getRange(2,1,n-1,17).getValues().forEach(function(r){
    if(String(r[8]||'').trim().toUpperCase()!=='COMPLETED')return;
    const d=r[5] instanceof Date?r[5]:new Date(r[5]);
    if(!AQBIsDateInRange(d,start,end))return;
