  const entry={'Transaction ID':AQBGenerateTransactionID(),'Date':new Date(),'Customer ID':val('Customer ID'),'Customer Name':val('Customer Name'),'Appointment ID':apt,'Service':val('Service'),'Transaction Type':'Income','Payment Method':'M-Pesa','Amount':amount,'Payment Status':'Paid','Description':'Daraja STK receipt '+receipt+' / Payment '+pid,'Recorded By':'AQB Daraja reconciliation','Source Payment ID':pid};
