function AQBEnrichExistingCatalogueServicesFromDailyBrief(trendItems){
  const items=Array.isArray(trendItems)?trendItems:[];
  if(!items.length)return {success:true,updated:0,skippedExistingPhoto:0,skippedDuplicate:0,unmatched:0};
  const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBEnsureCatalogueMetaColumns(),n=cat.getLastRow();
  if(n<2)return {success:true,updated:0,skippedExistingPhoto:0,skippedDuplicate:0,unmatched:items.length};
  const rows=cat.getRange(2,1,n-1,cat.getLastColumn()).getValues();
  const master=AQBGetMasterServiceRows().filter(function(x){return x.active;});
  const masterByKey={},masterByName={};
  master.forEach(function(x){
    const key=AQBNormalizeServiceKey(x.category,x.service);
    masterByKey[key]=x;
    const nk=String(x.service||'').trim().toLowerCase();
    if(nk&&!masterByName[nk])masterByName[nk]=x;
  });
  const rowByKey={};
  rows.forEach(function(r,i){
    const key=AQBNormalizeServiceKey(String(r[cm['Category']-1]||''),String(r[cm['Service Name']-1]||''));
    if(key&&!rowByKey[key])rowByKey[key]={row:r,index:i};
  });

  const owners={};
  rows.forEach(function(r){
    const own=cm['Own Photo']?String(r[cm['Own Photo']-1]||'').trim():'';
    const online=cm['Image URL']?String(r[cm['Image URL']-1]||'').trim():'';
    [own,online].forEach(function(v){const k=AQBNormalizeImageKey(v);if(k)owners[k]=true;});
  });

  const needsPhotoStatus={
    'Needs Relevant Unique Photo':true,
    'No Relevant Photo Found':true,
    'Invalid Photo URL':true,
    'Duplicate Image - Needs Unique Photo':true,
    'Duplicate Image - Replacement Required':true,
    'Photo Replacement Pending':true,
    'PENDING PHOTO':true,
    'PENDING PHOTO REPLACEMENT':true
  };
  const seenBrief={},updates=[];
  let updated=0,skippedExistingPhoto=0,skippedDuplicate=0,unmatched=0;

  items.forEach(function(t){
    const name=String(t.name||'').trim();
    const category=String(t.category||'').trim();
    const imageUrl=String(t.imageUrl||t.photoUrl||'').trim();
    if(!name||!imageUrl||!/^https?:\/\//i.test(imageUrl))return;
    const imageKey=AQBNormalizeImageKey(imageUrl);
    if(!imageKey||seenBrief[imageKey])return;
    seenBrief[imageKey]=true;

    const matches=Array.isArray(t.matchingServices)?t.matchingServices.map(function(x){return String(x||'').trim();}).filter(Boolean):[];
    let service=null;
    const exact=masterByKey[AQBNormalizeServiceKey(category,name)];
    if(exact)service=exact;
    if(!service){
      for(let i=0;i<matches.length&&!service;i++){
        const mk=AQBNormalizeServiceKey(category,matches[i]);
        if(masterByKey[mk])service=masterByKey[mk];
        else if(masterByName[String(matches[i]).toLowerCase()])service=masterByName[String(matches[i]).toLowerCase()];
      }
    }
    if(!service)service=masterByName[name.toLowerCase()]||null;
    if(!service){unmatched++;return;}

    const key=AQBNormalizeServiceKey(service.category,service.service),rec=rowByKey[key];
    if(!rec){unmatched++;return;}
    const r=rec.row;
    const own=cm['Own Photo']?String(r[cm['Own Photo']-1]||'').trim():'';
    const online=cm['Image URL']?String(r[cm['Image URL']-1]||'').trim():'';
    const current=own||online;
    const status=cm['Image Status']?String(r[cm['Image Status']-1]||'').trim().toUpperCase():'';

    // Preserve a usable/current image. Daily Brief enrichment is a gap-filler,
    // never a replacement for imagery that is already serving the service.
    if(current && !needsPhotoStatus[status] && status!=='PHOTO REQUIRED'){
      skippedExistingPhoto++;return;
    }
    if(owners[imageKey] && AQBNormalizeImageKey(current)!==imageKey){
      skippedDuplicate++;return;
    }

    if(cm['Image URL'])r[cm['Image URL']-1]=imageUrl;
    if(cm['Own Photo'])r[cm['Own Photo']-1]='';
    if(cm['Image Source'])r[cm['Image Source']-1]='AQB Daily Brief';
    if(cm['Image Source URL'])r[cm['Image Source URL']-1]=String(t.imageSourceUrl||'').trim();
    if(cm['Image Search Match'])r[cm['Image Search Match']-1]='Daily Brief photo for '+service.service;
    if(cm['Image Use Note'])r[cm['Image Use Note']-1]='Daily Brief photo candidate for existing AQB service. Revalidate before public publication; valid existing AQB imagery is protected.';
    if(cm['Image Content Hash'])r[cm['Image Content Hash']-1]='';
    if(cm['Image Status'])r[cm['Image Status']-1]='Daily Brief Photo - Validation Required';
    if(cm['Publication Status'])r[cm['Publication Status']-1]='PENDING PHOTO';
    if(cm['Photo Qualification Status'])r[cm['Photo Qualification Status']-1]='REVIEW REQUIRED';
    if(cm['Photo Provenance'])r[cm['Photo Provenance']-1]='AQB DAILY BRIEF';
    if(cm['Representative Image'])r[cm['Representative Image']-1]='YES';
    if(cm['Daily Brief ID'])r[cm['Daily Brief ID']-1]=String(t.dailyBriefId||'').trim();
    if(cm['Photo Brief'] && !String(r[cm['Photo Brief']-1]||'').trim())r[cm['Photo Brief']-1]=String(t.photoBrief||'').trim();
    updates.push([rec.index+2,r]);
    owners[imageKey]=true;
    updated++;
  });

  updates.forEach(function(x){cat.getRange(x[0],1,1,cat.getLastColumn()).setValues([x[1]]);});
  // Do not run the full dynamic Catalogue URL validator inside the live research call.
  // The candidate is stored safely and remains PENDING PHOTO until the normal
  // Catalogue validation/repair workflow verifies it. This keeps the 7am
  // intelligence job resumable and protects it from Apps Script execution limits.
  return {success:true,updated:updated,skippedExistingPhoto:skippedExistingPhoto,skippedDuplicate:skippedDuplicate,unmatched:unmatched};
}

