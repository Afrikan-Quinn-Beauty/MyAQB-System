  const endpoint='https://api.pexels.com/v1/search';
  // Do not over-constrain Pexels by orientation. The catalogue needs the best
  // representative image, and portrait hair imagery is common. Pexels remains
  // the source; AI performs the final visual qualification.
  const params={query:query,per_page:relaxed?40:30,page:1};
  const qs=Object.keys(params).map(function(k){return encodeURIComponent(k)+'='+encodeURIComponent(params[k]);}).join('&');

  try{
    const res=UrlFetchApp.fetch(endpoint+'?'+qs,{
      method:'get',muteHttpExceptions:true,
      headers:{'Authorization':apiKey,'User-Agent':'Afrikan-Quinn-Beauty-Catalogue/16.6.20'}
    });
    const rc=res.getResponseCode();
    if(rc<200||rc>=300)return {items:[],httpStatus:rc};
    const data=JSON.parse(res.getContentText()||'{}');
    const photos=Array.isArray(data.photos)?data.photos:[];
    const out=[];
    photos.forEach(function(p){
      const src=p&&p.src?p.src:{};
      const url=String(src.large2x||src.large||src.original||'').trim();
      const key=AQBNormalizeImageKey(url);
      if(!url||!key||reservedImages[key])return;
      const alt=String(p.alt||'');
      const pexelsUrl=String(p.url||'').trim();
      if(!relaxed && AQBIsClearlyWrongPexelsImage(service,category,description,alt,pexelsUrl))return;

      // Deterministic screening is a routing filter, not the final visual
      // decision. Keep plausible candidates for OpenAI/Gemini even when Pexels
      // metadata does not literally contain the exact hairstyle name.
      const score=relaxed?0:AQBScorePexelsImageRelevance(service,category,description,alt,false);
      if(!relaxed && score<8)return;

      out.push({
        photoId:p&&p.id?String(p.id):'',
        imageUrl:url,
        sourceUrl:pexelsUrl,
        match:alt.substring(0,500),
        photographer:String(p.photographer||'').trim(),
        credit:p.photographer?'Photo by '+p.photographer+' on Pexels':'Photo on Pexels',
        score:score
      });
    });
    out.sort(function(a,b){return b.score-a.score;});
    return {items:out.slice(0,relaxed?40:10),httpStatus:rc};
  }catch(e){
    return {items:[],httpStatus:0,error:String(e&&e.message||e)};
  }
}

function AQBScorePexelsImageRelevance(service,category,description,alt,relaxed){
  const hay=String(alt||'').toLowerCase();
  const s=String(service||'').toLowerCase();
  const d=String(description||'').toLowerCase();
  const profile=AQBGetPexelsVisualProfile(service,category,description);
  let score=0;

  // Hard reject: Pexels metadata contains a disallowed or clearly unrelated concept.
  for(let i=0;i<profile.forbidden.length;i++){
    if(hay.indexOf(profile.forbidden[i])>=0)return 0;
  }

  // Representation is required for the AQB catalogue.
  if(profile.audience==='child'){
    if(!/child|children|kid|kids|girl|boy|teen/.test(hay))return 0;
    if(/woman|women|adult|man|men/.test(hay) && !/girl|child|kid|teen/.test(hay))return 0;
    score+=8;
  }else{
    // Adult imagery must not contain an explicit male signal unless the service permits men.
    // Female metadata is a positive signal, not a mandatory word-level requirement.
    const explicitMale=/\b(?:man|men|male|boy|boys)\b/.test(hay);
    const explicitFemale=/\b(?:woman|women|female|lady|girl)\b/.test(hay);
    const neutralDetail=/hair|hairstyle|braid|braids|twist|twists|cornrow|loc|locks|wig|weave|nail|nails|manicure|pedicure|makeup|facial|skincare|massage|salon|styling|haircut/.test(hay);
    if(!profile.maleAllowed && explicitMale)return 0;
    if(explicitFemale)score+=6;
    else if(!profile.maleAllowed && neutralDetail)score+=4; // neutral hair/service-detail photo is acceptable
    if(/black|african|afro|african american/.test(hay))score+=8;
    else if(/\b(?:white|caucasian|blonde)\b/.test(hay))return 0;
    else if(!neutralDetail)return 0; // metadata with neither audience nor service detail is too ambiguous
    if(profile.maleAllowed && explicitMale)score+=4;
  }

  // Every service must have a concrete service/style match.
  let requiredHits=0;
  const requiredTerms=(relaxed?profile.required.filter(function(t){return !['long','medium','short'].includes(t);}):profile.required);
  requiredTerms.forEach(function(t){
    if(hay.indexOf(t)>=0 || (/(braids|twists|cornrows|locs)$/.test(t) && hay.indexOf(t.replace(/s$/,''))>=0)){score+=8;requiredHits++;}
  });
  if(requiredHits===0){
    // V16.6.20-Beta-C.3: do not discard a plausible Pexels result merely
    // because its alt text omits the exact style name. The query itself is
    // semantic, and OpenAI + Gemini perform the actual image-level check.
    const genericVisual=/hair|hairstyle|braid|braids|twist|twists|cornrow|loc|locks|wig|weave|salon|styling|haircut|nails|manicure|pedicure|makeup|facial|skincare|massage/.test(hay);
    if(!genericVisual)return 0;
    score+=8;
  }

  profile.preferred.forEach(function(t){if(hay.indexOf(t)>=0)score+=3;});

  // Extra protection against generic portraits: a relevant hair/beauty term must exist.
  if(!/hair|hairstyle|braid|braids|twist|twists|cornrow|loc|locks|wig|weave|salon|styling|nail|makeup|facial|massage|pedicure/.test(hay))return 0;

  // Category/service/description vocabulary improves precision.
  const tokens=(s+' '+String(category||'')+' '+d).split(/[^a-z0-9]+/).filter(function(t){return t.length>=4;});
  let hits=0;
  tokens.slice(0,20).forEach(function(t){if(hay.indexOf(t)>=0)hits++;});
  if(hits>=1)score+=4;
  if(hits>=2)score+=4;

  // Strong explicit service aliases.
  if(/passion\s*twist/.test(s) && /passion\s*twist/.test(hay))score+=12;
  if(/senegalese/.test(s) && /senegalese/.test(hay))score+=12;
  if(/box\s*braid/.test(s) && /box\s*braid/.test(hay))score+=12;
  if(/knotless/.test(s) && /knotless/.test(hay))score+=12;
  if(/cornrow/.test(s) && /cornrow/.test(hay))score+=12;
  if(/sisterlocks?/.test(s) && /sisterlock/.test(hay))score+=12;
  if(/micro\s*twist/.test(s) && /micro\s*twist/.test(hay))score+=12;
  if(/twist/.test(s) && /twist/.test(hay))score+=8;
  if(/bead/.test(s) && /bead/.test(hay))score+=10;
  if(/wash|shampoo|condition/.test(s) && /hair|shampoo|condition|wash/.test(hay))score+=8;
  if(/hair.?care|education|consultation/.test(s) && /hair|care|salon|consult/.test(hay))score+=6;

  // Length checks.
  if(/\blong\b/.test(s) && /long|waist|lengthy/.test(hay))score+=7;
  if(/\bmedium\b/.test(s) && /medium|shoulder/.test(hay))score+=7;
  if(/\bshort\b/.test(s) && /short/.test(hay))score+=7;

  return score;
}

function AQBTestPexelsConnection(){
  throw new Error("PEXELS_RETIRED: Approved AQB Studio originals are the image authority.");
  AQBRequireAdmin();
  const key=String(PropertiesService.getScriptProperties().getProperty('PEXELS_API_KEY')||'').trim();
  if(!key)throw new Error('PEXELS_API_KEY is not set in Script Properties.');
  const res=UrlFetchApp.fetch('https://api.pexels.com/v1/search?query=Black%20African%20woman%20hairstyle&per_page=1',{
    method:'get',muteHttpExceptions:true,headers:{'Authorization':key,'User-Agent':'Afrikan-Quinn-Beauty-Catalogue/15.6.5'}
  });
  const code=res.getResponseCode();
  if(code<200||code>=300)throw new Error('Pexels API test failed with HTTP '+code+'. Check the API key and Pexels access.');
  const data=JSON.parse(res.getContentText()||'{}');
  return {success:true,photos:Number(data.total_results||0)};
}

function AQBGetCataloguePhotoFolder(){
  const folderId=AQBNormalizeDriveFolderId(AQBGetSetupSetting('Catalogue Own Photo Folder ID'));
  if(!folderId)return {folderId:'',name:''};
  try{return {folderId:folderId,name:DriveApp.getFolderById(folderId).getName(),accessMode:'DRIVE_APP'};}
  catch(driveErr){
    try{
      const res=UrlFetchApp.fetch('https://www.googleapis.com/drive/v3/files/'+encodeURIComponent(folderId)+'?fields=id,name,mimeType&supportsAllDrives=true',{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});
      const code=res.getResponseCode(),body=res.getContentText(),data=body?JSON.parse(body):{};
      if(code>=200&&code<300&&data.mimeType==='application/vnd.google-apps.folder')return {folderId:folderId,name:String(data.name||''),accessMode:'DRIVE_API_FALLBACK'};
      return {folderId:folderId,name:'',error:'The configured Google Drive folder could not be opened. HTTP '+code+'. Re-authorize this web-app deployment for Google Drive or verify folder access.'};
    }catch(apiErr){
      return {folderId:folderId,name:'',error:'Google Drive access is not authorized for this web-app deployment. Re-authorize the deployment for Drive and confirm the configured folder is shared with the executing account.'};
    }
  }
}

function AQBSaveCataloguePhotoFolder(value){
  const user=AQBRequireAdmin();
  const folderId=AQBNormalizeDriveFolderId(value);
  if(!folderId)throw new Error('Please enter a Google Drive folder ID or folder URL.');
  let name='',accessMode='';
  try{const folder=DriveApp.getFolderById(folderId);name=folder.getName();accessMode='DRIVE_APP';}
  catch(driveErr){
    const res=UrlFetchApp.fetch('https://www.googleapis.com/drive/v3/files/'+encodeURIComponent(folderId)+'?fields=id,name,mimeType&supportsAllDrives=true',{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});
    const code=res.getResponseCode(),body=res.getContentText(),data=body?JSON.parse(body):{};
    if(code<200||code>=300||data.mimeType!=='application/vnd.google-apps.folder')throw new Error('The Google Drive folder could not be opened. Re-authorize this web-app deployment for Google Drive and confirm the folder is accessible to the executing account. HTTP '+code+'.');
    name=String(data.name||'');accessMode='DRIVE_API_FALLBACK';
  }
  AQBSetSetupSetting('Catalogue Own Photo Folder ID',folderId);
  AQBLogAudit('SAVE_CATALOGUE_PHOTO_PATH','Catalogue',folderId,'Admin '+user.email+' configured the own-photo upload folder: '+name+'. Access='+accessMode+'.');
  return {success:true,folderId:folderId,name:name,accessMode:accessMode};
}

function AQBGetImageContentHashFromDriveUrl(url){
  const id=AQBExtractDriveFileId(url); if(!id)return '';
  try{return AQBGenerateSha256Hex(Utilities.base64Encode(DriveApp.getFileById(id).getBlob().getBytes()));}catch(e){return '';}
}

function AQBSaveCatalogueOwnPhoto(payload){
  const user=AQBRequireCataloguePhotoManager();
  if(!payload)throw new Error('No photo information was received.');
  const catalogueId=String(payload.catalogueId||'').trim(), service=String(payload.service||'').trim();
  if(!catalogueId||!service)throw new Error('Please select a valid catalogue service.');
  const dataUrl=String(payload.dataUrl||'').trim();
  if(!dataUrl||!/^data:image\/(jpeg|jpg|png|webp);base64,/i.test(dataUrl))throw new Error('Please choose a JPG, PNG or WebP image.');
  const folderInfo=AQBGetCataloguePhotoFolder();
  if(!folderInfo.folderId)throw new Error('Configure the Own Photo Upload Path in Settings before uploading a catalogue photo.');
  if(folderInfo.error)throw new Error(folderInfo.error);

  const sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE), n=sheet.getLastRow(), cm=AQBBuildHeaderMap(sheet);
  let rowNum=null,row=null;
  if(n>=2){
    const rows=sheet.getRange(2,1,n-1,sheet.getLastColumn()).getValues();
    for(let i=0;i<rows.length;i++){
      if(String(rows[i][cm['Catalogue ID']-1]||'').trim()===catalogueId){rowNum=i+2;row=rows[i];break;}
    }
  }
  if(!rowNum)throw new Error('Catalogue record not found for the selected service.');
  const catalogueService=String(row[cm['Service Name']-1]||'').trim();
  const catalogueCategory=cm['Category']?String(row[cm['Category']-1]||'').trim():'';
  if(!catalogueService || catalogueService!==service)throw new Error('The selected service does not match the Catalogue record. Refresh the Catalogue and try again.');
  const meta={service:catalogueService,category:catalogueCategory};
  const match=dataUrl.match(/^data:image\/([^;]+);base64,(.+)$/i); if(!match)throw new Error('The selected image could not be read.');
  const mime='image/'+String(match[1]).toLowerCase().replace('jpg','jpeg');
  const bytes=Utilities.base64Decode(match[2]);
  if(bytes.length>10*1024*1024)throw new Error('Please use an image smaller than 10 MB.');
  const contentHash=AQBGenerateSha256Hex(Utilities.base64Encode(bytes));
  if(AQBCheckCatalogueImageHashExists(contentHash,catalogueId)){
    const repair=AQBValidateCataloguePhotos();
    throw new Error('This photo is already assigned to another AQB Catalogue service. AQB did not assign the duplicate. Automatic unique-photo replacement has been started for the selected service.');
  }
  const safeService=service.replace(/[^a-z0-9]+/gi,'-').replace(/^-|-$/g,'').slice(0,70)||'catalogue-photo';
  const fileName=safeService+'-'+catalogueId+'.'+(mime==='image/png'?'png':mime==='image/webp'?'webp':'jpg'),blob=Utilities.newBlob(bytes,mime,fileName);
  let fileId='',fileUrl='',sharingWarning='',accessMode='DRIVE_APP';
  try{
    const folder=DriveApp.getFolderById(folderInfo.folderId),file=folder.createFile(blob);
    fileId=file.getId();fileUrl=file.getUrl();
    try{file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);}catch(e){sharingWarning='Google Drive sharing policy prevented automatic public link access. Make the uploaded file viewable to anyone with the link for the public catalogue to display it.';}
  }catch(driveErr){
    accessMode='DRIVE_API_FALLBACK';
    const boundary='aqb_'+Utilities.getUuid().replace(/-/g,''),meta=JSON.stringify({name:fileName,parents:[folderInfo.folderId]}),
          head='--'+boundary+'\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n'+meta+'\r\n--'+boundary+'\r\nContent-Type: '+mime+'\r\n\r\n',tail='\r\n--'+boundary+'--',
          payload=Utilities.newBlob(head).getBytes().concat(bytes,Utilities.newBlob(tail).getBytes());
    const upload=UrlFetchApp.fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name,webViewLink&supportsAllDrives=true',{method:'post',headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken(),'Content-Type':'multipart/related; boundary='+boundary},payload:payload,muteHttpExceptions:true});
    const uploadCode=upload.getResponseCode(),uploadText=upload.getContentText();
    let uploaded={};try{uploaded=uploadText?JSON.parse(uploadText):{};}catch(ignore){}
    if(uploadCode<200||uploadCode>=300||!uploaded.id)throw new Error('Google Drive upload is not authorized for this web-app deployment. Re-authorize Drive access and redeploy using an account that can write to the configured AQB photo folder. HTTP '+uploadCode+'.');
    fileId=String(uploaded.id);fileUrl=String(uploaded.webViewLink||('https://drive.google.com/file/d/'+fileId+'/view'));
    const permission=UrlFetchApp.fetch('https://www.googleapis.com/drive/v3/files/'+encodeURIComponent(fileId)+'/permissions?supportsAllDrives=true',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},payload:JSON.stringify({role:'reader',type:'anyone'}),muteHttpExceptions:true});
    if(permission.getResponseCode()<200||permission.getResponseCode()>=300)sharingWarning='Photo uploaded, but Google Drive sharing policy prevented automatic public-link access. Make the uploaded file viewable to anyone with the link.';
  }
  // V16.21.16.7: Own Photo Manager stores a REVIEW CANDIDATE only.
  // No Catalogue, public snapshot, publication or approval writes are allowed here.
  const imageUrl='https://drive.google.com/uc?export=view&id='+fileId;
  const stage=AQBGetSpreadsheet().getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
  if(!stage)throw new Error('AQB Photo Staging is missing. Uploaded Drive file '+fileId+' requires manual review.');
  const sh=AQBBuildHeaderMap(stage), sv=stage.getDataRange().getValues();
  if(!sh['Catalogue ID']||!sh['Candidate Image URL'])throw new Error('Staging headers missing; uploaded file '+fileId+' not registered.');
  const matched=[];
  for(let i=1;i<sv.length;i++)if(String(sv[i][sh['Catalogue ID']-1]||'').trim().toUpperCase()===catalogueId.toUpperCase())matched.push(i+1);
  if(matched.length!==1)throw new Error('Expected exactly one staging record for '+catalogueId+'; found '+matched.length+'. Drive file '+fileId+' preserved.');
  const stageRow=matched[0],previous={};
  ['Candidate Image URL','Candidate Source URL','Candidate Source','Qualification Status','Review Reason','Photo Provenance'].forEach(function(h){if(sh[h])previous[h]=sv[stageRow-1][sh[h]-1];});
  // Append durable candidate history before replacement; never replace an approved public photo.
  const logName='AQB Photo Candidate History';
  let ledger=AQBGetSpreadsheet().getSheetByName(logName);
  if(!ledger){ledger=AQBGetSpreadsheet().insertSheet(logName);ledger.appendRow(['At','Catalogue ID','Action','Prior Candidate JSON','New File ID','New File URL','Actor']);}
  ledger.appendRow([new Date(),catalogueId,'STAGE_OWN_PHOTO',JSON.stringify(previous),fileId,fileUrl,user.email]);
  if(sh['Candidate Image URL'])stage.getRange(stageRow,sh['Candidate Image URL']).setValue(imageUrl);
  if(sh['Candidate Source URL'])stage.getRange(stageRow,sh['Candidate Source URL']).setValue(fileUrl);
  if(sh['Candidate Source'])stage.getRange(stageRow,sh['Candidate Source']).setValue(String(payload.source||'AQB Studio'));
  if(sh['Qualification Status'])stage.getRange(stageRow,sh['Qualification Status']).setValue('PENDING_REVIEW');
  if(sh['Review Reason'])stage.getRange(stageRow,sh['Review Reason']).setValue('New Own Photo candidate; requires exact-service review and Admin/Manager approval.');
  if(sh['Photo Provenance'])stage.getRange(stageRow,sh['Photo Provenance']).setValue(String(payload.provenance||'AI-generated representative concept; not documented AQB salon work'));
  return {catalogueId:catalogueId,fileId:fileId,imageUrl:imageUrl,staged:true,published:false,publicationWrites:0,historySheet:logName,warning:sharingWarning};

  /* Legacy direct-publication implementation retained below for reference only; unreachable via this entry point. */
  if(cm['Own Photo'])row[cm['Own Photo']-1]=imageUrl;
  if(cm['Image Status'])row[cm['Image Status']-1]='AQB Own Photo';
  if(cm['Image Source'])row[cm['Image Source']-1]='AQB Own Photo';
  if(cm['Image Source URL'])row[cm['Image Source URL']-1]=fileUrl;
  if(cm['Image Use Note'])row[cm['Image Use Note']-1]='Uploaded by AQB admin for '+meta.category+' / '+meta.service+'.';
  if(cm['Image Search Match'])row[cm['Image Search Match']-1]='AQB own photo';
  if(cm['Image Content Hash'])row[cm['Image Content Hash']-1]=contentHash;
  if(cm['Publication Status'])row[cm['Publication Status']-1]='PUBLISHABLE';
  // Durable pre-write snapshot of ACTUAL image columns and the public derivative.
  // No positional column assumptions; the snapshot is committed before publication.
  const rollbackSheetName='AQB Photo Rollback Log';
  const snapshotBook=AQBGetSpreadsheet();
  let rollbackSheet=snapshotBook.getSheetByName(rollbackSheetName);
  if(!rollbackSheet){rollbackSheet=snapshotBook.insertSheet(rollbackSheetName);rollbackSheet.appendRow(['Timestamp','Transaction ID','Catalogue ID','Action','Catalogue Before JSON','Public Before JSON','Status','Actor']);}
  const snapshotId=Utilities.getUuid(), photoFields=['Own Photo','Image URL','Image Status','Image Source','Image Source URL','Image Use Note','Image Search Match','Image Content Hash','Photo Provenance','Qualification Status','Publication Status'];
  const priorCatalogue=sheet.getRange(rowNum,1,1,sheet.getLastColumn()).getValues()[0];
  const extract=(values,map)=>{const o={};photoFields.forEach(k=>{if(map[k])o[k]=values[map[k]-1];});return o;};
  const publicSheetBefore=AQBGetSheet(CONFIG.SHEETS.PUBLIC_CATALOGUE),publicMapBefore=AQBBuildHeaderMap(publicSheetBefore);
  let publicBefore={};
  if(publicMapBefore['Catalogue ID']&&publicSheetBefore.getLastRow()>1){
    const pv=publicSheetBefore.getRange(2,1,publicSheetBefore.getLastRow()-1,publicSheetBefore.getLastColumn()).getValues();
    const match=pv.find(r=>String(r[publicMapBefore['Catalogue ID']-1]||'').trim().toUpperCase()===catalogueId.toUpperCase());
    if(match)publicBefore=extract(match,publicMapBefore);
  }
  rollbackSheet.appendRow([new Date(),snapshotId,catalogueId,'SAVE_OWN_PHOTO',JSON.stringify(extract(priorCatalogue,cm)),JSON.stringify(publicBefore),'SNAPSHOT_WRITTEN',user.email]);
  SpreadsheetApp.flush();
  const snapshotLedgerRow=rollbackSheet.getLastRow();
  // Only image fields are changed. Master Lists metadata remains untouched.
  try{
    sheet.getRange(rowNum,1,1,sheet.getLastColumn()).setValues([row]);
    SpreadsheetApp.flush();
    const verifyRow=sheet.getRange(rowNum,1,1,sheet.getLastColumn()).getValues()[0];
    const verifyUrl=String((cm['Own Photo']?verifyRow[cm['Own Photo']-1]:verifyRow[cm['Image URL']-1])||'').trim();
    if(verifyUrl!==imageUrl)throw new Error('Photo was uploaded to Drive but the Catalogue record could not be verified as saved.');
  }catch(writeError){
    try{AQBRestoreCataloguePhotoSnapshot(snapshotId);}catch(rollbackError){
      rollbackSheet.getRange(snapshotLedgerRow,7).setValue('ROLLBACK_FAILED');
      throw new Error('Photo publication failed and rollback needs staff intervention: '+String(writeError)+' / '+String(rollbackError));
    }
    throw writeError;
  }

  // immediately. Do not rebuild all 232 Catalogue services for a one-photo change.
  let publicRowUpdated=false,cacheUpdated=false;
  try{
    const publicSheet=AQBGetSheet(CONFIG.SHEETS.PUBLIC_CATALOGUE),pn=publicSheet.getLastRow(),pm=AQBBuildHeaderMap(publicSheet);
    if(pn>=2&&pm['Catalogue ID']){
      const pRows=publicSheet.getRange(2,1,pn-1,publicSheet.getLastColumn()).getValues();
      for(let i=0;i<pRows.length;i++){
        if(String(pRows[i][pm['Catalogue ID']-1]||'').trim().toUpperCase()!==catalogueId.toUpperCase())continue;
        if(pm['Image URL'])pRows[i][pm['Image URL']-1]=imageUrl;
        if(pm['Image Status'])pRows[i][pm['Image Status']-1]='AQB Own Photo';
        if(pm['Image Source'])pRows[i][pm['Image Source']-1]='AQB Own Photo';
        if(pm['Prepared At'])pRows[i][pm['Prepared At']-1]=new Date();
        publicSheet.getRange(i+2,1,1,publicSheet.getLastColumn()).setValues([pRows[i]]);
        publicRowUpdated=true;break;
      }
    }
    SpreadsheetApp.flush();
  }catch(ignorePublicRow){}
  try{
    const publicData=AQBGetCataloguePublicData();
    const patch=function(x){if(!x||String(x.catalogueId||'').trim().toUpperCase()!==catalogueId.toUpperCase())return false;x.image=imageUrl;x.imageStatus='AQB Own Photo';x.imageSource='AQB Own Photo';return true;};
    let touched=false;
    (publicData.items||[]).forEach(function(x){if(patch(x))touched=true;});
    (publicData.canonicalTrending||[]).forEach(function(x){if(patch(x))touched=true;});
    (publicData.mostLoved||[]).forEach(function(x){if(patch(x))touched=true;});
    if(touched){publicData.preparedAt=new Date().toISOString();AQBCachePublicCatalogueSnapshot(publicData);cacheUpdated=true;}
  }catch(ignoreCache){}

  rollbackSheet.getRange(snapshotLedgerRow,7).setValue('COMMITTED');
  AQBLogAudit('SAVE_CATALOGUE_OWN_PHOTO','Catalogue',catalogueId,user.role+' '+user.email+' uploaded/updated own photo for '+meta.category+' / '+meta.service+'. PublicRow='+publicRowUpdated+' Cache='+cacheUpdated+'.');
  return {success:true,version:'V16.21.14-CleanApp',catalogueId:catalogueId,service:meta.service,category:meta.category,imageUrl:imageUrl,warning:sharingWarning,driveAccessMode:accessMode,publicRowUpdated:publicRowUpdated,cacheUpdated:cacheUpdated,catalogueUpdated:true};
}

function AQBRestoreCataloguePhotoSnapshot(transactionId){
  AQBRequireCataloguePhotoManager();
  const key=String(transactionId||'').trim();if(!key)throw new Error('A rollback Transaction ID is required.');
  const ss=AQBGetSpreadsheet(),log=ss.getSheetByName('AQB Photo Rollback Log');
  if(!log||log.getLastRow()<2)throw new Error('No durable photo snapshots are available.');
  const entries=log.getRange(2,1,log.getLastRow()-1,8).getValues();
  let found=null,index=-1;for(let i=entries.length-1;i>=0;i--)if(String(entries[i][1])===key){found=entries[i];index=i+2;break;}
  if(!found)throw new Error('Snapshot transaction not found.');
  if(String(found[6])==='RESTORED')return {success:true,alreadyRestored:true,transactionId:key};
  const id=String(found[2]||'').trim().toUpperCase();
  const restore=(sheetName,encoded)=>{
    const before=JSON.parse(String(encoded||'{}'));if(!Object.keys(before).length)return false;
    const sh=AQBGetSheet(sheetName),hm=AQBBuildHeaderMap(sh);
    if(!hm['Catalogue ID'])throw new Error('Missing Catalogue ID column on '+sheetName);
    const data=sh.getDataRange().getValues();
    for(let i=1;i<data.length;i++){
      if(String(data[i][hm['Catalogue ID']-1]||'').trim().toUpperCase()!==id)continue;
      Object.keys(before).forEach(k=>{if(hm[k])sh.getRange(i+1,hm[k]).setValue(before[k]??'');});return true;
    }
    throw new Error('Cannot restore; missing service '+id+' in '+sheetName);
  };
  const restoredCatalogue=restore(CONFIG.SHEETS.CATALOGUE,found[4]);
  const restoredPublic=restore(CONFIG.SHEETS.PUBLIC_CATALOGUE,found[5]);
  SpreadsheetApp.flush();
  log.getRange(index,7).setValue('RESTORED');
  AQBLogAudit('RESTORE_CATALOGUE_PHOTO','Catalogue',id,'Photo rollback transaction '+key+' was restored. Refresh public cache before accepting publication.');
  return {success:true,transactionId:key,catalogueId:id,restoredCatalogue,restoredPublic,publicCacheRefreshRequired:true};
}

function AQBValidateCatalogueImageUrls(rows,m){
  const result={}, urls=[];
  rows.forEach(function(r){
    const own=String(m['Own Photo']?r[m['Own Photo']-1]||'':'').trim();
    const online=String(m['Image URL']?r[m['Image URL']-1]||'':'').trim();
    const image=own||online; if(!image||result[image]!==undefined)return;
    if(own){const id=AQBExtractDriveFileId(own); if(id){try{const file=DriveApp.getFileById(id); const mt=String(file.getMimeType()||'').toLowerCase(); result[image]=/^image\/(jpeg|png|webp)$/.test(mt); return;}catch(e){result[image]=false;return;}}}
    if(/^https?:\/\//i.test(image))urls.push(image); else result[image]=false;
  });
  for(let start=0;start<urls.length;start+=20){
    const batch=urls.slice(start,start+20).map(function(url){return {url:url,method:'get',muteHttpExceptions:true,followRedirects:true,headers:{'User-Agent':'Mozilla/5.0'}};});
    try{const responses=UrlFetchApp.fetchAll(batch);responses.forEach(function(res,i){const type=String(res.getHeaders()['Content-Type']||res.getHeaders()['content-type']||'').toLowerCase();const code=res.getResponseCode();result[urls[start+i]]=code>=200&&code<400&&/^image\/(jpeg|png|webp)/.test(type);});}
    catch(e){batch.forEach(function(req){result[req.url]=false;});}
  }
  return result;
}

