  let analysed=0,opportunities=0,hot=0,watch=0;const now=new Date();
  rows.forEach(r=>{const trendId=String(r[m['Trend ID']-1]||'').trim(),name=String(r[m['Style Name']-1]||'').trim(),cat=String(r[m['Category']-1]||'').trim(),activity=String(r[m['Trend Activity']-1]||'').trim().toUpperCase(),status=String(r[m['Status']-1]||'').trim().toUpperCase();
    // Only verified DNB-sourced Inbox signals may generate scheduled intelligence.
    // Manual Google research is an Inbox review flow, never scheduled discovery.
    const rt=String(r[m['Record Type']-1]||'').trim().toUpperCase(),src=m['Source']?String(r[m['Source']-1]||''):'';
    const evidenceTag=m['Source Evidence']?String(r[m['Source Evidence']-1]||''):'';
