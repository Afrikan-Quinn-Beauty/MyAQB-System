function AQBGetTrendInboxAdmin(){
  AQBRequireCataloguePhotoManager(); AQBEnsureAISheets();
  const s=AQBGetSheet('AQB AI Signals'),m=AQBBuildHeaderMap(s),n=s.getLastRow(),rows=n<2?[]:s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  const active=rows.filter(function(r){
    const rt=String(r[m['Record Type']-1]||'').toUpperCase();
    return rt==='TREND_INBOX' && String(r[m['Status']-1]||'').trim().toUpperCase()==='PENDING';
  });
  const normName=x=>String(x||'').normalize('NFKC').toLowerCase().trim().replace(/\s+/g,' ');
  const firstByName={};active.forEach(function(r){const key=normName(r[m['Style Name']-1]);if(key&&!firstByName[key])firstByName[key]=String(r[m['Trend ID']-1]||'');});
  return active.map(function(r){const o={}; TREND_INBOX_HEADERS.forEach(function(h){o[h]=m[h]?r[m[h]-1]:'';}); o['Service Name']=m['Service Name']?r[m['Service Name']-1]:'';
    const nm=String(o['Style Name']||'').trim(), cat=String(o['Category']||'').trim();
    const srcUrl=String(o['Source URL']||'').trim(), evidence=String(o['Source Evidence']||'').trim();
    const source=String(o['Source']||'').trim();
    const validSource=/^https:\/\/[^\s/]+\.[^\s/]+/i.test(srcUrl);
    const placeholder=/no new high.signal trend has been identified/i.test([nm,o['Description'],evidence].join(' '));
    const isDuplicate=!!(nm&&firstByName[normName(nm)]!==String(o['Trend ID']||''));
    const unverified=/SOURCE_REVIEW_REQUIRED|SOURCE REVIEW REQUIRED|not verified|original article.*verif/i.test([evidence,o['Review Notes']||''].join(' '));
    // V16.21.15.5.6: Kenya-first, evidence-based qualification. A free-text
    // description or search redirect is a research lead, NOT trend proof.
    // The structured evidence lives in the existing Source Evidence field.
    let pack=null;
    try{pack=JSON.parse(evidence);}catch(ignore){}
    const structured=!!(pack&&pack.schema==='AQB_TREND_EVIDENCE_V1'&&Array.isArray(pack.sources));
    const now=Date.now(),seen={},verified=[];
    if(structured){
      pack.sources.forEach(function(item){
        if(!item||item.styleName!==nm||item.exactStyleMatch!==true)return;
        const url=String(item.url||'').trim(),host=(url.match(/^https:\/\/([^/]+)/i)||[])[1]||'';
        const date=Date.parse(item.observedAt||'');
        if(!host||!Number.isFinite(date)||date>now+86400000||now-date>90*86400000)return;
        if(/(^|\.)news\.google\.com$|(^|\.)google\.com$/i.test(host))return;
        const publisher=String(item.publisher||'').trim();
        if(!publisher)return;
        const identity=host.toLowerCase()+'|'+publisher.toLowerCase();
        if(seen[identity])return;seen[identity]=true;
        verified.push({item:item,host:host,ageDays:(now-date)/86400000});
      });
    }
    const kenyan=verified.filter(x=>/^(KE|KENYA)$/i.test(String(x.item.country||'').trim()));
    const momentum=verified.some(x=>{
      const b=Number(x.item.baselineCount),c=Number(x.item.currentCount);
      return Number.isFinite(b)&&Number.isFinite(c)&&b>=1&&c>b&&
        String(x.item.metric||'').trim()!==''&&String(x.item.measurementWindow||'').trim()!=='';
    });
    const fresh=verified.some(x=>x.ageDays<=30);
    const assessed=structured&&pack.aqbFit===true&&pack.canonicalMatchReviewed===true;
    const variation=structured&&pack.distinctVariation===true;
    const localRationale=structured&&String(pack.kenyaEntryRationale||'').trim().length>=30;
    const points={authenticity:Math.min(20,verified.length*10),momentum:momentum?25:0,
      kenyaRelevance:kenyan.length?20:(localRationale?6:0),freshness:fresh?10:0,
      aqbServiceFit:assessed?15:0,distinctiveness:variation?10:0};
    const score=Object.keys(points).reduce((a,k)=>a+points[k],0);
    const qualificationIssues=[];
    if(!structured)qualificationIssues.push('STRUCTURED_EVIDENCE_REQUIRED');
    if(verified.length<2)qualificationIssues.push('TWO_INDEPENDENT_ORIGINAL_SOURCES_REQUIRED');
    if(!verified.some(x=>String(x.item.url||'').trim()===srcUrl))qualificationIssues.push('PRIMARY_SOURCE_NOT_VERIFIED');
    if(!momentum)qualificationIssues.push('MEASURABLE_MOMENTUM_REQUIRED');
    if(!kenyan.length&&!localRationale)qualificationIssues.push('KENYA_EVIDENCE_OR_ENTRY_RATIONALE_REQUIRED');
    if(!assessed)qualificationIssues.push('AQB_FIT_AND_CANONICAL_REVIEW_REQUIRED');
    if(score<70)qualificationIssues.push('TREND_SCORE_BELOW_70');
    if(isDuplicate)qualificationIssues.unshift('DUPLICATE_SUGGESTION');
    o['Qualification Score']=score;
    o['Qualification Breakdown']=points;
    o['Qualification Sources']=verified.length;
    o['Kenya Evidence Sources']=kenyan.length;
    o['Qualification Issues']=qualificationIssues;
    o['Approval Eligible']=!!(nm&&cat&&validSource&&evidence&&!placeholder&&!unverified&&qualificationIssues.length===0);
    o['Approval Issue']=isDuplicate?'DUPLICATE_SUGGESTION':o['Approval Eligible']?'':(!nm?'MISSING_STYLE_NAME':!cat?'MISSING_CATEGORY':placeholder?'INFORMATIONAL_PLACEHOLDER':unverified?'SOURCE_REVIEW_REQUIRED':!validSource?'UNVERIFIED_SOURCE_URL':!evidence?'MISSING_SOURCE_EVIDENCE':qualificationIssues[0]||'REVIEW_REQUIRED');
    return o;})
    .sort(function(a,b){return new Date(b['Discovered At']||b['Created At']||0)-new Date(a['Discovered At']||a['Created At']||0);}).slice(0,200);
}

