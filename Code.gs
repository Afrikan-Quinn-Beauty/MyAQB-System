function AQBParseDateFromClient(value){
  if(!value)return null;
  if(value instanceof Date)return new Date(value);
  const t=String(value).trim();
  if(/^\d{4}-\d{2}-\d{2}$/.test(t)){const p=t.split('-');return new Date(Number(p[0]),Number(p[1])-1,Number(p[2]));}
  const d=new Date(t); if(isNaN(d.getTime()))throw new Error('Invalid date: '+t); return d;
}

function AQBParseTimeFromClient(value){
  if(!value)return null;
  let t=String(value).trim();
  if(/^\d{4}$/.test(t))t=t.slice(0,2)+':'+t.slice(2);
  if(!/^\d{1,2}:\d{2}$/.test(t))throw new Error('Invalid time: '+t);
  const p=t.split(':'),h=Number(p[0]),m=Number(p[1]); if(h<0||h>23||m<0||m>59)throw new Error('Invalid time: '+t); return {hours:h,minutes:m};
}

function AQBFormatDateForClient(v){if(!v)return '';const d=v instanceof Date?v:new Date(v);if(isNaN(d.getTime())||d.getFullYear()<2000)return '';return Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy-MM-dd');}

function AQBFormatTimeForClient(v){if(!v)return '';const d=v instanceof Date?v:new Date(v);if(isNaN(d.getTime()))return '';return Utilities.formatDate(d,Session.getScriptTimeZone(),'HH:mm');}

function AQBAuditCustomerIdentityUniqueness(){
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow(),m=AQBBuildHeaderMap(s);
  const byId={},byPhone={},missing=[];
  if(n>=2)s.getRange(2,1,n-1,s.getLastColumn()).getValues().forEach(function(r,i){
    const id=AQBNormalizeCustomerId_(r[m['Customer ID']-1]),phone=AQBNormalizeCustomerPhone_(r[m['WhatsApp Number']-1]);
    if(!id||!phone)missing.push(i+2);
    if(id)(byId[id]||(byId[id]=[])).push(i+2);
    if(phone)(byPhone[phone]||(byPhone[phone]=[])).push(i+2);
  });
  const duplicates=function(x){return Object.keys(x).filter(k=>x[k].length>1).map(k=>({key:k,rows:x[k]}));};
  return {version:'V16.21.16.8.6',readOnly:true,rows:Math.max(0,n-1),duplicateIds:duplicates(byId),duplicatePhones:duplicates(byPhone),missingIdentityRows:missing,writes:0};
}

function AQBReconcileDuplicateCustomerProfiles(options){
  const admin=AQBRequireAdmin(); options=options||{};
  const expected={'AQB022':{count:2,serviceDate:'2026-10-20',nextDate:'2026-12-01',reminderDate:'2026-11-28'},
                  'AQB027':{count:4,serviceDate:'2026-10-18',nextDate:'2026-11-30',reminderDate:'2026-11-27'}};
  const commit=options.commit===true;
  if(commit&&options.confirm!=='RECONCILE_AQB022_AQB027_20261020')throw new Error('Explicit confirmation token is required.');
  const lock=LockService.getScriptLock();if(commit)lock.waitLock(30000);
  try{
    const ss=AQBGetSpreadsheet(),sheet=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),hm=AQBBuildHeaderMap(sheet),cols=sheet.getLastColumn(),last=sheet.getLastRow();
    ['Customer ID','WhatsApp Number','Last Retie Date','Next Retie Date','Reminder Date','Total Visits','Next Appointment Created'].forEach(k=>{if(!hm[k])throw new Error('Missing Customers column '+k);});
    const rows=last>1?sheet.getRange(2,1,last-1,cols).getValues():[];
    const byId={},byPhone={};rows.forEach((r,i)=>{
      const id=String(r[hm['Customer ID']-1]||'').trim().toUpperCase(),phone=AQBNormalizePhone(r[hm['WhatsApp Number']-1]);
      (byId[id]||(byId[id]=[])).push({row:i+2,data:r});
      (byPhone[phone]||(byPhone[phone]=[])).push({row:i+2,data:r});
    });
    const allDuplicateIds=Object.keys(byId).filter(k=>k&&byId[k].length>1);
    const otherDuplicates=allDuplicateIds.filter(id=>!expected[id]);
    if(otherDuplicates.length)throw new Error('Unanticipated duplicate IDs: '+otherDuplicates.join(',')+'. Abort to audit first.');
    const proposals=Object.keys(expected).map(id=>{
      const spec=expected[id],group=byId[id]||[];
      if(group.length!==spec.count)throw new Error(id+' has '+group.length+' rows; expected '+spec.count+'. Stop to audit current sheet.');
      const phones=[...new Set(group.map(x=>AQBNormalizePhone(x.data[hm['WhatsApp Number']-1])))];
      if(phones.length!==1||!AQBIsValidPhone(phones[0]))throw new Error(id+' has conflicting/invalid WhatsApp identities.');
      if((byPhone[phones[0]]||[]).length!==group.length)throw new Error(id+' phone is shared with another identity.');
      // Use the most recently evidenced visit total as a conservative unverified counter.
      // Preserve all original rows in a full-sheet snapshot before any mutation.
      const keep=group[0],maxVisits=Math.max(...group.map(x=>Number(x.data[hm['Total Visits']-1]||0)));
      return {id,rows:group.map(x=>x.row),retainedRow:keep.row,archivedRows:group.slice(1).map(x=>x.row),actualServiceDate:spec.serviceDate,nextRetieDate:spec.nextDate,reminderDate:spec.reminderDate,visitsRetainedUnverified:maxVisits,phone:phones[0],_keep:keep};
    });
    const preview={version:'V16.21.16.8.6',readOnly:!commit,mode:commit?'COMMIT':'PREVIEW',beforeRows:rows.length,beforeUniqueIds:Object.keys(byId).filter(Boolean).length,proposals:proposals.map(p=>({id:p.id,rows:p.rows,retainedRow:p.retainedRow,archivedRows:p.archivedRows,actualServiceDate:p.actualServiceDate,nextRetieDate:p.nextRetieDate,reminderDate:p.reminderDate,visitsRetainedUnverified:p.visitsRetainedUnverified})),appointmentWrites:0,paymentWrites:0};
    if(!commit)return preview;
    // Full spreadsheet sheet copy captures exact prior content and formatting.
    const backup=sheet.copyTo(ss),backupName='Customers BACKUP '+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd_HHmmss');
    backup.setName(backupName);
    SpreadsheetApp.flush();
    const toDelete=[];
    proposals.forEach(p=>{
      const edited=p._keep.data.slice(),spec=expected[p.id];
      const parseISO=d=>{const a=d.split('-').map(Number);return new Date(a[0],a[1]-1,a[2]);};
      edited[hm['Last Retie Date']-1]=parseISO(spec.serviceDate);
      edited[hm['Next Retie Date']-1]=parseISO(spec.nextDate);
      edited[hm['Reminder Date']-1]=parseISO(spec.reminderDate);
      edited[hm['Total Visits']-1]=p.visitsRetainedUnverified;
      // Retain booking flag until a separate appointment-authority audit; avoid new automatic booking creation.
      sheet.getRange(p.retainedRow,1,1,cols).setValues([edited]);
      toDelete.push(...p.archivedRows);
    });
    toDelete.sort((a,b)=>b-a).forEach(row=>sheet.deleteRow(row));
    const verified=AQBAuditCustomerIdentityUniqueness();
    if(verified.duplicateIds.length||verified.duplicatePhones.length)throw new Error('Post-migration uniqueness verification failed. Backup: '+backupName);
    AQBLogAudit('AQB_CUSTOMER_IDENTITY_RECONCILIATION','Customer','AQB022,AQB027','Backed up Customers to '+backupName+'; removed '+toDelete.length+' extra rows; actual service dates corrected; historical visits retained as unverified max; appointments and payments unchanged.');
    return {...preview,readOnly:false,backupSheet:backupName,removedExtraRows:toDelete.length,afterRows:verified.rows,afterDuplicateIds:verified.duplicateIds,afterDuplicatePhones:verified.duplicatePhones,warning:'Retained Next Appointment Created from primary rows pending audit of automatic appointment authority; do not run retie repair until reviewed.'};
  }finally{if(commit)lock.releaseLock();}
}

function AQBAssertUniqueCustomerRow(sheet,row,excludeRow){
  const m=AQBBuildHeaderMap(sheet),id=AQBNormalizeCustomerId_(row[m['Customer ID']-1]),phone=AQBNormalizeCustomerPhone_(row[m['WhatsApp Number']-1]);
  if(!id||!phone)throw new Error('Valid Customer ID and Kenyan WhatsApp number required.');
  if(AQBIsTestCustomer(id))throw new Error('AQB001–AQB003 are reserved.');
  const n=sheet.getLastRow();if(n<2)return;
  const data=sheet.getRange(2,1,n-1,sheet.getLastColumn()).getValues();
  data.forEach(function(r,i){const rowNum=i+2;if(rowNum===excludeRow)return;
    if(AQBNormalizeCustomerId_(r[m['Customer ID']-1])===id)throw new Error('Duplicate Customer ID '+id+' at row '+rowNum);
    if(AQBNormalizeCustomerPhone_(r[m['WhatsApp Number']-1])===phone)throw new Error('Phone belongs to existing '+String(r[m['Customer ID']-1]||'')+' at row '+rowNum+'; reuse that profile.');
  });
}

function AQBAppendUniqueCustomerRow(sheet,row){
  AQBAssertUniqueCustomerRow(sheet,row,0);
  const phoneCol=AQBBuildHeaderMap(sheet)['WhatsApp Number'];
  const destination=sheet.getLastRow()+1;
  if(phoneCol)sheet.getRange(destination,phoneCol).setNumberFormat('@');
  sheet.appendRow(row);
  if(phoneCol)sheet.getRange(destination,phoneCol).setValue(String(row[phoneCol-1]||''));
}

function AQBAssertSingleCustomerMatch(customerId){
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow();if(n<2)return;
  const m=AQBBuildHeaderMap(s),id=String(customerId||'').trim().toUpperCase();let count=0;
