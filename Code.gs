function AQBGetCustomerPaymentSummary(customerId){const s=AQBGetSheet(CONFIG.SHEETS.PAYMENTS),n=s.getLastRow();let due=0,paid=0;if(n>=2)s.getRange(2,1,n-1,13).getValues().forEach(r=>{if(String(r[2])!==String(customerId)||String(r[10])==='Cancelled')return;due=Math.max(due,Number(r[7]||0));paid+=Number(r[8]||0);});return {due,paid,balance:Math.max(0,due-paid)};}

