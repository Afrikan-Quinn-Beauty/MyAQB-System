  else if(subtype==='LOC_RETWIST') terms=['loc retwist','root maintenance','clean parts'];
  else if(subtype==='WIG_REVAMP') terms=['wig wash','wig revamp','lace wig restoration'];

  if(!terms.length){
    const map={
      CORNROWS:['cornrows','scalp pattern','precision parting'],BRAIDS:['braids','protective hairstyle'],TWISTS:['twists','textured protective hairstyle'],LOCS:['locs','natural hair'],WEAVE:['sew in weave','natural hair'],
      FINGER_COILS:['finger coils','natural hair'],ROD_SETS:['rod set curls','natural hair'],PIXIE_CUT:['pixie cut','black woman'],SILK_PRESS:['silk press','natural hair'],UPDO:['natural hair updo'],BANTU_KNOTS:['bantu knots','natural hair'],
      LOC_INSTALLATION:['loc installation','salon'],LOC_MAINTENANCE:['loc maintenance','salon'],LOC_TREATMENT:['loc treatment','salon'],LOC_DETOX:['loc detox','salon'],LOC_COLOR:['colored locs','salon'],LOC_EXTENSIONS:['loc extensions','salon'],LOC_STYLING_RESULT:['styled locs','black woman'],
