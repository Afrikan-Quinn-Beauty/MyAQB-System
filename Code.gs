    AQBAssertSingleCustomerMatch(customerId);
    AQBAppendByHeaders(AQBGetSheet(CONFIG.SHEETS.PAYMENTS),{'Payment ID':pid,'Date':date,'Customer ID':customerId,'Customer Name':customerName,'Appointment ID':id,'Service':service,'Payment Type':'Service Payment','Amount Due':amount,'Amount':amount,'Payment Method':'Cash','Payment Status':'Paid','Description':'Cash confirmed at service completion','Recorded By':actor.email});
    AQBAppendByHeaders(AQBGetSheet(CONFIG.SHEETS.CASH_FLOW),{'Transaction ID':txid,'Date':date,'Customer ID':customerId,'Customer Name':customerName,'Appointment ID':id,'Service':service,'Transaction Type':'Income','Payment Method':'Cash','Amount':amount,'Payment Status':'Paid','Description':'Payment '+pid+' — completion cash','Recorded By':actor.email,'Source Payment ID':pid});
    AQBUpdateAppointmentPaymentStatus(id);
    AQBUpdateCustomerPaymentStatus(customerId);
    AQBLogAudit('COMPLETION_CASH_RECEIPT','Payment',pid,'Cash KES '+amount+' for '+id+' confirmed by '+actor.email+'; Cash Flow '+txid+'.');
    return {success:true,paymentId:pid,transactionId:txid,amount:amount};
  } finally {lock.releaseLock();}
}


