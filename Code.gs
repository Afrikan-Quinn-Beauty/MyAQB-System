function AQBAuditUnifiedPhotoStaging(){
  AQBRequireAdmin();
  const ss=AQBGetSpreadsheet();
  const sheets={catalogue:ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),photo:ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),cards:ss.getSheetByName('AQB Family Photo Cards')};
  Object.keys(sheets).forEach(function(k){if(!sheets[k])throw Error('Missing required sheet '+k+'; no changes made');});
  function extract(sh,idName){
    const vals=sh.getDataRange().getValues();
    if(vals.length<2)throw Error('Empty sheet '+sh.getName());
    const header=vals[0].map(function(x){return String(x||'').trim();});
    const idx=header.indexOf(idName);
    if(idx<0)throw Error('Missing '+idName+' in '+sh.getName());
    const map={},dupes=[],invalid=[],blank=[];
    vals.slice(1).forEach(function(row,i){
      const id=String(row[idx]||'').trim().toUpperCase();
      if(!id){blank.push(i+2);return;}
      if(!/^AQBCAT\d{3}$/.test(id)){invalid.push({row:i+2,id:id});return;}
      if(map[id])dupes.push({id:id,rows:[map[id].rowNumber,i+2]});
      else map[id]={row:row,rowNumber:i+2};
    });
    return {header:header,map:map,count:vals.length-1,dupes:dupes,invalid:invalid,blank:blank};
  }
  const cat=extract(sheets.catalogue,'Catalogue ID');
  const photo=extract(sheets.photo,'Catalogue ID');
  const cards=extract(sheets.cards,'Canonical Service ID');
  const expected=Object.keys(cat.map).sort();
  const selected=['AQBCAT009','AQBCAT013','AQBCAT053','AQBCAT059','AQBCAT100','AQBCAT102','AQBCAT103','AQBCAT104','AQBCAT142','AQBCAT227'];
  function missing(reference,target){return reference.filter(function(id){return !target.map[id];});}
  function extra(target){return Object.keys(target.map).filter(function(id){return !cat.map[id];}).sort();}
  function field(a,rec,h){const i=a.header.indexOf(h);return i<0?'':String(rec.row[i]||'').trim();}
  const assetDetail=selected.map(function(id){
    const rec=cards.map[id];
    return {id:id,cardRow:rec?rec.rowNumber:null,locator:rec?field(cards,rec,'Card Asset Review Locator'):'',reviewState:rec?field(cards,rec,'Card Asset Review State'):'',photoStageRow:photo.map[id]?photo.map[id].rowNumber:null};
  });
  const statuses={},candidateCounts={catalogue:0,photo:0,cards:0};
  expected.forEach(function(id){
    const c=cat.map[id],p=photo.map[id],f=cards.map[id];
    if(c&&(field(cat,c,'Own Photo')||field(cat,c,'Image URL')))candidateCounts.catalogue++;
    if(p&&(field(photo,p,'Image URL')||field(photo,p,'Own Photo')||field(photo,p,'Photo Candidate URL')||field(photo,p,'Pexels Photo URL')))candidateCounts.photo++;
    if(f&&field(cards,f,'Candidate Image URL (unverified)'))candidateCounts.cards++;
    if(p){const state=field(photo,p,'Qualification Status')||'UNSPECIFIED';statuses[state]=(statuses[state]||0)+1;}
  });
  const problems=[];
  [['Catalogue',cat],['AQB Photo Staging',photo],['AQB Family Photo Cards',cards]].forEach(function(item){
    if(item[1].count!==232)problems.push(item[0]+' contains '+item[1].count+' rows, expected 232');
    if(item[1].dupes.length||item[1].invalid.length||item[1].blank.length)problems.push(item[0]+' has duplicate, invalid or blank IDs');
  });
  const photoMissing=missing(expected,photo),cardsMissing=missing(expected,cards);
  if(photoMissing.length||extra(photo).length)problems.push('Photo Staging ID set differs from canonical Catalogue');
  if(cardsMissing.length||extra(cards).length)problems.push('Family Photo Cards ID set differs from canonical Catalogue');
  assetDetail.forEach(function(a){if(!a.locator||!a.reviewState)problems.push(a.id+' missing selected local asset review metadata');});
  const result={version:'V16.21.15.6.5.4',readOnly:true,writes:0,publications:0,messagesSent:0,
    rows:{catalogue:cat.count,photoStaging:photo.count,familyPhotoCards:cards.count},uniqueIds:{catalogue:expected.length,photoStaging:Object.keys(photo.map).length,familyPhotoCards:Object.keys(cards.map).length},
    ids:{missingInPhotoStaging:photoMissing,missingInFamilyCards:cardsMissing,extraPhotoStaging:extra(photo),extraFamilyCards:extra(cards)},
    badRows:{catalogue:{duplicates:cat.dupes,invalid:cat.invalid,blank:cat.blank},photoStaging:{duplicates:photo.dupes,invalid:photo.invalid,blank:photo.blank},familyCards:{duplicates:cards.dupes,invalid:cards.invalid,blank:cards.blank}},
    imageReferenceCounts:candidateCounts,photoQualificationStatusCounts:statuses,selectedTen:assetDetail,
    reconciled:problems.length===0,issues:problems,qualificationAndLiveImageAccessibilityVerified:false};
  Logger.log('AQB_UNIFIED_PHOTO_STAGING_AUDIT '+JSON.stringify(result));
  return result;
}

function AQBAuditPhotoExceptions(){
  AQBRequireAdmin();
  const ss=AQBGetSpreadsheet();
  const catalogue=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE);
  const photo=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
  const cards=ss.getSheetByName('AQB Family Photo Cards');
  if(!catalogue||!photo||!cards)throw Error('Missing Catalogue, AQB Photo Staging or AQB Family Photo Cards.');
  function read(sh,idHeader){
    const vals=sh.getDataRange().getValues();
    const heads=vals[0].map(function(x){return String(x||'').trim();});
    const idx=heads.indexOf(idHeader);
    if(idx<0)throw Error('Missing '+idHeader+' in '+sh.getName());
    const items={};
    vals.slice(1).forEach(function(row,i){
      const id=String(row[idx]||'').trim().toUpperCase();
      if(!id)return;
      if(items[id])throw Error('Duplicate '+id+' in '+sh.getName());
      items[id]={row:row,sheetRow:i+2};
    });
    return {heads:heads,items:items};
  }
  const a=read(catalogue,'Catalogue ID'),b=read(photo,'Catalogue ID'),c=read(cards,'Canonical Service ID');
  function val(table,entry,key){
    if(!entry)return '';
    const index=table.heads.indexOf(key);
    return index<0?'':String(entry.row[index]===null?'':entry.row[index]||'').trim();
  }
  function evidenceDigest(raw){
    if(!raw)return {available:false};
    let o;try{o=JSON.parse(raw);}catch(e){return {available:true,parseError:true,preview:String(raw).slice(0,180)};}
    const qual=o.qualification||{},gate=o.gateOutcome||o.gate||{},contr=o.contradictions||qual.contradictions||[];
    return {available:true,contradictions:Array.isArray(contr)?contr.slice(0,6):String(contr).slice(0,200),identityContradiction:o.identityContradiction===true||qual.identityContradiction===true||gate.identityContradiction===true,
      mandatoryFailures:(o.mandatoryFailures||qual.mandatoryFailures||[]),weightedAttainmentPercent:o.weightedAttainmentPercent||qual.weightedAttainmentPercent||'',
      qualification:qual.tier||qual.qualified||'',gateOutcome:typeof gate==='string'?gate:(gate.tier||''),keys:Object.keys(o).slice(0,18)};
  }
  const exceptions=['HARD_IDENTITY_CONTRADICTION','RESEARCH_AGAIN','PENDING'];
  const ten=['AQBCAT009','AQBCAT013','AQBCAT053','AQBCAT059','AQBCAT100','AQBCAT102','AQBCAT103','AQBCAT104','AQBCAT142','AQBCAT227'];
  const detail=[],selected=[],counts={},warnings=[];
  Object.keys(b.items).sort().forEach(function(id){
    const p=b.items[id], cat=a.items[id],card=c.items[id];
    const status=val(b,p,'Qualification Status').toUpperCase()||'UNSPECIFIED';
    counts[status]=(counts[status]||0)+1;
    if(exceptions.indexOf(status)<0 && ten.indexOf(id)<0)return;
    const name=val(a,cat,'Service Name')||val(b,p,'Service Name');
    const brief=val(a,cat,'Photo Brief');
    const originalCandidate=val(b,p,'Candidate Image URL');
    const asset=val(c,card,'Card Asset Review Locator');
    const assetState=val(c,card,'Card Asset Review State');
    const hold=AQBGetCataloguePhotoHolds()[id]||null;
    const record={id:id,service:name,category:val(a,cat,'Category'),stageRow:p.sheetRow,cardRow:card?card.sheetRow:null,
      qualificationStatus:status,visualScore:val(b,p,'Visual Score'),gateOutcome:val(b,p,'Gate Outcome'),
      recoveryStatus:val(b,p,'Recovery Status'),searchStatus:val(b,p,'Search Status'),
      reviewReason:val(b,p,'Review Reason'),photoTrack:val(b,p,'Photo Track'),photoSubtype:val(b,p,'Photo Subtype'),
      searchQuery:val(b,p,'Search Query'),candidateSource:val(b,p,'Candidate Source'),
      hasCandidateUrl:!!originalCandidate,hasCanonicalImage:!!(val(a,cat,'Image URL')||val(a,cat,'Own Photo')),
      photoBrief:brief,description:val(a,cat,'Description').slice(0,600),
      evidence:evidenceDigest(val(b,p,'Candidate Evidence JSON')),
      inSelectedTen:ten.indexOf(id)>=0,localAsset:asset,localAssetState:assetState,
      codeHold:hold?{requiredStatus:hold.requiredStatus,serviceName:hold.serviceName,closure:hold.closure}:null};
    if(hold && hold.serviceName && name && hold.serviceName.toLowerCase()!==name.toLowerCase()){
      record.staleHoldNameMismatch=true;
      warnings.push(id+': stale hold label '+hold.serviceName+' versus Catalogue '+name);
    }
    if(status==='HARD_IDENTITY_CONTRADICTION')record.nextStep='REPLACE_OR_REQUALIFY_IDENTITY_AFTER_VISUAL_REVIEW';
    else if(status==='RESEARCH_AGAIN')record.nextStep='TARGETED_SEARCH_USING_CANONICAL_PHOTO_BRIEF';
    else if(status==='PENDING')record.nextStep='MANUAL_QUALIFICATION_OR_LOCAL_ASSET_REVIEW';
    else if(asset)record.nextStep='REVIEW_LOCAL_ASSET_HOSTING_AND_QUALIFICATION';
    else record.nextStep='RETAIN_CURRENT_PHOTO';
    if(exceptions.indexOf(status)>=0)detail.push(record);
    if(record.inSelectedTen)selected.push(record);
  });
  const found={},expectedCounts={'HARD_IDENTITY_CONTRADICTION':3,'RESEARCH_AGAIN':5,'PENDING':4};
  detail.forEach(function(r){found[r.qualificationStatus]=(found[r.qualificationStatus]||0)+1;});
  Object.keys(expectedCounts).forEach(function(k){if((found[k]||0)!==expectedCounts[k])warnings.push('Expected '+expectedCounts[k]+' '+k+' records from previous run, found '+(found[k]||0)+'; staging may have changed.');});
  ten.forEach(function(id){if(!c.items[id])warnings.push('Missing selected card '+id);});
  const result={version:'V16.21.15.6.5.7',readOnly:true,writes:0,networkUsed:false,publications:0,messagesSent:0,
    exceptionCounts:found,allStatusCounts:counts,exceptions:detail,selectedTen:selected,
    diagnostics:{photoStageImageReferenceColumnsPresent:['Candidate Image URL','Image URL','Own Photo','Pexels Photo URL'].filter(function(x){return b.heads.indexOf(x)>=0;}),
      photoStageEvidenceColumnsPresent:['Candidate Evidence JSON','Review Reason','Visual Score','Gate Outcome','Recovery Status'].filter(function(x){return b.heads.indexOf(x)>=0;}),
      imageAccessibilityVerified:false,actualImagePixelsInspected:false,localAssetsHosted:false},warnings:warnings};
  // V16.21.15.6.5.6: one bounded log line per exception prevents GAS truncation.
  // Never log candidate URLs, full evidence JSON, customer data or Photo Brief bodies.
  Logger.log('AQB_PHOTO_EXCEPTION_SUMMARY '+JSON.stringify({version:result.version,readOnly:true,writes:0,exceptionCounts:found,selectedCardCount:selected.length,warnings:warnings}));
  detail.forEach(function(r){
    const ev=r.evidence||{};
    Logger.log('AQB_PHOTO_EXCEPTION_ROW '+JSON.stringify({id:r.id,service:r.service,status:r.qualificationStatus,score:r.visualScore,gate:r.gateOutcome,recovery:r.recoveryStatus,search:r.searchStatus,reason:String(r.reviewReason||'').slice(0,160),query:String(r.searchQuery||'').slice(0,140),stageRow:r.stageRow,cardRow:r.cardRow,candidatePresent:r.hasCandidateUrl,canonicalImagePresent:r.hasCanonicalImage,evidenceContradiction:ev.identityContradiction===true,evidenceMandatoryFailures:ev.mandatoryFailures||[],evidenceContradictions:ev.contradictions||[],evidenceAttainment:ev.weightedAttainmentPercent||'',selectedCard:r.inSelectedTen,assetLocator:r.localAsset||'',assetState:r.localAssetState||'',codeHold:r.codeHold?r.codeHold.requiredStatus:'',holdNameMismatch:!!r.staleHoldNameMismatch,next:r.nextStep}));
  });
  selected.forEach(function(r){
    if(detail.some(function(e){return e.id===r.id;}))return;
    Logger.log('AQB_PHOTO_SELECTED_CARD '+JSON.stringify({id:r.id,service:r.service,status:r.qualificationStatus,assetLocator:r.localAsset,assetState:r.localAssetState,codeHold:r.codeHold?r.codeHold.requiredStatus:'',holdNameMismatch:!!r.staleHoldNameMismatch}));
  });
  return result;
}

