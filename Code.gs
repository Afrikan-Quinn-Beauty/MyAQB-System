function AQBEnrichPhotoSearchRoute(r,route){
  route=route||{};
  if(!route.pexelsRequired) return route;
  const name=String(r.serviceName||'').toLowerCase();
  const support=[r.serviceName,r.category,r.description,r.photoBrief,r.variants].join(' ').toLowerCase();
  let strategy=String(route.searchStrategy||'').toUpperCase();
  if(/bridal natural hair trial/.test(name)){route.track='SERVICE_REPRESENTATION';route.subtype='BRIDAL_HAIR_TRIAL';route.searchStrategy='BRIDAL_TRIAL';route.validationType='REPRESENTATIONAL';route.status='ROUTER_READY';route.pexelsRequired=true;strategy='BRIDAL_TRIAL';}
  else if(/queen bridal package/.test(name)){route.track='SERVICE_REPRESENTATION';route.subtype='BRIDAL_PACKAGE';route.searchStrategy='SALON_EXPERIENCE';route.validationType='REPRESENTATIONAL';route.status='ROUTER_READY';route.pexelsRequired=true;strategy='SALON_EXPERIENCE';}
  else if(/^essential$/.test(name)){route.track='SERVICE_REPRESENTATION';route.subtype='MEMBERSHIP_ESSENTIAL';route.searchStrategy='MEMBERSHIP_EXPERIENCE';route.validationType='REPRESENTATIONAL';route.status='ROUTER_READY';route.pexelsRequired=true;strategy='MEMBERSHIP_EXPERIENCE';}
  else if(/^queen$/.test(name)){route.track='SERVICE_REPRESENTATION';route.subtype='MEMBERSHIP_QUEEN';route.searchStrategy='MEMBERSHIP_EXPERIENCE';route.validationType='REPRESENTATIONAL';route.status='ROUTER_READY';route.pexelsRequired=true;strategy='MEMBERSHIP_EXPERIENCE';}
  else if(/^signature$/.test(name)){route.track='SERVICE_REPRESENTATION';route.subtype='MEMBERSHIP_SIGNATURE';route.searchStrategy='MEMBERSHIP_EXPERIENCE';route.validationType='REPRESENTATIONAL';route.status='ROUTER_READY';route.pexelsRequired=true;strategy='MEMBERSHIP_EXPERIENCE';}
  const subtype=AQBDerivePhotoSubtype(name,support,strategy,route);
  if(subtype) route.subtype=subtype;
  const enriched=AQBBuildEvidenceSearchQuery(r,route);
  const old=Array.isArray(route.queries)?route.queries:[];
  // Exact-service search portfolio: the canonical Photo Brief requires a short,
  // individual knotless-braided bob. Generic long-braid queries are unsafe.
  // Keep all existing source/qualification/candidate fields unchanged; research
  // is a separate guarded operation, never an automatic acceptance.
  const catId=String(r.catalogueId||r['Catalogue ID']||'').trim().toUpperCase();
  const isKnotlessBob=catId==='AQBCAT052' && /knotless.*bob|bob.*knotless/i.test(String(r.serviceName||''));
  const bobQueries=isKnotlessBob ? [
    'short knotless bob braids chin length black woman',
    'neck length knotless box braids bob visible roots',
    'knotless braided bob individual braids short hairstyle',
    'chin length knotless bob braids three quarter view'
  ] : [];
  // Photo Brief is the search vocabulary authority. Use only positive brief text;
  // exclusions remain qualification constraints rather than Pexels query words.
  const brief=AQBGetCataloguePositivePhotoBrief(r.photoBrief||'');
  const positive=brief.replace(/^(show|photograph|capture|depict)\s+/i,'').replace(/\s+/g,' ').trim();
  const briefTerms=positive.split(/[.;]/)[0].replace(/\b(primary subject|clearly visible|professional photograph|close-up photograph)\b/gi,'').trim();
  const briefQueries=briefTerms ? [
    (r.serviceName+' '+briefTerms).slice(0,145),
    (r.serviceName+' '+briefTerms.split(/,|\band\b/i).slice(0,2).join(' ')).slice(0,145)
  ] : [];
  const all=isKnotlessBob?bobQueries:briefQueries.concat([enriched],old);
  const seen={},dedup=[];
  all.forEach(function(x){x=String(x||'').replace(/\s+/g,' ').trim();const k=x.toLowerCase();if(x&&!seen[k]){seen[k]=1;dedup.push(x);}});
  route.queries=dedup;
  if(isKnotlessBob){route.searchQuery=dedup[0];route.photoResearchHold='EXACT_SHORT_BOB_IDENTITY_REQUIRED';}
  return route;
}

function AQBDerivePhotoSubtype(name,support,strategy,route){
  // Exact service identities first.
  if(/alicia keys cornrow/.test(name)) return 'ARTISTIC_GEOMETRIC_CORNROWS';
  if(/artistic feed-in cornrow|artistic feed in cornrow/.test(name)) return 'ARTISTIC_FEED_IN_CORNROWS';
  if(/beaded knotless bob/.test(name)) return 'BEADED_KNOTLESS_BOB';
  if(/finger coil/.test(name)) return 'FINGER_COILS';
  if(/defined wash\s*&\s*go|defined wash and go/.test(name)) return 'CURL_DEFINITION';
  if(/^big chop$/.test(name)) return 'NATURAL_HAIR_TRANSITION';
  if(/growth oil\s*\+\s*steam|growth oil and steam/.test(name)) return 'OIL_STEAM_THERAPY';
  if(/track.*sew.*leave[- ]?out|leave[- ]?out.*weave/.test(name)) return 'WEAVE_LEAVE_OUT';
  if(/french curl braid/.test(name)) return 'FRENCH_CURL_BRAIDS';
  if(/swahili stitch|swahili.*lines/.test(name)) return 'SWAHILI_STITCH_LINES';
  if(/passion twist/.test(name)) return 'PASSION_TWISTS';
  if(/spring twist/.test(name)) return 'SPRING_TWISTS';
  if(/faux loc/.test(name)) return 'FAUX_LOCS';
  if(/ghana weaving/.test(name)) return 'GHANA_WEAVING';
  if(/deep curl twist/.test(name)) return 'DEEP_CURL_TWISTS';
  if(/island twist/.test(name)) return 'ISLAND_TWISTS';
  if(/silk press/.test(name)) return 'SILK_PRESS_RESULT';
  if(/starter loc/.test(name)) return 'STARTER_LOCS';
  if(/sisterlocks installation/.test(name)) return 'SISTERLOCKS_INSTALLATION';
  if(/steam hair spa/.test(name)) return 'STEAM_HAIR_SPA';
  if(/twist[- ]out|braid[- ]out/.test(name)) return 'TWIST_BRAID_OUT';
  if(/wig installation.*styling/.test(name)) return 'WIG_INSTALLATION_STYLING';
  if(/microlink|micro weaving/.test(name)) return 'MICROLINK_MICRO_WEAVING';
  if(/loc detox/.test(name)) return 'LOC_DETOX';
  if(/loc extension/.test(name)) return 'LOC_EXTENSIONS';
  if(/instant dread/.test(name)) return 'INSTANT_LOCS';
  if(/retie|retighten/.test(name)) return 'LOC_RETIGHTENING';
  if(/retwist/.test(name)) return 'LOC_RETWIST';
  if(/wig.*revamp|wig wash/.test(name)) return 'WIG_REVAMP';

  if(/bridal natural hair trial/.test(name)) return 'BRIDAL_HAIR_TRIAL';
  if(/queen bridal package/.test(name)) return 'BRIDAL_PACKAGE';
  if(/^essential$/.test(name)) return 'MEMBERSHIP_ESSENTIAL';
  if(/^queen$/.test(name)) return 'MEMBERSHIP_QUEEN';
  if(/^signature$/.test(name)) return 'MEMBERSHIP_SIGNATURE';

  // Structural cues from current Description / Photo Brief.
  if(strategy==='CORNROWS' && /geometric|zig[- ]?zag|crossover|curved|sculptural/.test(support)) return 'ARTISTIC_GEOMETRIC_CORNROWS';
  if(strategy==='BRAIDS' && /knotless/.test(support) && /bob/.test(support) && /bead/.test(support)) return 'BEADED_KNOTLESS_BOB';
  if(strategy==='TWISTS' && /water[- ]?wave|boho|bohemian/.test(support)) return 'BOHO_TEXTURED_TWISTS';
  if(strategy==='LOCS' && /micro|sisterlocks/.test(support)) return 'MICROLOC_IDENTITY';
  if(strategy==='WEAVE' && /leave[- ]?out|natural part|real scalp/.test(support)) return 'WEAVE_LEAVE_OUT';

  if(route&&route.subtype) return String(route.subtype).toUpperCase();
  if(route&&route.track==='STYLE_IDENTITY') return strategy?strategy+'_STYLE':'STYLE_RESULT';
  if(route&&route.track==='SERVICE_REPRESENTATION') return String(route.validationType||'PROCESS').toUpperCase();
  return '';
}

