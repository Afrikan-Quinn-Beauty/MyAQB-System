function AQBAuditStudioPublicationReadiness(){
  AQBRequireCataloguePhotoManager();
  const ss=AQBGetSpreadsheet(),cat=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE),stage=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING),ledger=ss.getSheetByName('AQB Photo Approval Decisions'),cache=ss.getSheetByName('Catalogue Public Cache');
  if(!cat||!stage||!ledger)throw Error('Required Catalogue, Staging or Approval Decisions sheet missing.');
  const cm=AQBBuildHeaderMap(cat),sm=AQBBuildHeaderMap(stage),lm=AQBBuildHeaderMap(ledger),km=cache?AQBBuildHeaderMap(cache):{};
  function required(m,n){n.forEach(function(k){if(!m[k])throw Error('Required column missing: '+k);});}
  required(cm,['Catalogue ID','Service Name','Photo Brief','Publication Status','Image URL']);
  required(sm,['Catalogue ID','Candidate Image URL','Candidate Source','Photo Provenance','Qualification Status','Preview File ID','Preview Source File ID','Preview Status']);
  required(lm,['Catalogue ID','Candidate Image URL','Decision','Legacy Hold','Visual Match Confirmed']);
  const read=function(r,m,k){return m[k]?String(r[m[k]-1]==null?'':r[m[k]-1]).trim():'';};
  const map=function(sheet,hm,label){const result={},dupes=[];sheet.getDataRange().getValues().slice(1).forEach(function(r){const id=read(r,hm,'Catalogue ID').toUpperCase();if(!id)return;if(result[id])dupes.push(id);result[id]=r;});return {records:result,duplicates:dupes};};
  const c=map(cat,cm,'Catalogue'),st=map(stage,sm,'Staging');
  // Legacy public cache is telemetry only: never a source of publication authority.
  const legacyCacheCount=cache&&km['Catalogue ID']?Object.keys(map(cache,km,'Legacy Cache').records).length:0;
  const approvals={};ledger.getDataRange().getValues().slice(1).forEach(function(r){const id=read(r,lm,'Catalogue ID').toUpperCase();if(id)approvals[id]=r;});
  const fileId=function(url){const m=String(url||'').match(/(?:[?&]id=|\/file\/d\/)([A-Za-z0-9_-]{15,})/);return m?m[1]:'';};
  const holds=AQBGetCataloguePhotoHolds()||{},reasons={},details=[],seen={};
  const counter={version:'V16.21.16.8.23',readOnly:true,masterImagePolicy:'APPROVED_ORIGINAL_ONLY',reviewImagePolicy:'PREVIEW_ONLY',catalogue:Object.keys(c.records).length,staged:Object.keys(st.records).length,approvalDecisions:Object.keys(approvals).length,legacyPublicCacheSnapshot:legacyCacheCount,approvalsCurrent:0,previewReady:0,qualificationReady:0,originalSourceIdsMatch:0,protectedConfirmed:0,blocked:0,readyForSeparateQualificationReview:0,readyForPublication:0,reasonCounts:reasons,issues:details,approvalWrites:0,qualificationWrites:0,publicationWrites:0,photoSourceWrites:0,columnsDeleted:0};
  function issue(id,code){reasons[code]=(reasons[code]||0)+1;if(details.length<75)details.push({id:id,issue:code});seen[id]=true;}
  Object.keys(c.records).sort().forEach(function(id){
    const cr=c.records[id],sr=st.records[id],ar=approvals[id];
    if(!sr){issue(id,'STAGING_MISSING');return;}
    const original=read(sr,sm,'Candidate Image URL'),oId=fileId(original),review=read(sr,sm,'Preview File ID'),pSource=read(sr,sm,'Preview Source File ID');
    const approved=ar&&read(ar,lm,'Decision').toUpperCase()==='APPROVED'&&read(ar,lm,'Candidate Image URL')===original;
    if(approved)counter.approvalsCurrent++;else issue(id,'APPROVAL_MISSING_OR_SOURCE_CHANGED');
    if(oId&&oId===pSource&&read(sr,sm,'Preview Status')==='PREVIEW_READY'&&review&&review!==oId)counter.previewReady++;else issue(id,'PREVIEW_MISSING_OR_OUTDATED');
    if(oId&&ar&&fileId(read(ar,lm,'Candidate Image URL'))===oId)counter.originalSourceIdsMatch++;else issue(id,'ORIGINAL_SOURCE_ID_MISMATCH');
    if(!oId)issue(id,'NO_ORIGINAL_SOURCE');
    if(!read(cr,cm,'Photo Brief'))issue(id,'NO_PHOTO_BRIEF');
    if(read(sr,sm,'Candidate Source')!=='AQB Studio')issue(id,'SOURCE_NOT_AQB_STUDIO');
    if(!/AI.generated|representative|concept/i.test(read(sr,sm,'Photo Provenance')))issue(id,'PROVENANCE_MISSING_OR_UNCLEAR');
    if(holds[id]){
      if(approved&&read(ar,lm,'Visual Match Confirmed').toUpperCase()==='TRUE'&&read(ar,lm,'Legacy Hold').toUpperCase()==='TRUE')counter.protectedConfirmed++;
      else issue(id,'PROTECTED_HOLD_UNCONFIRMED');
    }
    if(read(sr,sm,'Qualification Status').toUpperCase()==='QUALIFIED'||(approved&&oId&&read(sr,sm,'Candidate Source')==='AQB Studio'))counter.qualificationReady++;else issue(id,'QUALIFICATION_PENDING');
    if(read(cr,cm,'Publication Status').toUpperCase()!=='PUBLISHABLE')issue(id,'PUBLICATION_NOT_READY');
    const liveUrl=read(cr,cm,'Image URL');if(fileId(liveUrl)&&fileId(liveUrl)===review)issue(id,'PREVIEW_USED_AS_CATALOGUE_IMAGE');
    if(approved&&oId&&pSource===oId)counter.readyForSeparateQualificationReview++;
    if(!seen[id])counter.readyForPublication++;
  });
  if(c.duplicates.length)issue('(CATALOGUE)','DUPLICATE_CATALOGUE_IDS');
  if(st.duplicates.length)issue('(STAGING)','DUPLICATE_STAGING_IDS');
  counter.blocked=counter.catalogue-counter.readyForPublication;
  counter.note='Read-only evidence report. Matching Studio original manual approval supplies qualification; separate staging reconciliation persists QUALIFIED. Legacy public cache is historical telemetry only, not publication authority. Drive original byte hash, public delivery URL accessibility and customer-channel publication are NOT verified by this audit. Never use 480x600 review preview as public master; AQB Studio promotion requires explicit scoped invocation and current separate qualification/publication approvals.';
  Logger.log('AQB_STUDIO_PUBLICATION_READINESS '+JSON.stringify({...counter,issues:details.slice(0,20)}));return counter;
}

