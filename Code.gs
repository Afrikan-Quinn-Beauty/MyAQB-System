function AQBVerifyPhotoAccessibility(){
  AQBRequireAdmin();
  const KEY='AQB_PHOTO_59_ACCESS_CURSOR';
  const props=PropertiesService.getScriptProperties();
  const ss=AQBGetSpreadsheet();
  const cat=ss.getSheetByName(CONFIG.SHEETS.CATALOGUE);
  const staging=ss.getSheetByName(CONFIG.SHEETS.PHOTO_STAGING);
  const cards=ss.getSheetByName('AQB Family Photo Cards');
  if(!cat||!staging||!cards)throw Error('Missing Catalogue, AQB Photo Staging, or AQB Family Photo Cards.');
  function read(sheet,heading){
    const raw=sheet.getDataRange().getValues();
    const head=raw[0].map(function(x){return String(x||'').trim();});
    const k=head.indexOf(heading);
    if(k<0)throw Error('Missing '+heading+' in '+sheet.getName());
    const data={};
    for(let i=1;i<raw.length;i++){
      const id=String(raw[i][k]||'').trim().toUpperCase();
      if(!/^AQBCAT\d{3}$/.test(id)||data[id])throw Error('Bad or duplicate AQBCAT ID in '+sheet.getName()+' row '+(i+1));
      data[id]=raw[i];
    }
    return {head:head,data:data,ids:Object.keys(data).sort()};
  }
  const C=read(cat,'Catalogue ID'),S=read(staging,'Catalogue ID'),F=read(cards,'Canonical Service ID');
  const ids=C.ids;
  if(ids.length!==232||S.ids.length!==232||F.ids.length!==232||ids.some(function(id){return !S.data[id]||!F.data[id];})){
    throw Error('232-record cross-sheet identity preflight failed; no requests made.');
  }
  function value(obj,id,key){const i=obj.head.indexOf(key);return i<0?'':String(obj.data[id][i]||'').trim();}
  const fingerprint=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,
    ids.map(function(id){return id+'|'+value(S,id,'Candidate Image URL')+'|'+value(C,id,'Image URL')+'|'+value(C,id,'Own Photo')+'|'+value(S,id,'Qualification Status');}).join('\n'))).slice(0,30);
  let cursor=Number(props.getProperty(KEY)||0);
  const fp=props.getProperty(KEY+'_FP');
  if(fp&&fp!==fingerprint)throw Error('Image references/statuses changed since accessibility audit began. Run AQBResetPhotoAccessibilityAudit to begin fresh.');
  if(!Number.isInteger(cursor)||cursor<0||cursor>232)throw Error('Invalid accessibility audit cursor.');
  if(cursor===232){
    const done={version:'V16.21.15.6.5.9',complete:true,rowsChecked:232,sheetWrites:0,imagesPromoted:0,visualInspection:false};
    Logger.log('AQB_PHOTO_59_COMPLETE '+JSON.stringify(done));return done;
  }
  // URL checks never send a candidate to a third-party service; only request the image's own host.
  // GET with a Range header is preferred over HEAD because many photo CDNs reject HEAD.
  function check(url){
    if(!url)return {state:'MISSING'};
    if(!/^https:\/\//i.test(url))return {state:'NON_HTTPS_OR_LOCAL'};
    try{
      const response=UrlFetchApp.fetch(url,{method:'get',headers:{Range:'bytes=0-255',Accept:'image/*'},followRedirects:true,muteHttpExceptions:true,validateHttpsCertificates:true});
      const status=response.getResponseCode();
      const headers=response.getAllHeaders();
      const ct=String(headers['Content-Type']||headers['content-type']||'').toLowerCase();
      // Apps Script HTTPResponse.getContent() may expose signed bytes (-128..127).
      // Normalize to 0..255 before PNG/JPEG magic checks; the .5.8 verifier
      // incorrectly classified valid PNG/JPEG images as IMAGE_BYTES_UNRECOGNIZED.
      const raw=response.getContent();
      const prefix=raw.slice(0,32).map(function(n){return n&255;});
      function ascii(offset,count){return String.fromCharCode.apply(null,prefix.slice(offset,offset+count));}
      const jpg=prefix.length>=3&&prefix[0]===255&&prefix[1]===216&&prefix[2]===255;
      const png=prefix.length>=8&&prefix[0]===137&&prefix[1]===80&&prefix[2]===78&&prefix[3]===71&&prefix[4]===13&&prefix[5]===10&&prefix[6]===26&&prefix[7]===10;
      const gif=prefix.length>=6&&(ascii(0,6)==='GIF87a'||ascii(0,6)==='GIF89a');
      const webp=prefix.length>=12&&ascii(0,4)==='RIFF'&&ascii(8,4)==='WEBP';
      const svg=ct.indexOf('image/svg+xml')>=0;
      const avif=prefix.length>=16&&ascii(4,4)==='ftyp'&&(ascii(8,4)==='avif'||ascii(8,4)==='avis');
      const heic=prefix.length>=16&&ascii(4,4)==='ftyp'&&['heic','heix','hevc','mif1'].indexOf(ascii(8,4))>=0;
      if(status!==200&&status!==206)return {state:'HTTP_ERROR',http:status};
      if(!/^image\//.test(ct))return {state:'NOT_IMAGE_CONTENT',http:status,contentType:ct.slice(0,80)};
      if(!(jpg||png||gif||webp||svg||avif||heic))return {state:'IMAGE_BYTES_UNRECOGNIZED',http:status,contentType:ct.slice(0,80),bytes:raw.length};
      return {state:'ACCESSIBLE_IMAGE',http:status,format:jpg?'JPEG':png?'PNG':gif?'GIF':webp?'WEBP':svg?'SVG':avif?'AVIF':'HEIC'};
    }catch(e){
      // Do not log error text (can include a private URL).
      return {state:'FETCH_FAILED'};
    }
  }
  const next=Math.min(232,cursor+12),counts={},rows=[];
  for(const id of ids.slice(cursor,next)){
    const candidate=value(S,id,'Candidate Image URL');
    const canonical=value(C,id,'Image URL')||value(C,id,'Own Photo');
    // Where both fields point to the same URL, issue one request.
    const a=check(candidate);
    const b=(canonical&&candidate&&canonical===candidate)?a:check(canonical);
    const asset=value(F,id,'Card Asset Review Locator');
    const row={id:id,status:value(S,id,'Qualification Status'),candidate:a.state,canonical:b.state,
      sameReference:!!candidate&&candidate===canonical,localAssetPresent:!!asset,
      requiresVisualReview:true,visualQualifiedNow:false};
    if(a.http)row.candidateHTTP=a.http;
    if(a.format)row.candidateFormat=a.format;
    if(a.contentType)row.candidateContentType=a.contentType;
    if(b.http)row.canonicalHTTP=b.http;
    if(b.format)row.canonicalFormat=b.format;
    if(b.contentType)row.canonicalContentType=b.contentType;
    rows.push(row);
    counts[a.state]=(counts[a.state]||0)+1;
    Logger.log('AQB_PHOTO_59_ROW '+JSON.stringify(row));
  }
  props.setProperties({[KEY]:String(next),[KEY+'_FP']:fingerprint});
  const out={version:'V16.21.15.6.5.9',networkAudit:true,sheetWrites:0,qualificationWrites:0,publications:0,messagesSent:0,
    from:cursor+1,to:next,total:232,nextCursor:next,complete:next===232,candidateStates:counts,
    pixelsDecoded:false,serviceIdentityCompared:false,S1S8Requalified:false,provenanceRightsVerified:false};
  Logger.log('AQB_PHOTO_59_PAGE '+JSON.stringify(out));return out;
}

