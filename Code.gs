}

function AQBAuditRetieDateAuthority(){
  AQBRequireAdmin();
  const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),cn=cs.getLastRow(),issues=[];
  if(cn<2){const out={version:'V16.21.14-CleanApp',function:'AQBAuditRetieDateAuthority',readOnly:true,writes:0,checked:0,appointmentAuthorities:0,nextRetieMismatches:0,reminderDateMismatches:0,legacyReminderMarkers:0,issues:[],success:true};Logger.log('=== AQB RETIE DATE AUTHORITY AUDIT ===');Logger.log(JSON.stringify(out));return out;}
  const cm=AQBBuildHeaderMap(cs),rows=cs.getRange(2,1,cn-1,cs.getLastColumn()).getValues();
  let checked=0,appointmentAuthorities=0,nextRetieMismatches=0,reminderDateMismatches=0,legacyReminderMarkers=0;
  rows.forEach(function(r){
    const id=String(r[cm['Customer ID']-1]||'');
    if(!AQBIsSisterlocksService(r[cm['Service']-1])||AQBIsConsultationService(r[cm['Service']-1]))return;
    checked++;
    const appt=AQBFindRetieAppointmentAuthority(id),next=AQBParseRetieDate(r[cm['Next Retie Date']-1]),rem=AQBParseRetieDate(r[cm['Reminder Date']-1]),marker=String(r[cm['Reminder Sent']-1]||'').trim();
    if(appt){
      appointmentAuthorities++;
      const expectedNext=new Date(appt.date);expectedNext.setHours(0,0,0,0);
      const expectedRem=new Date(expectedNext);expectedRem.setDate(expectedRem.getDate()-CONFIG.REMINDER_DAYS);expectedRem.setHours(0,0,0,0);
      if(!next||AQBFormatDateKey(next)!==AQBFormatDateKey(expectedNext)){nextRetieMismatches++;issues.push({customerId:id,issue:'NEXT_RETIE_DATE_MISMATCH',appointmentId:appt.appointmentId,expected:AQBFormatDateForClient(expectedNext),actual:next?AQBFormatDateForClient(next):''});}
      if(!rem||AQBFormatDateKey(rem)!==AQBFormatDateKey(expectedRem)){reminderDateMismatches++;issues.push({customerId:id,issue:'REMINDER_DATE_MISMATCH',appointmentId:appt.appointmentId,expected:AQBFormatDateForClient(expectedRem),actual:rem?AQBFormatDateForClient(rem):''});}
    }
    if(/^OVERDUE(?::|_)/i.test(marker)&&next&&marker.indexOf(AQBFormatDateKey(next))<0){legacyReminderMarkers++;issues.push({customerId:id,issue:'LEGACY_OR_STALE_OVERDUE_MARKER',marker:marker,nextRetieDate:AQBFormatDateForClient(next)});}
  });
  const out={version:'V16.21.14-CleanApp',function:'AQBAuditRetieDateAuthority',readOnly:true,writes:0,checked:checked,appointmentAuthorities:appointmentAuthorities,nextRetieMismatches:nextRetieMismatches,reminderDateMismatches:reminderDateMismatches,legacyReminderMarkers:legacyReminderMarkers,issues:issues,success:issues.length===0};
  Logger.log('=== AQB RETIE DATE AUTHORITY AUDIT ===');Logger.log(JSON.stringify(out));return out;
}

function AQBSyncRetieDateAuthority(){
  AQBRequireAdmin();
  const VERSION='V16.21.14-CleanApp';
  const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),cn=cs.getLastRow();
  if(cn<2){const out={version:VERSION,function:'AQBSyncRetieDateAuthority',readOnly:false,networkUsed:false,whatsAppSent:false,checked:0,appointmentAuthorities:0,updatedRows:0,nextRetieUpdated:0,reminderDateUpdated:0,reminderMarkersReset:0,issues:[],success:true};Logger.log('=== AQB RETIE DATE AUTHORITY SYNC ===');Logger.log(JSON.stringify(out));return out;}
  const cm=AQBBuildHeaderMap(cs),rows=cs.getRange(2,1,cn-1,cs.getLastColumn()).getValues();
  let checked=0,appointmentAuthorities=0,updatedRows=0,nextRetieUpdated=0,reminderDateUpdated=0,reminderMarkersReset=0;
  const issues=[];
  rows.forEach(function(r,i){
    const id=String(r[cm['Customer ID']-1]||'').trim();
    if(!id||!AQBIsSisterlocksService(r[cm['Service']-1])||AQBIsConsultationService(r[cm['Service']-1]))return;
    checked++;
    const appt=AQBFindRetieAppointmentAuthority(id);if(!appt)return;
    appointmentAuthorities++;
    const expectedNext=new Date(appt.date);expectedNext.setHours(0,0,0,0);
    const expectedRem=new Date(expectedNext);expectedRem.setDate(expectedRem.getDate()-CONFIG.REMINDER_DAYS);expectedRem.setHours(0,0,0,0);
    const oldNext=AQBParseRetieDate(r[cm['Next Retie Date']-1]),oldRem=AQBParseRetieDate(r[cm['Reminder Date']-1]);
    const oldMarker=String(r[cm['Reminder Sent']-1]||'').trim();
    const nextChanged=!oldNext||AQBFormatDateKey(oldNext)!==AQBFormatDateKey(expectedNext);
    const remChanged=!oldRem||AQBFormatDateKey(oldRem)!==AQBFormatDateKey(expectedRem);
    if(!nextChanged&&!remChanged)return;
    try{
      if(nextChanged){r[cm['Next Retie Date']-1]=expectedNext;nextRetieUpdated++;}
      if(remChanged){r[cm['Reminder Date']-1]=expectedRem;reminderDateUpdated++;}
      if(cm['Reminder Sent']){r[cm['Reminder Sent']-1]='No';reminderMarkersReset++;}
      cs.getRange(i+2,1,1,cs.getLastColumn()).setValues([r]);updatedRows++;
      const before='Next Retie Date '+(oldNext?AQBFormatDateForClient(oldNext):'(blank)')+', Reminder Date '+(oldRem?AQBFormatDateForClient(oldRem):'(blank)')+', Reminder Sent '+(oldMarker||'(blank)');
      const after='Next Retie Date '+AQBFormatDateForClient(expectedNext)+', Reminder Date '+AQBFormatDateForClient(expectedRem)+', Reminder Sent No';
      try{AQBLogAudit('AQB_RETIE_DATE_AUTHORITY_SYNC','Customer',id,'Appointment '+appt.appointmentId+' authoritative. Before: '+before+'. After: '+after+'. Last Retie Date unchanged.');}catch(ignore){}
    }catch(e){issues.push({customerId:id,appointmentId:appt.appointmentId,error:String(e&&e.message||e)});}
  });
  const out={version:VERSION,function:'AQBSyncRetieDateAuthority',readOnly:false,networkUsed:false,whatsAppSent:false,checked:checked,appointmentAuthorities:appointmentAuthorities,updatedRows:updatedRows,nextRetieUpdated:nextRetieUpdated,reminderDateUpdated:reminderDateUpdated,reminderMarkersReset:reminderMarkersReset,issues:issues,success:issues.length===0};
  try{AQBLogAudit('AQB_RETIE_DATE_AUTHORITY_SYNC_RUN','System','RETIE_DATE_AUTHORITY',JSON.stringify(out));}catch(ignore){}
  Logger.log('=== AQB RETIE DATE AUTHORITY SYNC ===');Logger.log(JSON.stringify(out));return out;
}

function AQBHasSisterlocksRetieHistory(customerId){
  const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<2)return false;
  const rows=s.getRange(2,1,n-1,17).getValues();
  return rows.some(function(r){
