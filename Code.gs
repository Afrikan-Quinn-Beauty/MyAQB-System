    if(primaryFamily&&p)add(subject+' '+p.terms[0]+' '+primaryFamily+' salon','ACTIVITY_FAMILY',p.key+' '+primaryFamily);
    if(briefTerms.length)add(subject+' '+briefTerms.slice(0,4).join(' ')+' salon','PHOTO_BRIEF','brief');
    if(descTerms.length)add(subject+' '+descTerms.slice(0,4).join(' ')+' hair service','DESCRIPTION','description');
    add(subject+' '+category+' professional hair service','CATEGORY','category');
  }else{
    add(subject+' '+service+' hairstyle','EXACT_SERVICE',service);
    aliases.slice(0,4).forEach(function(a){add(subject+' '+a+' hairstyle','ALIAS',a);});
    if(primaryFamily&&defs[primaryFamily]){
      add(subject+' '+defs[primaryFamily].aliases[0]+' hairstyle','FAMILY',primaryFamily);
      if(defs[primaryFamily].aliases[1])add(subject+' '+defs[primaryFamily].aliases[1]+' hairstyle','FAMILY',primaryFamily);
    }
    hard.slice(0,2).forEach(function(m){if(m.aliases&&m.aliases.length)add(subject+' '+m.aliases[0]+' hairstyle','HARD_MODIFIER',m.key);});
    if(primaryFamily&&briefTerms.length)add(subject+' '+primaryFamily+' '+briefTerms.slice(0,3).join(' ')+' hairstyle','PHOTO_BRIEF','brief');
    if(primaryFamily&&descTerms.length)add(subject+' '+primaryFamily+' '+descTerms.slice(0,3).join(' ')+' hairstyle','DESCRIPTION','description');
  }
  return {type:type,service:String(service||''),category:String(category||''),description:String(description||''),photoBrief:String(photoBrief||''),subject:subject,primaryFamily:primaryFamily,familyDef:primaryFamily?defs[primaryFamily]:null,aliases:aliases,hardModifiers:hard,softModifiers:soft,briefTerms:briefTerms,descTerms:descTerms,activity:activity,querySpecs:specs.slice(0,8)};
}

