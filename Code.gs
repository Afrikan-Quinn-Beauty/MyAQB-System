function AQBGetCustomerLanguageFallbacks(category,name){
  const low=(String(category||'')+' '+String(name||'')).toLowerCase(), out=[];
  if(/sisterlocks/.test(low)&&/retie|retight|retouch|maintenance/.test(low))out.push('retie','Sisterlocks retie','retightening','Sisterlocks maintenance');
  if(/microloc/.test(low)&&/retie|retight|maintenance/.test(low))out.push('microloc retie','microlocs maintenance','retightening');
  if(/children|child|kids|kid/.test(low)&&/braid/.test(low))out.push('kids braids','children braids','kids hair braiding');
  if(/box braid/.test(low))out.push('box braids','box braid');
  if(/cornrow/.test(low))out.push('cornrows','corn rows','cornrow braids');
  if(/feed.?in/.test(low)&&/cornrow|braid/.test(low))out.push('feed in braids','feed-in cornrows');
  if(/weav/.test(low))out.push('weave','weave installation','hair weave');
  if(/sew.?in/.test(low))out.push('sew in','sew-in','weave install');
  if(/mizani|relax/.test(low))out.push('relaxer','hair relaxer','Mizani');
  if(/twist/.test(low))out.push('twists','hair twists');
  if(/braid/.test(low))out.push('braids','hair braiding');
  return Array.from(new Set(out));
}

