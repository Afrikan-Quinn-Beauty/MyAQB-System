function AQBIsPublicCatalogueRowQualified(r,cm){
  const catalogueId=cm['Catalogue ID']?String(r[cm['Catalogue ID']-1]||'').trim().toUpperCase():'';
  const studioCurrent=String(cm['Image Source']?r[cm['Image Source']-1]||'':'').trim().toUpperCase()==='AQB STUDIO' && String(cm['Photo Qualification Status']?r[cm['Photo Qualification Status']-1]||'':'').trim().toUpperCase()==='QUALIFIED';
  const localAsset=!studioCurrent&&!!AQB_CATALOGUE_LOCAL_ASSETS[catalogueId];
  if(!localAsset&&!AQBHasCatalogueChannel(r,cm,'WEB'))return false;
  const active=cm['Active']?AQBNormalizeBool(r[cm['Active']-1]):false;
  const publication=cm['Publication Status']?String(r[cm['Publication Status']-1]||'').trim().toUpperCase():'';
  const imageStatus=cm['Image Status']?String(r[cm['Image Status']-1]||'').trim().toUpperCase():'';
  const ownPhoto=cm['Own Photo']?String(r[cm['Own Photo']-1]||'').trim():'';
  const onlinePhoto=cm['Image URL']?String(r[cm['Image URL']-1]||'').trim():'';
  const image=studioCurrent?onlinePhoto:(ownPhoto||onlinePhoto);
  const description=cm['Description']?String(r[cm['Description']-1]||'').trim():'';
  const priceText=cm['Price']?String(r[cm['Price']-1]||'').trim():'';
  const price=cm['Price']?AQBNormalizePriceText(r[cm['Price']-1]).amount:0;
  const quotePrice=/\b(?:custom\s+quote|quote(?:\s+on\s+request)?)\b/i.test(priceText);
  const blocked={
    'DUPLICATE IMAGE - NEEDS UNIQUE PHOTO':true,
    'DUPLICATE IMAGE - REPLACEMENT REQUIRED':true,
    'NEEDS RELEVANT UNIQUE PHOTO':true,
    'NO RELEVANT PHOTO FOUND':true,
    'INVALID PHOTO URL':true,
    'PHOTO REPLACEMENT PENDING':true
  };
  return active&&!!description&&((price>0)||quotePrice)&&(localAsset||/^https?:\/\//i.test(image))&&(localAsset||studioCurrent||!blocked[imageStatus])&&(publication==='PUBLISHABLE'||localAsset);
}

