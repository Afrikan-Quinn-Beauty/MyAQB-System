function AQBNormalizeTimeSetting(value,timezone){
  timezone=String(timezone||'Africa/Nairobi').trim()||'Africa/Nairobi';
  if(value instanceof Date && !isNaN(value.getTime())){
    return Utilities.formatDate(value,timezone,'HH:mm');
  }
  const text=String(value==null?'':value).trim();
  if(/^(?:[01]\d|2[0-3]):[0-5]\d$/.test(text))return text;
  const m=text.match(/^(\d{1,2}):([0-5]\d)$/);
  if(m){
    const h=Number(m[1]);
    if(h>=0&&h<=23)return ('0'+h).slice(-2)+':'+m[2];
  }
  return '';
}

