/**
 * AQB customer-facing date display, e.g. "Sunday 25th October 2026".
 * Display-only: never write the returned text to date-valued spreadsheet cells.
 * Internal calculations, ISO keys and Sunday-to-Monday scheduling stay unchanged.
 * Handles Date objects, yyyy-MM-dd, and unambiguous m/d/yyyy source strings.
 */
function AQBFormatDisplayDate(value) {
  if (value === null || value === undefined || value === '') return '';
  var zone = 'Africa/Nairobi';
  var date;
  if (value instanceof Date) {
    date = new Date(value.getTime());
  } else {
    var s = String(value).trim();
    var iso = /^(\d{4})-(\d{1,2})-(\d{1,2})(?:$|[T\s])/.exec(s);
    var us = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s);
    if (iso) {
      date = new Date(Number(iso[1]), Number(iso[2])-1, Number(iso[3]), 12);
      if (date.getFullYear() !== Number(iso[1]) || date.getMonth() !== Number(iso[2])-1 || date.getDate() !== Number(iso[3])) return '';
    } else if (us) {
      date = new Date(Number(us[3]), Number(us[1])-1, Number(us[2]), 12);
      if (date.getFullYear() !== Number(us[3]) || date.getMonth() !== Number(us[1])-1 || date.getDate() !== Number(us[2])) return '';
    } else {
      return ''; // Reject ambiguous free-text dates rather than guessing.
    }
  }
  if (!date || isNaN(date.getTime())) return '';
  var day = Number(Utilities.formatDate(date, zone, 'd'));
  var suffix = (day % 100 >= 11 && day % 100 <= 13) ? 'th' :
    ({1:'st',2:'nd',3:'rd'}[day % 10] || 'th');
  return Utilities.formatDate(date, zone, 'EEEE ') + day + suffix +
    Utilities.formatDate(date, zone, ' MMMM yyyy');
}

/** Customer-facing timestamp, preserving clock time in Africa/Nairobi. */
function AQBFormatDisplayDateTime(value) {
  var display = AQBFormatDisplayDate(value);
  if (!display || !(value instanceof Date)) return display;
  return display + ' at ' + Utilities.formatDate(value, 'Africa/Nairobi', 'HH:mm');
}

