function AQBIsQuickServiceRecord(name){
  name=String(name||'').toLowerCase().replace(/[–—]/g,'-');
  if(!name)return false;
  if(/\b(take[ -]?down|takedown|undo(?:ing)?|remov(?:al|e|ing))\b/.test(name))return true;
  if(/\b(treatment|therapy|deep condition|steam|spa|revamp|styling|style|installation|install|retie|retight|maintenance|repair|colour|color|package|consultation)\b/.test(name))return false;
  return /\b(wash only|shampoo only|wash (?:&|and) blow[ -]?dry|blow[ -]?dry|detangl(?:e|ing)?|trim|big chop)\b/.test(name);
}

function AQBResolveCatalogueCustomerCategory(record){
  record=record||{};
  const service=String(record.serviceName||record.service||'').trim();
  if(AQBIsQuickServiceRecord(service))return 'Quick Services';
  const proposal=AQBReconcileCanonicalPhotoFamily({
    category:String(record.category||''),
    serviceName:service,
    variants:String(record.variants||''),
    description:String(record.description||''),
    photoBrief:String(record.photoBrief||'')
  });
  return proposal&&proposal.family&&proposal.family!=='UNASSIGNED'?String(proposal.family):'';
}

