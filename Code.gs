// V16.22.1.22 — Audit Log newest-first maintenance. Does not modify timestamp values.
// Run AQBEnsureAuditLogSortTrigger once. It sorts at five-minute intervals.
function AQBEnsureAuditLogSortTrigger() {
  const name = 'AQBSortAuditLogNewestFirst';
  const existing = ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === name);
  if (!existing.length) ScriptApp.newTrigger(name).timeBased().everyMinutes(5).create();
  if (existing.length > 1) existing.slice(1).forEach(t => ScriptApp.deleteTrigger(t));
  return {success:true, handler:name, intervalMinutes:5, existing:existing.length};
}

function AQBSortAuditLogNewestFirst() {
  // Independent script lock: do not hold the global business-data lock while sorting.
  const lock = LockService.getUserLock();
  if (!lock.tryLock(1000)) return {success:false,reason:'AUDIT_SORT_BUSY'};
  try {
    const sheet = AQBGetSheet(CONFIG.SHEETS.AUDIT);
    const lastRow = sheet.getLastRow();
    if (lastRow < 3) return {success:true,rows:Math.max(0,lastRow-1)};
    // Existing audit schema is A:I. J is a temporary sort-key workspace only.
    if (sheet.getMaxColumns() < 10) sheet.insertColumnsAfter(sheet.getMaxColumns(), 10-sheet.getMaxColumns());
    const count = lastRow-1;
    const temp = sheet.getRange(2,10,count,1);
    if (temp.getValues().some(r => r[0] !== '')) throw new Error('AUDIT_SORT_COLUMN_J_NOT_EMPTY');
    const stamps = sheet.getRange(2,1,count,1).getValues();
    const keys = stamps.map(row => {
      const v=row[0];
      if (v instanceof Date && !isNaN(v.getTime())) return [v.getTime()];
      if (typeof v === 'number' && isFinite(v)) return [Math.round((v-25569)*86400000)];
      const t=String(v||'').trim();
      // ISO date-only and ISO date/time; no time invented in the source cell.
      let m=t.match(/^(\d{4})-(\d{2})-(\d{2})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?$/);
      if (m) return [Date.UTC(+m[1],+m[2]-1,+m[3],+(m[4]||0),+(m[5]||0),+(m[6]||0))];
      m=t.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?)?$/);
      if (m) return [Date.UTC(+m[3],+m[1]-1,+m[2],+(m[4]||0),+(m[5]||0),+(m[6]||0))];
      return [0]; // Undated/unrecognized records at bottom; original values preserved.
    });
    temp.setValues(keys);
    try {
      // Include all nine original columns so each audit record remains intact.
      sheet.getRange(2,1,count,10).sort([{column:10,ascending:false}]);
    } finally {
      sheet.getRange(2,10,count,1).clearContent();
    }
    sheet.getRange(2,1,sheet.getMaxRows()-1,1).setNumberFormat('m/d/yyyy h:mm:ss');
    return {success:true,rows:count,sort:'NEWEST_FIRST',timestampsRewritten:false};
  } finally { lock.releaseLock(); }
}


/**
 * OCTOBER 2026 WHATSAPP RECOVERY — explicit, resumable, one-time campaign.
 * Preview: AQBPreviewOctoberWhatsAppRecovery()
 * Execute: AQBRunOctoberWhatsAppRecovery({confirm:true,limit:5})
 * Never install this function as a time-driven trigger. Run batches manually.
 * This campaign is intentionally distinct from routine completion idempotency.
 */
function AQBGetOctoberWhatsAppRecoveryId_(){return 'AQB_OCT2026_COMPLETION_OVERDUE_V1';}
function AQBGetOctoberWhatsAppRecoveryCandidates_(){
  const start='2026-10-01',today=Utilities.formatDate(new Date(),'Africa/Nairobi','yyyy-MM-dd');
  const aps=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS);
  const ar=aps.getLastRow()>1?aps.getRange(2,1,aps.getLastRow()-1,aps.getLastColumn()).getValues():[];
  const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),cm=AQBBuildHeaderMap(cs);
  const cr=cs.getLastRow()>1?cs.getRange(2,1,cs.getLastRow()-1,cs.getLastColumn()).getValues():[];
  const customers={};
  cr.forEach(function(r){const id=String(r[cm['Customer ID']-1]||'').trim();if(id)customers[id]=r;});
  const completed=[],overdue=[],held=[];
  ar.forEach(function(r){
    if(String(r[8]||'').toUpperCase()!=='COMPLETED'||!AQBIsSisterlocksRetieService(r[4]))return;
    const d=AQBGetActualCompletionDateFromAppointment(r);
    const day=d?Utilities.formatDate(d,'Africa/Nairobi','yyyy-MM-dd'):'';
    if(!day||day<start||day>today)return;
    const id=String(r[0]||'').trim(),cid=String(r[1]||'').trim(),c=customers[cid];
    if(!c){held.push({kind:'COMPLETION',appointmentId:id,reason:'CUSTOMER_NOT_FOUND'});return;}
    const next=new Date(d.getTime());next.setDate(next.getDate()+42);
    const phone=AQBResolveWhatsAppNumber(c[cm['WhatsApp Number']-1]);
    if(!phone.valid){held.push({kind:'COMPLETION',appointmentId:id,reason:'INVALID_PHONE'});return;}
    completed.push({kind:'COMPLETION',key:'AQB_OCT_RECOVERY_COMPLETION_'+id,appointmentId:id,customerId:cid,phone:phone.normalized,first:AQBGetCustomerFirstName(c,cm),service:String(r[4]||''),actualDate:day,nextDate:Utilities.formatDate(next,'Africa/Nairobi','yyyy-MM-dd'),template:CONFIG.WHATSAPP_TEMPLATES.SISTERLOCKS_COMPLETE});
  });
  cr.forEach(function(c){
    const cid=String(c[cm['Customer ID']-1]||'').trim();
    if(!cid||!AQBIsSisterlocksRetieService(c[cm['Service']-1]))return;
    const last=AQBParseRetieDate(c[cm['Last Retie Date']-1]);
    if(!last)return;
    const next=new Date(last.getTime());next.setDate(next.getDate()+42);
    const due=Utilities.formatDate(next,'Africa/Nairobi','yyyy-MM-dd');
    if(due>today)return;
    const days=Math.floor((Date.parse(today+'T12:00:00Z')-Date.parse(due+'T12:00:00Z'))/86400000);
    const stage=AQBGetRetieOverdueStage(days);
    if(!stage)return;
    const authority=AQBFindRetieAppointmentAuthority(cid);
    if(authority&&authority.date){
      const booked=Utilities.formatDate(new Date(authority.date),'Africa/Nairobi','yyyy-MM-dd');
      if(booked>=today)return;
    }
    const phone=AQBResolveWhatsAppNumber(c[cm['WhatsApp Number']-1]);
    if(!phone.valid){held.push({kind:'OVERDUE',customerId:cid,reason:'INVALID_PHONE'});return;}
    overdue.push({kind:'OVERDUE',key:'AQB_OCT_RECOVERY_OVERDUE_'+cid+'_'+due+'_'+stage,customerId:cid,phone:phone.normalized,first:AQBGetCustomerFirstName(c,cm),service:String(c[cm['Service']-1]||''),nextDate:due,stage:stage,template:AQBGetRetieOverdueTemplate(stage)});
  });
  return {completed:completed,overdue:overdue,held:held};
}
function AQBGetOctoberWhatsAppRecoveryLedger_(){
  const sh=AQBGetSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES),m=AQBBuildHeaderMap(sh),found={};
  if(sh.getLastRow()<2)return found;
  const data=sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).getValues();
  data.forEach(function(r,i){
    const campaign=m['Recovery Campaign ID']?String(r[m['Recovery Campaign ID']-1]||''):'';
    if(campaign!==AQBGetOctoberWhatsAppRecoveryId_())return;
    const key=m['Notification Key']?String(r[m['Notification Key']-1]||''):'';
    if(key)found[key]={row:i+2,status:m['Delivery Status']?String(r[m['Delivery Status']-1]||''):''};
  });
  return found;
}
function AQBPreviewOctoberWhatsAppRecovery(){
  AQBRequireAdmin();
  const c=AQBGetOctoberWhatsAppRecoveryCandidates_(),seen=AQBGetOctoberWhatsAppRecoveryLedger_();
  const pending=c.completed.concat(c.overdue).filter(x=>!seen[x.key]);
  return {version:'V16.22.1.22',campaignId:AQBGetOctoberWhatsAppRecoveryId_(),since:'2026-10-01',dryRun:true,
    completionCandidates:c.completed.length,overdueCurrentlyEligible:c.overdue.length,alreadyAttempted:c.completed.length+c.overdue.length-pending.length,
    pending:pending,held:c.held,notes:'Preview only. No messages submitted. Historical messages do not exclude this explicitly authorized recovery cycle.'};
}
function AQBRunOctoberWhatsAppRecovery(options){
  AQBRequireAdmin();options=options||{};
  if(options.confirm!==true)throw new Error('Explicit confirmation required: AQBRunOctoberWhatsAppRecovery({confirm:true,limit:5})');
  const limit=Math.min(10,Math.max(1,Number(options.limit)||5));
  const quiet=AQBGetWhatsAppQuietTimeStatus(new Date());
  if(quiet.quiet||!AQBIsWhatsAppRecoverySendHour_())return {status:'DEFERRED_QUIET_HOURS',quiet:quiet};
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(1000))return {status:'LOCK_BUSY',sent:0};
  try{
    const preview=AQBPreviewOctoberWhatsAppRecovery();
    const candidates=preview.pending.slice(0,limit);
    const ws=AQBGetSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES),wm=AQBBuildHeaderMap(ws);
    const campaign=AQBGetOctoberWhatsAppRecoveryId_();
    const result={version:'V16.22.1.22',campaignId:campaign,attempted:0,accepted:0,held:0,details:[]};
    for(const item of candidates){
      // Re-evaluate eligibility before any network send, especially overdue.
      const fresh=AQBGetOctoberWhatsAppRecoveryCandidates_();
      const eligible=fresh.completed.concat(fresh.overdue).some(x=>x.key===item.key);
      if(!eligible){result.held++;result.details.push({key:item.key,status:'NO_LONGER_ELIGIBLE'});continue;}
      if(AQBGetOctoberWhatsAppRecoveryLedger_()[item.key]){result.held++;result.details.push({key:item.key,status:'ALREADY_ATTEMPTED'});continue;}
      const now=new Date();
      const entry={'Message ID':'','WhatsApp Number':item.phone,'Direction':'OUT','Timestamp':now,
        'Message Type':item.kind+'_RECOVERY_TEMPLATE','Message Text':'October 2026 recovery submission intent',
        'Customer ID':item.customerId,'Service':item.service,'Status':'QUEUED','Event ID':item.key,
        'Campaign':campaign,'Template Name':item.template,'Delivery Status':'QUEUED','Delivery Updated At':now,
        'Appointment ID':item.appointmentId||'','Notification Key':item.key,'Recovery Campaign ID':campaign,'Notification Attempt':1};
      AQBAppendWhatsAppLedgerByHeaders_(ws,entry);
      const ledgerRow=ws.getLastRow();
      // A QUEUED row is the durable idempotency guard; a crash is HELD for reconciliation.
      result.attempted++;
      try{
        const params=AQBBuildWhatsAppBodyVariables([item.first,item.nextDate]);
        const response=AQBSendWhatsAppTemplate(item.phone,item.template,'en_US',params);
        const meta=response&&response.response&&response.response.messages&&response.response.messages[0];
        const mid=meta&&meta.id?String(meta.id):'';
        const state=mid?'ACCEPTED':response&&response.skipped?'HELD_SKIPPED':'HELD_UNCERTAIN';
        if(wm['Message ID']&&mid)ws.getRange(ledgerRow,wm['Message ID']).setValue(mid);
        if(wm['Status'])ws.getRange(ledgerRow,wm['Status']).setValue(state);
        if(wm['Delivery Status'])ws.getRange(ledgerRow,wm['Delivery Status']).setValue(state);
        if(wm['Delivery Updated At'])ws.getRange(ledgerRow,wm['Delivery Updated At']).setValue(new Date());
        if(wm['Error']&&!mid)ws.getRange(ledgerRow,wm['Error']).setValue(String(response&&response.reason||response&&response.error||'Meta acceptance not confirmed'));
        if(item.appointmentId&&mid){
          // Mirror the campaign result to the appointment, without creating another ledger row.
          const ap=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),am=AQBBuildHeaderMap(ap);
          const ids=ap.getRange(2,am['Appointment ID'],ap.getLastRow()-1,1).getValues();
          const index=ids.findIndex(x=>String(x[0])===item.appointmentId);
          if(index>=0){
            const row=index+2,updates={'Last WhatsApp Type':'COMPLETION_RECOVERY','Last WhatsApp Status':state,
              'Last WhatsApp Sent At':new Date(),'Last WhatsApp Message ID':mid,'Last WhatsApp Template':item.template};
            Object.keys(updates).forEach(k=>{if(am[k])ap.getRange(row,am[k]).setValue(updates[k]);});
          }
        }
        if(mid)result.accepted++;else result.held++;
        result.details.push({key:item.key,status:state,messageId:mid});
      }catch(e){
        if(wm['Status'])ws.getRange(ledgerRow,wm['Status']).setValue('HELD_UNCERTAIN');
        if(wm['Delivery Status'])ws.getRange(ledgerRow,wm['Delivery Status']).setValue('HELD_UNCERTAIN');
        if(wm['Error'])ws.getRange(ledgerRow,wm['Error']).setValue(String(e&&e.message||e));
        result.held++;result.details.push({key:item.key,status:'HELD_UNCERTAIN',error:String(e&&e.message||e)});
      }
    }
    AQBLogAudit('AQB_OCTOBER_WHATSAPP_RECOVERY_RUN','System',campaign,JSON.stringify(result));
    return result;
  }finally{lock.releaseLock();}
}

