function AQBRunEventMessaging(){
  AQBEnsureEventMessagingConfig();
  AQBEnsureWhatsAppQuietTimeConfig();
  const quiet=AQBGetWhatsAppQuietTimeStatus(new Date());
  if(quiet.quiet){
    const out={version:'V16.21.16.4.1',quietTimeBlocked:true,quietTime:quiet,events:[],remaining:0};
    try{AQBLogAudit('AQB_EVENT_MESSAGE_QUIET_TIME','System','EVENT_MESSAGING',JSON.stringify(out));}catch(ignore){}
    return out;
  }
  const today=new Date(),events=AQBReadEventMessagingConfig().filter(function(e){
    const active=String(e['Active']).toLowerCase()==='true',
          auto=String(e['Auto Send']).toLowerCase()==='true';
    return active&&auto&&AQBMatchEventRuleDate(e,today);
  });
  const runs=[];let remaining=0;
  events.forEach(function(event){
    const r=AQBRunEventCampaign(event,40);runs.push(r);remaining+=Number(r.remaining||0);
  });
  if(remaining>0)AQBEnsureEventMessagingContinuation();
  return {version:'V16.21.16.4.1',date:Utilities.formatDate(today,Session.getScriptTimeZone(),'yyyy-MM-dd'),events:runs,remaining:remaining};
}

function AQBRunEventMessagingContinuation(){
  // Same due-date guard and duplicate ledger make continuation idempotent.
  return AQBRunEventMessaging();
}

function AQBEnsureEventMessagingTrigger(){
  const handler='AQBRunEventMessaging',current=[];
  ScriptApp.getProjectTriggers().forEach(function(t){
    const h=t.getHandlerFunction();
    if(h==='AQBRunEventMessaging_'){ScriptApp.deleteTrigger(t);return;}
    if(h===handler)current.push(t);
  });
  if(current.length>1)current.slice(1).forEach(function(t){ScriptApp.deleteTrigger(t);});
  if(current.length)return {installed:false,existing:true,handler:handler};
  ScriptApp.newTrigger(handler).timeBased().atHour(9).nearMinute(0).everyDays(1).create();
  return {installed:true,handler:handler,time:'09:00',timezone:Session.getScriptTimeZone()};
}

