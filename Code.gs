function AQBSetMasterCatalogueIdForService(category, service, catalogueId, price, trending) {
  const master=AQBGetSheet(CONFIG.SHEETS.LISTS);
  const mm=AQBEnsureMasterListsCatalogueIdColumn();
  const schema=AQBGetMasterListsSchema();
  const n=master.getLastRow();
  const key=AQBGetCanonicalServiceKey(category,service);
  let matches=0;
  if(n>=2){
    const rows=master.getRange(2,1,n-1,master.getLastColumn()).getValues();
    rows.forEach(function(r,i){
      const item=schema.legacyNoItem?'Service':String(r[mm['Item']-1]||'').trim();
      const k=AQBGetCanonicalServiceKey(r[mm['Category']-1],r[schema.serviceNameCol-1]);
      if(item!=='Service'||k!==key)return;
      r[mm['Catalogue ID']-1]=catalogueId;
      if(trending!==undefined && mm['Trending']) r[mm['Trending']-1]=trending;
      if(price!==undefined && String(price).trim() && mm['Price']) r[mm['Price']-1]=price;
      master.getRange(i+2,1,1,master.getLastColumn()).setValues([r]);
      matches++;
    });
  }
  return matches;
}

function AQBAppendMasterService(category, service, catalogueId, price) {
  const master=AQBGetSheet(CONFIG.SHEETS.LISTS);
  const mm=AQBEnsureMasterListsCatalogueIdColumn();
  const schema=AQBGetMasterListsSchema();
  const row=Array(master.getLastColumn()).fill('');
  const set=function(h,v){if(mm[h])row[mm[h]-1]=v;};
  set('Item','Service');
  set('Category',category);
  if(mm['Service Name']) set('Service Name',service);
  if(mm['Name']) set('Name',service);
  set('Catalogue ID',catalogueId);
  if(mm['Price']) set('Price',price);
  if(mm['Active']) set('Active',true);
  if(mm['Sort Order']) set('Sort Order',9999);
  if(mm['Trending']) set('Trending',true);
  master.appendRow(row);
  return master.getLastRow();
}

function AQBUpsertApprovedTrendIntoMasterLists(trendRow, tm, masterAction, newServiceName) {
  const category=String(trendRow[tm['Category']-1]||'').trim();
  const trendName=String(trendRow[tm['Style Name']-1]||'').trim();
  const serviceName=String(newServiceName||trendName).trim()||trendName;
  const price=trendRow[tm['Price']-1];
  if(!category||!trendName) throw new Error('Approved trend requires a category and style name.');

  const master=AQBGetSheet(CONFIG.SHEETS.LISTS);
  const mm=AQBEnsureMasterListsCatalogueIdColumn();
  const schema=AQBGetMasterListsSchema();
  const key=AQBGetCanonicalServiceKey(category,trendName);
  const n=master.getLastRow();
  let matches=[];
  if(n>=2){
    const rows=master.getRange(2,1,n-1,master.getLastColumn()).getValues();
    rows.forEach(function(r,i){
      const item=schema.legacyNoItem?'Service':String(r[mm['Item']-1]||'').trim();
      const k=AQBGetCanonicalServiceKey(r[mm['Category']-1],r[schema.serviceNameCol-1]);
      if(item==='Service'&&k===key) matches.push({row:r,index:i+2});
    });
  }

  let catalogueId='';
  matches.some(function(x){
    const id=String(x.row[mm['Catalogue ID']-1]||'').trim();
    if(AQBIsCanonicalCatalogueId(id)){catalogueId=id;return true;}
    return false;
  });
  if(!catalogueId) catalogueId=AQBResolveCatalogueId(category,trendName);
  if(!catalogueId) catalogueId=AQBGetNextCanonicalCatalogueId();

  const action=String(masterAction||'ADD_AS_NEW').toUpperCase();
  if(matches.length && action==='KEEP_EXISTING') {
    AQBSetMasterCatalogueIdForService(category,trendName,catalogueId,undefined,true);
    return {rowNum:matches[0].index,existing:true,action:action,catalogueId:catalogueId};
  }
  if(matches.length) {
    AQBSetMasterCatalogueIdForService(category,trendName,catalogueId,price,true);
    return {rowNum:matches[0].index,existing:true,action:action||'UPDATE_EXISTING',catalogueId:catalogueId};
  }

  AQBAppendMasterService(category,serviceName,catalogueId,price);
  return {rowNum:master.getLastRow(),existing:false,action:'ADD_AS_NEW',serviceName:serviceName,catalogueId:catalogueId};
}

function AQBEnsureCanonicalCatalogueIdentity(options) {
  /*
   *
   * The previous implementation could re-index Catalogue rows,
   * remap legacy IDs and write new AQBCAT### values. That behavior
   * is incompatible with the immutable Catalogue identity contract.
   *
   * This compatibility entry point is now READ-ONLY.
   * Identity repair must be performed deliberately by the canonical
   * identity allocator/audit workflow.
   */
  return AQBAuditCanonicalCatalogueIdentityGuard();
}

function AQBUpdatePermanentCatalogueFromAITrend(trendRow,tm,options){
  const opts=options||{};
  const category=String(trendRow[tm['Category']-1]||'').trim();
  const name=String(trendRow[tm['Style Name']-1]||'').trim();
  let catalogueId=AQBResolveCatalogueId(category,name);
  if(!catalogueId){
    const supplied=String(trendRow[tm['Catalogue ID']-1]||'').trim().toUpperCase();
    if(AQBIsCanonicalCatalogueId(supplied) && !AQBIsCatalogueIdInUse(supplied)) catalogueId=supplied;
  }
  if(!catalogueId) catalogueId=AQBGetNextCanonicalCatalogueId();
  if(tm['Catalogue ID'])trendRow[tm['Catalogue ID']-1]=catalogueId;

  if(opts.updateMaster){
    const master=AQBGetSheet(CONFIG.SHEETS.LISTS),mm=AQBEnsureMasterListsCatalogueIdColumn(),schema=AQBGetMasterListsSchema();
    const n=master.getLastRow(); let found=false;
    if(n>=2){
      const rows=master.getRange(2,1,n-1,master.getLastColumn()).getValues();
      rows.forEach(function(r,i){
        const item=schema.legacyNoItem?'Service':String(r[mm['Item']-1]||'').trim();
        const k=AQBGetCanonicalServiceKey(r[mm['Category']-1],r[schema.serviceNameCol-1]);
        if(item!=='Service'||k!==AQBGetCanonicalServiceKey(category,name))return;
        r[mm['Catalogue ID']-1]=catalogueId;
        if(mm['Trending'])r[mm['Trending']-1]=true;
        if(tm['Price']&&mm['Price']&&String(trendRow[tm['Price']-1]||'').trim())r[mm['Price']-1]=trendRow[tm['Price']-1];
        master.getRange(i+2,1,1,master.getLastColumn()).setValues([r]);found=true;
      });
    }
    if(!found && opts.createMasterIfMissing){
      AQBAppendMasterService(category,name,catalogueId,tm['Price']?trendRow[tm['Price']-1]:'');
    }
  }

  if(opts.updateCatalogue){
    const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBEnsureCanonicalChannelFields(cat,AQBEnsureCatalogueMetaColumns());
    const n=cat.getLastRow(); let rowNum=0,row=null;
    if(n>=2){
      const rows=cat.getRange(2,1,n-1,cat.getLastColumn()).getValues();
      for(let i=0;i<rows.length;i++){
        const r=rows[i];
        const id=String(r[cm['Catalogue ID']-1]||'').trim();
        const k=AQBGetCanonicalServiceKey(r[cm['Category']-1],r[cm['Service Name']-1]);
        if(id===catalogueId || k===AQBGetCanonicalServiceKey(category,name)){rowNum=i+2;row=r.slice();break;}
      }
    }
    if(!row)row=Array(cat.getLastColumn()).fill('');
    const existingRowId=rowNum?String(row[cm['Catalogue ID']-1]||'').trim().toUpperCase():'';
    if(existingRowId && AQBIsCanonicalCatalogueId(existingRowId)) catalogueId=existingRowId;
    else if(existingRowId && !AQBIsCanonicalCatalogueId(existingRowId)) {
      try{logIdentityConflictForAudit_({serviceKey:AQBGetCanonicalServiceKey(category,name),canonicalId:existingRowId,attemptedId:catalogueId,severity:'NON_CANONICAL_EXISTING_ID_QUARANTINED',actionTaken:'PRESERVE_EXISTING_ID_NO_ID_REWRITE',timestamp:new Date()});}catch(ignoreAudit){}
      catalogueId=existingRowId;
    }
    const set=function(h,v){if(cm[h]&&v!==undefined&&v!=='')row[cm[h]-1]=v;};
    set('Catalogue ID',catalogueId);set('Canonical Service Key',AQBGetCanonicalServiceKey(category,name));set('Category',category);set('Service Name',String(tm['Service Name']?trendRow[tm['Service Name']-1]||name:name));
    if(tm['Price'])set('Price',trendRow[tm['Price']-1]);
    if(tm['Description'])set('Description',trendRow[tm['Description']-1]);
    if(tm['Image URL'])set('Image URL',trendRow[tm['Image URL']-1]);
    if(tm['Image Source'])set('Image Source',trendRow[tm['Image Source']-1]);
    if(tm['Image Source URL'])set('Image Source URL',trendRow[tm['Image Source URL']-1]);
    if(tm['Photo Brief'])set('Photo Brief',trendRow[tm['Photo Brief']-1]);
    set('Catalogue Type','Service');set('Trend Status',tm['Trend Status']?trendRow[tm['Trend Status']-1]:'ACTIVE');set('Featured',tm['Featured']?trendRow[tm['Featured']-1]:'NO');
    if(tm['Trend Start'])set('Trend Start',trendRow[tm['Trend Start']-1]);if(tm['Trend End'])set('Trend End',trendRow[tm['Trend End']-1]);if(tm['Source'])set('Trend Source',trendRow[tm['Source']-1]);
    set('Publish Channels',AQBGetDefaultPublishChannels());if(tm['Collection IDs'])set('Collection IDs',trendRow[tm['Collection IDs']-1]);
    set('Active','Yes');
    if(rowNum)cat.getRange(rowNum,1,1,cat.getLastColumn()).setValues([row]); else cat.appendRow(row);
  }
  return catalogueId;
}

function AQBNormalizeCatalogueIdentityText(v) {
  return String(v == null ? '' : v).trim();
}

function AQBBuildCatalogueIdentityKey(category, service) {
  return AQBGetCanonicalServiceKey(AQBNormalizeCatalogueIdentityText(category), AQBNormalizeCatalogueIdentityText(service));
}

function AQBFindCatalogueMasterServiceRows(category, service) {
  var out = [];
  var master = AQBGetSheet(CONFIG.SHEETS.LISTS);
  var mm = AQBEnsureMasterListsCatalogueIdColumn();
  var schema = AQBGetMasterListsSchema();
  var n = master.getLastRow();
  if (n < 2) return out;

  var key = AQBBuildCatalogueIdentityKey(category, service);
  var rows = master.getRange(2, 1, n - 1, master.getLastColumn()).getValues();

  rows.forEach(function(r, i) {
    var item = schema.legacyNoItem ? 'Service' : AQBNormalizeCatalogueIdentityText(r[mm['Item'] - 1]);
    if (item !== 'Service') return;

    var rk = AQBBuildCatalogueIdentityKey(r[mm['Category'] - 1], r[schema.serviceNameCol - 1]);
    if (rk === key) {
      out.push({ rowNumber: i + 2, row: r.slice() });
    }
  });

  return out;
}

function AQBFindCatalogueByServiceKey(category, service) {
  var cat = AQBGetSheet(CONFIG.SHEETS.CATALOGUE);
  var cm = AQBEnsureCatalogueMetaColumns();
  var n = cat.getLastRow();
  var key = AQBBuildCatalogueIdentityKey(category, service);
  if (!key || n < 2) return null;

  var rows = cat.getRange(2, 1, n - 1, cat.getLastColumn()).getValues();
  for (var i = 0; i < rows.length; i++) {
    var rowKey = AQBBuildCatalogueIdentityKey(
      rows[i][cm['Category'] - 1],
      rows[i][cm['Service Name'] - 1]
    );
    if (rowKey !== key) continue;
    var id = AQBNormalizeCatalogueIdentityText(rows[i][cm['Catalogue ID'] - 1]);
    if (!AQBIsCanonicalCatalogueId(id)) continue;
    return {rowNumber:i + 2, row:rows[i].slice(), catalogueId:id, key:key};
  }
  return null;
}

function AQBResolveCatalogueId(category, service) {
  var existing = AQBFindCatalogueByServiceKey(category, service);
  return existing ? existing.catalogueId : '';
}

function AQBResolveOrAllocateCatalogueId(category, service) {
  var existing = AQBFindCatalogueByServiceKey(category, service);
  return existing ? existing.catalogueId : AQBGetNextCanonicalCatalogueId();
}

function AQBUpsertCatalogueMasterService(category, service, price, trending) {
  var master = AQBGetSheet(CONFIG.SHEETS.LISTS);
  var mm = AQBBuildHeaderMap(master);
  var schema = AQBGetMasterListsSchema();
  var n = master.getLastRow();
  var key = AQBBuildCatalogueIdentityKey(category, service);
  var matches = [];

  if (n >= 2) {
    var rows = master.getRange(2, 1, n - 1, master.getLastColumn()).getValues();
    for (var i = 0; i < rows.length; i++) {
      var item = schema.legacyNoItem ? 'Service' : AQBNormalizeCatalogueIdentityText(rows[i][mm['Item'] - 1]);
      if (item !== 'Service') continue;
      var rowKey = AQBBuildCatalogueIdentityKey(rows[i][mm['Category'] - 1], rows[i][schema.serviceNameCol - 1]);
      if (rowKey === key) matches.push({rowNumber:i + 2, row:rows[i].slice()});
    }
  }

  if (matches.length) {
    matches.forEach(function(match) {
      var row = match.row;
      if (mm['Item']) row[mm['Item'] - 1] = 'Service';
      if (mm['Category']) row[mm['Category'] - 1] = category;
      if (schema.serviceNameCol) row[schema.serviceNameCol - 1] = service;
      if (mm['Name']) row[mm['Name'] - 1] = service;
      if (mm['Price'] && AQBNormalizeCatalogueIdentityText(price)) row[mm['Price'] - 1] = price;
      if (mm['Active']) row[mm['Active'] - 1] = true;
      if (mm['Sort Order'] && !row[mm['Sort Order'] - 1]) row[mm['Sort Order'] - 1] = 9999;
      if (mm['Trending'] && trending !== undefined) row[mm['Trending'] - 1] = trending;
      master.getRange(match.rowNumber, 1, 1, master.getLastColumn()).setValues([row]);
    });
    return {created:false, updated:matches.length, rowNumber:matches[0].rowNumber};
  }

  var out = Array(master.getLastColumn()).fill('');
  var set = function(h,v){if(mm[h]) out[mm[h]-1] = v;};
  set('Item','Service');
  set('Category',category);
  if(mm['Service Name']) set('Service Name',service);
  if(mm['Name']) set('Name',service);
  set('Price',price);
  set('Active',true);
  set('Sort Order',9999);
  if(mm['Trending']) set('Trending',trending === undefined ? true : trending);
  master.appendRow(out);
  return {created:true, updated:0, rowNumber:master.getLastRow()};
}

function AQBSyncCatalogueAndResolveId(category, service) {
  AQBRefreshCatalogue();
  var found = AQBFindCatalogueByServiceKey(category, service);
  if (!found) {
    /* A second sync is safe and handles a just-created Master service. */
    AQBRefreshCatalogue();
    found = AQBFindCatalogueByServiceKey(category, service);
  }
  if (!found || !found.catalogueId) {
    throw new Error('Catalogue could not resolve a permanent Catalogue ID for ' + category + ' / ' + service + '.');
  }
  return found.catalogueId;
}

function AQBNormalizeCatalogueVariantText(value){
  return String(value||'').normalize('NFKC').toLowerCase()
    .replace(/[’‘]/g,"'").replace(/[’']s\b/g,'')
    .replace(/[-–—−_/]+/g,' ')
    .replace(/[^a-z0-9+\-\s]+/g,' ')
    .replace(/\s+/g,' ').trim();
}

function AQBGetUniqueCatalogueVariants(arr){
  const seen={},out=[];
  (arr||[]).forEach(function(v){
    v=String(v||'').replace(/\s+/g,' ').trim();
    const k=AQBNormalizeCatalogueVariantText(v);if(!v||!k||seen[k])return;seen[k]=true;out.push(v);
  });
  return out;
}

function AQBSplitCatalogueVariants(value){
  return String(value||'').split(/[\n,;|]+/).map(function(x){return String(x||'').replace(/\s+/g,' ').trim();}).filter(Boolean);
}

function AQBEscapeCatalogueRegex(value){
  return String(value||'').replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
}

function AQBHasCatalogueVariantPhrase(text,phrase){
  const h=AQBNormalizeCatalogueVariantText(text),p=AQBNormalizeCatalogueVariantText(phrase);
  if(!h||!p)return false;
  const rx=new RegExp('(?:^|[^a-z0-9])'+AQBEscapeCatalogueRegex(p).replace(/\s+/g,'\\s+')+'(?:$|[^a-z0-9])','i');
  return rx.test(h);
}

function AQBGetCatalogueVariantFamilyLabel(family){
  return ({cornrow:'cornrows',braid:'braids',twist:'twists',loc:'locs',weave:'weave',wig:'wig',curl:'curls',afro:'afro',straight:'straight hair'})[String(family||'')]||'';
}

function AQBGetCatalogueVariantCount(service){
  const n=AQBNormalizeCatalogueVariantText(service),m=n.match(/\b(\d+)\s*(lines?|rows?)\b/);
  return m?String(m[1]):'';
}

function AQBGetCatalogueVariantSize(service){
  const n=AQBNormalizeCatalogueVariantText(service),defs=['jumbo','large','chunky','medium','small','micro','mini'];
  for(let i=0;i<defs.length;i++)if(AQBHasCatalogueVariantPhrase(n,defs[i]))return defs[i];
  return '';
}

function AQBGetCatalogueVariantLength(service){
  const n=AQBNormalizeCatalogueVariantText(service),defs=['extra long','waist length','waist-length','hip length','hip-length','mid back','mid-back','shoulder length','shoulder-length','long','medium','short','bob'];
  for(let i=0;i<defs.length;i++)if(AQBHasCatalogueVariantPhrase(n,defs[i]))return defs[i].replace(/-/g,' ');
  return '';
}

