    console.warn('AQB TikTok feed access rejected (credential omitted from log).');
    return ContentService.createTextOutput('Feed unavailable').setMimeType(ContentService.MimeType.TEXT);
  }
  const format=String(e&&e.parameter&&e.parameter.format||'xml').toLowerCase();
  if(format!=='xml'&&format!=='csv')return ContentService.createTextOutput('Unsupported format').setMimeType(ContentService.MimeType.TEXT);
