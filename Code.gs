function AQBGetCustomerDetails(customerId){
  AQBRequireUser();const cs=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=cs.getLastRow();if(n<2)throw new Error('Customer not found.');let customer=null;
  const rows=cs.getRange(2,1,n-1,cs.getLastColumn()).getValues(),cm=AQBBuildHeaderMap(cs),nextMap=AQBGetNextAppointmentsMap();
  for(const r of rows){if(String(r[cm['Customer ID']-1]||'')===String(customerId)){customer=AQBBuildCustomerObject(r,cm,nextMap);break;}}
  if(!customer)throw new Error('Customer not found.');
  const as=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),an=as.getLastRow(),appointments=[];
  if(an>=2)as.getRange(2,1,an-1,17).getValues().forEach(r=>{if(String(r[1])===String(customerId))appointments.push(AQBBuildAppointmentObject(r));});
  appointments.sort((a,b)=>String(b.appointmentDate+b.startTime).localeCompare(String(a.appointmentDate+a.startTime)));
  const todayKey=AQBFormatDateKey(new Date());
  appointments.forEach(a=>{a.overdue=String(a.appointmentDate||'')<todayKey&&!['COMPLETED','CANCELLED','NO SHOW'].includes(String(a.status||'').trim().toUpperCase());});
  customer.overdueAppointment=appointments.find(a=>a.overdue)||null;
  return {customer,appointments};
}

function AQBGetCustomerDirectory(){
