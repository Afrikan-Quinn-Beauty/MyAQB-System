function AQBResolveEventSender(senderDisplay){
  const display=String(senderDisplay||'').trim(),name=display.split('—')[0].trim();
  const s=AQBGetSheet(CONFIG.SHEETS.USERS),n=s.getLastRow();
  if(n<2)return {authorized:false,name:name,display:display,reason:'USERS_EMPTY'};
  const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  for(let i=0;i<rows.length;i++){
    const userName=String(rows[i][m['Name']-1]||'').trim(),
          status=String(rows[i][m['Status']-1]||'').trim().toUpperCase(),
          role=String(rows[i][m['Role']-1]||'').trim();
    if(userName.toLowerCase()===name.toLowerCase()&&status==='ACTIVE'){
      return {authorized:true,name:userName,role:role,display:display};
    }
  }
  return {authorized:false,name:name,display:display,reason:'ACTIVE_USER_NOT_FOUND'};
}

function AQBBuildEventTemplateValues(event,customer){
  const map={
    FIRST_NAME:String(customer.firstName||customer.customerName||'').trim(),
    EVENT_GREETING:String(event['Event Greeting']||'').trim(),
    OPENING_MESSAGE:String(event['Opening Message']||'').trim(),
    CLOSING_MESSAGE:String(event['Closing Message']||'').trim(),
    SENDER:String(event['Sender']||'').trim()
  };
  return String(event['Template Variables']||'FIRST_NAME').split(',')
    .map(function(x){return String(x||'').trim().toUpperCase();})
    .filter(Boolean)
    .map(function(k){return map[k]!==undefined?map[k]:'';});
}

function AQBIsEventMessageSent(eventId,customerId){
  AQBEnsureSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES,WHATSAPP_MESSAGE_HEADERS.concat(AQB_EVENT_MESSAGE_LEDGER_HEADERS_));
  const s=AQBGetSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES),n=s.getLastRow();
  if(n<2)return false;
  const m=AQBBuildHeaderMap(s);if(!m['Event ID']||!m['Customer ID'])return false;
  const rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues(),
        eid=String(eventId||'').trim().toUpperCase(),cid=String(customerId||'').trim();
  return rows.some(function(r){
    if(String(r[m['Event ID']-1]||'').trim().toUpperCase()!==eid)return false;
    if(String(r[m['Customer ID']-1]||'').trim()!==cid)return false;
    const st=String(r[m['Status']-1]||'').trim().toUpperCase();
    return ['FAILED','ERROR','SKIPPED'].indexOf(st)===-1;
  });
}

function AQBLogEventWhatsApp(event,customer,result,status,error){
  const s=AQBEnsureSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES,WHATSAPP_MESSAGE_HEADERS.concat(AQB_EVENT_MESSAGE_LEDGER_HEADERS_)),
        response=result&&result.response?result.response:{},
        messageId=response&&Array.isArray(response.messages)&&response.messages[0]?String(response.messages[0].id||''):'',
        summary=[event['Event Greeting'],event['Opening Message'],event['Closing Message']].filter(Boolean).join(' | ');
  AQBAppendByHeaders(s,{
    'Message ID':messageId,
    'WhatsApp Number':AQBNormalizeWhatsAppIncomingNumber(customer.phone),
    'Direction':'OUT',
    'Timestamp':new Date(),
    'Message Type':String(event['Message Type']||'EVENT_TEMPLATE'),
    'Message Text':String(event['Message Text']||summary),
    'Customer ID':customer.customerId,
    'Intent':String(event['Message Intent']||'CUSTOMER_EVENT'),
    'Service':String(event['Service']||''),
    'Status':String(status||'').toUpperCase(),
    'Reply':'',
    'Error':String(error||''),
    'Event ID':String(event['Event ID']||'').trim().toUpperCase(),
    'Campaign':String(event['Event Name']||'').trim(),
    'Template Name':String(event['Template']||'').trim(),
    'Sender':String(event['Sender']||'').trim(),
    'Delivery Status':String(status||'').toUpperCase(),
    'Delivery Updated At':new Date()
  });
}

function AQBUpdateWhatsAppDeliveryStatus(status){
  const id=String(status&&status.id||'').trim();
  if(!id)return {updated:false};
  AQBEnsureSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES,WHATSAPP_MESSAGE_HEADERS.concat(AQB_EVENT_MESSAGE_LEDGER_HEADERS_));
  const s=AQBGetSheet(CONFIG.SHEETS.WHATSAPP_MESSAGES),n=s.getLastRow(),m=AQBBuildHeaderMap(s);
  if(n<2||!m['Message ID'])return {updated:false};
  const ids=s.getRange(2,m['Message ID'],n-1,1).getValues();
  for(let i=0;i<ids.length;i++){
    if(String(ids[i][0]||'').trim()!==id)continue;
    const state=String(status.status||'').trim().toUpperCase()||'UNKNOWN';
    if(m['Status'])s.getRange(i+2,m['Status']).setValue(state);
    if(m['Delivery Status'])s.getRange(i+2,m['Delivery Status']).setValue(state);
    if(m['Delivery Updated At'])s.getRange(i+2,m['Delivery Updated At']).setValue(new Date());
    if(m['Error']&&Array.isArray(status.errors)&&status.errors.length)s.getRange(i+2,m['Error']).setValue(JSON.stringify(status.errors));
    try{AQBUpdateAppointmentWhatsAppDelivery_(s,i+2,m,state,id);}catch(trackError){AQBLogAudit('WHATSAPP_TRACKER_ERROR','WhatsApp',id,String(trackError.message||trackError));}
    return {updated:true,row:i+2,status:state};
  }
  return {updated:false};
}

