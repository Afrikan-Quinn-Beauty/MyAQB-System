    const key=id+'|'+String(r[m['Type']-1]||'').trim().toUpperCase();if(opportunityKeys[key])return false;opportunityKeys[key]=true;
    return true;
  }).slice(-30).reverse().map(function(r){return {opportunityId:String(r[m['Opportunity ID']-1]||''),trendId:String(r[m['Trend ID']-1]||''),type:String(r[m['Type']-1]||''),trend:String(r[m['Trend']-1]||''),category:String(r[m['Category']-1]||''),opportunity:String(r[m['Opportunity']-1]||''),existingService:String(r[m['Existing Service']-1]||''),recommendedAction:String(r[m['Recommended Action']-1]||''),status:String(r[m['Status']-1]||'')};});
