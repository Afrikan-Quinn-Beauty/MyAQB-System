function AQBGetCataloguePublicPage(page, pageSize, category, search){
  // Read-only, truly paged public reader. Do NOT call the expensive complete
  // public payload (Most Loved, trends, appearance, logo) for every page.
  page=Math.max(1,Math.floor(Number(page)||1));
  pageSize=Math.min(12,Math.max(4,Math.floor(Number(pageSize)||12)));
  category=String(category||'All').trim();search=String(search||'').trim().toLowerCase();
  const all=AQBReadPreparedPublicCatalogue();
  // Customer showcase excludes operational logistics/fee records before pagination.
  // No mutation of Catalogue, price, payment, or public cache sheets.
  const visible=all.filter(function(x){
    const id=String(x.catalogueId||'').toUpperCase();
    const name=String(x.name||'').toLowerCase();
    const cat=String(x.category||'').toLowerCase();
    return !(/\b(mobile fee|radius zone fee|travel fee|transport fee|outside nairobi mobile|service area fee|logistics fee)\b/.test(name)) && !(/^(mobile beauty services|mobile service fees|travel fees|operational|logistics)$/.test(cat));
  });
  const filtered=visible.filter(function(x){
    const cat=String(x.category||x.group||''),customerCat=String(x.customerCategory||'');
    const hay=(String(x.name||'')+' '+cat+' '+customerCat+' '+String(x.serviceTier||'')+' '+String(x.description||'')).toLowerCase();
    return (category==='All'||cat===category||customerCat===category||String(x.serviceTier||'')===category) && (!search||hay.indexOf(search)>=0);
  });
  const start=(page-1)*pageSize;
  return {ready:all.length>0,items:filtered.slice(start,start+pageSize),page:page,pageSize:pageSize,total:filtered.length,hasMore:start+pageSize<filtered.length,
    categories:Array.from(new Set(visible.map(x=>String(x.category||'').trim()).filter(Boolean))).sort(),
    customerCategories:Array.from(new Set(visible.map(x=>String(x.customerCategory||'').trim()).filter(Boolean))).sort(),
    serviceTiers:Array.from(new Set(visible.map(x=>String(x.serviceTier||'').trim()).filter(Boolean))).sort(),
    warning:all.length?'':'Prepared Catalogue is empty; ask staff to prepare the public snapshot.',
    canonicalTrending:[],mostLoved:[]};
}

