  const catalogueId=m['Catalogue ID']?String(row[m['Catalogue ID']-1]||'').trim().toUpperCase():'';
  const studioCurrent=String(m['Image Source']?row[m['Image Source']-1]||'':'').trim().toUpperCase()==='AQB STUDIO' && String(m['Photo Qualification Status']?row[m['Photo Qualification Status']-1]||'':'').trim().toUpperCase()==='QUALIFIED';
  const image=studioCurrent?onlinePhoto:(ownPhoto||onlinePhoto);
  const localAsset=!studioCurrent&&!!AQB_CATALOGUE_LOCAL_ASSETS[catalogueId];
