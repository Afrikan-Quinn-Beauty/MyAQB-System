function AQBGetMetaCatalogueConfig(){
  const p=PropertiesService.getScriptProperties();
  const catalogId=String(p.getProperty('META_CATALOG_ID')||'').trim();
  const accessToken=String(p.getProperty('META_CATALOG_ACCESS_TOKEN')||'').trim();
  const graphVersion=String(p.getProperty('META_CATALOG_GRAPH_VERSION')||'v24.0').trim();
  return {catalogId:catalogId,accessToken:accessToken,graphVersion:/^v\d+\.\d+$/.test(graphVersion)?graphVersion:'v24.0',configured:!!(catalogId&&accessToken)};
}

function AQBGetMetaPixelId(){
  return String(PropertiesService.getScriptProperties().getProperty('META_PIXEL_ID')||'1523496786128990').trim();
}

function AQBNormalizeMetaText(v){return String(v||'').trim().toLowerCase();}

function AQBNormalizeMetaPhone(phone){
  const p=AQBNormalizePhone(phone);
  return p.replace(/\D/g,'');
}

function AQBSendMetaWebsiteEvent(eventName,eventId,customData,userData){
  const token=String(PropertiesService.getScriptProperties().getProperty('META_CAPI_ACCESS_TOKEN')||'').trim();
  const pixelId=AQBGetMetaPixelId();
  if(!token||!pixelId)return {sent:false,skipped:true,reason:'META_CAPI_ACCESS_TOKEN is not configured.'};
  const version=String(PropertiesService.getScriptProperties().getProperty('META_CAPI_GRAPH_VERSION')||'v24.0').trim();
  const event={event_name:String(eventName),event_time:Math.floor(Date.now()/1000),event_id:String(eventId||Utilities.getUuid()),action_source:'website',user_data:userData||{},custom_data:customData||{}};
  const sourceUrl=String(ScriptApp.getService().getUrl()||'').trim();if(sourceUrl)event.event_source_url=sourceUrl;
  const url='https://graph.facebook.com/'+(/^v\d+\.\d+$/.test(version)?version:'v24.0')+'/'+encodeURIComponent(pixelId)+'/events';
  const res=UrlFetchApp.fetch(url,{method:'post',muteHttpExceptions:true,contentType:'application/json',headers:{Authorization:'Bearer '+token},payload:JSON.stringify({data:[event]})});
  const code=res.getResponseCode(),body=res.getContentText()||'';let data={};try{data=body?JSON.parse(body):{};}catch(e){}
  if(code<200||code>=300)throw new Error('Meta Conversions API HTTP '+code+': '+(data&&data.error&&data.error.message?data.error.message:body));
  return {sent:true,response:data};
}

function AQBSendMetaPurchaseForPayment(paymentId,appointment,amount,customerId,customerName,service){
  const identity=AQBGetCanonicalCatalogueIdentity(service,appointment&&appointment.serviceGroup||'');
  if(!identity)throw new Error('No canonical AQB Catalogue ID could be resolved for service: '+service);
  const parts=AQBSplitCustomerName(customerName||'');
  const phone=appointment&&appointment.whatsappNumber?appointment.whatsappNumber:'';
  const userData={};
  if(phone){const ph=AQBNormalizeMetaPhone(phone);if(ph)userData.ph=[AQBGenerateSha256Hex(ph)];}
  if(parts.firstName)userData.fn=[AQBGenerateSha256Hex(AQBNormalizeMetaText(parts.firstName))];
  if(parts.lastName)userData.ln=[AQBGenerateSha256Hex(AQBNormalizeMetaText(parts.lastName))];
  if(customerId)userData.external_id=[AQBGenerateSha256Hex(AQBNormalizeMetaText(customerId))];
  const custom={currency:'KES',value:Number(amount)||0,order_id:String(paymentId),content_ids:[identity.catalogueId],content_type:'product',content_name:identity.service,content_category:identity.category,contents:[{id:identity.catalogueId,quantity:1}]};
  return AQBSendMetaWebsiteEvent('Purchase',paymentId,custom,userData);
}

function AQBEnsureCatalogueMetaColumns(){
  const sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE);
  let cm=AQBBuildHeaderMap(sheet);
  ['Publication Status','Daily Brief ID','Publish Channels'].forEach(function(h){
    if(!cm[h]){sheet.getRange(1,sheet.getLastColumn()+1).setValue(h);cm=AQBBuildHeaderMap(sheet);}
  });
