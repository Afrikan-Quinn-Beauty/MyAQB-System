  const output={version:'V16.21.16.8.32',readOnly:true,writes:0,rows:result};
  Logger.log('=== AQB PUBLIC ORIGINAL PHOTO TEST3 READ ONLY ===');Logger.log(JSON.stringify(output));return output;
}

function AQBEvaluatePhotoWithOpenAI(service,imageUrl){
  AQBRequireAdmin();const url=String(imageUrl||'').trim();if(!/^https?:\/\//i.test(url))throw new Error('A valid image URL is required.');
  const meta='AQB service: '+String(service&&service.service||'')+'\nCategory: '+String(service&&service.category||'')+'\nEvaluate whether this image accurately represents the exact service, is a realistic professional beauty photograph, has suitable African/Black natural-hair representation, and is safe for public AQB catalogue use. Return JSON: {valid,score,issues,correctService,description,needsReplacement}. Do not infer nationality from appearance.';
  const input=[{role:'user',content:[{type:'input_text',text:meta},{type:'input_image',image_url:url}]}];
  const r=AQBCallOpenAI(input,{maxOutputTokens:1000});let s=r.text.trim(),a=s.indexOf('{'),b=s.lastIndexOf('}');return {success:true,provider:AQBGetOpenAIStatus(),result:JSON.parse(a>=0&&b>a?s.slice(a,b+1):s)};
}

function AQBEvaluatePhotoCandidate(service,candidate){const c=candidate||{},s=service||{},url=String(c.downloadUrl||c.imageUrl||'').trim(),hay=(String(c.tags||'')+' '+String(c.title||'')).toLowerCase(),name=String(s.service||'').toLowerCase(),category=String(s.category||'').toLowerCase();let score=0,issues=[];if(!/^https?:\/\//i.test(url))issues.push('Invalid image URL');else score+=10;(name+' '+category).split(/[^a-z0-9]+/).filter(function(x){return x.length>=4;}).forEach(function(t){if(hay.indexOf(t)>=0)score+=8;});if(/generic|landscape|food|animal|car|building/.test(hay)){issues.push('Likely unrelated image');score-=30;}if(c.isDuplicate){issues.push('Duplicate candidate');score-=50;}if(c.isAQBOwned)score+=100;return {valid:issues.length===0&&score>0,score:score,issues:issues};}

function AQBRankPhotoCandidates(service,candidates){return(candidates||[]).map(function(c){return Object.assign({},c,AQBEvaluatePhotoCandidate(service,c));}).sort(function(a,b){return b.score-a.score;});}

function AQBCreatePhotoRecommendation(service,candidate,reason,confidence){const e=AQBEvaluatePhotoCandidate(service,candidate);return AQBCreateIntelligenceRecommendation('PHOTO',AQBNormalizeServiceKey(service.category,service.service),JSON.stringify(candidate||{}),JSON.stringify({candidate:candidate,evaluation:e}),reason||'Photo candidate requires Admin review and existing publication validation.',[AQBBuildIntelligenceEvidence('AQB photo candidate',new Date(),'Catalogue photo review','candidate',String(candidate&&candidate.pageUrl||candidate&&candidate.imageUrl||''))],confidence||'Medium');}

function AQBApplyPhotoRecommendation(recommendationId){AQBRequireAdmin();const rec=AQBListIntelligenceRecommendations({status:'PENDING'}).find(function(x){return x.recommendationId===String(recommendationId||'');});if(!rec)throw new Error('Pending photo recommendation not found.');let payload;try{payload=JSON.parse(rec.currentValue||'{}');}catch(e){throw new Error('Photo recommendation payload is invalid.');}const service={category:(rec.entityKey.split('|')[0]||''),service:(rec.entityKey.split('|').slice(1).join('|')||'')},ev=AQBEvaluatePhotoCandidate(service,payload);if(!ev.valid)throw new Error('Photo candidate failed intelligence validation: '+ev.issues.join('; '));AQBSetIntelligenceRecommendationStatus(recommendationId,'REVIEWED','Candidate validated; use existing AQB photo publication workflow. No direct publication was performed.');return {success:true,validated:true,published:false};}

function AQBClassifyPhotoTarget(service, category, description){
  const s=String(service||'').trim();
  const c=String(category||'').trim();
  const d=String(description||'').trim();
  const low=(s+' '+c+' '+d).toLowerCase();
  const servicePatterns=[
    /\b(removal|take down|takedown|wash|treatment|consultation|installation|install|retighten|retightening|repair|maintenance|conditioning|detox|trim|cut|colour|color|relax|relaxer|weave installation|sew.?in installation|styling service|mobile beauty|home service|trial|package|session|appointment)\b/,
    /\b(day|event|group|corporate|office|bridal)\b.*\b(service|package|session|consultation|day)\b/
  ];
  const stylePatterns=[
    /\b(braids?|cornrows?|twists?|locs?|locks?|afro|bob|pixie|updo|ponytail|curls?|waves?|coils?|silk press|wash.?and.?go|bantu knot|knotless|fulani|boho|french curl|lemonade|feed.?in|passion|havana|marley|nubian|island twists?|box braids?|mini twists?|finger coils?)\b/,
    /\b(style|hairstyle|look|finish|design)\b/
  ];
  const serviceHit=servicePatterns.some(function(re){return re.test(low);});
  const styleHit=stylePatterns.some(function(re){return re.test(low);});
  // Explicit process/service names win when the record clearly describes an activity.
  if(serviceHit && !styleHit)return {type:'SERVICE',confidence:'HIGH',reason:'Process/activity wording identifies a service.'};
  if(styleHit && !serviceHit)return {type:'STYLE',confidence:'HIGH',reason:'Named finished hairstyle/design identifies a style.'};
  if(serviceHit && styleHit){
    // If the name itself is a process, treat it as SERVICE; otherwise the named
    // finished look is STYLE. This avoids classifying "Wash & Go" as a wash service.
    const nameLow=s.toLowerCase();
    if(/\b(removal|take down|takedown|wash|treatment|consultation|installation|install|retighten|retightening|repair|maintenance|detox|trial|package|session)\b/.test(nameLow) && !/\b(wash.?and.?go|silk press|knotless|box braids?|cornrows?|twists?|locs?|afro|bob|pixie|updo)\b/.test(nameLow)){
      return {type:'SERVICE',confidence:'HIGH',reason:'Service/process wording in the service name takes precedence.'};
    }
    return {type:'STYLE',confidence:'MEDIUM',reason:'The named offering contains a recognizable finished-style term.'};
  }
  // Conservative default: a generic operational offering is a SERVICE.
  return {type:'SERVICE',confidence:'LOW',reason:'No sufficiently specific finished-style marker was found.'};
}

function AQBGetVariantVisualTerms(value,maxCount){
  const stop={
    create:1,creates:1,creating:1,created:1,provide:1,provides:1,providing:1,client:1,clients:1,
    service:1,services:1,salon:1,professional:1,beautiful:1,beauty:1,look:1,looks:1,style:1,styles:1,
    hairstyle:1,hairstyles:1,hair:1,photo:1,image:1,show:1,shows:1,showing:1,wear:1,wearing:1,
    result:1,results:1,finish:1,finished:1,using:1,used:1,desired:1,requested:1,ideal:1,clear:1,
    black:1,african:1,woman:1,women:1,model:1,texture:1,primary:1,subject:1,technique:1
  };
  return AQBGetMeaningfulVariantTokens(value,Math.max(12,Number(maxCount||12)*2)).filter(function(t){return !stop[t];}).slice(0,Math.max(1,Number(maxCount||10)));
}

function AQBGetForbiddenPhotoMetadata(text){
  const bad=['nude','naked','topless','lingerie','underwear','bikini','swimwear','boudoir','erotic','porn','laundry','washing clothes','dishwashing','architecture','landscape','microphone','concert','musician'];
  return bad.filter(function(x){return AQBHasVariantTerm(text,x);});
}

function AQBCountIndependentPhotoHits(hits,familyTerms){
  const fam=(familyTerms||[]).map(AQBNormalizeVariantText).filter(Boolean);
  return (hits||[]).filter(function(hit){
    const h=AQBNormalizeVariantText(hit);
    if(!h)return false;
    return !fam.some(function(f){
      return f===h || f.indexOf(h)>=0 || h.indexOf(f)>=0;
    });
  });
}

function AQBHasPhotoPhrase(text,phrase){
  const h=AQBNormalizeVariantText(text), p=AQBNormalizeVariantText(phrase);
  if(!h||!p)return false;
  const rx=new RegExp('(?:^|\\s)'+AQBEscapeRegex(p).replace(/\s+/g,'\\s+')+'(?:$|\\s)');
  return rx.test(h);
}

function AQBCountExactPhotoHits(text,terms){
  const out=[];
  (terms||[]).forEach(function(t){
    if(AQBHasPhotoPhrase(text,t) && out.indexOf(t)<0)out.push(t);
  });
  return out;
}

function AQBGetPhotoSubjectEvidence(text){
  const n=AQBNormalizeVariantText(text);
  const hairTerms=[
    'hair','hairstyle','hairstyles','hairstyling','hairdo','scalp','hairline',
    'salon','stylist','braider','barber','cornrow','cornrows','dreadlock','dreadlocks',
    'locs','sisterlocks','afro','wig','weave','hair extensions','braided hair','curly hair'
  ];
  const humanTerms=[
    'woman','women','man','men','girl','girls','boy','boys','person','people',
    'portrait','model','client','customer','head','face','child','children'
  ];
  const objectTerms=[
    'rope','cord','cable','twine','yarn','string','thread','fabric','textile',
    'basket','wicker','macrame','shoelace','belt','chain','craft','material'
  ];
  const hairHits=AQBCountExactPhotoHits(n,hairTerms),
        humanHits=AQBCountExactPhotoHits(n,humanTerms),
        objectHits=AQBCountExactPhotoHits(n,objectTerms);
  return {
    valid:(hairHits.length>0||humanHits.length>0),
    hairHits:hairHits,
    humanHits:humanHits,
    objectHits:objectHits
  };
}

function AQBGetPhotoServiceIdentity(service,profile){
  const n=AQBNormalizeVariantText(service), family=String(profile&&profile.primaryFamily||'');
  const stop={
    'african':1,'woman':1,'women':1,'hair':1,'hairstyle':1,'style':1,'service':1,
    'large':1,'small':1,'medium':1,'jumbo':1,'micro':1,'mini':1,
    'long':1,'short':1,'basic':1,'classic':1,'standard':1,'trend':1,'finish':1,
    'line':1,'lines':1,'row':1,'rows':1
  };
  const familyWords={
    braid:1,braids:1,braided:1,braiding:1,
    cornrow:1,cornrows:1,
    twist:1,twists:1,twisted:1,
    loc:1,locs:1,dreadlock:1,dreadlocks:1,
    weave:1,weaving:1,wig:1,wigs:1,curl:1,curls:1,curly:1,
    afro:1,straight:1
  };
  const tokens=n.split(/\s+/).filter(function(w){
    return w && !/^\d+$/.test(w) && !stop[w] && !familyWords[w];
  });
  return {family:family,namedTokens:tokens,hasNamedIdentity:tokens.length>0};
}

function AQBGetPhotoVariantSignature(variant,profile){
  const n=AQBNormalizeVariantText(variant), terms=[];
  function add(x){if(x&&terms.indexOf(x)<0)terms.push(x);}
  if(/side swept|side cornrow|side line/.test(n)){add('side swept');add('side cornrows');}
  if(/straight back/.test(n)){add('straight back');}
  if(/knotless/.test(n))add('knotless');
  if(/\bbob\b/.test(n)){add('bob');add('short');}
  if(/curl|curly|boho|bohemian|goddess/.test(n)){add('curl');add('curly');}
  if(/two strand|2 strand/.test(n)){add('two strand twists');add('twists');}
  if(/rope twist/.test(n)){add('rope twists');add('twists');}
  if(/passion/.test(n)){add('passion twists');add('curly twists');}
  if(/senegalese/.test(n))add('senegalese twists');
  if(/marley/.test(n))add('marley twists');
  if(/havana/.test(n))add('havana twists');
  if(/stitch/.test(n)){add('stitch braids');add('stitch cornrows');}
  if(/feed in/.test(n)){add('feed in braids');add('feed in cornrows');}
  if(/bead/.test(n)){add('beads');add('beaded');}
  if(/scalp/.test(n)){add('scalp braids');add('cornrows');}
  if(profile&&profile.primaryFamily==='cornrow'&&/line/.test(n))add('cornrows');
  return terms;
}

function AQBGetPhotoVariantEvidence(text,variants,profile){
  const direct=[],signature=[];
  (variants||[]).forEach(function(v){
    if(v.generic)return;
    if(AQBHasPhotoPhrase(text,v.name))direct.push(v.name);
    const sig=AQBGetPhotoVariantSignature(v.name,profile);
    const hits=AQBCountExactPhotoHits(text,sig);
    if(hits.length)signature.push({variant:v.name,hits:hits});
  });
  return {direct:AQBGetUniqueVariantValues(direct),signature:signature};
}

function AQBGetDistinctivePhotoAliases(profile){
  const generic={
    'african braids':1,'braided hairstyle':1,'box braids':1,'protective braids':1,
    'two strand twists':0,'rope twists':0,'african twists':1,'protective twists':1,
    'cornrows':1,'african cornrows':1,'scalp braids':1,'straight back braids':0,
    'locs hairstyle':1,'dreadlocks hairstyle':1,'african locs':1,
    'curly hairstyle':1,'defined curls':1,'ringlet curls':0
  };
  return (profile&&profile.aliases||[]).filter(function(a){
    const n=AQBNormalizeVariantText(a);
    return generic[n]!==1;
  });
}

function AQBGetPhotoQueryCorroboration(candidate){
  const kinds={},queries={};
  ((candidate&&candidate.querySpecs)||[]).forEach(function(s){
    const q=AQBNormalizeVariantText(s&&s.q||''),k=String(s&&s.kind||'');
    if(q)queries[q]=1;
    if(k)kinds[k]=(kinds[k]||0)+1;
  });
  const specificKinds=['FOUR_FIELD_FOCUSED','CUSTOMER_VARIANT','DISTINCTIVE_ALIAS','SERVICE_NAME','PHOTO_BRIEF'];
  let specific=0;
  specificKinds.forEach(function(k){if(kinds[k])specific+=kinds[k];});
  return {uniqueQueries:Object.keys(queries).length,kinds:kinds,specificSupport:specific};
}

function AQBGetSoftPhotoVariants(service){
  const n=AQBNormalizeVariantText(service),out=[];
  [
    ['large',['large','thick','chunky']],
    ['small',['small','fine','thin']],
    ['medium',['medium','shoulder length']],
    ['jumbo',['jumbo','extra large']],
    ['micro',['micro','tiny']],
    ['long',['long','waist length']],
    ['short',['short','chin length']]
  ].forEach(function(d){
    if(AQBHasVariantTerm(n,d[0]))out.push({key:d[0],terms:d[1]});
  });
  const m=n.match(/\b(\d+)\s*(lines?|rows?)\b/);
  if(m){
    const num=String(m[1]),words={'4':'four','5':'five','6':'six','7':'seven','8':'eight','9':'nine','10':'ten','12':'twelve'};
    out.push({
      key:num+' '+m[2],
      terms:[num+' line',num+' lines',num+' row',num+' rows']
        .concat(words[num]?[words[num]+' lines',words[num]+' rows']:[])
    });
  }
  return out;
}

function AQBGetHardPhotoEvidence(hard,text,variants,profile){
  const direct=AQBCountVariantHits(text,hard.terms||[]);
  if(direct.length)return {key:hard.key,mode:'DIRECT',hits:direct,variant:''};

  // A customer phrase can prove a hard feature only when its trusted visual signature maps to that feature.
  for(let i=0;i<(variants||[]).length;i++){
    const v=variants[i];
    if(v.generic)continue;
    const sig=AQBGetPhotoVariantSignature(v.name,profile),sigHits=AQBCountExactPhotoHits(text,sig);
    if(!sigHits.length)continue;
    const hk=AQBNormalizeVariantText(hard.key);
    const joined=AQBNormalizeVariantText([v.name].concat(sig).join(' '));
    if(
      (hk==='side swept'&&/side swept|side cornrow|side line/.test(joined)) ||
      (hk==='curl'&&/curl|curly|boho|bohemian|goddess/.test(joined)) ||
      (hk==='knotless'&&/knotless/.test(joined)) ||
      (hk==='bob'&&/\bbob\b|chin length|short/.test(joined)) ||
      (hk==='feed in'&&/feed in/.test(joined)) ||
      (hk==='beaded'&&/bead/.test(joined)) ||
      (hk==='micro'&&/\bmicro\b|tiny/.test(joined))
    ){
      return {key:hard.key,mode:'CUSTOMER_VARIANT',hits:sigHits,variant:v.name};
    }
  }
  return {key:hard.key,mode:'MISSING',hits:[],variant:''};
}

function AQBQualifyPhotoMetadataCandidate(service,category,description,photoBrief,target,candidate,variants){
  photoBrief=AQBGetCataloguePositivePhotoBrief(photoBrief);
  const profile=AQBBuildVariantProfile(service,category,description,photoBrief,target),
        text=AQBNormalizeVariantText([
          candidate&&candidate.match||'',
          candidate&&candidate.sourceUrl||''
        ].join(' ')),
        bad=AQBGetForbiddenPhotoMetadata(text),
        subject=AQBGetPhotoSubjectEvidence(text),
        identity=AQBGetPhotoServiceIdentity(service,profile);
  let summary={subjectEvidence:subject,identity:identity};

  if(!text)return {level:'REJECT',valid:false,score:0,reason:'Pexels candidate has no usable metadata.',summary:summary};
  if(bad.length)return {level:'REJECT',valid:false,score:0,reason:'Candidate contains unrelated/unsafe metadata: '+bad.join(', ')+'.',summary:{forbidden:bad,subjectEvidence:subject}};

  if(subject.objectHits.length && !subject.hairHits.length){
    return {level:'REJECT',valid:false,score:0,reason:'Object-only metadata detected ('+subject.objectHits.join(', ')+'); no explicit hair context.',summary:summary};
  }
  if(!subject.valid){
    return {level:'REJECT',valid:false,score:0,reason:'Candidate lacks human/hair subject evidence in Pexels metadata.',summary:summary};
  }

  const familyTerms=profile.familyDef&&profile.familyDef.terms||[],
        familyHits=AQBCountVariantHits(text,familyTerms),
        bridalS2FamilyEvidence=(profile.primaryFamily==='bridal'&&familyHits.length)?{
          dictionary:'BRIDAL_S2_DICTIONARY',
          matchedTerms:familyHits.slice(0,8)
        }:null,
        contr=AQBGetVariantContradictions(profile,text),
        hardEvidence=(profile.hardModifiers||[]).map(function(h){return AQBGetHardPhotoEvidence(h,text,variants,profile);}),
        hardDirect=hardEvidence.filter(function(x){return x.mode!=='MISSING';}),
        hardMissing=hardEvidence.filter(function(x){return x.mode==='MISSING';}),
        briefHits=AQBCountVariantHits(text,profile.briefTerms||[]),
        descHits=AQBCountVariantHits(text,profile.descTerms||[]),
        independentBrief=AQBCountIndependentPhotoHits(briefHits,familyTerms),
        independentDesc=AQBCountIndependentPhotoHits(descHits,familyTerms),
        exactService=AQBHasPhotoPhrase(text,service),
        customerEvidence=AQBGetPhotoVariantEvidence(text,variants,profile),
        distinctiveAliases=AQBGetDistinctivePhotoAliases(profile),
        distinctiveAliasHits=AQBCountVariantHits(text,distinctiveAliases),
        soft=AQBGetSoftPhotoVariants(service),
        softDirect=[],softMissing=[],
        corroboration=AQBGetPhotoQueryCorroboration(candidate);

  soft.forEach(function(v){
    const hits=AQBCountVariantHits(text,v.terms||[]);
    (hits.length?softDirect:softMissing).push({key:v.key,hits:hits});
  });

  summary={
    subjectEvidence:subject,
    identity:identity,
    primaryFamily:profile.primaryFamily,
    familyHits:familyHits,
    familyEvidenceSource:bridalS2FamilyEvidence?bridalS2FamilyEvidence.dictionary:'',
    familyEvidenceMatches:bridalS2FamilyEvidence?bridalS2FamilyEvidence.matchedTerms:[],
    hardEvidence:hardEvidence,
    hardMissing:hardMissing.map(function(x){return x.key;}),
    exactService:exactService,
    customerVariantDirect:customerEvidence.direct,
    customerVariantSignature:customerEvidence.signature,
    distinctiveAliasHits:distinctiveAliasHits,
    softVariantDirect:softDirect,
    softVariantMissing:softMissing.map(function(x){return x.key;}),
    independentBriefHits:independentBrief,
    independentDescHits:independentDesc,
    contradictions:contr,
    queryCorroboration:corroboration
  };

  if(contr.length)return {level:'REJECT',valid:false,score:0,reason:'Candidate contradicts requested visual target: '+contr.join('; ')+'.',summary:summary};

  let score=0;
  if(exactService)score+=45;
  score+=Math.min(30,familyHits.length*15);
  score+=hardDirect.length*16;
  score+=Math.min(18,customerEvidence.direct.length*12 + customerEvidence.signature.length*6);
  score+=Math.min(12,distinctiveAliasHits.length*6);
  score+=Math.min(8,softDirect.length*4);
  score+=Math.min(8,independentBrief.length*2);
  score+=Math.min(7,independentDesc.length*2);
  score+=Math.min(8,corroboration.specificSupport*2);

  if(target&&target.type==='SERVICE'){
    const act=AQBBuildVariantActivityProfile([service,category,description,photoBrief].join(' '),service),
          ap=act&&act.primary,
          activityHits=ap?AQBCountVariantHits(text,ap.terms||[]):[];
    summary.activity=ap?ap.key:'';
    summary.activityHits=activityHits;
    if(ap&&activityHits.length){
      score+=30;
      return {level:'AUTO_QUALIFIED',valid:true,score:Math.min(100,score),reason:'SERVICE activity/process is directly supported by Pexels metadata.',summary:summary};
    }
    if(familyHits.length||customerEvidence.direct.length||independentBrief.length||independentDesc.length){
      return {level:'PEXELS_REVIEW',valid:false,score:Math.min(79,Math.max(45,score)),reason:'Plausible service photo, but the booked activity/process is not directly proven by Pexels metadata.',summary:summary};
    }
    return {level:'REJECT',valid:false,score:0,reason:'Service activity/process is not evidenced in Pexels metadata.',summary:summary};
  }

  // Core style family never relaxes.
  if(profile.primaryFamily&&!familyHits.length){
    return {level:'REJECT',valid:false,score:0,reason:'Hard family gate failed: no '+profile.primaryFamily+' evidence in Pexels metadata.',summary:summary};
  }

  // it is identity, not merely ranking. Query wording may discover a candidate, but it does
  // not prove the visible feature. Missing metadata evidence therefore requires review.
  const identityStructural=soft.filter(function(v){
    return /^(?:large|small|medium|jumbo|micro|mini)$/.test(String(v.key||'')) || /^\d+\s+(?:line|lines|row|rows)$/.test(String(v.key||''));
  }), structuralMissing=identityStructural.filter(function(v){
    return !AQBCountVariantHits(text,v.terms||[]).length;
  });
  summary.identityStructuralRequired=identityStructural.map(function(v){return v.key;});
  summary.identityStructuralMissing=structuralMissing.map(function(v){return v.key;});
  if(identityStructural.length&&structuralMissing.length){
    return {level:'PEXELS_REVIEW',valid:false,score:Math.min(79,Math.max(50,score)),reason:'Correct hairstyle family found, but exact service identity feature(s) '+structuralMissing.map(function(v){return v.key;}).join(', ')+' are not proven by Pexels metadata.',summary:summary};
  }

  // Defining visual modifiers remain mandatory, but trusted customer-language synonyms may satisfy them.
  if((profile.hardModifiers||[]).length>0){
    if(hardMissing.length===0){
      return {level:'AUTO_QUALIFIED',valid:true,score:Math.min(100,Math.max(80,score)),reason:'Core hairstyle family and all defining visual features are directly supported by metadata or trusted customer-language synonyms.',summary:summary};
    }
    return {level:'PEXELS_REVIEW',valid:false,score:Math.min(79,Math.max(50,score)),reason:'Correct hairstyle family found, but defining feature(s) '+hardMissing.map(function(x){return x.key;}).join(', ')+' remain unproven.',summary:summary};
  }

  // Named commercial styles need identity evidence beyond a generic family.
  if(identity.hasNamedIdentity){
    if(exactService||customerEvidence.direct.length||customerEvidence.signature.length||distinctiveAliasHits.length){
      return {level:'AUTO_QUALIFIED',valid:true,score:Math.min(100,Math.max(74,score)),reason:'Core hairstyle family plus canonical/customer-variant identity evidence is present; any explicit size/count identity requirement has also passed.',summary:summary};
    }
    if(familyHits.length){
      return {level:'PEXELS_REVIEW',valid:false,score:Math.min(89,Math.max(50,score)),reason:'Core hairstyle family is correct, but the named commercial style is not directly evidenced by metadata/customer variants; 80%+ may be retained as a near-match candidate for visual review.',summary:summary};
    }
  }

  // Generic family services can auto-pass on correct human/hair family when no explicit size/count identity requirement remains missing.
  if(familyHits.length){
    return {level:'AUTO_QUALIFIED',valid:true,score:Math.min(100,Math.max(70,score)),reason:'Core human/hair subject and hairstyle family match; any explicit size/count identity requirement has also passed.',summary:summary};
  }

  return {level:'REJECT',valid:false,score:0,reason:'Candidate does not provide enough direct evidence for the requested style.',summary:summary};
}

function AQBGetCatalogueVariantVisualSignature(service,category,description,photoBrief,row,cm){
  const defs=AQBGetCatalogueVariantFeatureDefinitions(),existing=AQBGetCatalogueExistingVariantLanguage(row,cm,service),
        primary=[service].concat(existing).join(' | '),
        evidence=[service,description,AQBGetCataloguePositivePhotoBrief(photoBrief)].concat(existing).join(' | '),
        recordType=AQBGetCatalogueVariantRecordType(service,category,description),
        family=AQBGetCatalogueVariantFamilyFromService(service,category),
        signature={
