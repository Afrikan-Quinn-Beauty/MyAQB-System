  if(!/^https?:\/\//i.test(image))return false;
  const status=String(m['Image Status']?row[m['Image Status']-1]||'':'').trim().toUpperCase();
  const pub=m['Publication Status']?String(row[m['Publication Status']-1]||'').trim().toUpperCase():'';
  const blocked={
