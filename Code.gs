function AQBReadAllMetaCatalogueProducts(){
  AQBRequireAdmin();
  const result=[],seen={},cursors={};
  let after='';
  for(let page=0;page<100;page++){
    const path='/products?fields=id,retailer_id,name,availability,image_url,price&limit=500'+(after?'&after='+encodeURIComponent(after):'');
    const data=AQBSendMetaCatalogueRequest('get',path);
    if(!Array.isArray(data.data))throw new Error('Meta returned an invalid product list on page '+(page+1));
    data.data.forEach(function(item){
      const objectId=String(item.id||'').trim();
      if(!objectId)throw new Error('Meta product without remote object ID; stopping.');
      if(seen[objectId])throw new Error('Duplicate remote object ID in Meta pagination: '+objectId);
      seen[objectId]=true;result.push(item);
    });
    if(!(data.paging&&data.paging.next))return result;
    const cursor=String(data.paging.cursors&&data.paging.cursors.after||'').trim();
    if(!cursor||cursor===after||cursors[cursor])throw new Error('Invalid Meta paging cursor; stopping.');
    cursors[cursor]=true;after=cursor;
  }
  throw new Error('Meta pagination exceeded 100 pages; stopping.');
}

function AQBAuditMetaLegacyRemoval(){
  AQBRequireAdmin();
  const items=AQBReadAllMetaCatalogueProducts();
  const ids={},legacy=[],canonical=[];
  items.forEach(function(x){
    const id=String(x.retailer_id||'').trim().toUpperCase();
    if(!id)throw new Error('Meta product missing retailer_id: '+x.id);
    if(ids[id])throw new Error('Duplicate retailer_id in Meta: '+id);
    ids[id]=true;
    (/^AQBCAT\d{3}$/.test(id)?canonical:legacy).push({retailer_id:id,remoteId:String(x.id)});
  });
  const report={version:'V16.22.1.0',readOnly:true,metaCount:items.length,canonicalCount:canonical.length,legacyCount:legacy.length,legacy:legacy};
  Logger.log('=== AQB META LEGACY REMOVAL PREFLIGHT ===');Logger.log(JSON.stringify(report));
  return report;
}

function AQBRemoveMetaLegacyProducts(){
  throw new Error('Deletion paused after 142 requests remained unverified. Run AQBPreviewMetaLegacyDeleteBatches and inspect Meta API response semantics before any further write.');
  const admin=AQBRequireAdmin();
  const pre=AQBAuditMetaLegacyRemoval();
  // Require a complete, stable inventory. Never delete a canonical-format retailer ID.
  if(pre.canonicalCount!==263||pre.metaCount!==405||pre.legacyCount!==142)
    throw new Error('Inventory changed from approved 405/263/142 baseline; deletion stopped. Review fresh audit first.');
  const entries=pre.legacy;
  let submitted=0;const failures=[];
  for(let start=0;start<entries.length;start+=25){
    const batch=entries.slice(start,start+25);
    const requests=batch.map(function(x){return {method:'DELETE',retailer_id:x.retailer_id,data:{id:x.remoteId}};});
    try{
      const response=AQBSendMetaCatalogueRequest('post','/items_batch',{allow_upsert:false,item_type:'PRODUCT_ITEM',requests:requests});
      // Meta batch acceptance is not proof of individual deletion; verify by re-fetching.
      if(response&&response.error)throw new Error(JSON.stringify(response.error));
      submitted+=batch.length;
    }catch(e){failures.push({batchStart:start,ids:batch.map(function(x){return x.retailer_id;}),error:String(e.message||e)});}
  }
  const after=AQBAuditMetaLegacyRemoval();
  const report={version:'V16.22.1.0',submitted:submitted,failedBatches:failures,remainingLegacy:after.legacyCount,remainingMeta:after.metaCount,
    verified:after.legacyCount===0&&after.metaCount===263&&after.canonicalCount===263};
  Logger.log('=== AQB META LEGACY REMOVAL VERIFICATION ===');Logger.log(JSON.stringify(report));
  try{AQBLogAudit('META_LEGACY_CLEANUP','Catalogue','META','Admin '+admin.email+' submitted '+submitted+' legacy deletions; remaining '+after.legacyCount+'; verified '+report.verified);}catch(ignore){}
  return report;
}

/**
 * AQB V16.22.1.3 | Read-only Meta deletion diagnostics.
 * Inspects one legacy item and checks whether the catalogue count is unchanged.
 * Never sends DELETE or batch write requests.
 */
function AQBDiagnoseMetaLegacyDeletion(){
  AQBRequireAdmin();
  const items=AQBReadAllMetaCatalogueProducts();
  const canonical=items.filter(function(x){return /^AQBCAT\d{3}$/i.test(String(x.retailer_id||''));});
  const legacy=items.filter(function(x){return !/^AQBCAT\d{3}$/i.test(String(x.retailer_id||''));});
  const sample=legacy[0]||null;
  let remoteCheck=null;
  if(sample){
    try{
      const x=AQBSendMetaCatalogueRequest('get','/products?fields=id,retailer_id&limit=1');
      remoteCheck={firstPageReturned:Array.isArray(x.data)?x.data.length:null,hasPaging:!!x.paging};
    }catch(e){remoteCheck={error:String(e.message||e)};}
  }
  const result={version:'V16.22.1.3',readOnly:true,metaCount:items.length,
    canonicalCount:canonical.length,legacyCount:legacy.length,
    sampleLegacy:sample?{retailer_id:String(sample.retailer_id),remoteId:String(sample.id)}:null,
    remoteCheck:remoteCheck,
    observation:'Batch submitted count is not deletion confirmation; previous run remained at 405/142. Inspect individual batch responses before retrying.'};
  Logger.log('=== AQB META DELETION DIAGNOSTIC ===');
  Logger.log(JSON.stringify(result));
  return result;
}

