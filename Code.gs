// V16.22.1.1 — Retie Automation
// Extracted top-level functions; globally callable in Apps Script.

function AQBIsSisterlocksRetieService(service){ return /sisterlocks\s+retightening/i.test(String(service||'').trim()); }

function AQBGetAutomaticRetieService(customerService){
  const s=String(customerService||'').trim();
  if(AQBIsSisterlocksRetieService(s)) return s;
  try{
    const services=AQBGetMasterListOptions('Service');
    const exact=services.find(x=>AQBIsSisterlocksRetieService(x.service));
    return exact?exact.service:'Sisterlocks Retightening – Short/Medium';
  }catch(e){
    return 'Sisterlocks Retightening – Short/Medium';
  }
}

function AQBIsSisterlocksService(service,category){
  const s=String(service||'').trim(), c=String(category||'').trim();
  if(!s || /consultation/i.test(s)) return false;
  return /^sisterlocks\b/i.test(s) || /^sisterlocks\b/i.test(c) || /^sisterlocks services$/i.test(c);
}

function AQBIsCustomerRetieOverdue(lastRetieDate){
  if(!lastRetieDate)return false;
  const d=AQBParseRetieDate(lastRetieDate);if(!d)return false;d.setHours(0,0,0,0);
  const today=new Date();today.setHours(0,0,0,0);
  return Math.floor((today.getTime()-d.getTime())/86400000)>CONFIG.RETIE_DAYS;
}

function AQBRefreshAllCustomerRetieDates(){
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow(); if(n<2)return {updated:0};
  const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues(); let updated=0;
  rows.forEach(function(r,i){
    const service=String(r[m['Service']-1]||'').trim(),last=r[m['Last Retie Date']-1];
    if(!AQBIsSisterlocksService(service) || AQBIsConsultationService(service) || !(last instanceof Date))return;
    const c=AQBCalculateRetieDates(last), next=AQBParseDateFromClient(c.nextRetieDate), reminder=AQBParseDateFromClient(c.reminderDate);
    const oldNext=r[m['Next Retie Date']-1] instanceof Date?AQBFormatDateForClient(r[m['Next Retie Date']-1]):'';
    const oldReminder=r[m['Reminder Date']-1] instanceof Date?AQBFormatDateForClient(r[m['Reminder Date']-1]):'';
    if(oldNext!==c.nextRetieDate || oldReminder!==c.reminderDate){r[m['Next Retie Date']-1]=next;r[m['Reminder Date']-1]=reminder;s.getRange(i+2,1,1,s.getLastColumn()).setValues([r]);updated++;}
  });
  return {updated};
}

function AQBCalculateRetieDates(lastRetieDate){
  if(!lastRetieDate)return {nextRetieDate:'',reminderDate:''};
  const d=AQBParseDateFromClient(lastRetieDate),next=new Date(d); next.setHours(0,0,0,0); next.setDate(next.getDate()+CONFIG.RETIE_DAYS);
  const businessNext=AQBNormalizeBusinessDate(next);
  const rem=new Date(businessNext); rem.setDate(rem.getDate()-CONFIG.REMINDER_DAYS);
  return {nextRetieDate:AQBFormatDateForClient(businessNext),reminderDate:AQBFormatDateForClient(rem)};
}

function AQBBuildStaffRetieCallKey(customerId,dueDate){return 'AQB_RETIE_CALL_DONE:'+String(customerId||'').trim()+':'+String(dueDate||'').trim();}

function AQBGetRetieFollowUps(){
  AQBRequireUser();
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow();if(n<2)return [];
  const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  const as=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS), an=as.getLastRow();
  const futureRetieByCustomer={};
  if(an>=2){
    const arows=as.getRange(2,1,an-1,17).getValues(), now=new Date();
    arows.forEach(function(a){
      const customerId=String(a[1]||'').trim(), service=String(a[4]||'').trim(), status=String(a[8]||'').trim().toUpperCase();
      if(!customerId||!AQBIsSisterlocksService(service)||['CANCELLED','NO SHOW','COMPLETED'].includes(status))return;
      let d=a[5] instanceof Date?new Date(a[5]):new Date(a[5]); if(isNaN(d.getTime()))return;
      let t=a[6] instanceof Date?new Date(a[6]):new Date(a[6]); if(!isNaN(t.getTime()))d.setHours(t.getHours(),t.getMinutes(),0,0);
      if(d<now)return;
      if(!futureRetieByCustomer[customerId]||d<futureRetieByCustomer[customerId].when){
        futureRetieByCustomer[customerId]={when:d,appointmentId:String(a[0]||''),service:service,status:status};
      }
    });
  }
  const today=new Date();today.setHours(0,0,0,0);const out=[];
  rows.forEach(function(r){
    const service=String(r[m['Service']-1]||'').trim();
    if(!AQBIsSisterlocksService(service)||AQBIsConsultationService(service))return;
    const next=AQBParseRetieDate(r[m['Next Retie Date']-1]);if(!next)return;next.setHours(0,0,0,0);
    const days=Math.floor((next.getTime()-today.getTime())/86400000);
    // Staff follow-up starts 3 days before due and remains visible while overdue.
    if(days>3)return;
    const customerId=String(r[m['Customer ID']-1]||'').trim(),dueDate=AQBFormatDateForClient(next);
    // A future Sisterlocks appointment already resolves the follow-up need.
    // Do not ask staff to call a client who is already booked.
    if(futureRetieByCustomer[customerId])return;
    const props=PropertiesService.getScriptProperties();
    out.push({customerId,firstName:AQBGetCustomerFirstName(r,m),phone:String(r[m['WhatsApp Number']-1]||''),dueDate,days,callDone:props.getProperty(AQBBuildStaffRetieCallKey(customerId,dueDate))==='Yes'});
  });
  out.sort((a,b)=>a.days-b.days||a.firstName.localeCompare(b.firstName,undefined,{sensitivity:'base'}));
  return out.slice(0,20);
}

function AQBMarkStaffRetieCallDone(customerId,dueDate){
  AQBRequireUser();customerId=String(customerId||'').trim();dueDate=String(dueDate||'').trim();
  if(!customerId||!dueDate)throw new Error('Customer and retie due date are required.');
  PropertiesService.getScriptProperties().setProperty(AQBBuildStaffRetieCallKey(customerId,dueDate),'Yes');
  AQBLogAudit('RETIE_CALL_COMPLETED','Customer',customerId,'Staff retie follow-up call marked done for due date '+dueDate+'.');
  return {success:true,customerId,dueDate,callDone:true};
}

function AQBParseRetieDate(v){if(v===0||v==='0'||v===null||v===undefined||v==='')return null;const d=v instanceof Date?new Date(v):new Date(v);return isNaN(d.getTime())||d.getFullYear()<2000?null:d;}

function AQBEnsureAutomaticRetieTrigger(){
  const triggers=ScriptApp.getProjectTriggers();
  const legacy=triggers.filter(t=>t.getHandlerFunction()==='createMissingAutomaticRetieAppointments_');legacy.forEach(t=>ScriptApp.deleteTrigger(t));
  if(triggers.some(t=>t.getHandlerFunction()==='AQBRunAutomaticRetieAppointments'))return;
  ScriptApp.newTrigger('AQBRunAutomaticRetieAppointments').timeBased().everyHours(1).create();
}

function AQBInstallAutomaticRetieTrigger(){
  AQBRequireAdmin();
  ScriptApp.getProjectTriggers().filter(t=>['createMissingAutomaticRetieAppointments_','AQBRunAutomaticRetieAppointments'].indexOf(t.getHandlerFunction())>=0).forEach(t=>ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('AQBRunAutomaticRetieAppointments').timeBased().everyHours(1).create();
  return {success:true,handler:'AQBRunAutomaticRetieAppointments',message:'Automatic retie booking trigger installed (runs hourly).'};
}

function AQBRepairAutomaticRetieData(){
  AQBRequireAdmin();
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();
    if(n<2)return {amountsUpdated:0,whatsappSent:0,whatsappFailed:0};
    const rows=s.getRange(2,1,n-1,17).getValues();
    const customerSheet=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),cm=AQBBuildHeaderMap(customerSheet),cn=customerSheet.getLastRow();
    const customers=cn>=2?customerSheet.getRange(2,1,cn-1,customerSheet.getLastColumn()).getValues():[];
    const byId={};customers.forEach(r=>{byId[String(r[cm['Customer ID']-1]||'')]=r;});
    let amountsUpdated=0,whatsappSent=0,whatsappFailed=0;
    rows.forEach(function(r,i){
      if(String(r[12]||'').trim()!=='Automatic Retie')return;
      const pricing=AQBFindServicePricing(String(r[4]||'').trim());
      const amount=AQBGetPublicStartingPriceNumber(pricing.price);
      if(amount>0 && (!Number(r[14]||0)||!Number(r[16]||0)||!String(r[15]||'').trim())){
        r[14]=amount;r[15]=pricing.price||('KSh '+amount.toLocaleString('en-KE'));r[16]=amount;s.getRange(i+2,1,1,17).setValues([r]);amountsUpdated++;
      }
      // Automatic future reties do not send a normal booking-confirmation message.
      // Delivery/retry infrastructure is kept separate for the dedicated status system.
    });
    return {amountsUpdated,whatsappSent,whatsappFailed};
  }finally{lock.releaseLock();}
}

function AQBSendSisterlocksCompletionWhatsApp(customer,nextAppointment){
  const t=CONFIG.WHATSAPP_TEMPLATES.SISTERLOCKS_COMPLETE;
  const date=nextAppointment&&nextAppointment.appointmentDate?nextAppointment.appointmentDate:AQBFormatDateForClient(customer.nextRetieDate);
  const result=AQBSendWhatsAppTemplate(customer.phone,t,'en_US',AQBBuildWhatsAppBodyVariables([customer.firstName,date]));
  if(result.sent)AQBLogAudit('WHATSAPP_COMPLETION_SENT','Customer',customer.customerId,'Sisterlocks completion thank-you sent with next retie date '+date+'.');
  return result;
}

function AQBSendRetieKnownHistoryOverdue(sheet,rowNum,row,m,context){
  const customerId=String(row[m['Customer ID']-1]||'').trim(),
        service=String(row[m['Service']-1]||'').trim(),
        last=AQBParseRetieDate(row[m['Last Retie Date']-1]);
  let next=AQBParseRetieDate(row[m['Next Retie Date']-1]),reminder=null,historySource='stored Next Retie Date';
  if(!customerId||!AQBIsSisterlocksRetieService(service)){
    return {sent:false,eligible:false,reason:'KNOWN_RETIE_HISTORY_NOT_AVAILABLE'};
  }
  if(!next && last){
    const calc=AQBCalculateRetieDates(last);
    next=AQBParseDateFromClient(calc.nextRetieDate);
    reminder=AQBParseDateFromClient(calc.reminderDate);
    row[m['Next Retie Date']-1]=next;
    row[m['Reminder Date']-1]=reminder;
    historySource='calculated from Last Retie Date';
  }else if(next){
    next.setHours(0,0,0,0);
    reminder=new Date(next);reminder.setDate(reminder.getDate()-CONFIG.RETIE_REMINDER_DAYS);
    row[m['Reminder Date']-1]=reminder;
  }else{
    return {sent:false,eligible:false,reason:'KNOWN_RETIE_HISTORY_NOT_AVAILABLE'};
  }

  const today=new Date();today.setHours(0,0,0,0);
  next.setHours(0,0,0,0);
  const daysSinceLastRetie=last?Math.floor((today.getTime()-new Date(last).setHours(0,0,0,0))/86400000):null;
  const daysOverdue=daysSinceLastRetie!==null?daysSinceLastRetie:Math.floor((today.getTime()-next.getTime())/86400000);
  if(daysOverdue<=CONFIG.RETIE_DAYS){
    return {sent:false,eligible:false,reason:'WITHIN_42_DAY_RETIE_CYCLE',nextRetieDate:AQBFormatDateForClient(next),daysOverdue:Math.max(0,daysOverdue),daysSinceLastRetie:daysSinceLastRetie};
  }

  // Keep the existing AQB ladder intact: +7, +21, +42.
  const stage=AQBGetRetieOverdueStage(daysOverdue);
  if(!stage){
    return {sent:false,eligible:false,reason:'OVERDUE_BELOW_FIRST_7_DAY_STAGE',nextRetieDate:AQBFormatDateForClient(next),daysOverdue:daysOverdue};
  }

  // If a current/future retie appointment is already in place, the booking is
  // more authoritative than sending an overdue prompt.
  const appt=AQBFindRetieAppointmentAuthority(customerId);
  if(appt){
    const d=new Date(appt.date);d.setHours(0,0,0,0);
    if(d>=today){
      return {sent:false,eligible:false,reason:'ACTIVE_RETIE_APPOINTMENT_EXISTS',appointmentId:appt.appointmentId,appointmentDate:appt.appointmentDate,daysOverdue:daysOverdue};
    }
  }

  const markerKey=AQBGetRetieReminderMarker(stage,AQBFormatDateKey(next)),
        marker=String(row[m['Reminder Sent']-1]||'').trim();
  if(marker===markerKey)return {sent:false,eligible:true,duplicateBlocked:true,reason:'OVERDUE_STAGE_ALREADY_SENT',stage:stage,daysOverdue:daysOverdue};

  const quiet=AQBGetWhatsAppQuietTimeStatus(new Date());
  if(quiet.quiet){
    try{AQBLogRetieReminderDecision('DEFERRED',customerId,stage+' onboarding overdue message deferred by quiet time '+quiet.start+'-'+quiet.end+' '+quiet.timezone+'. Context='+String(context||''));}catch(ignore){}
    return {sent:false,eligible:true,deferred:true,reason:'QUIET_TIME',stage:stage,daysOverdue:daysOverdue,quietTime:quiet};
  }

  const contact=AQBResolveWhatsAppNumber(row[m['WhatsApp Number']-1]);
  if(!contact.valid){
    try{AQBLogRetieReminderDecision('SKIPPED',customerId,stage+' onboarding overdue message skipped: invalid/missing WhatsApp number.');}catch(ignore){}
    return {sent:false,eligible:true,reason:'INVALID_WHATSAPP',stage:stage,daysOverdue:daysOverdue};
  }

  const first=AQBGetCustomerFirstName(row,m),template=AQBGetRetieOverdueTemplate(stage);
  try{
    const result=AQBSendWhatsAppTemplate(contact.normalized,template,'en_US',AQBBuildWhatsAppBodyVariables([first,AQBFormatDateForClient(next)]));
    if(result&&result.sent){
      row[m['Reminder Sent']-1]=markerKey;
      sheet.getRange(rowNum,1,1,sheet.getLastColumn()).setValues([row]);
      AQBLogRetieReminderDecision('SENT',customerId,stage+' overdue message sent from '+historySource+'. Last Retie '+(last?AQBFormatDateForClient(last):'not recorded')+', Next Retie '+AQBFormatDateForClient(next)+', '+daysOverdue+' days overdue. Context='+String(context||''));
      return {sent:true,eligible:true,stage:stage,daysOverdue:daysOverdue,nextRetieDate:AQBFormatDateForClient(next),template:template};
    }
    return {sent:false,eligible:true,reason:String(result&&result.reason||'SEND_RETURNED_FALSE'),stage:stage,daysOverdue:daysOverdue};
  }catch(e){
    AQBLogRetieReminderDecision('FAILED',customerId,stage+' onboarding overdue message failed: '+String(e&&e.message||e));
    return {sent:false,eligible:true,reason:'SEND_FAILED',error:String(e&&e.message||e),stage:stage,daysOverdue:daysOverdue};
  }
}

function AQBGetRetieOverdueStage(daysOverdue){
  const days=Number(daysOverdue);
  if(!isFinite(days)||days<CONFIG.RETIE_OVERDUE_REMINDER_1_DAYS)return '';
  if(days>=CONFIG.RETIE_OVERDUE_REMINDER_3_DAYS)return 'OVERDUE_42D';
  if(days>=CONFIG.RETIE_OVERDUE_REMINDER_2_DAYS)return 'OVERDUE_21D';
  return 'OVERDUE_7D';
}

function AQBGetRetieReminderMarker(stage,dateValue){return String(stage||'')+':'+String(dateValue||'');}

function AQBGetRetieOverdueTemplate(stage){
  if(stage==='OVERDUE_7D')return CONFIG.WHATSAPP_TEMPLATES.RETIE_OVERDUE;
  if(stage==='OVERDUE_21D')return CONFIG.WHATSAPP_TEMPLATES.RETIE_OVERDUE_FOLLOWUP;
  if(stage==='OVERDUE_42D')return CONFIG.WHATSAPP_TEMPLATES.RETIE_LONG_OVERDUE;
  return '';
}

function AQBLogRetieReminderDecision(decision,customerId,description){try{AQBLogAudit('AQB_RETIE_REMINDER_'+decision,'Customer',String(customerId||''),String(description||''));}catch(ignore){}}

function AQBProcessRetieReminders(){
  const VERSION='V16.22.1.13';
  AQBEnsureWhatsAppQuietTimeConfig();
  const quiet=AQBGetWhatsAppQuietTimeStatus(new Date());
  if(quiet.quiet){
    const deferred={version:VERSION,function:'AQBProcessRetieReminders',quietTimeBlocked:true,quietTime:quiet,approaching:0,overdue7:0,overdue21:0,overdue42:0,sent:0,skipped:0,failed:0};
    try{AQBLogAudit('AQB_RETIE_REMINDER_QUIET_TIME','System','RETIE_REMINDERS',JSON.stringify(deferred));}catch(ignore){}
    Logger.log('=== AQB RETIE REMINDERS DEFERRED — QUIET TIME ===');Logger.log(JSON.stringify(deferred));return deferred;
  }
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),n=s.getLastRow();
  if(n<2){const empty={version:VERSION,function:'AQBProcessRetieReminders',approaching:0,overdue7:0,overdue21:0,overdue42:0,sent:0,skipped:0,failed:0,appointmentAuthoritative:0,dateRowsSynchronized:0};try{AQBLogAudit('AQB_RETIE_REMINDER_RUN','System','RETIE_REMINDERS',JSON.stringify(empty));}catch(ignore){}return empty;}
  const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues();
  let approaching=0,overdue7=0,overdue21=0,overdue42=0,sent=0,skipped=0,failed=0,appointmentAuthoritative=0,dateRowsSynchronized=0;
  const today=new Date();today.setHours(0,0,0,0);
  // Reuse CSW's message ledger for reminder Meta IDs and webhook status tracking.
  // Historic reminder markers stay authoritative; this never resends earlier reminders.
  function recordRetieMessage(customerId,phone,first,service,markerKey,template,dateText,result,status,error){
    try{
      AQBLogEventWhatsApp({
        'Event ID':markerKey,'Event Name':'Sisterlocks Retie Reminder',
        'Template':template,'Sender':'AQB Automated Retie Worker',
        'Message Type':'RETIE_TEMPLATE','Message Intent':'RETIE_REMINDER',
        'Service':service,'Message Text':String(first||'')+' | Retie date: '+String(dateText||'')+' | '+markerKey
      },{'customerId':customerId,'phone':phone},result,status,error||'');
    }catch(ledgerError){
      try{AQBLogAudit('AQB_RETIE_LEDGER_ERROR','Customer',customerId,
        'Retie message '+markerKey+' was processed but could not be logged: '+String(ledgerError&&ledgerError.message||ledgerError));}catch(ignore){}
    }
  }
  rows.forEach(function(r,i){
    const customerId=String(r[m['Customer ID']-1]||'');
    if(!AQBIsSisterlocksService(r[m['Service']-1]) || AQBIsConsultationService(r[m['Service']-1]))return;
    const first=AQBGetCustomerFirstName(r,m),phone=String(r[m['WhatsApp Number']-1]||'');
    const appt=AQBFindRetieAppointmentAuthority(customerId);
    let marker=String(r[m['Reminder Sent']-1]||'').trim();

    // V16.22.1.13: Booking dates NEVER rewrite canonical retie-cycle dates.
    // Preserve 42-day + Sunday-to-Monday business normalization in AQBCalculateRetieDates.
    if(appt)appointmentAuthoritative++;

    // A future booking governs its advance reminder. An unresolved past booking
    // governs appointment-overdue visibility, but a KNOWN completed retie governs
    // maintenance severity (+42 days, moving Sunday to Monday). Unknown-history
    // customers retain the missed booking/Next Retie Date as the overdue authority.
    const storedNext=AQBParseRetieDate(r[m['Next Retie Date']-1]);
    const lastCompleted=AQBParseRetieDate(r[m['Last Retie Date']-1]);
    let next=storedNext?new Date(storedNext):null;
    const overdueBooking=!!(appt&&appt.date<today);
    let overdueAuthority='STORED_NEXT_RETIE_DATE';
    if(lastCompleted){
      const calculated=AQBCalculateRetieDates(lastCompleted);
      const due=AQBParseRetieDate(calculated.nextRetieDate);
      if(due){next=new Date(due);overdueAuthority='LAST_RETIE_PLUS_42_BUSINESS_DAY';}
    }
    if(!next)return;next.setHours(0,0,0,0);
    const delta=Math.floor((next.getTime()-today.getTime())/86400000);
    const contact=AQBResolveWhatsAppNumber(phone);

    // Pre-retie reminder: Next Retie Date - 3 days, with catch-up until the due date.
    if(delta>=0&&delta<=CONFIG.REMINDER_DAYS){
      const markerKey='APPROACHING:'+AQBFormatDateKey(next);
      if(marker!==markerKey && !AQBIsEventMessageSent(markerKey,customerId) && !AQBRetieAcceptedEvidence_(markerKey,customerId)){
        if(!contact.valid){skipped++;AQBLogRetieReminderDecision('SKIPPED',customerId,'Pre-retie reminder due '+AQBFormatDateForClient(next)+'; invalid/missing WhatsApp number after AQB normalization. Raw='+contact.raw+' Normalized='+contact.normalized);return;}
        try{
          const res=AQBSendWhatsAppTemplate(contact.normalized,CONFIG.WHATSAPP_TEMPLATES.RETIE_REMINDER,'en_US',AQBBuildWhatsAppBodyVariables([first,AQBFormatDateForClient(next)]));
          if(res&&res.sent){r[m['Reminder Sent']-1]=markerKey;s.getRange(i+2,m['Reminder Sent']).setValue(markerKey);approaching++;sent++;recordRetieMessage(customerId,contact.normalized,first,String(r[m['Service']-1]||''),markerKey,CONFIG.WHATSAPP_TEMPLATES.RETIE_REMINDER,AQBFormatDateForClient(next),res,'ACCEPTED','');AQBLogRetieReminderDecision('SENT',customerId,'Meta accepted pre-retie reminder for Next Retie Date '+AQBFormatDateForClient(next)+'.');}
          else{skipped++;recordRetieMessage(customerId,contact.normalized,first,String(r[m['Service']-1]||''),markerKey,CONFIG.WHATSAPP_TEMPLATES.RETIE_REMINDER,AQBFormatDateForClient(next),res,'FAILED',String(res&&res.reason||'Send skipped'));AQBLogRetieReminderDecision('SKIPPED',customerId,'Pre-retie reminder not sent: '+String(res&&res.reason||'WhatsApp sender returned sent=false.'));}
        }catch(e){failed++;AQBLogRetieReminderDecision('FAILED',customerId,'Pre-retie reminder failed: '+String(e&&e.message||e));try{AQBLogAudit('WHATSAPP_ERROR','Customer',customerId,String(e&&e.message||e));}catch(ignore){}}
      }
      return;
    }

    if(delta>0)return;
    const daysOverdue=Math.floor((today.getTime()-next.getTime())/86400000);
    const stage=AQBGetRetieOverdueStage(daysOverdue);if(!stage)return;
    const markerKey=AQBGetRetieReminderMarker(stage,AQBFormatDateKey(next));
    const bookedStageKey=overdueBooking?AQBGetRetieReminderMarker(stage,AQBFormatDateKey(appt.date)):'';
    // A stage submitted against the missed booking must not be repeated simply
    // because maintenance-based escalation now uses the calculated due date.
    if(marker===markerKey || (bookedStageKey&&marker===bookedStageKey) ||
       AQBIsEventMessageSent(markerKey,customerId) || AQBRetieAcceptedEvidence_(markerKey,customerId) ||
       (bookedStageKey&&(AQBIsEventMessageSent(bookedStageKey,customerId)||AQBRetieAcceptedEvidence_(bookedStageKey,customerId))))return;
    if(!contact.valid){skipped++;AQBLogRetieReminderDecision('SKIPPED',customerId,stage+' reminder skipped for Next Retie Date '+AQBFormatDateForClient(next)+': invalid/missing WhatsApp number after AQB normalization. Raw='+contact.raw+' Normalized='+contact.normalized);return;}
    const template=AQBGetRetieOverdueTemplate(stage);
    try{
      const res=AQBSendWhatsAppTemplate(contact.normalized,template,'en_US',AQBBuildWhatsAppBodyVariables([first,AQBFormatDateForClient(next)]));
      if(res&&res.sent){
        r[m['Reminder Sent']-1]=markerKey;s.getRange(i+2,m['Reminder Sent']).setValue(markerKey);sent++;
        recordRetieMessage(customerId,contact.normalized,first,String(appt&&appt.service||r[m['Service']-1]||''),markerKey,template,AQBFormatDateForClient(next),res,'ACCEPTED','');
        if(stage==='OVERDUE_7D')overdue7++;else if(stage==='OVERDUE_21D')overdue21++;else overdue42++;
        AQBLogRetieReminderDecision('SENT',customerId,stage+' reminder sent; Next Retie Date '+AQBFormatDateForClient(next)+'; '+daysOverdue+' days overdue.');
        if(stage==='OVERDUE_42D'){try{AQBLogAudit('AQB_RETIE_MANUAL_FOLLOWUP_REQUIRED','Customer',customerId,'Third automated overdue reminder sent at '+daysOverdue+' days overdue. Next Retie Date '+AQBFormatDateForClient(next)+'. Further follow-up should be manual.');}catch(ignore){}}
      }else{skipped++;recordRetieMessage(customerId,contact.normalized,first,String(r[m['Service']-1]||''),markerKey,template,AQBFormatDateForClient(next),res,'FAILED',String(res&&res.reason||'Send skipped'));AQBLogRetieReminderDecision('SKIPPED',customerId,stage+' reminder not sent: '+String(res&&res.reason||'WhatsApp sender returned sent=false.'));}
    }catch(e){failed++;AQBLogRetieReminderDecision('FAILED',customerId,stage+' reminder failed: '+String(e&&e.message||e));try{AQBLogAudit('WHATSAPP_ERROR','Customer',customerId,String(e&&e.message||e));}catch(ignore){}}
  });
  const out={version:VERSION,function:'AQBProcessRetieReminders',readOnly:false,networkUsed:true,reminderAuthority:'FUTURE_BOOKING_OR_MISSED_BOOKING_WITH_KNOWN_LAST_RETIE_PLUS_42',preReminderRule:'Next Retie Date - 3 days',overdueRules:['Next Retie Date + 7 days','Next Retie Date + 21 days','Next Retie Date + 42 days'],approaching:approaching,overdue7:overdue7,overdue21:overdue21,overdue42:overdue42,sent:sent,skipped:skipped,failed:failed,appointmentAuthoritative:appointmentAuthoritative,dateRowsSynchronized:dateRowsSynchronized};
  try{AQBLogAudit('AQB_RETIE_REMINDER_RUN','System','RETIE_REMINDERS',JSON.stringify(out));}catch(ignore){}
  Logger.log('=== AQB RETIE REMINDERS ===');Logger.log(JSON.stringify(out));return out;
}

function AQBEnsureRetieReminderTrigger(){
  const legacy='processWhatsAppRetieReminders_',canonical='AQBProcessRetieReminders';
  const triggers=ScriptApp.getProjectTriggers();
  triggers.filter(function(t){return t.getHandlerFunction()===legacy;}).forEach(function(t){ScriptApp.deleteTrigger(t);});
  const canonicalTriggers=ScriptApp.getProjectTriggers().filter(function(t){return t.getHandlerFunction()===canonical;});
  if(canonicalTriggers.length){canonicalTriggers.slice(1).forEach(function(t){ScriptApp.deleteTrigger(t);});return {success:true,created:false,handler:canonical,legacyRemoved:true};}
  ScriptApp.newTrigger(canonical).timeBased().everyDays(1).atHour(9).create();
  return {success:true,created:true,handler:canonical,legacyRemoved:true};
}

function AQBInstallRetieReminderTrigger(){AQBRequireAdmin();const names=['processWhatsAppRetieReminders_','AQBProcessRetieReminders'];ScriptApp.getProjectTriggers().filter(function(t){return names.includes(t.getHandlerFunction());}).forEach(function(t){ScriptApp.deleteTrigger(t);});ScriptApp.newTrigger('AQBProcessRetieReminders').timeBased().everyDays(1).atHour(9).create();return {success:true,handler:'AQBProcessRetieReminders',message:'AQB retie reminder trigger installed daily at approximately 09:00.'};}

