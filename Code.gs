/** V16.22.1.12 — Read-only customer integrity audit. No customer edits. */
function AQBAuditCustomerIntegrity(){
  AQBRequireAdmin();
  const ss=AQBGetSpreadsheet(),sh=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS),m=AQBBuildHeaderMap(sh);
  const n=sh.getLastRow(),data=n>1?sh.getRange(2,1,n-1,sh.getLastColumn()).getValues():[];
  const byId={},byPhone={},missingIds=[],invalidPhones=[];
  data.forEach(function(r,i){
    const id=String(r[m['Customer ID']-1]||'').trim().toUpperCase();
    const phone=AQBNormalizePhone(r[m['WhatsApp Number']-1]);
    if(!id){missingIds.push(i+2);return;}
    (byId[id]||(byId[id]=[])).push(i+2);
    if(phone)(byPhone[phone]||(byPhone[phone]=[])).push({customerId:id,row:i+2});
    if(!AQBIsValidPhone(phone))invalidPhones.push({customerId:id,row:i+2,phone:phone,reason:phone?'not a Kenyan mobile number':'blank or malformed'});
  });
  const orphanReferences=[];
  [CONFIG.SHEETS.APPOINTMENTS,CONFIG.SHEETS.PAYMENTS,CONFIG.SHEETS.WHATSAPP_MESSAGES].forEach(function(name){
    const ref=ss.getSheetByName(name);if(!ref||ref.getLastRow()<2)return;
    const hm=AQBBuildHeaderMap(ref),c=hm['Customer ID'];if(!c)return;
    const ids=ref.getRange(2,c,ref.getLastRow()-1,1).getValues(),missing={};
    ids.forEach(function(v,i){const id=String(v[0]||'').trim().toUpperCase();if(id&&!byId[id]){const entry=missing[id]||(missing[id]={sheet:name,customerId:id,count:0,exampleRow:i+2});entry.count++;}});
    Object.keys(missing).forEach(function(id){orphanReferences.push(missing[id]);});
  });
  const duplicateIds=Object.keys(byId).filter(function(id){return byId[id].length>1;}).map(function(id){return {customerId:id,rows:byId[id]};});
  const duplicatePhones=Object.keys(byPhone).filter(function(p){return byPhone[p].length>1;}).map(function(p){return {phone:p,records:byPhone[p]};});
  return {success:true,readOnly:true,customerRows:data.length,uniqueCustomerIds:Object.keys(byId).length,
    duplicateIds:duplicateIds,duplicatePhones:duplicatePhones,missingIdRows:missingIds,
    invalidWhatsAppNumbers:invalidPhones,orphanReferences:orphanReferences,
    note:'Gaps in AQBID numbering alone are not evidence of missing customers. No records were changed.'};
}
