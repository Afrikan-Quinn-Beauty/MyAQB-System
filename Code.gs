}

function AQBMigrateCustomersAddLocationColumn(){
  const ss=AQBGetSpreadsheet();
  const s=ss.getSheetByName(CONFIG.SHEETS.CUSTOMERS);
  if(!s)return;
  let headers=s.getRange(1,1,1,Math.max(s.getLastColumn(),1)).getValues()[0].map(v=>String(v||'').trim());
  const existingCol=headers.indexOf('Customer Location')+1;
  if(existingCol===4)return;
  if(existingCol>0){
    // Move an already-created Location column to D without losing its values.
    const values=s.getRange(1,existingCol,s.getLastRow(),1).getValues();
    s.deleteColumn(existingCol);
    s.insertColumnBefore(4);
    s.getRange(1,4,values.length,1).setValues(values);
    return;
  }
  // Existing v3 layout has Service in column D. Insert the new Location column at D.
  s.insertColumnBefore(4);
  s.getRange(1,4).setValue('Customer Location');
}

function AQBNormalizeCustomersSheet(){
  const s=AQBGetSheet(CONFIG.SHEETS.CUSTOMERS);
  if(!s)return;
  const desired=[
    'Customer ID','Customer Name','First Name','Last Name','WhatsApp Number','Customer Location','Service',
    'Last Retie Date','Next Retie Date','Preferred Day','Preferred Time','Reminder Sent','Payment Status',
    'Total Visits','Notes','Customer Status','Reminder Date','Next Appointment Created'
  ];
  const lastCol=Math.max(s.getLastColumn(),1), lastRow=s.getLastRow();
  const headers=s.getRange(1,1,1,lastCol).getValues()[0].map(v=>String(v||'').trim());
  const idx={}; headers.forEach((h,i)=>{if(h && idx[h]===undefined)idx[h]=i;});
  const data=lastRow>=2?s.getRange(2,1,lastRow-1,lastCol).getValues():[];
  const out=data.map(row=>desired.map(h=>{
    if(idx[h]!==undefined)return row[idx[h]];
    // Populate First/Last from legacy Customer Name when those columns did not exist.
    if(h==='First Name'||h==='Last Name'){
      const full=idx['Customer Name']!==undefined?String(row[idx['Customer Name']]||'').trim():'';
      const parts=AQBSplitCustomerName(full);
      return h==='First Name'?parts.firstName:parts.lastName;
    }
    return h==='Next Appointment Created'?'No':'';
  }));
  const targetCols=desired.length;
  if(lastCol>targetCols)s.deleteColumns(targetCols+1,lastCol-targetCols);
  s.getRange(1,1,1,targetCols).setValues([desired]);
  if(out.length)s.getRange(2,1,out.length,targetCols).setValues(out);
}

function AQBSplitCustomerName(fullName){
  const clean=String(fullName||'').trim().replace(/\s+/g,' ');
  if(!clean)return {firstName:'',lastName:''};
  const parts=clean.split(' ');
  return {firstName:parts.shift(),lastName:parts.join(' ')};
}

function AQBBuildCustomerFullName(firstName,lastName,fallback){
  const joined=[String(firstName||'').trim(),String(lastName||'').trim()].filter(Boolean).join(' ');
  return joined || String(fallback||'').trim();
}

function AQBEnsureCustomerNameParts(row,m){
  if(!m['First Name']||!m['Last Name'])return;
  const existingFirst=String(row[m['First Name']-1]||'').trim();
  const existingLast=String(row[m['Last Name']-1]||'').trim();
  if(existingFirst)return;
  const parts=AQBSplitCustomerName(row[m['Customer Name']-1]);
  row[m['First Name']-1]=parts.firstName;
  row[m['Last Name']-1]=parts.lastName;
}

function AQBGetCustomerFirstName(row,m){
  const first=m&&m['First Name']?String(row[m['First Name']-1]||'').trim():'';
  if(first)return first;
  return AQBSplitCustomerName(m&&m['Customer Name']?row[m['Customer Name']-1]:'').firstName;
}

function AQBNormalizeGoogleContactPerson(person){
  person=person||{}; const name=(person.names&&person.names[0])||{}, phone=(person.phoneNumbers&&person.phoneNumbers[0])||{}, email=(person.emailAddresses&&person.emailAddresses[0])||{};
  const given=String(name.givenName||'').trim(), family=String(name.familyName||'').trim(), display=String(name.displayName||[given,family].filter(Boolean).join(' ')||'').trim();
  const sources=Array.isArray(person.metadata&&person.metadata.sources)?person.metadata.sources:[];
  return {resourceName:String(person.resourceName||''),etag:String(person.etag||''),sources:sources,firstName:given,lastName:family,name:display,phone:String(phone.value||'').trim(),email:String(email.value||'').trim()};
}

function AQBGetGoogleContacts(){
  const user=AQBRequireGoogleContactsUser();
  if(typeof People==='undefined' || !People.People || !People.People.Connections) throw new Error('Google Contacts authorization or People API access is required.');
  const out=[]; let token='';
  do{ const opts={personFields:'names,phoneNumbers,emailAddresses,metadata',pageSize:1000}; if(token)opts.pageToken=token; const res=People.People.Connections.list('people/me',opts)||{};
    (res.connections||[]).forEach(function(person){const c=AQBNormalizeGoogleContactPerson(person);if(c.name||c.phone||c.email)out.push(c);}); token=res.nextPageToken||'';
  }while(token && out.length<5000);
  out.sort(function(a,b){return String(a.name).localeCompare(String(b.name),'en',{sensitivity:'base'});}); return {success:true,count:out.length,contacts:out,googleAccountEmail:user.email,googleAccountName:user.name,contactsSource:'Google Contacts for the signed-in AQB staff account'};
}

function AQBGetGoogleContactsPage(pageToken,query){
  const user=AQBRequireGoogleContactsUser();
  if(typeof People==='undefined'||!People.People||!People.People.Connections)throw new Error('Google People API is unavailable for this account.');
  const opts={personFields:'names,phoneNumbers,emailAddresses,metadata',pageSize:100};
  if(pageToken)opts.pageToken=String(pageToken);
  try{
    const res=People.People.Connections.list('people/me',opts)||{};
