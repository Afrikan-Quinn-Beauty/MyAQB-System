function AQBParseAcquisitionHandoff(text){
  const match=String(text||'').match(/\[AQB_BOOK:(AQBCAT\d{3})(?:;SRC:([a-z0-9_-]{0,32}))?(?:;CMP:([a-zA-Z0-9_-]{0,48}))?\]/i);
  if(!match)return null;
  return {catalogueId:match[1].toUpperCase(),source:String(match[2]||'catalogue').toLowerCase(),campaign:String(match[3]||'')};
}
function AQBGetAcquisitionSheet(){
  const book=SpreadsheetApp.getActiveSpreadsheet();
  let sheet=book.getSheetByName('AQB Acquisition Enquiries');
  if(!sheet){sheet=book.insertSheet('AQB Acquisition Enquiries');sheet.appendRow(['Timestamp','WhatsApp Message ID','Phone','Customer ID','Catalogue ID','Source','Campaign','Status','Appointment ID','Consent']);}
  return sheet;
}
function AQBRecordAcquisitionEnquiry(payload){
  const p=payload||{};const messageId=String(p.messageId||'');
  if(!messageId)throw new Error('A WhatsApp message ID is required for enquiry idempotency.');
  const lock=LockService.getScriptLock();lock.waitLock(15000);
  try{
    const sh=AQBGetAcquisitionSheet();const last=sh.getLastRow();
    if(last>1&&sh.getRange(2,2,last-1,1).getValues().some(function(r){return String(r[0])===messageId;}))return {duplicate:true};
    sh.appendRow([new Date(),messageId,String(p.phone||''),String(p.customerId||''),String(p.catalogueId||''),String(p.source||'catalogue'),String(p.campaign||''),'ENQUIRY','','NOT_REQUESTED']);
    return {recorded:true};
  }finally{lock.releaseLock();}
}
function AQBGetAcquisitionScorecard(){
  AQBRequireAdmin();const sh=AQBGetAcquisitionSheet(),last=sh.getLastRow();
  if(last<2)return {enquiries:0,bySource:{},confirmedBookings:'Not linked',completedAppointments:'Not linked',revenue:'Not linked'};
  const rows=sh.getRange(2,1,last-1,10).getValues(),sources={};
  rows.forEach(function(r){const k=String(r[5]||'unknown');sources[k]=(sources[k]||0)+1;});
  return {enquiries:rows.length,bySource:sources,confirmedBookings:'Not linked',completedAppointments:'Not linked',revenue:'Not linked',note:'Enquiry counts only. Do not interpret as completed bookings or paid conversions.'};
}
function AQBPreviewMetaLegacyDeleteBatches(){
  AQBRequireAdmin();const a=AQBAuditMetaLegacyRemoval();
  const batches=[];for(let i=0;i<a.legacy.length;i+=25){
    const entries=a.legacy.slice(i,i+25);
    batches.push({batch:i/25+1,count:entries.length,firstRetailerId:entries[0].retailer_id,lastRetailerId:entries[entries.length-1].retailer_id});
  }
  return {readOnly:true,remoteCount:a.metaCount,canonicalCount:a.canonicalCount,legacyCount:a.legacyCount,batches:batches,
    warning:'No deletion executed. Existing /items_batch requests must be validated against Meta item-level response and remote re-read before retry.'};
}

