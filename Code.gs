  const c=String(category||'').trim().replace(/[–—]/g,' ').replace(/\s+/g,' ');
  const profile=AQBGetPexelsVisualProfile(service,category,d);
  const age=profile.audience==='child'?'Black African child':(profile.maleAllowed?'Black African man':'Black African woman');
