    'Service Name':obj.serviceName||'','Family':obj.family||'','Customer Variant Name':obj.variantName||'',
    'Match Keywords':obj.matchKeywords||'','Exclude Keywords':obj.excludeKeywords||'','Match Mode':obj.matchMode||'ANY',
    'Active':obj.active||'YES','Source Name':obj.sourceName||'','Source URL':obj.sourceUrl||'',
    'Source Type':obj.sourceType||'','Notes':obj.notes||'','Updated At':new Date()
  };
  Object.keys(values).forEach(function(h){if(cm[h])row[cm[h]-1]=values[h];});
  return row;
}

function AQBPrepareServiceVariantDatabase(actorEmail){
  const sheet=AQBEnsureServiceVariantsSheet(),cm=AQBBuildHeaderMap(sheet),existing={},manualKeys={},legacyRows=[];
  if(sheet.getLastRow()>=2){
    sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).getValues().forEach(function(r){
      const key=cm['Variant Key']?String(r[cm['Variant Key']-1]||'').trim():'',
            legacyVariant=cm['Customer Variant Name']?String(r[cm['Customer Variant Name']-1]||'').trim():'',
            legacyService=cm['Service Name']?String(r[cm['Service Name']-1]||'').trim():'';
      if(!key){if(legacyVariant&&legacyService)legacyRows.push({serviceName:legacyService,variantName:legacyVariant});return;}
      existing[key]=r;
      const st=cm['Source Type']?String(r[cm['Source Type']-1]||'').trim().toUpperCase():'';
      if(st==='MANUAL')manualKeys[key]=true;
    });
  }

  const desired=[];
  AQBGetServiceVariantMarketSeed().forEach(function(x){desired.push(x);});

  const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),ccm=AQBEnsureCustomerVariantColumns(cat,AQBBuildHeaderMap(cat)),serviceNameToId={};
  if(cat.getLastRow()>=2){
    const rows=cat.getRange(2,1,cat.getLastRow()-1,cat.getLastColumn()).getValues();
    rows.forEach(function(r){
      const legacyId=ccm['Catalogue ID']?String(r[ccm['Catalogue ID']-1]||'').trim():'',legacyService=ccm['Service Name']?String(r[ccm['Service Name']-1]||'').trim():'';
      if(legacyId&&legacyService)serviceNameToId[AQBNormalizeCatalogueVariantText(legacyService)]=legacyId;
    });
    legacyRows.forEach(function(x){
      const id=serviceNameToId[AQBNormalizeCatalogueVariantText(x.serviceName)]||'';if(!id)return;
      const obj={scope:'SERVICE',parentKey:id,catalogueId:id,serviceName:x.serviceName,family:'',variantName:x.variantName,matchKeywords:'',excludeKeywords:'',matchMode:'ALWAYS',active:'YES',sourceName:'Manual legacy ServiceVariants',sourceUrl:'',sourceType:'MANUAL',notes:'Migrated from pre-C.4.7.4 ServiceVariants row.'};
      const k=AQBGetCatalogueVariantKey(obj.scope,obj.parentKey,obj.variantName);manualKeys[k]=true;existing[k]=AQBBuildCatalogueVariantRow(obj,cm,sheet.getLastColumn());
    });
    rows.forEach(function(r){
      const id=ccm['Catalogue ID']?String(r[ccm['Catalogue ID']-1]||'').trim():'',
            service=ccm['Service Name']?String(r[ccm['Service Name']-1]||'').trim():'',
            category=ccm['Category']?String(r[ccm['Category']-1]||'').trim():'',
            desc=ccm['Description']?String(r[ccm['Description']-1]||'').trim():'',
            brief=ccm['Photo Brief']?String(r[ccm['Photo Brief']-1]||'').trim():'';
      if(!id||!service)return;
      const sig=AQBGetCatalogueVariantVisualSignature(service,category,desc,brief,r,ccm),serviceKey=AQBNormalizeCatalogueVariantText(service);
      function addServiceVariant(name,sourceType,sourceName,notes){
        name=String(name||'').trim();if(!name||AQBNormalizeCatalogueVariantText(name)===serviceKey)return;
        desired.push({scope:'SERVICE',parentKey:id,catalogueId:id,serviceName:service,family:sig.family,variantName:name,matchKeywords:'',excludeKeywords:'',matchMode:'ALWAYS',active:'YES',sourceName:sourceName||'AQB Catalogue',sourceUrl:'',sourceType:sourceType||'CATALOGUE',notes:notes||'Catalogue-ID-owned customer terminology.'});
      }
      if(ccm['Customer-Facing Name'])addServiceVariant(r[ccm['Customer-Facing Name']-1],'CATALOGUE','AQB Catalogue','Customer-facing name.');
      if(ccm['Service Synonyms'])AQBSplitCatalogueVariants(r[ccm['Service Synonyms']-1]).forEach(function(v){addServiceVariant(v,'CATALOGUE','AQB Catalogue','Existing service synonym.');});
      (AQBGetCatalogueKnownStyleMap()[serviceKey]||[]).forEach(function(v){addServiceVariant(v,'AQB_CURATED','AQB Curated Vocabulary','Known equivalent/near-equivalent customer term.');});
      AQBGetCatalogueStructuralServiceVariants(service,sig).forEach(function(v){addServiceVariant(v,'AQB_STRUCTURAL','AQB Structural Rules','Derived only from exact Service Name structure/count/size/action.');});
    });
  }

  const dedup={};
  desired.forEach(function(x){
    const k=AQBGetCatalogueVariantKey(x.scope,x.parentKey,x.variantName);if(!k||manualKeys[k])return;dedup[k]=x;
  });
  const output=[];
  Object.keys(manualKeys).forEach(function(k){if(existing[k])output.push(existing[k]);});
  Object.keys(dedup).sort().forEach(function(k){output.push(AQBBuildCatalogueVariantRow(dedup[k],cm,sheet.getLastColumn()));});

  if(sheet.getLastRow()>1)sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).clearContent();
  if(output.length)sheet.getRange(2,1,output.length,sheet.getLastColumn()).setValues(output);
  try{sheet.setFrozenRows(1);sheet.autoResizeColumns(1,Math.min(SERVICE_VARIANT_HEADERS.length,10));}catch(ignore){}

  return {sheet:sheet,rows:output.length,manualPreserved:Object.keys(manualKeys).length,marketSeedRows:AQBGetServiceVariantMarketSeed().length};
}

