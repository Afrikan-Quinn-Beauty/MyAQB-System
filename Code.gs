function AQBSyncCatalogueToTikTok(){
  const u=AQBRequireAdmin(),c=AQBGetTikTokCatalogueConfig();
  if(!c.configured)throw new Error('Configure the TikTok Business Center ID, Catalogue ID, and API access token first.');
  const data=AQBBuildTikTokDirectCatalogueRows(),existing=AQBGetTikTokCatalogueProducts(),bySku={};
  existing.forEach(function(x){const id=String(x.sku_id||x.product_id||'').trim();if(id)bySku[id]=x;});
  const desired={};data.rows.forEach(function(x){desired[x.id]=true;});
  const create=[],update=[],remove=[];
  data.rows.forEach(function(x){(bySku[x.id]?update:create).push(AQBBuildTikTokApiProduct(x));});
  Object.keys(bySku).forEach(function(id){if(!desired[id])remove.push(id);});

  const results={success:true,eligible:data.counts.eligible,existing:existing.length,create:0,update:0,remove:0,failed:0,feedLogIds:[],errors:[]},
        failedById={};
  function submit(path,products,label){
    if(!products.length)return;
    try{
      const r=AQBSendTikTokCatalogueRequest('post',path,{bc_id:c.bcId,catalog_id:c.catalogId,products:products});
      const logId=r&&r.data&&r.data.feed_log_id?String(r.data.feed_log_id):'';
      if(logId)results.feedLogIds.push(logId);
      results[label]+=products.length;
    }catch(e){
      const msg=String(e&&e.message||e);results.failed+=products.length;results.errors.push(label+': '+msg);
      products.forEach(function(p){failedById[String(p.sku_id||'')]=msg;});
    }
  }
  submit('/catalog/product/upload/',create,'create');
  submit('/catalog/product/update/',update,'update');
  if(remove.length){
    try{
      const r=AQBSendTikTokCatalogueRequest('post','/catalog/product/delete/',{bc_id:c.bcId,catalog_id:c.catalogId,sku_ids:remove});
      const logId=r&&r.data&&r.data.feed_log_id?String(r.data.feed_log_id):'';
      if(logId)results.feedLogIds.push(logId);results.remove=remove.length;
    }catch(e){
      const msg=String(e&&e.message||e);results.failed+=remove.length;results.errors.push('remove: '+msg);
      remove.forEach(function(id){failedById[id]=msg;});
    }
  }

  const now=new Date(),syncEntries=[];
  data.rows.forEach(function(x){
    const remote=bySku[x.id]?String(bySku[x.id].product_id||bySku[x.id].id||''):'',err=failedById[x.id]||'';
    syncEntries.push({catalogueId:x.id,channel:'TIKTOK',remoteObjectId:remote,status:err?'ERROR':'SYNC_SUBMITTED',syncedAt:now,error:err});
  });
  remove.forEach(function(id){
    const remote=bySku[id]?String(bySku[id].product_id||bySku[id].id||''):'',err=failedById[id]||'';
    syncEntries.push({catalogueId:id,channel:'TIKTOK',remoteObjectId:remote,status:err?'ERROR':'REMOVED_SUBMITTED',syncedAt:now,error:err});
  });
  AQBWriteChannelSyncBatch(syncEntries);
  PropertiesService.getScriptProperties().setProperty(CONFIG.TIKTOK.LAST_VALIDATED_PROPERTY,now.toISOString());
  try{AQBLogAudit('SYNC_CATALOGUE_TIKTOK','Marketing','TIKTOK',u.email+' synchronized dynamic AQB Catalogue set to TikTok API. Eligible '+data.counts.eligible+', created '+results.create+', updated '+results.update+', removed '+results.remove+', failed '+results.failed+'.');}catch(ignore){}
  results.message=results.failed?'TikTok synchronization submitted with errors. Review Catalogue Channel Sync before retrying.':'TikTok synchronization submitted successfully for the current eligible AQB Catalogue ID set.';
  results.identity='Catalogue ID / sku_id';
  return results;
}

function AQBVerifyTikTokCatalogue(){
