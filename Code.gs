function AQBPreviewCashFlowPaymentRecovery(){
  AQBRequireAdmin();const d=AQBGetPaymentRecoveryRows(),p=d.pm,c=d.cm,a=d.am,u=d.um;
  const knownCustomers={};d.customers.forEach(function(r){knownCustomers[String(r[u['Customer ID']-1]||'').trim()]=true;});
  const appointments={};d.appointments.forEach(function(r){appointments[String(r[a['Appointment ID']-1]||'').trim()]=r;});
  const results=[];
  d.cash.forEach(function(r,i){
    if(String(r[c['Transaction Type']-1]||'').toLowerCase()!=='income')return;
    const id=String(r[c['Appointment ID']-1]||'').trim(),tx=String(r[c['Transaction ID']-1]||'').trim(),linked=String(r[c['Source Payment ID']-1]||'').trim();
    if(!id||!tx)return;
    const app=appointments[id],amount=Number(r[c['Amount']-1]||0),customerId=String(r[c['Customer ID']-1]||'').trim();
    const matches=d.payments.filter(function(q){return String(q[p['Appointment ID']-1]||'').trim()===id;});
    const siblings=d.cash.filter(function(q){return String(q[c['Appointment ID']-1]||'').trim()===id&&String(q[c['Transaction Type']-1]||'').toLowerCase()==='income';});
    const issues=[];
    if(AQBIsTestCustomer(customerId) || (app && AQBIsTestCustomer(app[a['Customer ID']-1])))issues.push('TEST_CUSTOMER_EXCLUDED');
    if(linked)issues.push('ALREADY_LINKED');
    if(!app)issues.push('APPOINTMENT_NOT_FOUND');
    if(app && String(app[a['Status']-1]||'').toUpperCase()!=='COMPLETED')issues.push('NOT_COMPLETED');
    // V16.21.16.8.50: a completed non-test appointment is eligible even when
    // serviced early, its saved charge differs, or the legacy customer sheet
    // no longer contains the Cash Flow customer. Preserve source data as-is.
    if(!isFinite(amount)||amount<0)issues.push('INVALID_AMOUNT');
    const sourceStatus=String(r[c['Payment Status']-1]||'').trim().toLowerCase();
    const advisory=[];
    if(!knownCustomers[customerId] || (app && String(app[a['Customer ID']-1]||'').trim()!==customerId))advisory.push('CUSTOMER_REFERENCE_MISMATCH');
    if(sourceStatus!=='paid')advisory.push('SOURCE_PAYMENT_STATUS_'+(sourceStatus||'BLANK'));
    if(app && Number(app[a['Charged Price']-1]||0)!==amount)advisory.push('CHARGE_AMOUNT_DIFFERS');
    if(matches.length)issues.push('PAYMENTS_ALREADY_EXIST');
    if(siblings.length!==1)issues.push('MULTIPLE_INCOME_ROWS');
    results.push({transactionId:tx,appointmentId:id,customerId:customerId,amount:amount,method:String(r[c['Payment Method']-1]||''),status:issues.length?'HOLD':'ELIGIBLE',reasons:issues,advisories:advisory,rowNumber:i+2});
  });
  const eligible=results.filter(function(x){return x.status==='ELIGIBLE';});
  const report={version:'V16.21.16.8.50',readOnly:true,writes:0,total:results.length,eligible:eligible.length,held:results.length-eligible.length,records:results};
  Logger.log('=== AQB CASH FLOW PAYMENT RECOVERY PREVIEW (READ ONLY) ===');Logger.log(JSON.stringify(report));return report;
}

function AQBCommitCashFlowPaymentRecovery(options){
  const user=AQBRequireAdmin(),opt=options||{};
  if(opt.confirm!==true)throw new Error('Confirmation required: confirm:true');
  const ids=Array.isArray(opt.transactionIds)?opt.transactionIds.map(String):[];
  if(!ids.length||ids.length>25||new Set(ids).size!==ids.length)throw new Error('Provide 1–25 unique transaction IDs from the latest preview.');
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try{
    // Preview is recalculated while the commit lock is held; no saved token is trusted.
    const preview=AQBPreviewCashFlowPaymentRecovery(),byId={};preview.records.forEach(function(x){byId[x.transactionId]=x;});
    const invalid=ids.filter(function(id){return !byId[id]||byId[id].status!=='ELIGIBLE';});
    if(invalid.length)throw new Error('Recovery blocked; re-preview these transactions: '+invalid.join(', '));
    const d=AQBGetPaymentRecoveryRows(),c=d.cm,p=d.pm,a=d.am;
    const out=[];
    ids.forEach(function(tx){
      const rec=byId[tx],app=d.appointments.find(function(r){return String(r[a['Appointment ID']-1]||'')===rec.appointmentId;});
      if(AQBIsTestCustomer(rec.customerId)||AQBIsTestCustomer(app&&app[a['Customer ID']-1]))throw new Error('Test customer recovery prohibited: '+tx);
      const cf=d.cash.find(function(r){return String(r[c['Transaction ID']-1]||'')===tx;});
      const paymentId=AQBGeneratePaymentID();
      AQBAppendByHeaders(d.ps,{'Payment ID':paymentId,'Date':cf[c['Date']-1],'Customer ID':rec.customerId,
        'Customer Name':String(cf[c['Customer Name']-1]||''),'Appointment ID':rec.appointmentId,
        'Service':String(cf[c['Service']-1]||''),'Payment Type':'Full Payment',
        'Amount Due':Number(app[a['Charged Price']-1]||0),'Amount':rec.amount,'Payment Method':rec.method,
        'Payment Status':'Paid','Description':'Recovered from existing Cash Flow transaction '+tx+(rec.advisories&&rec.advisories.length?' [review: '+rec.advisories.join(', ')+']':''),
        'Recorded By':user.email});
      d.cs.getRange(rec.rowNumber,c['Source Payment ID']).setValue(paymentId);
      AQBLogAudit('RECOVER_CASH_FLOW_PAYMENT','Payment',paymentId,'Recovered existing income '+tx+' for '+rec.appointmentId+' without creating new Cash Flow income.'+(rec.advisories&&rec.advisories.length?' Advisory: '+rec.advisories.join(', '):''));
      out.push({transactionId:tx,paymentId:paymentId,appointmentId:rec.appointmentId});
    });
    return {success:true,recovered:out.length,records:out,newIncomeRows:0};
  }finally{lock.releaseLock();}
}

