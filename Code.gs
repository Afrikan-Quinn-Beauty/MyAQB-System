function AQBGetMetaCatalogueSettings(){
  const u=AQBRequireAdmin(), c=AQBGetMetaCatalogueConfig();
  return {success:true,configured:c.configured,catalogId:c.catalogId,graphVersion:c.graphVersion,accessTokenConfigured:!!c.accessToken,pixelId:AQBGetMetaPixelId(),capiConfigured:!!String(PropertiesService.getScriptProperties().getProperty('META_CAPI_ACCESS_TOKEN')||'').trim(),user:{name:u.name,email:u.email}};
}

function AQBSaveMetaCatalogueSettings(payload){
  const u=AQBRequireAdmin(); payload=payload||{};
  const catalogId=String(payload.catalogId||'').trim();
  const tokenInput=String(payload.accessToken||'').trim();
  const existingToken=String(PropertiesService.getScriptProperties().getProperty('META_CATALOG_ACCESS_TOKEN')||'').trim();
  const token=tokenInput||existingToken;
  const graphVersion=String(payload.graphVersion||'v24.0').trim();
  if(!/^\d+$/.test(catalogId))throw new Error('Enter a valid Meta Catalogue ID.');
  if(!token)throw new Error('Enter the Meta Catalogue access token.');
  if(!/^v\d+\.\d+$/.test(graphVersion))throw new Error('Enter a valid Meta Graph API version such as v24.0.');
  const p=PropertiesService.getScriptProperties();
  p.setProperty('META_CATALOG_ID',catalogId);
  p.setProperty('META_CATALOG_ACCESS_TOKEN',token);
  p.setProperty('META_CATALOG_GRAPH_VERSION',graphVersion);
  AQBEnsureCatalogueMetaColumns();
  AQBLogAudit('SAVE_META_CATALOGUE_SETTINGS','System',catalogId,'Admin '+u.email+' configured direct Meta Catalogue synchronization.');
  return AQBGetMetaCatalogueSettings();
}

function AQBSendMetaCatalogueRequest(method,path,payload){
  const c=AQBGetMetaCatalogueConfig();
  if(!c.configured)throw new Error('Configure the Meta Catalogue ID and access token in Settings first.');
  const url='https://graph.facebook.com/'+c.graphVersion+'/'+c.catalogId+path;
  const options={method:method||'get',muteHttpExceptions:true,headers:{Authorization:'Bearer '+c.accessToken,'Content-Type':'application/json'}};
  if(payload!==undefined)options.payload=JSON.stringify(payload);
  const res=UrlFetchApp.fetch(url,options),code=res.getResponseCode(),body=res.getContentText()||'';
  let data={};try{data=body?JSON.parse(body):{};}catch(e){data={raw:body};}
  if(code<200||code>=300){const msg=data&&data.error&&data.error.message?data.error.message:body;throw new Error('Meta API HTTP '+code+': '+msg);}
  return data;
}

function AQBTestMetaConnection(){
  AQBRequireAdmin();
  const c=AQBGetMetaCatalogueConfig();
  if(!c.configured)throw new Error('Configure the Meta Catalogue ID and access token in Settings first.');
  const data=AQBSendMetaCatalogueRequest('get','?fields=id,name,product_count');
  return {success:true,catalogId:String(data.id||c.catalogId),name:String(data.name||''),productCount:Number(data.product_count||0),graphVersion:c.graphVersion};
}

function AQBReconcileCatalogueWithMeta(){
  const u=AQBRequireAdmin(),data=AQBBuildChannelCatalogueRows('META');
  const desired={},rowsById={};
  data.rows.forEach(function(x){desired[x.id]=true;rowsById[x.id]=x;});

  let metaItems=[];
  try{
    metaItems=AQBReadAllMetaCatalogueProducts();
  }catch(e){throw new Error('Could not read COMPLETE Meta product inventory for reconciliation: '+String(e.message||e));}

  const metaByKey={};
  metaItems.forEach(function(x){const k=String(x.retailer_id||x.id||'').trim();if(k)metaByKey[k]=x;});

  const requests=[],refs=[];let matched=0,created=0,updated=0,removed=0;
  data.rows.forEach(function(x){
    const existing=metaByKey[x.id]||null;
    requests.push({
      method:'UPDATE',retailer_id:x.id,
      data:{
        id:x.id,title:String(x.title||''),description:String(x.description||''),
        availability:'in stock',condition:'new',price:Number(x.price||0).toFixed(2)+' KES',
        image_link:String(x.image||''),link:String(x.link||''),
        brand:'Afrikan Quinn Beauty Centre',category:'Beauty Services > '+String(x.category||'Beauty Services')
      }
    });
    refs.push({id:x.id,kind:existing?'update':'create',remoteObjectId:existing?String(existing.id||''):''});
    if(existing){matched++;updated++;}else created++;
  });

  metaItems.forEach(function(x){
    const key=String(x.retailer_id||x.id||'').trim();
    if(!key||desired[key])return;
    requests.push({method:'DELETE',retailer_id:key,data:{id:String(x.id||key)}});
    refs.push({id:key,kind:'remove',remoteObjectId:String(x.id||'')});
    removed++;
  });

  let failed=0;const syncEntries=[];
  for(let start=0;start<requests.length;start+=50){
    const batch=requests.slice(start,start+50),bref=refs.slice(start,start+50);
    try{
      AQBSendMetaCatalogueRequest('post','/items_batch',{allow_upsert:true,item_type:'PRODUCT_ITEM',requests:batch});
      bref.forEach(function(ref){
        syncEntries.push({catalogueId:ref.id,channel:'META',remoteObjectId:ref.remoteObjectId,status:ref.kind==='remove'?'REMOVED_SUBMITTED':'SYNC_SUBMITTED',syncedAt:new Date(),error:''});
      });
    }catch(e){
      const msg=String(e&&e.message||e).slice(0,1000);failed+=batch.length;
      bref.forEach(function(ref){syncEntries.push({catalogueId:ref.id,channel:'META',remoteObjectId:ref.remoteObjectId,status:'ERROR',syncedAt:new Date(),error:msg});});
    }
  }
  AQBWriteChannelSyncBatch(syncEntries);
  try{AQBLogAudit('RECONCILE_CATALOGUE_META','Catalogue','META','Admin '+u.email+' reconciled dynamic AQB Catalogue set with Meta. Eligible '+data.counts.eligible+', Meta existing '+metaItems.length+', created '+created+', updated '+updated+', removed '+removed+', failed '+failed+'.');}catch(ignore){}
  return {success:failed===0,eligible:data.counts.eligible,blocked:data.counts.blocked,channelExcluded:data.counts.channelExcluded,metaExisting:metaItems.length,matched:matched,created:created,updated:updated,removed:removed,failed:failed,identity:'Catalogue ID / retailer_id',message:'AQB Catalogue ↔ Meta reconciliation submitted from the current eligible Catalogue ID set.'};
}

function AQBPreviewMetaCatalogueReconciliation(){
  AQBRequireAdmin();
  const sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),map=AQBBuildHeaderMap(sheet);
  const required=['Catalogue ID','Service Name','Active','Price','Image URL'];
  const missingHeaders=required.filter(function(h){return !map[h];});
  if(missingHeaders.length)throw new Error('Catalogue missing: '+missingHeaders.join(', '));
  const raw=sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).getValues():[];
  const local={},duplicateIds=[],blocked=[],excluded=[];
  raw.forEach(function(r){
    const id=String(r[map['Catalogue ID']-1]||'').trim().toUpperCase();
    if(!id)return;
    if(local[id]){duplicateIds.push(id);return;}
    const title=String(r[map['Service Name']-1]||'').trim();
    const active=AQBNormalizeBool(r[map['Active']-1]);
    const studio=!!map['Image Source']&&!!map['Photo Qualification Status']&&String(r[map['Image Source']-1]||'').trim().toUpperCase()==='AQB STUDIO'&&String(r[map['Photo Qualification Status']-1]||'').trim().toUpperCase()==='QUALIFIED';
    const image=studio?String(r[map['Image URL']-1]||'').trim():(String(map['Own Photo']?r[map['Own Photo']-1]:'')||'').trim()||String(r[map['Image URL']-1]||'').trim();
    const price=AQBNormalizePriceText(r[map['Price']-1]).amount;
    const reasons=[];
    if(!active)reasons.push('INACTIVE');
    if(!title)reasons.push('MISSING_NAME');
    if(!image||!/^https?:\/\//i.test(image))reasons.push('IMAGE_UNAVAILABLE_FOR_META');
    if(!(price>0))reasons.push('PRICE_NOT_POSITIVE');
    if(!AQBIsCataloguePublicImageQualified(r,map))reasons.push('PHOTO_NOT_PUBLISHABLE');
    if(map['Publish Channels']&&!AQBHasCatalogueChannel(r,map,'META'))excluded.push(id);
    if(reasons.length)blocked.push({id:id,reasons:reasons});
    local[id]={id:id,title:title,price:price,image:image,reasons:reasons};
  });
  const remote=[],seenCursors={};
  const basePath='/products?fields=id,retailer_id,name,price,image_url&limit=500';
  let after='',more=true;
  for(let page=0;more&&page<100;page++){
    // Construct the path ourselves: never execute or derive a destination from Meta paging.next.
    const path=basePath+(after?'&after='+encodeURIComponent(after):'');
    const data=AQBSendMetaCatalogueRequest('get',path);
    (Array.isArray(data.data)?data.data:[]).forEach(function(x){remote.push(x);});
    const paging=data.paging||{};
    const next=String(paging.next||'');
    const cursor=String(paging.cursors&&paging.cursors.after||'').trim();
    if(!next){more=false;break;}
    if(!cursor)throw new Error('Meta returned another page without an after cursor; read-only preview stopped without following external URL. Pages read: '+(page+1));
    if(cursor===after||seenCursors[cursor])throw new Error('Meta pagination cursor repeated; read-only preview stopped.');
    seenCursors[cursor]=true;
    after=cursor;
    if(page===99)throw new Error('Meta inventory exceeds preview pagination safety cap.');
  }
  const current={},duplicates=[];
  remote.forEach(function(x){const id=String(x.retailer_id||'').trim().toUpperCase();if(!id)return;if(current[id])duplicates.push(id);else current[id]=x;});
  const missingInMeta=Object.keys(local).filter(function(id){return !current[id];});
  const extraInMeta=Object.keys(current).filter(function(id){return !local[id];});
  const matched=Object.keys(local).filter(function(id){return !!current[id];});
  const changed=matched.filter(function(id){
    const a=local[id],b=current[id];
    return String(a.title)!==String(b.name||'') || (Number(String(b.price||'').replace(/[^0-9.]/g,''))!==a.price) || String(a.image)!==String(b.image_url||'');
  });
  const report={success:true,readOnly:true,writes:0,deletes:0,canonicalCount:Object.keys(local).length,rawCatalogueRows:raw.length,metaCount:remote.length,metaDistinctIds:Object.keys(current).length,duplicateCanonicalIds:duplicateIds,duplicateMetaIds:duplicates,missingInMeta:missingInMeta,extraInMeta:extraInMeta,changedCandidates:changed,matched:matched.length,blockedCanonical:blocked,channelExcluded:excluded,warning:'PREVIEW ONLY. Remote deletion list requires explicit review. Price/image changes are candidates; Meta response formats may differ.'};
  Logger.log('=== AQB META CATALOGUE RECONCILIATION PREVIEW ===');
  Logger.log(JSON.stringify(report));
  return report;
}

