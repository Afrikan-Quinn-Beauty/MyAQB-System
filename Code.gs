function AQBCreateTikTokGenericCatalogueFeed(){
  const data=AQBBuildTikTokCatalogueRows();
  const params=typeof arguments!=='undefined'&&arguments.length?arguments[0]:null;
  const forceCsv=params&&params.format==='csv';
  if(forceCsv){
    const csv=[data.headers].concat(data.rows.map(function(row){return row.map(AQBEscapeCsv).join(',');})).join('\n');
    return ContentService.createTextOutput(csv+'\n').setMimeType(ContentService.MimeType.CSV);
  }
  // TikTok accepts XML (RSS/Atom) for data feeds. Use XML as the default
  // machine-readable response because Apps Script web-app URLs can redirect
  // ContentService responses and TikTok has previously rejected the CSV URL
  // as an unsupported file format.
  const esc=function(v){return String(v===null||v===undefined?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&apos;');};
  const items=data.rows.map(function(r){
    return '<item><g:item_id xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[0])+'</g:item_id><g:title xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[1])+'</g:title><g:description xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[2])+'</g:description><g:image_link xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[3])+'</g:image_link><g:link xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[4])+'</g:link><g:price xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[5])+'</g:price><g:availability xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[6])+'</g:availability><g:video_link xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[7])+'</g:video_link><g:custom_label_0 xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[10])+'</g:custom_label_0><g:custom_label_1 xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[11])+'</g:custom_label_1><g:custom_label_2 xmlns:g=\"http://base.google.com/ns/1.0\">'+esc(r[12])+'</g:custom_label_2></item>';
  }).join('');
  const xml='<?xml version=\"1.0\" encoding=\"UTF-8\"?><rss version=\"2.0\" xmlns:g=\"http://base.google.com/ns/1.0\"><channel><title>Afrikan Quinn Beauty — TikTok Services</title><link>'+esc(String(ScriptApp.getService().getUrl()||''))+'</link><description>AQB canonical channel catalogue</description>'+items+'</channel></rss>';
  return ContentService.createTextOutput(xml).setMimeType(ContentService.MimeType.RSS);
}

