function AQBGetCatalogueAuthorityFingerprint(){
  const sheet=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(sheet);
  const fields=['Catalogue ID','Category','Customer Category','Service Name','Service Tier','Description','Photo Brief','Booking Link'];
  fields.forEach(function(h){if(!cm[h])throw new Error('Missing Catalogue authority column: '+h);});
  const rows=sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,sheet.getLastColumn()).getValues():[];
  const records=rows.map(function(r){
    const o={};fields.forEach(function(h){o[h]=String(r[cm[h]-1]||'').trim();});return o;
  }).filter(function(o){return o['Catalogue ID']||o['Service Name'];});
  records.sort(function(a,b){return String(a['Catalogue ID']).localeCompare(String(b['Catalogue ID']));});
  return Utilities.base64EncodeWebSafe(
    Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(records))
  );
}

function AQBBuildCatalogueCustomerVariants(){
  AQBRequireCataloguePhotoManager();
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(1000))throw new Error('Another Catalogue task is running.');
  try{
    const authority=AQBAuditCatalogueSourceOfTruth();
    if(!authority||!authority.success){
      throw new Error('Catalogue source-of-truth audit must pass before rebuilding customer variants.');
    }
    const fingerprint=AQBGetCatalogueAuthorityFingerprint();
    const out=AQBBuildCatalogueCustomerVariantNames();
    if(fingerprint!==AQBGetCatalogueAuthorityFingerprint()){
      throw new Error('Catalogue authority fields changed during variant generation. Rebuild variants.');
    }
    PropertiesService.getScriptProperties().setProperty('AQB_CATALOGUE_VARIANT_AUTHORITY_FINGERPRINT',fingerprint);
    return out;
  }finally{
    lock.releaseLock();
  }
}

function AQBResolveCataloguePromotionAuthority(sr,sm){
  function read(h){return sm[h]?sr[sm[h]-1]:'';}
  const status=String(read('Qualification Status')||'').trim().toUpperCase().replace(/^AUTO_APPROVED_/,'');
  const score=Number(read('Visual Score'));
  const recoveryStatus=String(read('Recovery Status')||'').trim().toUpperCase();
  const candidate=String(read('Candidate Image URL')||'').trim();
  const approved={STRONG:true,GOOD:true,ACCEPTABLE:true};
  let tierConsistent=false;
  if(status==='STRONG')tierConsistent=isFinite(score)&&score>=90;
  else if(status==='GOOD')tierConsistent=isFinite(score)&&score>=80;
  else if(status==='ACCEPTABLE')tierConsistent=isFinite(score)&&score>65;

  let evidence=null,legacyCurrent=false,legacyQualified=false;
  try{
    evidence=JSON.parse(String(read('Candidate Evidence JSON')||''))||null;
    legacyCurrent=!!(evidence&&evidence.visualQuality&&String(evidence.visualQuality.version||'')===AQB_PHOTO_PIPELINE_VERSION_);
    legacyQualified=!!(evidence&&evidence.qualification&&evidence.qualification.qualification&&evidence.qualification.qualification.qualified===true);
  }catch(ignoreEvidence){}
  const gate=String(read('Gate Outcome')||'').trim().toUpperCase();
  if(legacyCurrent&&legacyQualified&&gate==='QUALIFIED'){
    return {allow:true,authority:'CURRENT_PIPELINE_EVIDENCE',status:status,score:score,recoveryStatus:recoveryStatus};
  }

  // Durable incumbent authority: the candidate itself is unchanged (verified separately
  // by Source Fingerprint), its stored publishable status is valid, and its incumbent
  // Visual Score still satisfies the same AQB tier thresholds.  Recovery challenger
  // evidence must not invalidate this retained incumbent.
  if(candidate&&approved[status]&&tierConsistent){
    return {allow:true,authority:'RECONCILED_INCUMBENT_QUALIFICATION',status:status,score:score,recoveryStatus:recoveryStatus,legacyEvidenceCurrent:legacyCurrent,legacyEvidenceQualified:legacyQualified,challengerGate:gate};
  }
  return {allow:false,authority:'NO_CURRENT_INCUMBENT_AUTHORITY',status:status,score:score,recoveryStatus:recoveryStatus,legacyEvidenceCurrent:legacyCurrent,legacyEvidenceQualified:legacyQualified,challengerGate:gate};
}

