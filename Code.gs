function AQBGetCatalogueStructuralServiceVariants(service,signature){
  const out=[],family=signature.family,f=AQBGetCatalogueVariantFamilyLabel(family),count=signature.count,size=signature.size,length=signature.length,n=AQBNormalizeCatalogueVariantText(service);
  function add(v){if(v)out.push(v);}
  if(signature.recordType==='STYLE'&&f){
    if(size)add(size+' '+f);
    if(length&&length!==size)add(length+' '+f);
    if(count){
      add(count+' '+(size?size+' ':'')+f);
      if(family==='cornrow'){
        add(count+' straight-back lines');add(count+' plain lines');add(count+' Ghana weaving lines');
        if(size)add(count+' '+(size==='large'?'chunky':size)+' cornrows');
      }
    }
    if(family==='cornrow'&&/large cornrow/.test(n)){
      ['Large cornrows','Straight Backs','All Backs','Straight-back lines','Plain Lines','Ghana Weaving'].forEach(add);
    }
  }
  if(signature.recordType==='SERVICE'){
    if(family==='loc'&&/grooming/.test(n)){add('Loc Grooming');add('Loc Maintenance');add('Loc Care');}
    if(/retightening|retie/.test(n)){add(family==='loc'?'Loc Retie':'Hair Retie');add('Retightening');}
    if(/removal|take down|takedown/.test(n)){add(family==='braid'?'Braid Takedown':'Hair Takedown');add('Protective Style Removal');}
    if(/consultation/.test(n)){add('Hair Consultation');add('Salon Consultation');}
    if(/bridal.*styling|styling.*bridal/.test(n)){add('Bridal Hair Styling');add('Wedding Hair Styling');}
    if(/special occasion.*updo|updo.*special occasion/.test(n)){add('Special Occasion Updo');add('Formal Updo');}
    if(/treatment/.test(n)){
      const withoutBrand=String(service||'').replace(/^\s*Mizani\s+/i,'').trim();
      if(withoutBrand&&AQBNormalizeCatalogueVariantText(withoutBrand)!==n){add(withoutBrand);add(withoutBrand.replace(/\bTreatment\b/i,'Hair Treatment'));}
    }
  }
  return AQBGetUniqueCatalogueVariants(out).filter(function(v){return AQBNormalizeCatalogueVariantText(v)!==AQBNormalizeCatalogueVariantText(service);});
}

