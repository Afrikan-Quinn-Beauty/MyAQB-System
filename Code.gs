function AQBParseOpenAIJson(text){
  let s=String(text||'').trim();
  const fence=s.match(/```(?:json)?\s*([\s\S]*?)\s*```/i);if(fence)s=fence[1].trim();
  const a=s.indexOf('{'),b=s.lastIndexOf('}');if(a>=0&&b>a)s=s.slice(a,b+1);
  try{return JSON.parse(s);}catch(e){throw new Error('OpenAI returned an invalid research response. AQB kept the existing Trend data unchanged.');}
}

function AQBGetOpenAIKey(){const key=String(PropertiesService.getScriptProperties().getProperty(CONFIG.OPENAI.API_KEY_PROPERTY)||'').trim();if(!key)throw new Error('OpenAI API key is not configured. Add '+CONFIG.OPENAI.API_KEY_PROPERTY+' to Script Properties.');return key;}

function AQBCallOpenAI(input,options){
  const key=AQBGetOpenAIKey(),p=PropertiesService.getScriptProperties(),cache=CacheService.getScriptCache();
  const model=String(p.getProperty(CONFIG.OPENAI.MODEL_PROPERTY)||CONFIG.OPENAI.DEFAULT_MODEL).trim();
  const payload={model:model,input:input,max_output_tokens:Number(options&&options.maxOutputTokens||2200)};
  if(options&&options.tools)payload.tools=options.tools;
  if(options&&options.temperature!==undefined)payload.temperature=options.temperature;
  const res=UrlFetchApp.fetch('https://api.openai.com/v1/responses',{method:'post',muteHttpExceptions:true,contentType:'application/json',headers:{Authorization:'Bearer '+key},payload:JSON.stringify(payload)});
  const httpCode=res.getResponseCode(),body=res.getContentText()||'';
  if(httpCode<200||httpCode>=300){
    let parsed={};try{parsed=body?JSON.parse(body):{};}catch(ignore){}
    const err=parsed.error||{},errCode=String(err.code||'').trim(),errType=String(err.type||'').trim();
    let state='ERROR',message='OpenAI research temporarily unavailable. Existing AQB Trend data was kept unchanged.';
    if(errCode==='credit_balance_exhausted'){
      state='CREDIT_BALANCE_EXHAUSTED';
      message='OpenAI research temporarily unavailable — API credits are exhausted. Existing AQB Trend data remains available.';
    }else if(httpCode===429){
      state='RATE_LIMITED';
      message='OpenAI research temporarily unavailable due to an API usage limit. Existing AQB Trend data remains available.';
    }
    cache.put('AQB_OPENAI_LAST_STATE',state,21600);
    cache.put('AQB_OPENAI_LAST_ERROR',message,21600);
    throw new Error(message);
  }
  try{
    const data=JSON.parse(body);
    cache.put('AQB_OPENAI_LAST_STATE','READY',21600);
    cache.remove('AQB_OPENAI_LAST_ERROR');
    return {data:data,text:extractOpenAIResponseText_(data)};
  }catch(e){
    cache.put('AQB_OPENAI_LAST_STATE','INVALID_RESPONSE',21600);
    cache.put('AQB_OPENAI_LAST_ERROR','OpenAI returned an unreadable response. Existing AQB Trend data was kept unchanged.',21600);
    throw new Error('OpenAI returned an unreadable response. Existing AQB Trend data was kept unchanged.');
  }
}

