function AQBIsClearlyWrongPexelsImage(service,category,description,match,sourceUrl){
  const hay=String(match||'').toLowerCase();
  const profile=AQBGetPexelsVisualProfile(service,category,description);
  if(!hay)return false;
  if(profile.audience!=='child' && !profile.maleAllowed){
    if(/\b(?:man|men|male|boy|boys)\b/.test(hay))return true;
    if(profile.femaleRequired && !/\b(?:woman|women|female|lady|girl)\b/.test(hay))return true;
  }
  if(profile.audience==='child' && /\b(?:adult|woman|women|man|men|male)\b/.test(hay) && !/\b(?:girl|child|kid|teen)\b/.test(hay))return true;
  for(let i=0;i<profile.forbidden.length;i++)if(hay.indexOf(profile.forbidden[i])>=0)return true;
  return false;
}

