  try{
    const cat=AQBGetSheet(CONFIG.SHEETS.CATALOGUE),cm=AQBBuildHeaderMap(cat),cn=cat.getLastRow();
    if(cn>=2){
      cat.getRange(2,1,cn-1,cat.getLastColumn()).getValues().forEach(function(r){
        const id=cm['Catalogue ID']?String(r[cm['Catalogue ID']-1]||'').trim().toUpperCase():'';
        if(!id||!byId[id])return;
        ['Service Name','Customer-Facing Name','Customer Search Names','Service Synonyms','Customer Variant Names'].forEach(function(h){
          if(!cm[h])return;
          String(r[cm[h]-1]||'').split(/[|;,]+/).forEach(function(v){const k=norm(v);if(k&&!aliasToId[k])aliasToId[k]=id;});
        });
      });
    }
  }catch(ignore){}
  const appointments=[];
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.APPOINTMENTS),n=s.getLastRow();if(n<2)return [];
    const lastCol=Math.max(17,s.getLastColumn()),header=s.getRange(1,1,1,lastCol).getValues()[0],hm={};header.forEach(function(v,i){hm[String(v||'').trim().toLowerCase()]=i;});
    const col=function(names,fallback){for(var i=0;i<names.length;i++){var k=names[i].toLowerCase();if(hm[k]!==undefined)return hm[k];}return fallback;};
    const serviceCol=col(['service'],4),statusCol=col(['status'],8),dateCol=col(['appointment date','date'],5),customerCol=col(['customer id','customerid'],1),whatsappCol=col(['whatsapp number','whatsapp'],3);
    s.getRange(2,1,n-1,lastCol).getValues().forEach(function(r){
      const status=String(r[statusCol]||'').trim().toUpperCase();if(status!=='COMPLETED')return;
      let date=r[dateCol];if(!(date instanceof Date))date=new Date(String(date||''));if(isNaN(date.getTime()))return;
      const service=String(r[serviceCol]||'').trim();if(!service)return;
      appointments.push({service:service,date:date,customer:String(r[customerCol]||'').trim()||String(r[whatsappCol]||'').trim()});
    });
  }catch(e){return [];}
  function match(service){
    const n=norm(service);if(byName[n])return byName[n];
    const aliasId=aliasToId[n];if(aliasId&&byId[aliasId])return byId[aliasId];
    try{const ident=AQBGetCanonicalCatalogueIdentity(service,'');if(ident&&byId[String(ident.catalogueId||'').toUpperCase()])return byId[String(ident.catalogueId||'').toUpperCase()];}catch(ignore){}
    const aliases=Object.keys(aliasToId).filter(function(k){return k===n||k.indexOf(n)>=0||n.indexOf(k)>=0;});
    if(aliases.length){const id=aliasToId[aliases.sort(function(a,b){return b.length-a.length;})[0]];if(id&&byId[id])return byId[id];}
    const keys=Object.keys(byName).filter(function(k){return k===n||k.indexOf(n)>=0||n.indexOf(k)>=0;});return keys.length?byName[keys.sort(function(a,b){return b.length-a.length;})[0]]:null;
  }
  function build(useCutoff){
    const counts={};appointments.forEach(function(a){if(useCutoff&&a.date<cutoff)return;const x=match(a.service);if(!x)return;const key=String(x.catalogueId||x.name||'').toUpperCase();if(!counts[key])counts[key]={item:x,completedBookings:0,customers:{},lastActivity:0};const c=counts[key];c.completedBookings++;c.lastActivity=Math.max(c.lastActivity,a.date.getTime());if(a.customer)c.customers[a.customer]=(c.customers[a.customer]||0)+1;});return counts;
  }
  let counts=build(true),windowUsed=days;if(!Object.keys(counts).length&&appointments.length){counts=build(false);windowUsed='ALL_HISTORY';}
  return Object.keys(counts).map(function(key){const c=counts[key],customerIds=Object.keys(c.customers),repeatCustomers=customerIds.filter(function(id){return c.customers[id]>1;}).length;return Object.assign({},c.item,{mostLoved:true,appointmentSource:'Appointments',completedBookings:c.completedBookings,totalLovedBookings:c.completedBookings,uniqueCustomers:customerIds.length,repeatCustomers:repeatCustomers,lastActivity:new Date(c.lastActivity).toISOString(),mostLovedWindow:windowUsed});}).sort(function(a,b){return Number(b.repeatCustomers||0)-Number(a.repeatCustomers||0)||Number(b.completedBookings||0)-Number(a.completedBookings||0)||Number(b.uniqueCustomers||0)-Number(a.uniqueCustomers||0)||String(b.lastActivity||'').localeCompare(String(a.lastActivity||''));}).slice(0,6);
}

function AQBGetCataloguePublicData(){
  const cache=CacheService.getScriptCache();
  const key='AQB_PUBLIC_CATALOGUE_V1621165';
  try{
    let cached=cache.get(key);
    if(!cached){
      const count=Math.max(0,Number(cache.get(key+'__META')||0));
      if(count){let parts=[];for(let i=0;i<count;i++){const p=cache.get(key+'__'+i);if(!p){parts=[];break;}parts.push(p);}if(parts.length===count)cached=parts.join('');}
    }
    if(cached){
      const parsed=JSON.parse(cached);
      if(parsed&&Array.isArray(parsed.items)&&Array.isArray(parsed.mostLoved)&&Array.isArray(parsed.canonicalTrending)){
        if(!parsed.logo)parsed.logo=AQBGetPublicLogoDataInternal();
        return parsed;
      }
      if(parsed&&Array.isArray(parsed.items)){
        const currentTrending=AQBGetCurrentApprovedTrendingItems(parsed.items);
        const canonicalTrending=currentTrending.map(function(x){return {catalogueId:x.catalogueId,serviceTier:String(x.serviceTier||'').trim(),category:x.category,customerCategory:String(x.customerCategory||'').trim(),name:x.name,price:x.price,description:x.description,image:x.image,booking:x.booking,whatsapp:x.whatsapp,catalogueType:'Trend',trendStatus:'ACTIVE',featured:'YES',trendStart:x.trendStart||'',trendEnd:x.trendEnd||'',trendSource:x.trendSource||'',collectionIds:x.collectionIds||'',isTrend:true,group:x.category};});
        const mostLoved=AQBGetCatalogueMostLoved(parsed.items,365);
        const popularityMap={};mostLoved.forEach(function(x){popularityMap[String(x.catalogueId||x.name||'').toLowerCase()]=x;});(parsed.items||[]).forEach(function(x){const k=String(x.catalogueId||x.name||'').toLowerCase(),p=popularityMap[k];if(p){x.completedBookings=p.completedBookings;x.uniqueCustomers=p.uniqueCustomers;x.lastCompleted=p.lastCompleted;}});
        parsed.canonicalTrending=canonicalTrending; parsed.mostLoved=mostLoved; parsed.mostLovedWindowDays=90;
        parsed.items.forEach(function(x){x.isTrend=false;}); currentTrending.forEach(function(t){const match=parsed.items.find(function(x){return String(x.catalogueId||'')===String(t.catalogueId||'');});if(match)match.isTrend=true;});
        AQBCachePublicCatalogueSnapshot(parsed); return parsed;
      }
    }
  }catch(ignoreCached){}

  // V16.0.7: public visitors read the persistent prepared snapshot. Do not
  // rebuild it from Master Lists/Catalogue on a public request.
  try{
    const items=AQBReadPreparedPublicCatalogue();
    // Current Trending is driven by approved active Trend Catalogue records, not
    // the historical Master Lists Trending flag/legacy list. The prepared public
    // snapshot remains the publication/photo safety gate.
    const currentTrending=AQBGetCurrentApprovedTrendingItems(items);
    const canonicalTrending=currentTrending.map(function(x){return {
      catalogueId:x.catalogueId,serviceTier:String(x.serviceTier||'').trim(),category:x.category,customerCategory:String(x.customerCategory||'').trim(),name:x.name,price:x.price,description:x.description,image:x.image,
      booking:x.booking,whatsapp:x.whatsapp,catalogueType:'Trend',trendStatus:'ACTIVE',featured:'YES',
      trendStart:x.trendStart||'',trendEnd:x.trendEnd||'',trendSource:x.trendSource||'',collectionIds:x.collectionIds||'',isTrend:true,group:x.category
    };});
    const mostLoved=AQBGetCatalogueMostLoved(items,365);
    items.forEach(function(x){x.isTrend=false;});
    currentTrending.forEach(function(t){const match=items.find(function(x){return String(x.catalogueId||'')===String(t.catalogueId||'');});if(match)match.isTrend=true;});
    const base=String(ScriptApp.getService().getUrl()||'').replace(/\/$/,'');
    const result={ready:items.length>0,items:items,appearance:AQBGetPublicAppearance(),logo:AQBGetPublicLogoDataInternal(),catalogueUrl:base+'?page=catalogue',
      preparedAt:new Date().toISOString(),canonicalTrending:canonicalTrending,mostLoved:mostLoved,mostLovedWindowDays:365,
      warning:items.length?'':'Catalogue has not been prepared yet.'};
    AQBCachePublicCatalogueSnapshot(result);
    return result;
  }catch(e){
    return {ready:false,items:[],appearance:AQBGetPublicAppearance(),logo:AQBGetPublicLogoDataInternal(),catalogueUrl:String(ScriptApp.getService().getUrl()||'')+'?page=catalogue',preparedAt:'',canonicalTrending:[],mostLoved:[],mostLovedWindowDays:365,warning:String(e&&e.message?e.message:e)};
  }
}

function AQBGetCatalogueLegacyPublicData(options){
  options=options||{};
  // V15.3: public customers only READ the already-synchronized Catalogue.
  // Never run Master Lists sync or online image searches during page load.
  const webAppUrl=String(ScriptApp.getService().getUrl()||'').replace(/\/$/,'');
  let values=[], h={}, warning='';
  try{
    const s=AQBGetSheet(CONFIG.SHEETS.CATALOGUE);
    values=s.getDataRange().getValues();
    if(values.length){values[0].forEach(function(v,i){h[String(v||'').trim()]=i;});}
  }catch(e){
    warning=String(e&&e.message?e.message:e);
  }

  if(values.length<2 || h['Category']===undefined || h['Service Name']===undefined || h['Price']===undefined || h['Active']===undefined){
    return {items:[],logo:AQBGetPublicLogoDataInternal(),catalogueUrl:webAppUrl+'?page=catalogue',warning:warning||'Catalogue is not synchronized yet.'};
  }

  // Normal public Catalogue loads use the already-synchronised Catalogue price.
  // The Master Lists remains authoritative when the Catalogue is synchronised, but
  // we must not perform another full Master Lists read for every public page load.
  const livePrices={};
