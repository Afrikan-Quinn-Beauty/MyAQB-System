function doPost(e){
  try{
    const body=e&&e.postData&&e.postData.contents?JSON.parse(e.postData.contents):{};
    const route=String(e&&e.parameter&&e.parameter.route||'').trim().toLowerCase();
    if(String(e&&e.parameter&&e.parameter.aqb_route||'')==='daraja_callback')return AQBHandleDarajaCallback(e,body);
    if(route==='dnb-ingest' || body.feed==='AQB_DNB'){
      const token=String(e&&e.parameter&&e.parameter.token||body.token||'').trim();
      if(!AQBVerifyAQBDNBFeedToken(token)) return AQBBuildJsonOutput({success:false,error:'Forbidden'});
      try{
        const result=AQBUpsertDNBFeed(body);
        return AQBBuildJsonOutput(result);
      }catch(dnbErr){
        try{AQBEnsureAQBDNBFeedSheets();AQBSetAQBDNBStatus({LAST_ATTEMPTED_FEED:new Date(),LAST_ERROR:String(dnbErr&&dnbErr.message||dnbErr),API_STATUS:'ERROR'});}catch(ignore){}
        return AQBBuildJsonOutput({success:false,error:String(dnbErr&&dnbErr.message||dnbErr)});
      }
    }
    if(String(body.object||'')!=='whatsapp_business_account')return ContentService.createTextOutput('IGNORED').setMimeType(ContentService.MimeType.TEXT);
    AQBProcessWhatsAppWebhook(body);
    return ContentService.createTextOutput('EVENT_RECEIVED').setMimeType(ContentService.MimeType.TEXT);
  }catch(err){
    try{AQBGetSheet(CONFIG.SHEETS.AUDIT).appendRow([new Date(),'WhatsApp Webhook','System','WHATSAPP_WEBHOOK_ERROR','WhatsApp','',String(err&&err.message||err)]);}catch(ignore){}
    return ContentService.createTextOutput('EVENT_RECEIVED').setMimeType(ContentService.MimeType.TEXT);
  }
}

