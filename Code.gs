function AQBGetCatalogueMostLoved(items,windowDays){
  const list=Array.isArray(items)?items:[];if(!list.length)return [];
  const days=Math.max(90,Number(windowDays)||365),today=new Date();today.setHours(0,0,0,0);const cutoff=new Date(today);cutoff.setDate(cutoff.getDate()-days);
  function norm(v){return String(v||'').toLowerCase().replace(/[–—−]/g,'-').replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim();}
  const byName={},byId={},aliasToId={};
  list.forEach(function(x){const n=norm(x.name),id=String(x.catalogueId||'').trim().toUpperCase();if(n&&!byName[n])byName[n]=x;if(id)byId[id]=x;});
