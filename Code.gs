function AQBNormalizeTrendRuntimeRecords(){
  const s=AQBEnsureConsolidatedIntelligenceSheet(),n=s.getLastRow(); if(n<2)return {normalized:0};
  const m=AQBBuildHeaderMap(s),rows=s.getRange(2,1,n-1,s.getLastColumn()).getValues(); let normalized=0;
  rows.forEach(function(r){
    const trendId=m['Trend ID']?String(r[m['Trend ID']-1]||'').trim():'';
    const recordId=m['Record ID']?String(r[m['Record ID']-1]||'').trim():'';
    const style=m['Style Name']?String(r[m['Style Name']-1]||'').trim():'';
    if(trendId.indexOf('AQB-TI-')!==0 || !style)return;
    const type=m['Record Type']?String(r[m['Record Type']-1]||'').trim().toUpperCase():'';
    const source=m['Source Sheet']?String(r[m['Source Sheet']-1]||'').trim().toUpperCase():'';
    let changed=false;
    if(m['Record ID']&&!recordId){r[m['Record ID']-1]=trendId;changed=true;}
    if(m['Record Type']&&type!=='TREND_INBOX'){r[m['Record Type']-1]='TREND_INBOX';changed=true;}
    if(m['Source Sheet']&&source!=='AQB TREND INBOX'){r[m['Source Sheet']-1]='AQB Trend Inbox';changed=true;}
    if(m['Status']&&!String(r[m['Status']-1]||'').trim()){r[m['Status']-1]='PENDING';changed=true;}
    if(changed)normalized++;
  });
  if(normalized)s.getRange(2,1,rows.length,s.getLastColumn()).setValues(rows);
  return {normalized:normalized};
}

function AQBNormalizeTrendDuplicateKey(category,name){
  const c=String(category||'').trim().toLowerCase().replace(/[–—]/g,'-').replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim();
  const n=String(name||'').trim().toLowerCase().replace(/[–—]/g,'-').replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim();
  return c+'|'+n;
}

