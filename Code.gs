  const current=AQBRequireAdmin();
  const started=new Date();
  const retie=AQBRefreshAllCustomerRetieDates();
  let automatic={created:0,skipped:0};
  try{ automatic=AQBRunAutomaticRetieAppointments(); }catch(e){ automatic={created:0,skipped:0,error:String(e&&e.message||e)}; }
